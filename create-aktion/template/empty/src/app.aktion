// The entry module. In a multi-file Aktion project the entry assigns the root
// node to $app(...)
// Edit this file and the dev server hot-reloads while preserving live `$state`.

function App() {
  return Column([
    Markdown("# Hello, Aktion"),
    Text("Edit src/app.aktion to start building. The UI hot-reloads on save.", {
      tone: "muted"
    })
  ], { gap: "m", padding: "l" })
}

$app(App())