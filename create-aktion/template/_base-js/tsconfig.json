{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // `.aktion.js` modules contribute their types to host code and tests.
    // `"checkJs": true` would type-check the modules themselves too, but under
    // `strict` they then need JSDoc types (parameters, `$http` resources), which
    // these modules do not carry. Write them in TypeScript (`--lang ts`) to have
    // them checked.
    "allowJs": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests"]
}
