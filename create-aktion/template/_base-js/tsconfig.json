{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // `.aktion.js` modules contribute their types to host code and tests.
    // Add `"checkJs": true` to have `tsc` check them too.
    "allowJs": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests"]
}
