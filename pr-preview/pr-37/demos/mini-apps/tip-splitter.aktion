// Tip & Bill Splitter — split a check across a party with a tip slider and rounding.
// Uses: $store({ persist }), SegmentedControl for quick tips, $util.currency, sx hover states.
$app(Column([header, inputs, result, breakdown], { gap: "lg", padding: "md" }))

check = $store({
  persist: "tip.check",
  bill: 58.4,
  pct: 18,
  people: 2,
  setPct: (s, p) => { s.pct = Number(p) }
})
$roundUp = false

money = n => $util.currency(n, "USD")

tip      = check.bill * check.pct / 100
total    = check.bill + tip
perRaw   = check.people > 0 ? total / check.people : total
perPerson = $roundUp ? Math.ceil(perRaw) : perRaw
collected = perPerson * check.people
extra    = collected - total

header = PageHeader("Tip & Bill Splitter", {
  subtitle: "Fair shares in a tap",
  badge: Badge(`${check.pct}% tip`, { tone: "primary" })
})

quickTips = SegmentedControl(["10", "15", "18", "20", "25"], {
  value: String(check.pct),
  onChange: (p) => check.setPct(p)
})

inputs = Card([
  SectionHeader("The bill", { eyebrow: "INPUTS" }),
  FormControl("Bill amount", { field: NumberInput("bill", { value: check.bill, min: 0, step: 0.5 }) }),
  FormControl("Tip percentage", { field: Slider("tipPct", { min: 0, max: 40, step: 1, value: check.pct, showValue: true }) }),
  Row([Text("Quick tip %", { variant: "small-heavy", tone: "muted" }), quickTips], { gap: "md", align: "center" }),
  FormControl("Split between", { field: NumberInput("people", { value: check.people, min: 1, max: 50, step: 1 }) }),
  Switch("roundUp", { label: "Round up each share", value: $roundUp, description: "Rounds every person up to the next dollar" })
], { animate: "fade-up" })

statSx = { states: { hover: { translateY: "-2px", shadow: "md" } } }

result = Grid([
  StatCard("Tip", { value: money(tip), icon: "hand-holding-dollar", tone: "primary", sx: statSx }),
  StatCard("Total", { value: money(total), icon: "receipt", tone: "info", sx: statSx }),
  StatCard("Per person", { value: money(perPerson), icon: "user-group", tone: "success", sx: statSx })
], { columns: { base: 1, sm: 3 }, gap: "md" })

breakdown = Card([
  SectionHeader("Breakdown"),
  DescriptionList([
    DescriptionItem("Subtotal", { value: money(check.bill) }),
    DescriptionItem("Tip", { value: `${money(tip)} (${check.pct}%)`, icon: "percent" }),
    DescriptionItem("Grand total", { value: money(total), icon: "sack-dollar" }),
    DescriptionItem("People", { value: String(check.people), icon: "users" }),
    DescriptionItem("Each pays", { value: money(perPerson), icon: "wallet" })
  ], { columns: 2 }),
  Show($roundUp && extra > 0.001, {
    children: Callout("success", { title: `You'll collect ${money(extra)} extra`, description: "Rounding up means a little more in the tip jar.", icon: "circle-up", compact: true })
  })
], { animate: { preset: "fade-up", delay: 80 } })
