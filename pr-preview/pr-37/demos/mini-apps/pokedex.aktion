// Pokédex — browse Pokémon from the free PokeAPI with paging, then tap one to
// load its types, stats and artwork in a slide-over panel. Starting point for:
// any paginated API browser with a list + detail drill-down.
// Uses: $query (cached, keyed by page), $http on-demand detail, Async states, Sheet, Progress.
$app(Column([header, grid, pager, detailSheet], { gap: "lg", padding: "md" }))

PER_PAGE = 24
$page = 0
$detailId = null
$detail = null

listUrl = `https://pokeapi.co/api/v2/pokemon?limit=${PER_PAGE}&offset=${$page * PER_PAGE}`
$list = $query({ url: listUrl, key: `pokedex-page-${$page}`, ttl: 600000 })

idFromUrl = url => Number(url.split("/").filter(s => s != "").pop())
artwork = id => `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`

typeTone = {
  fire: "danger", water: "info", grass: "success", electric: "warning", psychic: "primary",
  ice: "info", dragon: "primary", dark: "neutral", fairy: "primary", normal: "neutral",
  fighting: "danger", flying: "info", poison: "primary", ground: "warning", rock: "neutral",
  bug: "success", ghost: "primary", steel: "neutral"
}
toneFor = t => typeTone[t] ?? "neutral"

total = $list.data ? $list.data.count : 0
maxPage = total > 0 ? Math.ceil(total / PER_PAGE) - 1 : 0

function openMon(id) {
  $detailId = id
  $detail = $http({ url: `https://pokeapi.co/api/v2/pokemon/${id}` })
}

header = PageHeader("Pokédex", {
  subtitle: total > 0 ? `${total} Pokémon · page ${$page + 1} of ${maxPage + 1}` : "Powered by PokeAPI",
  badge: Badge("Live API", { tone: "success", icon: "dragon" })
})

function monCard(entry) {
  const id = idFromUrl(entry.url)
  return OnClick(Card([Column([
    Center([Image(artwork(id), { alt: entry.name, fit: "contain", sx: { w: "96px", h: "96px" } })]),
    Text(`#${String(id).padStart(3, "0")}`, { variant: "small", tone: "muted", align: "center" }),
    Text($util.capitalize(entry.name), { variant: "body-heavy", align: "center" })
  ], { gap: "2xs" })], {
    key: String(id),
    sx: { states: { hover: { translateY: "-3px", shadow: "md" } } }
  }), { onClick: () => openMon(id) })
}

grid = Async($list, {
  loading: LoadingState("Loading Pokémon…", { description: "Fetching this page from PokeAPI" }),
  error: ErrorState("Couldn't reach PokeAPI", { description: "Check your connection and retry.", actions: [Button("Retry", { variant: "primary", icon: "rotate-right", onClick: () => $list.refetch() })] }),
  data: Grid(($list.data ? $list.data.results : []).map(e => monCard(e)), { columns: { base: 2, sm: 3, md: 4, lg: 6 }, gap: "md" })
})

pager = Row([
  Button("Previous", { variant: "secondary", icon: "arrow-left", disabled: $page == 0, onClick: () => { if ($page > 0) $page = $page - 1 } }),
  Spacer(),
  Text(`Page ${$page + 1}${maxPage > 0 ? " / " + (maxPage + 1) : ""}`, { variant: "small", tone: "muted" }),
  Spacer(),
  Button("Next", { variant: "primary", icon: "arrow-right", disabled: $page >= maxPage, onClick: () => { if ($page < maxPage) $page = $page + 1 } })
], { align: "center" })

function statRow(s) {
  const tone = s.base_stat >= 100 ? "success" : s.base_stat >= 60 ? "primary" : "warning"
  return Row([
    StackItem(Text($util.titlecase(s.stat.name.replace(/-/g, " ")), { variant: "small" }), { basis: "120px" }),
    StackItem(Progress(s.base_stat, { max: 200, tone }), { grow: 1 }),
    Text(String(s.base_stat), { variant: "small-heavy" })
  ], { gap: "sm", align: "center" })
}

function detailView() {
  const d = $detail.data
  return Column([
    Center([Image(artwork(d.id), { alt: d.name, fit: "contain", sx: { w: "180px", h: "180px" } })]),
    Center([Text($util.capitalize(d.name), { variant: "heading" })]),
    Center([Row(d.types.map(t => Badge($util.capitalize(t.type.name), { tone: toneFor(t.type.name), size: "sm" })), { gap: "xs" })]),
    Grid([
      StatCard("Height", { value: `${d.height / 10} m`, icon: "ruler-vertical", tone: "info" }),
      StatCard("Weight", { value: `${d.weight / 10} kg`, icon: "weight-hanging", tone: "primary" })
    ], { columns: 2, gap: "sm" }),
    SectionHeader("Base stats", { eyebrow: "STATS" }),
    Column(d.stats.map(s => statRow(s)), { gap: "xs" }),
    SectionHeader("Abilities"),
    BadgeList(d.abilities.map(a => $util.capitalize(a.ability.name.replace(/-/g, " "))), { size: "sm" })
  ], { gap: "md" })
}

detailSheet = Sheet($detailId != null ? [Async($detail, {
  loading: LoadingState("Loading details…"),
  error: ErrorState("Couldn't load that Pokémon", { actions: [Button("Retry", { variant: "primary", onClick: () => openMon($detailId) })] }),
  data: detailView()
})] : [], {
  open: $detailId != null,
  side: "right",
  title: "Pokémon details",
  onClose: () => { $detailId = null }
})
