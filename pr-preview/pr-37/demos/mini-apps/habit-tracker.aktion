// Habit Tracker — a weekly grid you tap to complete, with streaks and a heatmap.
// Uses: $store({ persist, history }) with undo, Confetti at 100%, sx hover states.
$app(Column([header, kpis, grid, heatCard, addCard], { gap: "lg", padding: "md" }))

days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

tracker = $store({
  persist: "habits.tracker",
  history: 25,
  habits: [
    { id: "h1", name: "Drink water",   icon: "droplet",      done: [true, true, true, false, true, false, false] },
    { id: "h2", name: "Read 20 min",   icon: "book-open",    done: [true, false, true, true, true, false, false] },
    { id: "h3", name: "Workout",       icon: "dumbbell",     done: [false, true, false, true, false, true, false] },
    { id: "h4", name: "Meditate",      icon: "spa",          done: [true, true, true, true, true, true, false] }
  ],
  toggle: (s, habitId, dayIdx) => {
    s.habits = s.habits.map(h => h.id == habitId ? { ...h, done: h.done.map((v, i) => i == dayIdx ? !v : v) } : h)
  },
  add:    (s, h) => { s.habits = [...s.habits, h] },
  remove: (s, id) => { s.habits = s.habits.filter(h => h.id != id) }
})
$newHabit = ""

totalCells = tracker.habits.length * 7
doneCells  = $util.sum(tracker.habits.map(h => h.done.filter(Boolean).length))
pct        = totalCells > 0 ? Math.round((doneCells / totalCells) * 100) : 0
perfectWeek = totalCells > 0 && doneCells == totalCells

function streakOf(h) {
  let best = 0
  let run = 0
  for (let i = 0; i < h.done.length; i++) {
    if (h.done[i]) { run++; if (run > best) best = run }
    else run = 0
  }
  return best
}

function addHabit() {
  if (!$newHabit) return
  tracker.add({ id: $util.uuid(), name: $newHabit, icon: "circle-check", done: [false, false, false, false, false, false, false] })
  $newHabit = ""
}

header = PageHeader("Habit Tracker", {
  subtitle: "Tap a day to mark it done — streaks build automatically",
  badge: Badge(`${pct}% this week`, { tone: pct >= 70 ? "success" : pct >= 40 ? "warning" : "neutral" }),
  actions: [
    Button("Undo", { variant: "ghost", icon: "rotate-left", size: "sm", onClick: () => tracker.undo(), disabled: !tracker.canUndo }),
    Button("Redo", { variant: "ghost", icon: "rotate-right", size: "sm", onClick: () => tracker.redo(), disabled: !tracker.canRedo })
  ]
})

kpis = Stats([
  StatCard("Habits", { value: String(tracker.habits.length), icon: "list-check", tone: "primary" }),
  StatCard("Completed", { value: `${doneCells}/${totalCells}`, icon: "circle-check", tone: "success" }),
  StatCard("Best streak", { value: `${tracker.habits.length ? Math.max(...tracker.habits.map(h => streakOf(h))) : 0} days`, icon: "fire", tone: "warning" })
])

dayToggle = (h, i) => IconButton(h.done[i] ? "circle-check" : "circle", {
  label: `${h.name} ${days[i]}`,
  variant: h.done[i] ? "primary" : "ghost",
  size: "sm",
  onClick: () => tracker.toggle(h.id, i)
})

habitRow = h => Box([Row([
  StackItem(Row([Icon(h.icon, { size: "sm" }), Text(h.name, { variant: "body-heavy" })], { gap: "sm", align: "center" }), { grow: 1, minWidth: "140px" }),
  Row(days.map((d, i) => dayToggle(h, i)), { gap: "xs" }),
  Badge(String(streakOf(h)), { tone: "warning", size: "sm", icon: "fire" }),
  IconButton("trash", { label: "Remove habit", variant: "ghost", size: "sm", onClick: () => tracker.remove(h.id) })
], { gap: "md", align: "center", wrap: true })], { padding: "sm", border: "subtle", sx: { states: { hover: { bg: "surface" } } } })

grid = Card([
  Row([
    StackItem(SectionHeader("This week", { eyebrow: "MON – SUN" }), { grow: 1 }),
    Show(perfectWeek, { children: Badge("Perfect week!", { tone: "success", icon: "trophy" }) })
  ], { align: "center" }),
  Show(perfectWeek, { children: Confetti({ fire: true, count: 90 }) }),
  Row([Box([Text("", { variant: "small" })], { padding: "xs" }), Spacer(), Row(days.map(d => Box([Text(d, { variant: "small-heavy", tone: "muted" })], { padding: "xs" })), { gap: "xs" })], { align: "center" }),
  Show(tracker.habits.length > 0, {
    fallback: EmptyState("No habits yet", { description: "Add one below to start tracking.", icon: "seedling" }),
    children: Column(tracker.habits.map(h => habitRow(h)), { gap: "sm" })
  })
])

heatCard = Show(tracker.habits.length > 0, {
  children: Card([
    SectionHeader("Completion heatmap", { subtitle: "Darker = done" }),
    Heatmap(days, { yLabels: tracker.habits.map(h => h.name), values: tracker.habits.map(h => h.done.map(v => v ? 1 : 0)), tone: "success" })
  ], { animate: "fade-up" })
})

addCard = Card([
  SectionHeader("Add a habit", { eyebrow: "NEW" }),
  Row([
    StackItem(Input("newHabit", { placeholder: "e.g. Stretch for 5 minutes", value: $newHabit }), { grow: 1 }),
    Button("Add habit", { onClick: addHabit, variant: "primary", icon: "plus", disabled: !$newHabit })
  ], { gap: "sm", align: "end" })
])
