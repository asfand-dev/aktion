// Expense Splitter — log who paid what on a trip, see balances and the fewest settle-up payments.
// Starting point for: group-finance tools (trips, flatshares, team lunches).
// Uses: $store({ persist, history }) with undo, $form add expense, $util.currency, animate.
$app(Column([header, kpis, body, ledger], { gap: "lg", padding: "md" }))

people = ["Ava", "Ben", "Chloe", "Dan"]

trip = $store({
  persist: "split.trip",
  history: 30,
  expenses: [
    { id: "e1", payer: "Ava",   label: "Airbnb (3 nights)", amount: 420 },
    { id: "e2", payer: "Ben",   label: "Groceries",         amount: 86.5 },
    { id: "e3", payer: "Chloe", label: "Car rental",        amount: 180 },
    { id: "e4", payer: "Dan",   label: "Dinner out",        amount: 124 },
    { id: "e5", payer: "Ava",   label: "Museum tickets",    amount: 60 }
  ],
  add:    (s, e) => { s.expenses = [e, ...s.expenses] },
  remove: (s, id) => { s.expenses = s.expenses.filter(e => e.id != id) }
})

addForm = $form({
  values: { payer: "Ava", label: "", amount: 0 },
  rules: {
    label:  [$util.rules.required("Describe the expense")],
    amount: [$util.rules.min(0.01, "Enter an amount")]
  },
  onSubmit: (v) => {
    trip.add({ id: $util.uuid(), payer: v.payer, label: v.label, amount: Number(v.amount) })
    addForm.reset()
  }
})

money = n => $util.currency(n, "USD")

total = $util.sum(trip.expenses.map(e => e.amount))
fairShare = people.length > 0 ? total / people.length : 0
paidBy = p => $util.sum(trip.expenses.filter(e => e.payer == p).map(e => e.amount))
balanceOf = p => paidBy(p) - fairShare

// Greedy settle-up: repeatedly match the biggest debtor with the biggest creditor.
function settlements() {
  const bal = people.map(p => ({ p, b: Math.round(balanceOf(p) * 100) / 100 }))
  const out = []
  for (let guard = 0; guard < 12; guard++) {
    bal.sort((a, b) => a.b - b.b)
    const debtor = bal[0]
    const creditor = bal[bal.length - 1]
    if (!debtor || !creditor || debtor.b > -0.01 || creditor.b < 0.01) break
    const amt = Math.min(-debtor.b, creditor.b)
    out.push({ from: debtor.p, to: creditor.p, amount: amt })
    debtor.b += amt
    creditor.b -= amt
  }
  return out
}

header = PageHeader("Expense Splitter", {
  subtitle: `${people.length} people · ${trip.expenses.length} expenses · saved locally`,
  badge: Badge(money(total), { tone: "primary", icon: "money-bill-transfer" }),
  actions: [
    Button("Undo", { variant: "ghost", icon: "rotate-left", size: "sm", onClick: () => trip.undo(), disabled: !trip.canUndo }),
    Button("Redo", { variant: "ghost", icon: "rotate-right", size: "sm", onClick: () => trip.redo(), disabled: !trip.canRedo })
  ]
})

kpis = Stats([
  StatCard("Trip total", { value: money(total), icon: "sack-dollar", tone: "primary" }),
  StatCard("Fair share", { value: money(fairShare), icon: "scale-balanced", tone: "info" }),
  StatCard("Transfers needed", { value: String(settlements().length), icon: "right-left", tone: "success" })
])

balanceRow = p => Row([
  Avatar(p, { size: "sm" }),
  StackItem(Column([
    Text(p, { variant: "body-heavy" }),
    Text(`paid ${money(paidBy(p))}`, { variant: "small", tone: "muted" })
  ], { gap: "none" }), { grow: 1 }),
  Text(`${balanceOf(p) >= 0 ? "+" : ""}${money(balanceOf(p))}`, { variant: "body-heavy", tone: balanceOf(p) >= 0.01 ? "success" : balanceOf(p) <= -0.01 ? "danger" : "muted" })
], { gap: "sm", align: "center" })

balances = Card([
  SectionHeader("Balances", { eyebrow: "WHO'S UP, WHO'S DOWN" }),
  Column(people.map(p => balanceRow(p)), { gap: "md" })
], { animate: "fade-up" })

settleRows = settlements()
settleCard = Card([
  SectionHeader("Settle up", { eyebrow: "FEWEST PAYMENTS", subtitle: settleRows.length == 0 ? "All square!" : `${settleRows.length} transfer${settleRows.length == 1 ? "" : "s"} clears everything` }),
  Show(settleRows.length > 0, {
    fallback: SuccessState("Everyone is even", { icon: "handshake", description: "No transfers needed." }),
    children: Column(settleRows.map(s => Row([
      PersonChip(s.from),
      Icon("arrow-right-long", { size: "sm" }),
      PersonChip(s.to),
      Spacer(),
      Badge(money(s.amount), { tone: "primary" })
    ], { gap: "sm", align: "center" })), { gap: "md" })
  })
], { animate: { preset: "fade-up", delay: 80 } })

addCard = Card([
  SectionHeader("Add expense", { eyebrow: "NEW" }),
  FormControl("Paid by", { field: Select("payer", { items: people.map(p => SelectItem(p, { label: p })), value: addForm.values.payer }) }),
  FormControl("What for", { field: Input("label", { placeholder: "e.g. Taxi to the airport", value: addForm.values.label, error: addForm.errors.label, onBlur: () => addForm.touch("label") }) }),
  FormControl("Amount", { field: NumberInput("amount", { value: addForm.values.amount, min: 0, step: 0.5, error: addForm.errors.amount }) }),
  Button("Add expense", { variant: "primary", icon: "plus", fullWidth: true, onClick: () => addForm.submit(), disabled: !addForm.values.label || addForm.values.amount <= 0 })
], { animate: { preset: "fade-up", delay: 160 } })

body = Grid([balances, settleCard, addCard], { columns: { base: 1, lg: 3 }, gap: "lg", alignItems: "start" })

ledger = Card([
  SectionHeader("Expenses", { eyebrow: "LEDGER" }),
  Show(trip.expenses.length > 0, {
    fallback: EmptyState("No expenses yet", { icon: "receipt" }),
    children: Table([
      Col("Paid by", { values: trip.expenses.map(e => PersonChip(e.payer)) }),
      Col("Description", { values: trip.expenses.map(e => e.label) }),
      Col("Amount", { align: "right", values: trip.expenses.map(e => Text(money(e.amount), { variant: "body-heavy" })) }),
      Col("", { align: "right", values: trip.expenses.map(e => IconButton("trash", { label: "Delete", variant: "ghost", size: "sm", onClick: () => trip.remove(e.id) })) })
    ], { striped: true })
  })
])
