// Kanban Board — move tasks across stages, add new cards, filter by priority.
// Uses: $store({ persist, history }) with undo/redo, $form for the add-card modal, keyed cards + sx hover.
$app(Column([header, toolbar, board, addModal], { gap: "lg", padding: "md" }))

stages = [
  { key: "backlog", label: "Backlog",     tone: "neutral" },
  { key: "todo",    label: "To do",       tone: "info" },
  { key: "doing",   label: "In progress", tone: "warning" },
  { key: "done",    label: "Done",        tone: "success" }
]

boardStore = $store({
  persist: "kanban.board",
  history: 40,
  tasks: [
    { id: "k1", title: "Design landing hero", priority: "high",   col: "doing" },
    { id: "k2", title: "Set up CI pipeline",  priority: "medium", col: "todo" },
    { id: "k3", title: "Write API docs",      priority: "low",    col: "backlog" },
    { id: "k4", title: "Fix login redirect",  priority: "high",   col: "todo" },
    { id: "k5", title: "Ship dark mode",      priority: "medium", col: "done" },
    { id: "k6", title: "Refactor settings",   priority: "low",    col: "backlog" },
    { id: "k7", title: "Onboarding emails",   priority: "medium", col: "doing" }
  ],
  moveTo: (s, id, col) => { s.tasks = s.tasks.map(t => t.id == id ? { ...t, col } : t) },
  add:    (s, t) => { s.tasks = [...s.tasks, t] },
  remove: (s, id) => { s.tasks = s.tasks.filter(t => t.id != id) }
})

$filter = "all"
$addOpen = false
$addCol = "backlog"

// managed add-card form: validation + reset come for free
addForm = $form({
  values: { title: "", priority: "medium" },
  rules: { title: [$util.rules.required("Give the task a title"), $util.rules.minLength(3)] },
  onSubmit: (v) => {
    boardStore.add({ id: $util.uuid(), title: v.title, priority: v.priority, col: $addCol })
    $addOpen = false
    addForm.reset()
  }
})

prioTone = p => p == "high" ? "danger" : p == "medium" ? "warning" : "neutral"
stageIndex = key => stages.findIndex(s => s.key == key)
visible = col => boardStore.tasks.filter(t => t.col == col && ($filter == "all" || t.priority == $filter))

function move(task, dir) {
  const i = stageIndex(task.col) + dir
  if (i < 0 || i >= stages.length) return
  boardStore.moveTo(task.id, stages[i].key)
}

function openAdd(col) {
  $addCol = col
  addForm.reset()
  $addOpen = true
}

header = PageHeader("Kanban Board", {
  subtitle: `${boardStore.tasks.length} tasks across ${stages.length} stages`,
  badge: Badge(`${visible("done").length} done`, { tone: "success" }),
  actions: [
    Button("Undo", { variant: "ghost", icon: "rotate-left", size: "sm", onClick: () => boardStore.undo(), disabled: !boardStore.canUndo }),
    Button("Redo", { variant: "ghost", icon: "rotate-right", size: "sm", onClick: () => boardStore.redo(), disabled: !boardStore.canRedo })
  ]
})

toolbar = Toolbar({
  left: [Text("Filter priority", { variant: "small-heavy", tone: "muted" }),
    ToggleGroup("filter", { items: [
      { value: "all", label: "All" },
      { value: "high", label: "High" },
      { value: "medium", label: "Medium" },
      { value: "low", label: "Low" }
    ], value: $filter, size: "sm" })],
  right: [Button("Add task", { onClick: () => openAdd("backlog"), variant: "primary", icon: "plus", size: "sm" })]
})

taskCard = t => Box([Column([
  Row([
    StackItem(Text(t.title, { variant: "body-heavy" }), { grow: 1 }),
    Badge(t.priority, { tone: prioTone(t.priority), size: "xs" })
  ], { align: "start", gap: "sm" }),
  Row([
    IconButton("arrow-left", { label: "Move back", variant: "ghost", size: "xs", disabled: stageIndex(t.col) == 0, onClick: () => move(t, -1) }),
    IconButton("arrow-right", { label: "Move forward", variant: "ghost", size: "xs", disabled: stageIndex(t.col) == stages.length - 1, onClick: () => move(t, 1) }),
    Spacer(),
    IconButton("trash", { label: "Delete", variant: "ghost", size: "xs", onClick: () => boardStore.remove(t.id) })
  ], { align: "center" })
], { gap: "sm" })], {
  key: t.id,
  padding: "sm", border: "subtle", background: "surface",
  sx: { states: { hover: { shadow: "md", translateY: "-1px" } } }
})

columnView = s => Card([
  Row([
    StackItem(Text(s.label, { variant: "body-heavy" }), { grow: 1 }),
    Badge(String(visible(s.key).length), { tone: s.tone, size: "sm" })
  ], { align: "center" }),
  Separator("horizontal"),
  Show(visible(s.key).length > 0, {
    fallback: Center([Text("No tasks", { variant: "small", tone: "muted" })], { minHeight: "60px" }),
    children: Column(visible(s.key).map(t => taskCard(t)), { gap: "sm" })
  }),
  Button("Add", { variant: "ghost", size: "sm", icon: "plus", fullWidth: true, onClick: () => openAdd(s.key) })
])

board = Grid(stages.map(s => columnView(s)), { columns: { base: 1, sm: 2, lg: 4 }, gap: "md", alignItems: "start" })

addModal = Modal("Add a task", {
  open: $addOpen,
  closeOnBackdrop: true,
  onClose: () => { $addOpen = false },
  children: [Column([
    FormControl("Title", { field: Input("addTitle", {
      placeholder: "What needs doing?",
      value: addForm.values.title,
      error: addForm.errors.title,
      onBlur: () => addForm.touch("title")
    }) }),
    FormControl("Priority", { field: Radio("addPriority", { items: [
      SelectItem("high", { label: "High" }),
      SelectItem("medium", { label: "Medium" }),
      SelectItem("low", { label: "Low" })
    ], value: addForm.values.priority }) }),
    FormControl("Stage", { field: Select("addCol", { items: stages.map(s => SelectItem(s.key, { label: s.label })), value: $addCol }) })
  ], { gap: "md" })],
  footer: [
    Button("Cancel", { variant: "ghost", onClick: () => { $addOpen = false } }),
    Button("Create task", { variant: "primary", icon: "check", onClick: () => addForm.submit(), disabled: !addForm.values.title })
  ]
})
