// SaaS Landing Page — a complete marketing page built from the marketing composites.
// Starting point for: product launches, startup sites, feature announcements.
// Uses: $theme branding, NavBar (mobile burger), Backdrop, Display + GradientText, Bento,
//        MetricStrip countUp, LogoCloud, Reveal scroll entrances, PricingTable, Footer, ThemeToggle.
$app(Column([nav, hero, logos, features, metrics, pricing, cta, pageFooter], { gap: "none" }))

$theme({
  colors: { primary: "#7c3aed", accent: "#06b6d4" },
  radius: "lg",
  fonts: { import: ["Inter:400,600,800"] }
})

$annual = true

nav = NavBar({
  brand: Brand("Driftbase"),
  links: [
    Link("Features", { href: "#features" }),
    Link("Pricing", { href: "#pricing" }),
    Link("Docs", { href: "#" })
  ],
  actions: [
    ThemeToggle(),
    Button("Start free", { variant: "primary", size: "sm", onClick: () => $toast.success("This is where signup would start") })
  ],
  sticky: true,
  blur: true
})

hero = Section([
  Backdrop({ grid: true, blobs: ["#7c3aed55", "#06b6d455"], particles: 30, type: "drift" }),
  Column([
    Eyebrow("NOW IN PUBLIC BETA"),
    Display(["Ship realtime apps ", GradientText("ridiculously fast", { gradient: "brand" })], { size: "hero", align: "center", balance: true }),
    Text("Driftbase syncs your data across every client in milliseconds — no sockets to babysit, no cache to invalidate.", { variant: "large", tone: "muted", align: "center" }),
    Row([
      Button("Start building free", { variant: "primary", size: "lg", icon: "rocket" }),
      Button("Read the docs", { variant: "secondary", size: "lg", icon: "book" })
    ], { gap: "md", justify: "center", wrap: true }),
    Text("No credit card · 50k synced rows free forever", { variant: "small", tone: "muted", align: "center" })
  ], { gap: "lg", align: "center", sx: { py: "2xl" } })
], { background: "base", width: "lg", align: "center", padding: "lg" })

logos = Section([
  LogoCloud([
    LogoChip("Acme Robotics", { icon: "robot" }),
    LogoChip("Northwind", { icon: "wind" }),
    LogoChip("Globex", { icon: "globe" }),
    LogoChip("Initech", { icon: "building" }),
    LogoChip("Hooli", { icon: "h" })
  ], { label: "Synced in production at" })
], { background: "soft", padding: "sm" })

featureCard = (icon, title, body) => Card([
  Icon(icon, { size: "lg", color: "var(--rui-color-primary)" }),
  Heading(title, { size: "sm" }),
  Text(body, { variant: "body", tone: "muted" })
], { sx: { states: { hover: { translateY: "-3px", shadow: "lg" } }, h: "full" } })

features = Section([
  Reveal(
    Bento([
      BentoCell(featureCard("bolt", "Millisecond sync", "Every write fans out to subscribed clients in under 50ms, globally. Conflict resolution is automatic."), { span: "hero" }),
      BentoCell(featureCard("shield-halved", "Row-level auth", "Declarative rules decide who sees what — enforced at the edge."), { span: "tile" }),
      BentoCell(featureCard("clock-rotate-left", "Time travel", "Rewind any record. Audit log included."), { span: "tile" }),
      BentoCell(featureCard("plug", "Drop-in SDKs", "Web, iOS, Android and edge runtimes — one mental model everywhere."), { span: "wide" }),
      BentoCell(featureCard("server", "Zero ops", "We run the infra. You ship features."), { span: "tile" }),
      BentoCell(featureCard("code-branch", "Branching data", "Preview deployments get an isolated copy of production data."), { span: "tile" })
    ], { columns: 4, gap: "md", rowHeight: "170px" }),
    { animation: "fade-up" }
  )
], { eyebrow: "WHY DRIFTBASE", title: "Everything realtime, nothing to manage", subtitle: "The boring parts of multiplayer infrastructure, solved once.", align: "center", width: "xl", id: "features" })

metrics = Section([
  Reveal(
    MetricStrip([
      Metric("48ms", { label: "p99 global sync" }),
      Metric("12000", { label: "Teams in beta", countUp: true }),
      Metric("99.99%", { label: "Uptime SLA" }),
      Metric("50k", { label: "Free synced rows" })
    ], { columns: 4 }),
    { animation: "zoom" }
  )
], { background: "brand", padding: "md", align: "center" })

planPrice = monthly => $annual ? Math.round(monthly * 0.8) : monthly

pricing = Section([
  Row([
    Text("Monthly", { variant: "body-heavy", tone: $annual ? "muted" : "default" }),
    Switch("annual", { value: $annual, label: "" }),
    Row([Text("Annual", { variant: "body-heavy", tone: $annual ? "default" : "muted" }), Badge("-20%", { tone: "success", size: "sm" })], { gap: "xs", align: "center" })
  ], { gap: "sm", justify: "center", align: "center" }),
  Reveal(
    PricingTable([
      PricingCard("Hobby", { price: "$0", period: "/mo", features: ["50k synced rows", "2 projects", "Community support"], action: Button("Start free", { variant: "secondary", fullWidth: true }) }),
      PricingCard("Pro", { price: `$${planPrice(29)}`, period: "/mo", features: ["5M synced rows", "Unlimited projects", "Branching data", "Email support"], highlighted: true, badge: "Most popular", action: Button("Start 14-day trial", { variant: "primary", fullWidth: true }) }),
      PricingCard("Scale", { price: `$${planPrice(99)}`, period: "/mo", features: ["Unlimited rows", "SSO + audit log", "99.99% SLA", "Dedicated support"], action: Button("Talk to sales", { variant: "secondary", fullWidth: true }) })
    ]),
    { animation: "fade-up" }
  )
], { eyebrow: "PRICING", title: "Start free, scale when you do", align: "center", width: "lg", id: "pricing", background: "soft" })

cta = Section([
  Reveal(
    Card([Column([
      Heading("Ready to go multiplayer?", { size: "section", align: "center" }),
      Text("Create a project, paste the SDK snippet, and watch two browser tabs stay in sync.", { variant: "body", tone: "muted", align: "center" }),
      Row([Button("Start building free", { variant: "primary", size: "lg", icon: "rocket" })], { justify: "center" })
    ], { gap: "md", align: "center", sx: { py: "lg" } })], { sx: { bgOverlay: "gradient.brand", radius: "lg" } }),
    { animation: "zoom" }
  )
], { width: "md", padding: "md" })

pageFooter = Footer({
  brand: Brand("Driftbase"),
  tagline: "Realtime sync for product teams.",
  columns: [
    FooterColumn("Product", { links: [Link("Features", { href: "#features" }), Link("Pricing", { href: "#pricing" }), Link("Changelog", { href: "#" })] }),
    FooterColumn("Company", { links: [Link("About", { href: "#" }), Link("Blog", { href: "#" }), Link("Careers", { href: "#" })] }),
    FooterColumn("Legal", { links: [Link("Privacy", { href: "#" }), Link("Terms", { href: "#" })] })
  ],
  legal: "© 2026 Driftbase Inc. — demo landing page"
})
