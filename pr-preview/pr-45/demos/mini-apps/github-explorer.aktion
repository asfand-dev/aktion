// GitHub Explorer — search repositories with infinite "load more" pagination.
// Starting point for: any search-driven directory backed by a paginated API.
// Uses: $query({ infinite }) with loadMore/hasMore, OnIntersect auto-load, RelativeTime, sx.
$app(Column([header, searchRow, view], { gap: "lg", padding: "md" }))

$q = "web framework"
$term = "web framework"

// `infinite` makes .data a flat list across pages; loadMore() appends the next page.
$repos = $query({
  url: `https://api.github.com/search/repositories?q=${encodeURIComponent($term)}&sort=stars&order=desc`,
  key: `gh-search-${$term}`,
  ttl: 300000,
  infinite: {
    param: "page",
    limit: 12,
    mode: "page",
    select: b => b.items
  }
})

function search() { if ($q) $term = $q }

fmt = n => $util.format(n, "compact")

header = PageHeader("GitHub Explorer", {
  subtitle: "Search repositories · sorted by stars · infinite scroll",
  badge: Badge("Live API", { tone: "success", icon: "code-branch" })
})

searchRow = Row([
  StackItem(SearchBar("q", { placeholder: "Search repos… e.g. game engine, cli tool", value: $q, onSubmit: search }), { grow: 1 }),
  Button("Search", { onClick: search, variant: "primary", icon: "magnifying-glass" })
], { gap: "sm", align: "end" })

repoCard = (r, i) => Card([
  Row([
    Avatar(r.owner.login, { src: r.owner.avatar_url, size: "sm" }),
    StackItem(Column([
      Link(r.full_name, { href: r.html_url, external: true }),
      Text(r.description ? r.description.slice(0, 110) : "No description", { variant: "small", tone: "muted" })
    ], { gap: "none" }), { grow: 1 })
  ], { gap: "sm", align: "start" }),
  Row([
    Badge(`★ ${fmt(r.stargazers_count)}`, { tone: "warning", size: "sm" }),
    Badge(`⑂ ${fmt(r.forks_count)}`, { tone: "info", size: "sm" }),
    Show(!!r.language, { children: Badge(r.language || "", { tone: "neutral", size: "sm" }) }),
    Spacer(),
    RelativeTime(r.pushed_at)
  ], { gap: "xs", align: "center", wrap: true })
], {
  key: String(r.id),
  sx: { states: { hover: { translateY: "-2px", shadow: "md" } } }
})

results = Column([
  Grid(($repos.data ?? []).map((r, i) => repoCard(r, i)), { columns: { base: 1, md: 2, lg: 3 }, gap: "md" }),
  // The button doubles as a sentinel: scrolling it into view loads the next page automatically.
  Show($repos.hasMore, {
    fallback: Center([Text("That's everything for this search.", { variant: "small", tone: "muted" })]),
    children: OnIntersect(
      Center([Button($repos.loadingMore ? "Loading…" : "Load more repos", {
        variant: "secondary", icon: "angles-down",
        loading: $repos.loadingMore,
        onClick: () => $repos.loadMore()
      })]),
      { onEnter: () => $repos.loadMore(), once: false, rootMargin: "0px 0px 200px 0px" }
    )
  })
], { gap: "lg" })

view = Async($repos, {
  loading: LoadingState("Searching GitHub…", { description: `Looking for "${$term}"` }),
  error: ErrorState("Search failed", { description: "GitHub rate-limits anonymous searches — wait a minute and retry.", actions: [Button("Retry", { onClick: () => $repos.refetch(), variant: "primary", icon: "rotate-right" })] }),
  data: Show(($repos.data ?? []).length > 0, {
    fallback: EmptyState("No repositories found", { description: `Nothing matched "${$term}".`, icon: "magnifying-glass" }),
    children: results
  })
})
