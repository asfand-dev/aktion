// Fernhollow Roasters — a coffee shop home where browsing and the cart are one system: tiles, facets,
// sort, search and paging all narrow the same grid, and every figure in the drawer is recomputed from
// the cart, so the badge, the promo and the total can never disagree.
// Starting point for: shop homepages, catalogue browse pages, any cart-driven storefront.
// Uses: $theme, Navbar + Overlay cart badge, cover Hero, Carousel, Tile filters, FilterPill/Switch/Select
//       facets, ProductCard Grid + Pagination, Drawer + Cart + OrderSummary with a real promo code, $form.
$app(Column([promoBanner, nav, hero, categoryBand, seasonal, browse, strip, benefits, newsletter, pageFooter, cartDrawer], { gap: "none" }))
$theme({ colors: { primary: "#8a5a2b", accent: "#3f7d5a" }, fonts: { import: ["Inter:400,600,800"] } })

$search = ""
$category = "All"
$band = "all"
$minRating = 0
$inStock = false
$sort = "featured"
$page = 1
$slide = 0
$cartOpen = false
$promoInput = ""
$promo = ""
$viewed = []
$subscribed = false

money = n => $util.currency(n, "USD")
shot = (seed, w, h) => `https://picsum.photos/seed/${seed}/${w}/${h}`
freeShipFrom = 60
taxRate = 0.0825
perPage = 6

catalog = [
  { id: "c-yirg",    name: "Yirgacheffe Reserve",              category: "Coffee",      price: 21,  compareAt: 0,   rating: 4.8, reviews: 412,  stock: 38,  sku: "FH-C-118", seed: "fernhollow-yirgacheffe",     blurb: "Jasmine, bergamot and white peach. Washed, roasted for filter." },
  { id: "c-house",   name: "Fernhollow House Blend",           category: "Coffee",      price: 17,  compareAt: 21,  rating: 4.6, reviews: 1284, stock: 120, sku: "FH-C-101", seed: "fernhollow-house-blend",     blurb: "Cocoa, hazelnut and a soft plum finish. Our Tuesday roast." },
  { id: "c-huila",   name: "Huila Honey Process",              category: "Coffee",      price: 24,  compareAt: 0,   rating: 4.9, reviews: 96,   stock: 12,  sku: "FH-C-133", seed: "fernhollow-huila-honey",     blurb: "Red apple and raw sugar. Ninety kilos landed, that is all." },
  { id: "c-decaf",   name: "Midnight Swiss Water Decaf",       category: "Coffee",      price: 18,  compareAt: 0,   rating: 4.4, reviews: 208,  stock: 54,  sku: "FH-C-140", seed: "fernhollow-midnight-decaf",  blurb: "Chemical-free decaf that still tastes like its origin." },
  { id: "b-dripper", name: "Hollow Cone Dripper",              category: "Brewers",     price: 32,  compareAt: 39,  rating: 4.5, reviews: 331,  stock: 26,  sku: "FH-B-210", seed: "fernhollow-cone-dripper",    blurb: "One large aperture, ribbed walls, fired in Stoke-on-Trent." },
  { id: "b-press",   name: "Ridgeline French Press 1L",        category: "Brewers",     price: 58,  compareAt: 0,   rating: 4.7, reviews: 512,  stock: 8,   sku: "FH-B-224", seed: "fernhollow-ridgeline-press", blurb: "Double-wall steel, dishwasher safe, filter you can rebuild." },
  { id: "b-kettle",  name: "Swan Neck Kettle 0.9L",            category: "Brewers",     price: 86,  compareAt: 105, rating: 4.8, reviews: 274,  stock: 19,  sku: "FH-B-232", seed: "fernhollow-swan-kettle",     blurb: "One-degree increments and a spout that pours where you aim." },
  { id: "b-lever",   name: "Fernhollow Lever Espresso",        category: "Brewers",     price: 349, compareAt: 0,   rating: 4.9, reviews: 61,   stock: 0,   sku: "FH-B-260", seed: "fernhollow-lever-espresso",  blurb: "Spring lever, no pump, no electronics to fail. Back in May." },
  { id: "d-tumbler", name: "Vacuum Travel Tumbler 350ml",      category: "Drinkware",   price: 29,  compareAt: 0,   rating: 4.3, reviews: 640,  stock: 88,  sku: "FH-D-310", seed: "fernhollow-travel-tumbler",  blurb: "Six hours hot, fits a bike cage and every car cup holder." },
  { id: "d-cups",    name: "Stoneware Cortado Cups, set of 4", category: "Drinkware",   price: 44,  compareAt: 52,  rating: 4.6, reviews: 182,  stock: 31,  sku: "FH-D-318", seed: "fernhollow-cortado-cups",    blurb: "Speckled glaze, 120 ml, thrown by a studio two valleys over." },
  { id: "d-carafe",  name: "Glass Serving Carafe 600ml",       category: "Drinkware",   price: 26,  compareAt: 0,   rating: 4.2, reviews: 74,   stock: 5,   sku: "FH-D-322", seed: "fernhollow-glass-carafe",    blurb: "Borosilicate, pours cleanly, stacks under the dripper." },
  { id: "a-grinder", name: "Hand Grinder Mk II",               category: "Accessories", price: 128, compareAt: 0,   rating: 4.8, reviews: 903,  stock: 22,  sku: "FH-A-410", seed: "fernhollow-hand-grinder",    blurb: "48 mm conical burrs, magnetic catch, forty clicks of range." },
  { id: "a-scale",   name: "Pour Scale with Timer",            category: "Accessories", price: 62,  compareAt: 74,  rating: 4.5, reviews: 388,  stock: 41,  sku: "FH-A-402", seed: "fernhollow-pour-scale",      blurb: "0.1 g resolution, flow-rate readout, USB-C and splash proof." },
  { id: "a-filters", name: "Unbleached Filters, 200 pack",     category: "Accessories", price: 9,   compareAt: 0,   rating: 4.7, reviews: 1520, stock: 240, sku: "FH-A-430", seed: "fernhollow-paper-filters",   blurb: "Thick, slow, no papery taste. Compostable with the grounds." }
]
categories = [
  { label: "All",         icon: "store",          description: "Everything on the shelf" },
  { label: "Coffee",      icon: "mug-hot",        description: "Single origins and blends" },
  { label: "Brewers",     icon: "flask",          description: "Drippers, presses, kettles" },
  { label: "Drinkware",   icon: "mug-saucer",     description: "Cups, carafes, tumblers" },
  { label: "Accessories", icon: "scale-balanced", description: "Grinders, scales, filters" }
]
bands = [
  { value: "under25", label: "Under $25",  icon: "tag" },
  { value: "mid",     label: "$25 to $75", icon: "tags" },
  { value: "over75",  label: "Over $75",   icon: "gem" }
]
promos = [
  { code: "FERN10",   kind: "percent",  value: 0.1, min: 0,  label: "10% off the whole order" },
  { code: "BREWKIT",  kind: "percent",  value: 0.2, min: 90, label: "20% off orders over $90" },
  { code: "FREESHIP", kind: "shipping", value: 0,   min: 0,  label: "Free delivery, any order size" }
]
lookbook = [
  { src: shot("fernhollow-harvest-lot", 1400, 600), alt: "Hessian sacks of green Ethiopian coffee stacked in the Fernhollow warehouse", caption: "The Harvest Release — 90 kg of Huila honey process, roasted the day it ships", collection: "Coffee" },
  { src: shot("fernhollow-brew-bench", 1400, 600),  alt: "A brew bench with a swan neck kettle, cone dripper and scale mid-pour",       caption: "Bench essentials — the three tools that fix nine out of ten bad cups",     collection: "Brewers" },
  { src: shot("fernhollow-cortado-set", 1400, 600), alt: "Four speckled stoneware cortado cups drying on a wooden rack",                caption: "Studio drinkware — small runs from a pottery two valleys over",           collection: "Drinkware" }
]

cart = $store({
  persist: "fernhollow.cart",
  items: [],
  count: (s) => $util.sum(s.items.map(i => i.qty)),
  subtotal: (s) => $util.sum(s.items.map(i => i.price * i.qty)),
  add: (s, p) => {
    const seen = s.items.find(i => i.id == p.id)
    if (seen) s.items = s.items.map(i => i.id == p.id ? { ...i, qty: Math.min(i.qty + 1, p.stock) } : i)
    else s.items = [...s.items, { id: p.id, name: p.name, price: p.price, qty: 1, max: p.stock, image: shot(p.seed, 120, 120) }]
  },
  setQty: (s, id, qty) => { s.items = qty <= 0 ? s.items.filter(i => i.id != id) : s.items.map(i => i.id == id ? { ...i, qty } : i) },
  remove: (s, id) => { s.items = s.items.filter(i => i.id != id) },
  clear: (s) => { s.items = [] }
})

// ---------- every figure below is derived from the live cart ----------
activePromo = () => promos.find(p => p.code == $promo)
promoOk = () => activePromo() != null && cart.subtotal() >= activePromo().min
discountAmount = () => promoOk() && activePromo().kind == "percent" ? Math.round(cart.subtotal() * activePromo().value * 100) / 100 : 0
netSubtotal = () => cart.subtotal() - discountAmount()
shipsFree = () => cart.items.length == 0 || netSubtotal() >= freeShipFrom || (promoOk() && activePromo().kind == "shipping")
shippingCost = () => shipsFree() ? 0 : 6.9
taxAmount = () => Math.round(netSubtotal() * taxRate * 100) / 100
orderTotal = () => Math.round((netSubtotal() + shippingCost() + taxAmount()) * 100) / 100
shipGap = () => Math.max(0, freeShipFrom - netSubtotal())

// ---------- faceting: one predicate, every control feeds it ----------
inBand = (p, b) => b == "under25" ? p.price < 25 : b == "mid" ? p.price >= 25 && p.price <= 75 : b == "over75" ? p.price > 75 : true
haystack = p => $util.lowercase(`${p.name} ${p.category} ${p.blurb} ${p.sku}`)
query = () => $util.lowercase($util.trim($search))
matches = p => (query().length == 0 || haystack(p).includes(query())) && ($category == "All" || p.category == $category) && inBand(p, $band) && p.rating >= $minRating && (!$inStock || p.stock > 0)
function sortResults(list) {
  if ($sort == "price-asc") return [...list].sort((a, b) => a.price - b.price)
  if ($sort == "price-desc") return [...list].sort((a, b) => b.price - a.price)
  if ($sort == "rating") return [...list].sort((a, b) => b.rating - a.rating)
  if ($sort == "reviews") return [...list].sort((a, b) => b.reviews - a.reviews)
  return list
}
results = () => sortResults(catalog.filter(p => matches(p)))
totalPages = () => Math.max(1, Math.ceil(results().length / perPage))
pageNow = () => Math.min(Math.max($page, 1), totalPages())
pageItems = () => results().slice((pageNow() - 1) * perPage, pageNow() * perPage)
categoryCount = label => label == "All" ? catalog.length : catalog.filter(p => p.category == label).length
bandCount = value => catalog.filter(p => $category == "All" || p.category == $category).filter(p => inBand(p, value)).length
slideNow = () => Math.min(Math.max($slide, 0), lookbook.length - 1)
bestSellers = [...catalog].sort((a, b) => b.reviews - a.reviews).slice(0, 4)
viewedItems = () => $viewed.map(id => catalog.find(p => p.id == id)).filter(p => p != null)
activeChips = () => [
  { when: $category != "All", label: `Category: ${$category}`, value: "category" },
  { when: $band != "all", label: $band == "all" ? "" : bands.find(b => b.value == $band).label, value: "band" },
  { when: $minRating > 0, label: `${$minRating} stars and up`, value: "rating" },
  { when: $inStock, label: "In stock only", value: "stock" },
  { when: query().length > 0, label: `Search: ${$util.trim($search)}`, value: "search" }
].filter(c => c.when)

pickCategory = label => { $category = label; $page = 1 }
toggleBand = value => { $band = $band == value ? "all" : value; $page = 1 }
toggleRating = value => { $minRating = $minRating == value ? 0 : value; $page = 1 }
dropChip = v => { $category = v == "category" ? "All" : $category; $band = v == "band" ? "all" : $band; $minRating = v == "rating" ? 0 : $minRating; $inStock = v == "stock" ? false : $inStock; $search = v == "search" ? "" : $search; $page = 1 }
clearFilters = () => { $search = ""; $category = "All"; $band = "all"; $minRating = 0; $inStock = false; $page = 1; $toast.info("Filters cleared") }
viewProduct = p => { $viewed = [p.id, ...$viewed.filter(id => id != p.id)].slice(0, 4); $toast.info(`${p.name} · ${p.sku} · ${$util.plural(p.stock, "left in stock", "left in stock")}`) }
function addToCart(p) {
  if (p.stock == 0) $toast.warning(`${p.name} is out of stock — back in May`)
  else { cart.add(p); $toast.success(`${p.name} added — ${money(cart.subtotal())} in your cart`) }
}
function applyPromo() {
  const code = $util.uppercase($util.trim($promoInput))
  const found = promos.find(p => p.code == code)
  if (code.length == 0) $toast.info("Type a promo code first — try FERN10")
  else if (found == null) $toast.error(`${code} is not a code we recognise`)
  else if (cart.subtotal() < found.min) $toast.warning(`${found.code} needs ${money(found.min)} in the cart — you are ${money(found.min - cart.subtotal())} short`)
  else { $promo = found.code; $promoInput = ""; $toast.success(`${found.code} applied — ${found.label}`) }
}
function checkout() {
  const ref = `FH-${$util.uppercase($util.substring($util.uuid(), 0, 6))}`
  $toast.success(`Order ${ref} placed — ${money(orderTotal())} confirmed, roasting Tuesday`)
  cart.clear()
  $promo = ""
  $cartOpen = false
}

// ---------- chrome ----------
promoBanner = Banner("10% off your first order", {
  message: `Code FERN10 at checkout, and delivery is free over ${money(freeShipFrom)}.`,
  tone: "primary", icon: "tag",
  action: CopyButton("FERN10", { label: "Copy FERN10", copiedLabel: "Code copied" })
})
cartButton = Overlay(IconButton("cart-shopping", { label: `Open cart, ${$util.plural(cart.count(), "item")}`, variant: "secondary", onClick: () => { $cartOpen = true } }), {
  items: cart.count() > 0 ? [OverlayItem(Badge(String(cart.count()), { tone: "primary", size: "xs" }), { anchor: "top-right" })] : []
})
navSearch = SearchBar("nav-search", { placeholder: "Search the shop", value: $search, shortcut: "/", ariaLabel: "Search products", onChange: v => { $search = v; $page = 1 } })
nav = Navbar({
  brand: Brand("Fernhollow", { version: "Roasters" }),
  items: categories.filter(c => c.label != "All").map(c => NavbarItem(c.label, { icon: c.icon, active: $category == c.label, onClick: () => pickCategory(c.label) })),
  actions: [navSearch, ThemeToggle(), cartButton],
  sticky: true, collapsible: true
})
hero = Section([
  Hero("Coffee worth getting out of bed for", {
    eyebrow: "HARVEST RELEASE · MARCH 2026",
    subtitle: "Small lots roasted in Fernhollow every Tuesday and Friday, packed the same afternoon, with the bench gear to brew them properly at home.",
    layout: "cover", imageSrc: shot("fernhollow-roastery-hero", 1600, 700), height: "420px", overlay: 0.58,
    caption: `Roasted to order · free carbon-neutral delivery over ${money(freeShipFrom)}`,
    primary: Button("Shop the Harvest Release", { variant: "primary", icon: "mug-hot", onClick: () => pickCategory("Coffee") }),
    secondary: Button(`Browse all ${catalog.length} products`, { variant: "secondary", icon: "table-cells-large", onClick: () => pickCategory("All") })
  })
], { background: "base", width: "full", padding: "none", id: "top" })
categoryBand = Section([
  Grid(categories.map(c => Tile(c.label, { icon: c.icon, value: `${categoryCount(c.label)}`, description: c.description, tone: $category == c.label ? "primary" : "default", selected: $category == c.label, onClick: () => pickCategory(c.label), key: c.label })), { columns: { base: 2, md: 3, lg: 5 }, gap: "md" })
], { eyebrow: "THE SHELF", title: "Start with a shelf", subtitle: "Every tile filters the grid below — nothing here is decorative.", align: "center", width: "lg", padding: "lg" })
seasonal = Section([
  Carousel(lookbook, { activeIndex: slideNow(), onChange: i => { $slide = i }, ratio: "21:9", showDots: true, showArrows: true, label: "Seasonal lookbook" }),
  Row([Icon("seedling", { size: "sm" }), Text(`Slide ${slideNow() + 1} of ${lookbook.length} · ${categoryCount(lookbook[slideNow()].collection)} products in this collection`, { variant: "small", tone: "muted" }), Spacer(),
    Button(`Shop ${lookbook[slideNow()].collection}`, { variant: "secondary", size: "sm", icon: "arrow-right", iconPosition: "trailing", onClick: () => pickCategory(lookbook[slideNow()].collection) })
  ], { gap: "sm", align: "center", wrap: true })
], { eyebrow: "IN SEASON", title: "March at the roastery", align: "center", width: "lg", padding: "lg", background: "soft" })

// ---------- browse ----------
function ShopCard(p) {
  const ribbon = p.compareAt > 0 ? "Sale" : p.stock > 0 && p.stock <= 6 ? "Low stock" : null
  const cta = Button(p.stock == 0 ? "Notify me" : "Add to cart", { variant: p.stock == 0 ? "ghost" : "secondary", size: "sm", fullWidth: true, icon: p.stock == 0 ? "bell" : "cart-plus", onClick: () => addToCart(p) })
  return ProductCard(p.name, { image: shot(p.seed, 480, 360), price: p.price, compareAt: p.compareAt > 0 ? p.compareAt : null, currency: "$", rating: p.rating, reviewCount: p.reviews, badge: ribbon, soldOut: p.stock == 0, onClick: () => viewProduct(p), action: cta, key: p.id })
}
facets = Card([
  SectionHeader("Narrow it down", { eyebrow: "FILTERS", actions: [Button("Reset", { variant: "ghost", size: "sm", icon: "rotate-left", onClick: clearFilters })] }),
  Text("Price", { variant: "small-heavy", tone: "muted" }),
  Row(bands.map(b => FilterPill(b.label, { active: $band == b.value, count: bandCount(b.value), icon: b.icon, onToggle: () => toggleBand(b.value), key: b.value })), { gap: "xs", wrap: true }),
  Text("Rating", { variant: "small-heavy", tone: "muted" }),
  Row([FilterPill("4.0 and up", { active: $minRating == 4, icon: "star", onToggle: () => toggleRating(4) }), FilterPill("4.5 and up", { active: $minRating == 4.5, icon: "star", onToggle: () => toggleRating(4.5) })], { gap: "xs", wrap: true }),
  Separator("horizontal"),
  Switch("in-stock", { label: "In stock only", description: "Hide anything we cannot ship this week", value: $inStock, onChange: v => { $inStock = v; $page = 1 } })
])
sortSelect = Select("sort", {
  items: [SelectItem("featured", "Featured"), SelectItem("price-asc", "Price: low to high"), SelectItem("price-desc", "Price: high to low"), SelectItem("rating", "Top rated"), SelectItem("reviews", "Most reviewed")],
  value: $sort, label: "Sort by", labelHidden: true, onChange: v => { $sort = v; $page = 1 }
})
browseSearch = SearchBar("browse-search", { placeholder: "Search coffee, brewers, kit…", value: $search, ariaLabel: "Search the catalogue", onChange: v => { $search = v; $page = 1 } })
browseGrid = Show(results().length > 0, {
  fallback: EmptyState("Nothing matches those filters", { description: "Try a wider price band, drop the rating floor, or clear the search and start again.", icon: "magnifying-glass", actions: [Button("Clear all filters", { variant: "primary", icon: "broom", onClick: clearFilters })] }),
  children: Column([
    Grid(pageItems().map(p => ShopCard(p)), { columns: { base: 1, sm: 2, lg: 3 }, gap: "lg" }),
    Pagination(pageNow(), { totalPages: totalPages(), total: results().length, perPage: perPage, onChange: n => { $page = n } })
  ], { gap: "lg" })
})
browse = Section([
  Split(facets, {
    right: Column([
      Toolbar({ left: [browseSearch], right: [sortSelect] }),
      Row([Text($util.plural(results().length, "product"), { variant: "body-heavy" }), Text(`of ${catalog.length} · page ${pageNow()} of ${totalPages()}`, { variant: "small", tone: "muted" }), Spacer(),
        Show(activeChips().length > 0, { children: FilterChips(activeChips(), { onRemove: v => dropChip(v), onClear: clearFilters, clearLabel: "Clear all" }) })
      ], { gap: "sm", align: "center", wrap: true }),
      browseGrid
    ], { gap: "md" }),
    ratio: "1/3", gap: "xl", stackAt: "lg", align: "start"
  })
], { eyebrow: "BROWSE", title: "The whole shelf, filtered your way", width: "xl", padding: "lg", id: "browse" })

// ---------- recently viewed, falling back to best sellers ----------
function MiniCard(p) {
  return Card([
    Row([Image(shot(p.seed, 120, 120), { alt: `${p.name} — ${p.blurb}`, sx: { w: "56px", h: "56px", radius: "md" } }),
      StackItem(Column([Text(p.name, { variant: "body-heavy" }), Text(`${p.category} · ${p.sku}`, { variant: "small", tone: "muted" })], { gap: "none" }), { grow: 1 }),
      PriceTag(p.price, { compareAt: p.compareAt > 0 ? p.compareAt : null, size: "sm" })], { gap: "sm", align: "center" }),
    Rating(p.rating, { readonly: true, size: "sm", count: p.reviews }),
    Button("Add to cart", { variant: "secondary", size: "sm", fullWidth: true, icon: "cart-plus", disabled: p.stock == 0, onClick: () => addToCart(p) })
  ], { key: `mini-${p.id}` })
}
strip = Section([
  Show($viewed.length > 0, {
    fallback: Column([SectionHeader("This week's best sellers", { eyebrow: "POPULAR", subtitle: "Ranked by verified review count, not by margin." }),
      Grid(bestSellers.map(p => MiniCard(p)), { columns: { base: 1, sm: 2, lg: 4 }, gap: "md" })], { gap: "md" }),
    children: Column([SectionHeader("Recently viewed", { eyebrow: "YOUR TRAIL", subtitle: "Open a product card and it lands here.", actions: [Button("Clear", { variant: "ghost", size: "sm", icon: "eraser", onClick: () => { $viewed = [] } })] }),
      Grid(viewedItems().map(p => MiniCard(p)), { columns: { base: 1, sm: 2, lg: 4 }, gap: "md" })], { gap: "md" })
  })
], { width: "xl", padding: "lg", background: "soft" })
benefits = Section([
  FeatureGrid([
    FeatureItem("Roasted to order", { description: "Nothing sits in a warehouse. Your bag is roasted the morning it ships.", icon: "fire-burner", tone: "primary" }),
    FeatureItem(`Free delivery over ${money(freeShipFrom)}`, { description: "Carbon-neutral courier, plastic-free packaging, tracked end to end.", icon: "truck-fast", tone: "success" }),
    FeatureItem("60-day gear guarantee", { description: "Brew with it for two months. Not for you? Send it back, we pay postage.", icon: "shield-halved", tone: "info" }),
    FeatureItem("Direct trade, published", { description: "Every lot lists the farm, the price we paid and the export date.", icon: "handshake", tone: "warning" })
  ], { columns: 4 })
], { eyebrow: "WHY FERNHOLLOW", title: "What you get either way", align: "center", width: "lg", padding: "lg", id: "benefits" })

// ---------- newsletter ----------
signup = $form({
  values: { name: "", email: "" },
  rules: {
    name: [$util.rules.required("Tell us what to call you")],
    email: [$util.rules.required("We need somewhere to send the guide"), $util.rules.email("That address is missing an @ or a domain")]
  },
  onSubmit: v => { $subscribed = true; $toast.success(`Brew guide on its way to ${v.email}`) }
})
signupErrors = () => Object.keys(signup.errors).filter(k => signup.errors[k]).map(k => ({ field: `nl-${k}`, label: k == "name" ? "First name" : "Email", message: signup.errors[k] }))
newsletterCard = Card([
  Show($subscribed, {
    children: SuccessState("You are on the list", {
      description: "The four-page brew guide lands within the hour, and one roast note a month after that.", icon: "envelope-circle-check",
      actions: [Button("Sign up another address", { variant: "secondary", icon: "plus", onClick: () => { $subscribed = false; signup.reset() } })]
    }),
    fallback: Column([
      SectionHeader("Get the brew guide", { eyebrow: "NEWSLETTER", subtitle: "Four pages on ratio, grind and water. One roast note a month, nothing else." }),
      ValidationSummary(signup.errors, { title: "Check these before you send:", count: true }),
      Grid([
        FormControl("First name", { field: Input("nl-name", { placeholder: "Ada", value: signup.values.name, error: signup.errors.name, onChange: v => signup.setField("name", v), onBlur: () => signup.touch("name") }) }),
        FormControl("Email", { field: Input("nl-email", { type: "email", placeholder: "you@example.com", autocomplete: "email", value: signup.values.email, error: signup.errors.email, onChange: v => signup.setField("email", v), onBlur: () => signup.touch("email") }) })
      ], { columns: { base: 1, md: 2 }, gap: "md" }),
      Row([Button("Send me the guide", { variant: "primary", icon: "paper-plane", loading: signup.submitting, onClick: () => signup.submit() }),
        Text("Unsubscribe in one click. We never pass your address on.", { variant: "small", tone: "muted" })], { gap: "sm", align: "center", wrap: true })
    ], { gap: "md" })
  })
])
newsletter = Section([newsletterCard], { width: "md", padding: "lg" })

// ---------- cart drawer ----------
promoRow = Show($promo == "", {
  children: Column([
    InputGroup(Input("promo-code", { label: "Promo code", placeholder: "FERN10", value: $promoInput, onChange: v => { $promoInput = v } }), { icon: "tag", action: Button("Apply", { variant: "secondary", size: "sm", onClick: applyPromo }) }),
    Text("Try FERN10, BREWKIT or FREESHIP.", { variant: "small", tone: "muted" })
  ], { gap: "2xs" }),
  fallback: Row([Pill(`${$promo} applied`, { tone: "success", icon: "circle-check" }), Text(activePromo() == null ? "" : activePromo().label, { variant: "small", tone: "muted" }), Spacer(),
    Button("Remove", { variant: "ghost", size: "sm", icon: "xmark", onClick: () => { $promo = ""; $toast.info("Promo code removed") } })
  ], { gap: "sm", align: "center", wrap: true })
})
cartBody = Show(cart.items.length > 0, {
  fallback: EmptyState("Your cart is empty", { description: "Add a bag of coffee or a piece of bench gear and the totals here start working.", icon: "cart-shopping", actions: [Button("Browse the shop", { variant: "primary", icon: "store", onClick: () => { $cartOpen = false; pickCategory("All") } })] }),
  children: Column([
    Cart(cart.items, { onQty: (id, qty) => cart.setQty(id, qty), onRemove: (id) => cart.remove(id), currency: "USD" }),
    Separator("horizontal"),
    promoRow,
    OrderSummary(cart.items.map(i => ({ label: i.name, amount: i.price * i.qty, qty: i.qty })), {
      subtotal: money(cart.subtotal()), discount: discountAmount() > 0 ? `− ${money(discountAmount())}` : null,
      shipping: shippingCost() == 0 ? "Free" : money(shippingCost()), tax: money(taxAmount()), total: money(orderTotal()),
      note: `Tax estimated at ${$util.percent(taxRate, 2)} — recalculated at checkout.`
    }),
    Callout("info", { title: shipGap() == 0 ? "Free delivery unlocked" : `${money(shipGap())} away from free delivery`, description: `Orders over ${money(freeShipFrom)} ship carbon-neutral at no charge.`, icon: "truck-fast", compact: true })
  ], { gap: "md" })
})
cartDrawer = Drawer("Your cart", {
  open: $cartOpen, side: "right", width: "460px", onClose: () => { $cartOpen = false },
  children: [cartBody],
  footer: [Button("Keep shopping", { variant: "ghost", onClick: () => { $cartOpen = false } }), Button(`Checkout · ${money(orderTotal())}`, { variant: "primary", icon: "lock", disabled: cart.items.length == 0, onClick: checkout })]
})
pageFooter = Footer({
  brand: Brand("Fernhollow"),
  tagline: "Small-batch coffee and the bench gear to brew it properly.",
  columns: [
    FooterColumn("Shop", { links: [Link("Coffee", { href: "#browse" }), Link("Brewers", { href: "#browse" }), Link("Drinkware", { href: "#browse" }), Link("Accessories", { href: "#browse" })] }),
    FooterColumn("Help", { links: [Link("Delivery & returns", { href: "#benefits" }), Link("Brew guides", { href: "#" }), Link("Wholesale", { href: "#" })] }),
    FooterColumn("Roastery", { links: [Link("Our farms", { href: "#" }), Link("Pricing transparency", { href: "#" }), Link("Visit us", { href: "#" })] })
  ],
  legal: "© 2026 Fernhollow Roasters Ltd — demo storefront, no real orders are placed"
})
