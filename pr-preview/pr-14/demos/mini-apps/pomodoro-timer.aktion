// Pomodoro Focus Timer — work/break cycles with a live ring, session log and saved settings.
// Uses: $store({ persist }) for settings, sx typography, animate presets, Confetti on completion.
$app(Column([header, board, settings], { gap: "lg", padding: "md" }))

// ---- persisted settings + session count (one store instead of four $storage effects) ----
prefs = $store({
  persist: "pomo.settings",
  completed: 0,
  focus: 25,
  short: 5,
  long: 15,
  setCompleted: (s, n) => { s.completed = n }
})

// ---- live state ----
$phase     = "focus"
$running   = false
$remaining = prefs.focus * 60
$total     = prefs.focus * 60
$log       = []
$bursts    = 0

durationFor = p => (p == "focus" ? prefs.focus : p == "short" ? prefs.short : prefs.long) * 60
pct         = $total > 0 ? Math.round((($total - $remaining) / $total) * 100) : 0
phaseLabel  = $phase == "focus" ? "Focus" : $phase == "short" ? "Short break" : "Long break"
phaseTone   = $phase == "focus" ? "primary" : "success"

function fmt(s) {
  const m = Math.floor(s / 60)
  const r = Math.floor(s % 60)
  return `${String(m).padStart(2, "0")}:${String(r).padStart(2, "0")}`
}

function toggle() { $running = !$running }

function resetTimer() {
  $running = false
  $remaining = durationFor($phase)
  $total = $remaining
}

function switchPhase(next) {
  $running = false
  $phase = next
  $remaining = durationFor(next)
  $total = $remaining
}

function advance() {
  if ($phase == "focus") {
    const done = prefs.completed + 1
    prefs.setCompleted(done)
    $bursts = $bursts + 1
    $log = [{ label: `Focus #${done} complete`, time: $util.formatDate($util.now(), "time"), icon: "check", tone: "success" }, ...$log].slice(0, 6)
    $phase = done % 4 == 0 ? "long" : "short"
  } else {
    $phase = "focus"
  }
  $remaining = durationFor($phase)
  $total = $remaining
}

// tick once per second while running
$effect(() => {
  if ($running) {
    if ($remaining > 1) { $remaining = $remaining - 1 }
    else { advance() }
  }
}, ["every(1000)"])

header = PageHeader("Pomodoro Timer", {
  subtitle: "Focus in 25-minute sprints, then take a break",
  badge: Badge($running ? "Running" : "Paused", { tone: $running ? "success" : "neutral" }),
  actions: [Button("Reset session count", { variant: "ghost", icon: "rotate-left", size: "sm", onClick: () => { prefs.setCompleted(0); $log = [] } })]
})

phaseSwitch = ToggleGroup("phase", {
  items: [
    { value: "focus", label: "Focus", icon: "brain" },
    { value: "short", label: "Short break", icon: "mug-hot" },
    { value: "long",  label: "Long break", icon: "couch" }
  ],
  value: $phase,
  onChange: switchPhase
})

// confetti bursts once per completed focus block (keyed remount re-fires it)
celebration = Show($bursts > 0, { children: Confetti({ fire: true, count: 70, key: $bursts }) })

ring = Center([Column([
  Text(fmt($remaining), { variant: "title", sx: { fontSize: "4.25rem", weight: 700 }, style: "font-variant-numeric: tabular-nums; letter-spacing: 3px; line-height: 1;" }),
  Text(phaseLabel, { variant: "large-heavy", tone: phaseTone }),
  Box([Progress(pct, { tone: phaseTone, max: 100, showValue: true })], { maxWidth: "320px" })
], { gap: "md", align: "center" })], { minHeight: "200px" })

controls = Row([
  Button($running ? "Pause" : "Start", { onClick: toggle, variant: "primary", icon: $running ? "pause" : "play", size: "lg" }),
  Button("Reset", { onClick: resetTimer, variant: "secondary", icon: "rotate-right", size: "lg" }),
  Button("Skip", { onClick: advance, variant: "ghost", icon: "forward-step", size: "lg" })
], { gap: "md", justify: "center" })

stats = Stats([
  StatCard("Completed", { value: String(prefs.completed), icon: "trophy", tone: "primary" }),
  StatCard("Focus minutes", { value: String(prefs.completed * prefs.focus), icon: "hourglass-half" }),
  StatCard("Until long break", { value: String((4 - (prefs.completed % 4)) % 4 || 4), icon: "flag-checkered" })
])

logCard = Show($log.length > 0, {
  fallback: EmptyState("No sessions yet", { description: "Press Start and finish a focus block to log it here.", icon: "list-check" }),
  children: Timeline($log.map(e => TimelineItem(e.label, { time: e.time, icon: e.icon, tone: e.tone })))
})

board = Grid([
  Card([SectionHeader("Timer", { eyebrow: phaseLabel.toUpperCase() }), phaseSwitch, ring, controls, celebration], { animate: "fade-up" }),
  Card([SectionHeader("This session"), stats, Separator("horizontal"), logCard], { animate: { preset: "fade-up", delay: 80 } })
], { columns: { base: 1, md: 2 }, gap: "lg" })

settings = Card([
  SectionHeader("Durations", { subtitle: "Adjust while paused — saved automatically", eyebrow: "SETTINGS" }),
  Grid([
    FormControl("Focus (min)", { field: Slider("focusMin", { min: 5, max: 60, step: 5, value: prefs.focus, showValue: true, onChange: () => { if (!$running && $phase == "focus") resetTimer() } }) }),
    FormControl("Short break (min)", { field: Slider("shortMin", { min: 1, max: 20, step: 1, value: prefs.short, showValue: true, onChange: () => { if (!$running && $phase == "short") resetTimer() } }) }),
    FormControl("Long break (min)", { field: Slider("longMin", { min: 5, max: 45, step: 5, value: prefs.long, showValue: true, onChange: () => { if (!$running && $phase == "long") resetTimer() } }) })
  ], { columns: { base: 1, md: 3 }, gap: "md" })
], { animate: { preset: "fade-up", delay: 160 } })
