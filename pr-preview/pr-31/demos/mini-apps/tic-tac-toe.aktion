// Tic-Tac-Toe — two-player noughts and crosses with win/draw detection, a
// running scoreboard and a highlighted winning line. Starting point for: any
// turn-based board game with win conditions.
// Uses: $store({ persist }) scoreboard, pure win-check helper, Grid board, Confetti.
$app(Center([Container([Column([header, status, board, scores, controls], { gap: "lg" })], { size: "sm" })], { minHeight: "85vh" }))

score = $store({
  persist: "ttt.scores",
  x: 0, o: 0, draws: 0,
  win: (s, p) => { if (p == "X") s.x += 1; else s.o += 1 },
  draw: (s) => { s.draws += 1 },
  reset: (s) => { s.x = 0; s.o = 0; s.draws = 0 }
})

$cells = ["", "", "", "", "", "", "", "", ""]
$turn = "X"
$winner = null      // "X" | "O" | "draw" | null
$line = []          // winning indices

lines = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]

function winnerOf(cells) {
  for (let l of lines) {
    const [a, b, c] = l
    if (cells[a] != "" && cells[a] == cells[b] && cells[b] == cells[c]) return { player: cells[a], line: l }
  }
  if (cells.every(v => v != "")) return { player: "draw", line: [] }
  return null
}

function play(i) {
  if ($winner != null || $cells[i] != "") return
  const next = [...$cells]
  next[i] = $turn
  $cells = next
  const result = winnerOf(next)
  if (result) {
    $winner = result.player
    $line = result.line
    if (result.player == "draw") score.draw(); else score.win(result.player)
  } else {
    $turn = $turn == "X" ? "O" : "X"
  }
}

function newRound() {
  $cells = ["", "", "", "", "", "", "", "", ""]
  $turn = "X"
  $winner = null
  $line = []
}

header = PageHeader("Tic-Tac-Toe", {
  subtitle: "Two players, one board",
  badge: Badge("X vs O", { tone: "primary", icon: "hashtag" })
})

status = Center([
  $winner == null
    ? Row([Text("Turn:", { tone: "muted" }), Badge($turn, { tone: $turn == "X" ? "primary" : "warning", size: "lg" })], { gap: "sm", align: "center" })
    : $winner == "draw"
      ? Badge("It's a draw", { tone: "neutral", size: "lg", icon: "handshake" })
      : Badge(`${$winner} wins!`, { tone: $winner == "X" ? "primary" : "warning", size: "lg", icon: "trophy" })
])

function cell(i) {
  const mark = $cells[i]
  const inLine = $line.includes(i)
  return OnClick(Center([
    mark == "" ? Text("", { variant: "title" }) : Icon(mark == "X" ? "xmark" : "o", { size: "xl", color: mark == "X" ? "var(--rui-color-primary)" : "var(--rui-color-warning)" })
  ], { minHeight: "92px" }), { onClick: () => play(i) })
}

function cellBox(i) {
  const inLine = $line.includes(i)
  return Box([cell(i)], {
    key: String(i),
    padding: "sm",
    border: inLine ? "strong" : "subtle",
    background: inLine ? "muted" : "surface",
    sx: { borderRadius: "var(--rui-radius-md)", states: { hover: { shadow: "sm" } } }
  })
}

board = Card([
  Grid($util.range(0, 8).map(i => cellBox(i)), { columns: 3, gap: "sm" }),
  Show($winner != null && $winner != "draw", { children: Confetti({ fire: true, count: 80, key: `${score.x}-${score.o}` }) })
])

scores = Stats([
  StatCard("Player X", { value: String(score.x), icon: "xmark", tone: "primary" }),
  StatCard("Draws", { value: String(score.draws), icon: "handshake", tone: "default" }),
  StatCard("Player O", { value: String(score.o), icon: "o", tone: "warning" })
])

controls = Row([
  Button("New round", { variant: "primary", icon: "rotate-right", onClick: newRound }),
  Spacer(),
  Button("Reset scores", { variant: "ghost", icon: "trash", onClick: () => { score.reset(); newRound() } })
], { align: "center" })
