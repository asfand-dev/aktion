// 13 · Routing
// =============================================================================
function RouterDemo() {
  return Column([
    Row([
      NavLink("Overview", { to: "/", exact: true, icon: "gauge", variant: "pill" }),
      NavLink("Deploys", { to: "/deploys", icon: "rocket", variant: "pill" }),
      NavLink("Settings", { to: "/settings", icon: "gear", variant: "pill" }),
      NavLink("Old settings URL", { to: "/old-settings", icon: "arrow-turn-up", variant: "pill" })
    ], { gap: "xs", wrap: true }),
    RouteView($router({
      "/": Callout("info", { title: "Overview", description: "This panel follows the URL hash. Pick a link above.", compact: true }),
      "/deploys": Callout("success", { title: "Deploys", description: "Three deploys today, all green.", compact: true }),
      "/settings": Callout("neutral", { title: "Settings", description: "Region eu-central-1, autoscaling on.", compact: true }),
      "/old-settings": Redirect("/settings"),
      default: Callout("warning", { title: "Not found", description: `Nothing lives at ${route.path}.`, compact: true })
    }), { routeKey: route.path, animation: "fade-up", duration: 200 })
  ], { gap: "md" })
}

routingGroup = Group("routing", [
  Grid([
    Specimen(["NavLink", "RouteView"], "Client-side routes", [RouterDemo()]),
    Specimen(["Redirect"], "Redirects", [
      Text("The Old settings URL link lands on a route that renders Redirect(\"/settings\"), so the router moves straight on to Settings.", { variant: "small" }),
      CodeBlock("\"/old-settings\": Redirect(\"/settings\")", { language: "aktion", header: false })
    ])
  ], { columns: { base: 1, lg: 2 }, gap: "lg" })
], "soft")

