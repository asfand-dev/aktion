$tourStep = 0
$tourOpen = false
$spotlightOpen = false

counterSource = "$count = 0\n\n$app(Card([\n  CardHeader(\"Deploy counter\"),\n  Text(\"Deploys today: \" + $count),\n  Button(\"Ship one\", {\n    variant: \"primary\",\n    onClick: () => { $count += 1 }\n  })\n]))"

patternsGroup = Group("patterns", [
  Specimen(["TopBar", "PageHeader", "Toolbar"], "Page chrome", [
    TopBar("Atlas", { subtitle: "Production · eu-central-1", left: [Badge("v3.2.1", { tone: "info" })], center: [SearchBar("topbar-search", { placeholder: "Search deploys, logs and people…", shortcut: "Cmd+K" })], right: [IconButton("bell", { label: "Notifications", variant: "ghost" }), Button("Deploy", { variant: "primary", size: "sm", icon: "rocket" })] }),
    PageHeader("Deploys", { subtitle: "318 this month · 2 failed", breadcrumbs: ["Acme Cloud", "Atlas"], status: Badge("Healthy", { tone: "success" }), actions: [Button("Export CSV", { variant: "secondary", icon: "download" }), Button("New deploy", { variant: "primary", icon: "plus" })] }),
    Toolbar({ left: [FilterPill("Production", { active: true, count: 12 }), FilterPill("Preview", { count: 41 })], right: [ToggleGroup("toolbar-view", { items: [{ value: "list", label: "List" }, { value: "board", label: "Board" }], value: "list", size: "sm", label: "Layout" })], searchable: true, searchPlaceholder: "Filter deploys…" })
  ]),
  Specimen(["KanbanBoard", "KanbanColumn", "KanbanCard"], "Sprint board", [
    KanbanBoard([
      KanbanColumn("Backlog", { items: [
        KanbanCard("Usage-based billing", { description: "Meter API calls per workspace.", tags: ["billing"], assignee: "Noah Williams", icon: "receipt" }),
        KanbanCard("Dark mode for emails", { tags: ["design"], assignee: "Diego Alvarez" })
      ] }),
