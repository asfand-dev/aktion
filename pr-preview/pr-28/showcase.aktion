$modalOpen = false
$drawerOpen = false
$drawerStatus = "failed"

logLines = [
  "14:02:11  build started for commit 8f2a1c9",
  "14:02:40  412 unit tests passed",
  "14:03:02  bundled 38 assets (1.2 MB)",
  "14:03:31  uploaded to 34 edge regions",
