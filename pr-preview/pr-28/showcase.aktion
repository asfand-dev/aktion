$filterChips = ["status:failed", "service:billing", "region:eu-central-1"]
$failedOnly = true
$mineOnly = false
$queryRules = [{ field: "service", op: "contains", value: "atlas" }, { field: "duration", op: "gt", value: "120" }]
$paletteOpen = false
$envVars = [{ key: "ATLAS_REGION", value: "eu-central-1" }, { key: "CACHE_TTL", value: "300" }]
$docTitle = "Q4 launch plan"
$panelShown = true
$priorities = ["Latency", "Cost", "Reliability", "Security"]
$releaseOrder = ["Freeze the release branch", "Run the canary", "Promote to 100%", "Announce in #releases"]
$dropped = ""
$gesture = "none yet"

function moveRelease(from, to) {
  const next = [...$releaseOrder]
  const item = next.splice(from, 1)[0]
  next.splice(to, 0, item)
  $releaseOrder = next
}

paletteItems = [
  { label: "New deploy", value: "deploy", group: "Actions", shortcut: "Cmd+D" },
  { label: "Invite a teammate", value: "invite", group: "Actions" },
  { label: "Open the billing page", value: "billing", group: "Navigation" },
  { label: "Search the docs", value: "docs", group: "Navigation", shortcut: "/" },
  { label: "Toggle the theme", value: "theme", group: "Settings" }
]

bellItems = [
  { title: "Deploy #482 is live", message: "atlas-api · eu-central-1", time: "2m ago", unread: true },
  { title: "Budget at 80%", message: "Data pipeline", time: "1h ago", unread: true },
  { title: "Weekly digest", time: "Monday" }
]

logRows = $util.range(0, 400).map(i => ({
  time: `14:${String(Math.floor(i / 60) % 60).padStart(2, "0")}:${String(i % 60).padStart(2, "0")}`,
  level: i % 17 === 0 ? "ERROR" : (i % 5 === 0 ? "WARN" : "INFO"),
  tone: i % 17 === 0 ? "danger" : (i % 5 === 0 ? "warning" : "neutral"),
  message: i % 17 === 0 ? `upstream timeout on /v1/usage (request ${1000 + i})` : `GET /v1/projects/${i % 9} 200 in ${18 + (i * 7) % 90} ms`
}))

oldConfig = "[deploy]\nregion = \"eu-central-1\"\nstrategy = \"rolling\"\nreplicas = 3\n\n[cache]\nttl = 60\n"
newConfig = "[deploy]\nregion = \"eu-central-1\"\nstrategy = \"canary\"\ncanary_steps = [5, 25, 100]\nreplicas = 3\n\n[cache]\nttl = 300\n"

advancedGroup = Group("advanced", [
  Wall([
    Specimen(["FilterPill", "FilterChips", "QueryBuilder"], "Filtering", [
      Row([FilterPill("Failed", { active: $failedOnly, count: 2, icon: "circle-xmark", onToggle: () => { $failedOnly = !$failedOnly } }), FilterPill("Mine", { active: $mineOnly, count: 7, onToggle: () => { $mineOnly = !$mineOnly } }), FilterPill("Archived", { count: 0, disabled: true })], { gap: "xs", wrap: true }),
      FilterChips($filterChips, { onRemove: (value) => { $filterChips = $filterChips.filter(c => c !== value) }, onClear: () => { $filterChips = [] } }),
      QueryBuilder([{ name: "service", label: "Service" }, { name: "duration", label: "Duration (s)", type: "number" }, { name: "author", label: "Author" }], { value: $queryRules, onChange: (rules) => { $queryRules = rules } })
    ]),
    Specimen(["IconButton", "NotificationBell", "CommandPalette"], "Quick actions", [
      Row([
        IconButton("pen", { label: "Edit", variant: "secondary" }),
        IconButton("copy", { label: "Duplicate", variant: "ghost" }),
        IconButton("star", { label: "Starred", variant: "ghost", active: true }),
        IconButton("trash", { label: "Delete", variant: "danger" }),
        IconButton("arrows-rotate", { label: "Refreshing", loading: true }),
        Spacer(),
        NotificationBell({ count: 2, items: bellItems, align: "right", onMarkAllRead: () => { $toast.show("All caught up") } })
      ], { gap: "xs", align: "center" }),
      Row([Button("Search everything", { variant: "secondary", icon: "magnifying-glass", onClick: () => { $paletteOpen = true } }), KbdShortcut(["Cmd", "K"])], { gap: "sm", align: "center" }),
      CommandPalette(paletteItems, { open: $paletteOpen, placeholder: "Type a command or search…", shortcut: "Cmd+K", onSelect: (v) => { $paletteOpen = false; $toast.show(`Ran ${v}`) }, onClose: () => { $paletteOpen = false } })
    ]),
    Specimen(["FieldRepeater"], "Environment variables", [
      FieldRepeater($envVars, { fields: [{ name: "key", label: "Key" }, { name: "value", label: "Value" }], addLabel: "Add a variable", max: 6, onChange: (rows) => { $envVars = rows } })
    ]),
    Specimen(["VirtualList"], "Virtualised log", [
      Text("400 log lines; only the visible ones are rendered.", { variant: "small", tone: "muted" }),
      VirtualList(logRows, { itemHeight: 32, height: 192, renderItem: (row) => Row([Badge(row.level, { tone: row.tone, size: "xs" }), Text(row.time, { variant: "small", tone: "muted" }), StackItem(Text(row.message, { variant: "small", truncate: true }), { grow: 1, minWidth: "0" })], { gap: "sm", align: "center" }) })
    ]),
    Specimen(["JsonTree"], "JSON inspector", [
      JsonTree({ deploy: 482, service: "atlas-api", region: "eu-central-1", canary: { steps: [5, 25, 100], errorRate: 0.0011, passed: true }, author: { name: "Priya Raman", team: "platform" } }, { expandedDepth: 2, maxHeight: 260 })
    ]),
    Specimen(["Truncate", "InlineEdit"], "Editable text", [
      InlineEdit($docTitle, { label: "Document title", hint: "Click the title to rename it", onSave: (v) => { $docTitle = v } }),
      Truncate("Atlas is Acme Cloud's edge platform for teams that ship every day. It renders pages at 34 points of presence, gives every pull request its own preview URL and signs each change into an exportable audit log, so the boring parts of production stay boring and the interesting parts get the attention.", { maxLines: 2, expandLabel: "Read more", collapseLabel: "Show less" })
    ]),
    Specimen(["Reveal", "Transition", "FlipList", "Parallax"], "Motion", [
      Reveal(Callout("info", { title: "Revealed on scroll", description: "Fades up the first time it enters the viewport.", compact: true }), { animation: "fade-up", once: true }),
      Switch("motion-panel", { label: "Show the release panel", value: $panelShown }),
      Transition(Box([Text("v3.2.1 is live in 34 regions.")], { padding: "sm", background: "success", radius: "md" }), { show: $panelShown, preset: "slide-down" }),
      Row([
        Button("Shuffle", { variant: "secondary", size: "sm", icon: "shuffle", onClick: () => { $priorities = [$priorities[2], $priorities[0], $priorities[3], $priorities[1]] } }),
        FlipList($priorities.map(p => Badge(p, { tone: "primary", key: p })), { horizontal: true })
      ], { gap: "sm", align: "center", wrap: true }),
      Parallax(Image("https://picsum.photos/seed/acme-ridge/640/240", { alt: "A mountain ridge at dusk", ratio: "8:3", fit: "cover", loading: "eager" }), { speed: 0.15 })
    ]),
    Specimen(["Sortable", "Draggable", "DropZone", "OnGesture"], "Drag, drop and gestures", [
      Sortable($releaseOrder.map(t => Card([Text(t, { variant: "body-heavy" })], { padding: "sm", key: t })), { handle: true, ariaLabel: "Release checklist order", onReorder: (from, to) => moveRelease(from, to) }),
      Row([
        Draggable(Badge("hotfix-482", { tone: "warning", icon: "code-branch" }), { data: "hotfix-482", ariaLabel: "Drag the hotfix branch" }),
        DropZone(Text($dropped ? `Queued ${$dropped} for deploy` : "Drop a branch here to deploy it", { variant: "small", tone: "muted" }), { label: "Deploy target", onDrop: (data) => { $dropped = data } })
      ], { gap: "md", align: "center", wrap: true }),
      OnGesture(Box([Text(`Swipe, long-press or double-tap. Last gesture: ${$gesture}`, { variant: "small" })], { padding: "sm", border: "subtle", radius: "md" }), { swipe: (dir) => { $gesture = `swipe ${dir}` }, longPress: () => { $gesture = "long press" }, doubleTap: () => { $gesture = "double tap" } })
    ]),
    Specimen(["ReadingProgress"], "Reading progress", [
      Text("The thin gradient bar pinned to the top edge of this page fills as you scroll.", { variant: "small" })
    ])
  ]),
  Specimen(["DiffViewer"], "Config diff", [
    DiffViewer(oldConfig, { right: newConfig, mode: "split", leftTitle: "atlas.toml · main", rightTitle: "atlas.toml · this branch", maxHeight: 260 })
  ]),
  Specimen(["Gantt"], "Q4 roadmap", [
    Gantt([
      { id: "canary", label: "Canary deploys", start: "2026-10-01", end: "2026-10-12", progress: 100 },
      { id: "purge", label: "Cache purge by tag", start: "2026-10-06", end: "2026-10-24", progress: 55 },
      { id: "saml", label: "SAML for Business", start: "2026-10-13", end: "2026-11-06", progress: 30 },
      { id: "billing", label: "Usage-based billing", start: "2026-10-27", end: "2026-11-27", progress: 0 },
      { id: "summit", label: "Customer summit", start: "2026-11-16", end: "2026-11-18", progress: 0 }
