      ], { direction: { base: "column", md: "row" }, gap: "sm", uniform: true }),
      Center([Column([Spinner("sm"), Text("Centred on both axes", { variant: "small", tone: "muted" })], { gap: "xs", align: "center" })], { minHeight: "80px" })
    ]),
