    ]),
    Specimen(["Show", "Lazy", "ErrorBoundary"], "Conditional rendering", [
      Switch("show-advanced", { label: "Show advanced settings", value: $showAdvanced }),
      Show($showAdvanced, { children: [Input("max-connections", { label: "Max connections", value: "200" })], fallback: Text("Advanced settings are hidden.", { variant: "small", tone: "muted" }) }),
      Lazy(null, { fallback: Skeleton("card"), children: [Callout("success", { title: "Lazy section loaded", description: "Rendered once its loader resolved.", compact: true })] }),
      ErrorBoundary({ fallback: Callout("danger", { title: "Widget crashed", description: "The rest of the page kept working." }), children: [Callout("info", { title: "Guarded widget", description: "An error in here would show the fallback instead of breaking the page.", compact: true })] })
    ]),
    Specimen(["Portal", "LiveRegion", "FocusTrap"], "Accessibility plumbing", [
      Box([Text("Portal target", { variant: "small", tone: "muted" })], { id: "showcase-portal-target", padding: "sm", border: "default", radius: "md" }),
      Portal([Badge("Rendered elsewhere, shown here", { tone: "primary", icon: "share" })], { target: "#showcase-portal-target" }),
      Row([
        Button("Save draft", { variant: "primary", size: "sm", onClick: () => { $saveStatus = `Draft saved at ${new Date().toLocaleTimeString()}` } }),
        LiveRegion($saveStatus, { politeness: "polite", visible: true })
      ], { gap: "sm", align: "center", wrap: true }),
      Switch("trap-focus", { label: "Trap keyboard focus in the card below", value: $trapFocus }),
      FocusTrap(Card([Column([Input("trap-email", { label: "Invite by email", placeholder: "you@acme.dev" }), Button("Send invite", { variant: "primary", size: "sm" })], { gap: "sm" })], { variant: "outlined" }), { active: $trapFocus, onEscape: () => { $trapFocus = false } })
    ])
  ])
], "base")

// =============================================================================
// 15 · Behaviour wrappers
// =============================================================================
$clicks = 0
$hovering = false
$lastKey = ""
$focused = false
$seen = false
$mountedAt = ""

wrappersGroup = Group("wrappers", [
  Grid([
    Specimen(["OnClick", "OnMouse", "OnKeyboard", "OnFocus"], "Event wrappers", [
      OnClick(Box([Text(`Clicked ${$clicks} times. Click me.`, { variant: "body-heavy" })], { padding: "sm", border: "subtle", radius: "md" }), { onClick: () => { $clicks += 1 } }),
      OnMouse(Box([Text($hovering ? "The pointer is over this box" : "Hover this box", { variant: "body-heavy" })], { padding: "sm", background: $hovering ? "primary" : "muted", radius: "md" }), { enter: () => { $hovering = true }, leave: () => { $hovering = false } }),
      OnKeyboard(Box([Text($lastKey ? `Last key: ${$lastKey}` : "Focus this box and press a key", { variant: "body-heavy" })], { padding: "sm", border: "default", radius: "md" }), { onKeyDown: (e) => { $lastKey = e.key }, focusable: true }),
      OnFocus(Input("focus-demo", { label: $focused ? "Focused. Tab away to blur." : "Tab into this field", placeholder: "Focus me" }), { onFocus: () => { $focused = true }, onBlur: () => { $focused = false } })
    ]),
    Specimen(["OnIntersect", "OnMount", "Css", "Link"], "Lifecycle, styling and links", [
      OnIntersect(Callout($seen ? "success" : "neutral", { title: $seen ? "Seen on screen" : "Waiting to be seen", description: "OnIntersect flips this the first time it scrolls into view.", compact: true }), { onEnter: () => { $seen = true }, once: true }),
      OnMount(Text($mountedAt ? `Mounted at ${$mountedAt}` : "Mounting…", { variant: "small", tone: "muted" }), { onMount: () => { $mountedAt = new Date().toLocaleTimeString() } }),
      Css(Card([Text("Restyled with Css(child, { style }) using theme tokens", { variant: "body-heavy" })]), { style: "border: 1px dashed var(--rui-color-primary); background: var(--rui-color-bg-subtle);" }),
      Row([Link("Read the docs", { href: "get-started.html" }), Link("Changelog", { href: "https://github.com/asfand-dev/aktion/blob/main/CHANGELOG.md", external: true }), Link("A subtle link", { href: "components.html", variant: "subtle" })], { gap: "md", wrap: true })
    ])
  ], { columns: { base: 1, lg: 2 }, gap: "lg" })
], "soft")

// =============================================================================
// 16 · Interop
// =============================================================================
weeklyDeploys = [14, 22, 18, 27, 31, 12, 9]
weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

// Imperative drawing, the kind of code a third-party chart library runs.
// Colours come from the theme tokens, so it repaints correctly per theme.
function drawDeploys(canvas, values) {
  const width = 320
  const height = 120
  const ratio = window.devicePixelRatio || 1
  canvas.width = width * ratio
  canvas.height = height * ratio
  canvas.style.width = "100%"
  canvas.style.maxWidth = `${width}px`
  canvas.style.height = `${height}px`
  const ctx = canvas.getContext("2d")
  // No 2D context (canvas disabled, or a DOM without one): leave it blank.
  if (!ctx) {
    return
  }
  ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
  ctx.clearRect(0, 0, width, height)
  const styles = getComputedStyle(canvas)
  const bar = styles.getPropertyValue("--rui-color-primary").trim() || "#4f46e5"
  const ink = styles.getPropertyValue("--rui-color-text-muted").trim() || "#64748b"
  const top = Math.max(...values)
  const step = width / values.length
  ctx.font = "11px sans-serif"
  values.forEach((v, i) => {
    const h = Math.round((v / top) * (height - 30))
    ctx.fillStyle = bar
    ctx.fillRect(i * step + 8, height - 18 - h, step - 16, h)
    ctx.fillStyle = ink
    ctx.fillText(weekdays[i], i * step + 8, height - 4)
  })
}

nestedProgram = `$app(Card([
  CardHeader("A nested <aktion-app>", { subtitle: "Its own program, state and theme" }),
  Row([Badge("theme: dark", { tone: "info" }), Badge("isolated", { tone: "success" })], { gap: "xs" })
]))`

interopGroup = Group("interop", [
  Grid([
    Specimen(["Mount"], "Imperative widget", [
      Text("A canvas drawn by plain DOM code that Aktion never re-renders.", { variant: "small", tone: "muted" }),
      Mount({ tag: "canvas", props: { values: weeklyDeploys }, setup: (node, p) => { drawDeploys(node, p.values); return node }, update: (node, p) => { drawDeploys(node, p.values) } })
    ]),
    Specimen(["WebComponent"], "Custom elements", [
      Text("Any custom element works. This one is another <aktion-app>, running its own program in the dark theme.", { variant: "small", tone: "muted" }),
      WebComponent("aktion-app", { attributes: { theme: "dark", margin: "0", response: nestedProgram } })
    ])
  ], { columns: { base: 1, lg: 2 }, gap: "lg" })
], "base")

