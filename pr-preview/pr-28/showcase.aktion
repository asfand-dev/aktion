      BentoCell(Card([Column([Icon("shield-halved", { size: "lg" }), Text("SOC 2 Type II", { variant: "body-heavy" }), Text("Audited every year", { variant: "small", tone: "muted" })], { gap: "2xs" })])),
      BentoCell(Card([Column([Icon("code-pull-request", { size: "lg" }), Text("Preview deploys", { variant: "body-heavy" }), Text("A URL for every pull request", { variant: "small", tone: "muted" })], { gap: "2xs" })])),
      BentoCell(Card([Row([Icon("chart-line", { size: "lg" }), Column([Text("Usage analytics", { variant: "body-heavy" }), Text("Per-route cost and latency, updated every minute", { variant: "small", tone: "muted" })], { gap: "3xs" })], { gap: "md", align: "center" })]), { span: "wide" }),
      BentoCell(Card([Column([Icon("rotate-left", { size: "lg" }), Text("Instant rollback", { variant: "body-heavy" }), Text("One click, any release", { variant: "small", tone: "muted" })], { gap: "2xs" })])),
      BentoCell(Card([Column([Icon("wallet", { size: "lg" }), Text("Budgets", { variant: "body-heavy" }), Text("Alerts before the invoice", { variant: "small", tone: "muted" })], { gap: "2xs" })])),
      BentoCell(Card([Row([Icon("users", { size: "lg" }), Column([Text("Roles and audit log", { variant: "body-heavy" }), Text("Every change signed, searchable and exportable", { variant: "small", tone: "muted" })], { gap: "3xs" })], { gap: "md", align: "center" })]), { span: "wide" })
    ], { columns: 4, gap: "md", rowHeight: { base: "minmax(110px, auto)", md: "132px" } })
  ])
], "base")

// =============================================================================
// 02 · Content
// =============================================================================
contentGroup = Group("content", [
  Wall([
    Specimen(["Display", "GradientText", "Eyebrow", "Heading", "Text", "TextContent"], "Type scale", [
      Eyebrow("Release notes · October"),
      Display(["Ship ", GradientText("faster", { gradient: "brand" }), " with Atlas"], { size: "lg" }),
      Heading("Edge rendering is generally available", { size: "md", level: 4 }),
      Text("Pages now render at the point of presence nearest to your users.", { variant: "body" }),
      Text("Rolled out to every workspace on 30 Sep 2026.", { variant: "small", tone: "muted" }),
      Row([Text("Success", { variant: "small-heavy", tone: "success" }), Text("Warning", { variant: "small-heavy", tone: "warning" }), Text("Danger", { variant: "small-heavy", tone: "danger" }), TextContent("TextContent is Text's legacy alias", { variant: "small", tone: "muted" })], { gap: "sm", wrap: true })
    ]),
    Specimen(["Badge", "BadgeList", "Pill"], "Status labels", [
      Row([Badge("Neutral"), Badge("Primary", { tone: "primary" }), Badge("Shipped", { tone: "success", icon: "check" }), Badge("At risk", { tone: "warning", icon: "triangle-exclamation" }), Badge("Failed", { tone: "danger", icon: "xmark" }), Badge("Beta", { tone: "info" })], { gap: "xs", wrap: true }),
      BadgeList(["TypeScript", "Edge", "GraphQL", "Postgres", "Redis", "gRPC", "Kafka"], { tone: "primary", size: "sm", max: 5 }),
      Row([Pill("SSL active", { tone: "success", icon: "lock" }), Pill("Deploying", { tone: "activating", icon: "arrows-rotate" }), Pill("Quota 82%", { tone: "warning" }), Pill("Build failed", { tone: "critical" }), Pill("Draft", { tone: "neutral" })], { gap: "xs", wrap: true })
    ]),
    Specimen(["Callout"], "Inline notices", [
      Callout("info", { title: "Scheduled maintenance", description: "eu-central-1 restarts on Thursday at 02:00 UTC." }),
      Callout("success", { title: "Backup complete", description: "A 42.6 GB snapshot is stored in two regions.", compact: true }),
      Callout("warning", { title: "Certificate expiring", description: "Renew atlas.acme.dev within 6 days.", compact: true }),
      Callout("danger", { title: "Deploy failed", description: "The health check timed out after 30 seconds.", actions: [Button("View logs", { variant: "secondary", size: "sm" })] })
    ]),
    Specimen(["Quote"], "Pull quote", [
      Quote("We replaced four thousand lines of dashboard glue with forty lines of Aktion, and the on-call rotation noticed.", { cite: "Amara Okafor, SRE lead at Acme Cloud", tone: "primary" })
    ]),
    Specimen(["CodeBlock", "Kbd", "KbdShortcut"], "Code and keys", [
      CodeBlock("$count = 0\n\n$app(Card([\n  CardHeader(\"Counter\"),\n  Button(\"Clicked \" + $count + \" times\", {\n    variant: \"primary\",\n    onClick: () => { $count += 1 }\n  })\n]))", { language: "aktion", filename: "counter.aktion", showLineNumbers: true, highlightLines: "5-8" }),
      Row([Text("Search", { variant: "small", tone: "muted" }), Kbd(["Cmd", "K"]), Text("Save", { variant: "small", tone: "muted" }), KbdShortcut("Ctrl+S"), Text("Palette", { variant: "small", tone: "muted" }), KbdShortcut(["Shift", "Cmd", "P"])], { gap: "xs", align: "center", wrap: true })
    ]),
    Specimen(["Skeleton", "Spinner", "LoadingDots"], "Loading placeholders", [
      Row([Skeleton("avatar"), StackItem(Skeleton("paragraph", { lines: 2 }), { grow: 1 })], { gap: "md", align: "center" }),
      Skeleton("table-row", { lines: 2 }),
      Row([Spinner("sm"), Spinner("md", { label: "Syncing" }), Spinner("md", { label: "Importing rows", tone: "success" })], { gap: "md", align: "center", wrap: true }),
      Row([Text("Summarising the incident"), LoadingDots("Thinking", { size: "sm", tone: "primary" })], { gap: "sm", align: "center" })
    ]),
    Specimen(["Prose", "Markdown"], "Long-form text", [
      Prose([Markdown("### Atlas 3.2\n\nAtlas now **streams** responses from the edge. Highlights:\n\n- 41% lower p95 latency\n- Zero-downtime deploys with `atlas deploy --canary`\n- A [migration guide](https://example.com/atlas/3.2) for older projects\n\n> Most workspaces upgrade in about ten minutes.")], { size: "sm" })
    ]),
    Specimen(["Icon", "Svg", "VisuallyHidden"], "Icons and inline SVG", [
      Row([Icon("house", { size: "lg", label: "Home" }), Icon("chart-line", { size: "lg", label: "Analytics" }), Icon("bell", { size: "lg", variant: "regular", label: "Alerts" }), Icon("github", { size: "lg", variant: "brands", label: "GitHub" }), Icon("figma", { size: "lg", variant: "brands", label: "Figma" }), Icon("shield-halved", { size: "lg", label: "Security" })], { gap: "md", align: "center", wrap: true }),
      Row([
        Svg("<rect x='2' y='14' width='4' height='8' rx='1'/><rect x='10' y='8' width='4' height='14' rx='1'/><rect x='18' y='3' width='4' height='19' rx='1'/>", { viewBox: "0 0 24 24", width: "40px", height: "40px", fill: "var(--rui-color-primary)", label: "Usage rising" }),
        Column([
          Text("Usage up three weeks running", { variant: "body-heavy" }),
          Row([Icon("circle-check", { color: "var(--rui-color-success)" }), VisuallyHidden([Text("Verified:")]), Text("Billing details verified", { variant: "small", tone: "muted" })], { gap: "xs", align: "center" })
        ], { gap: "3xs" })
      ], { gap: "md", align: "center" })
    ]),
    Specimen(["Image"], "Responsive image", [
      Image("https://images.unsplash.com/photo-1551434678-e076c223a692?w=960&q=80", { alt: "Two engineers working at their desks", caption: "The Atlas platform team at work", ratio: "16:9", fit: "cover", loading: "eager" })
    ]),
    Specimen(["CountUp", "CountdownTimer", "RelativeTime"], "Live numbers and time", [
      Row([
        Column([Heading([CountUp(12480, { suffix: "+" })], { size: "md", level: 4 }), Text("Workspaces", { variant: "small", tone: "muted" })], { gap: "3xs", align: "center" }),
        Column([Heading([CountUp(99.98, { suffix: "%", decimals: 2 })], { size: "md", level: 4 }), Text("Uptime", { variant: "small", tone: "muted" })], { gap: "3xs", align: "center" }),
        Column([Heading([CountUp(34)], { size: "md", level: 4 }), Text("Edge regions", { variant: "small", tone: "muted" })], { gap: "3xs", align: "center" })
      ], { gap: "lg", justify: "between" }),
      Column([Text("Atlas 4.0 launches in", { variant: "small-heavy" }), CountdownTimer(launchAt, { endLabel: "Atlas 4.0 is live" })], { gap: "xs" }),
      Row([Icon("clock-rotate-left", { size: "sm" }), Text("Last deploy", { variant: "small", tone: "muted" }), RelativeTime(lastDeployAt)], { gap: "xs", align: "center" })
    ])
  ])
], "soft")

