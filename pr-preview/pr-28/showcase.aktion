        { label: "Projects", values: ["3", "25", "Unlimited"] },
        { label: "Edge regions", values: ["1", "12", "34"] },
        { label: "Single sign-on", values: [false, false, true] },
        { label: "Audit log", values: [false, true, true] },
        { label: "Support", values: ["Community", "Business hours", "24/7"] }
      ], highlightColumn: 1 })
    ]),
    Specimen(["InfiniteList"], "Activity feed", [
      InfiniteList(feedItems.slice(0, $feedCount), { hasMore: $feedCount < feedItems.length, onLoadMore: () => { $feedCount = Math.min($feedCount + 3, feedItems.length) }, loaderLabel: "Loading older activity…" })
    ]),
    Specimen(["VirtualGrid"], "Virtualised grid", [
