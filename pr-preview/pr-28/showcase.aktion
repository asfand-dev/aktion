dataGroup = Group("data", [
  Specimen(["Stats", "StatCard", "Sparkline"], "Key metrics", [
    Stats([
      StatCard("Monthly revenue", { value: "$84.2k", trend: "up", delta: "+12.4%", spark: [52, 58, 61, 66, 70, 78, 84], hint: "vs. September" }),
      StatCard("Active workspaces", { value: "12,480", trend: "up", delta: "+318", icon: "users", spark: [109, 112, 114, 118, 121, 123, 125] }),
      StatCard("p95 latency", { value: "184 ms", trend: "down", delta: "-41%", icon: "gauge-high", tone: "success", spark: [312, 290, 264, 240, 221, 199, 184] }),
      StatCard("Open incidents", { value: "2", trend: "flat", delta: "±0", icon: "triangle-exclamation", tone: "warning" })
    ]),
    Stats([
      { label: "Requests", value: "1.24M", hint: "today" },
      { label: "Error rate", value: "0.12%", hint: "-0.03 pts", tone: "success" },
      { label: "Cache hits", value: "93.4%", hint: "+1.2 pts" },
      { label: "Bandwidth", value: "18.2 TB", hint: "this month" }
    ], { layout: "strip" }),
