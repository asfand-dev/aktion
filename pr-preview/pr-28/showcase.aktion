// 03 · Forms
// =============================================================================
$projectName = "atlas-search"
$projectRegion = "eu-central-1"
$projectDescription = "Full-text search for the docs and the dashboard."
$password = "Correct-horse-9"
$phone = "4155550134"
$otp = "4821"
$agreed = true
$alertPrefs = { deploys: true, budget: true, digest: false }
$cycle = "yearly"
$autoscale = true
$owner = "mei"
$runtimes = ["node", "bun"]
$labels = ["edge", "search", "q4"]
$reviewNote = "Looks good to me. @priya can you approve the deploy?"
$launchDate = "2026-10-20"
$reportFrom = "2026-09-01"
$reportTo = "2026-09-30"
$standup = "09:30"
$freezeAt = "2026-10-16T18:00"
$cpuCap = 8
$replicas = 3
$seats = 12
$brandColor = "#4f46e5"
$view = "board"
$granularity = "Daily"
$docsQuery = ""
$size = "M"
$colorway = "indigo"
$wizStep = 1
$wizPlan = "team"
$escalate = "15"
$wsChecked = false
$reactions = [
  { emoji: "👍", count: 12, active: true },
  { emoji: "🎉", count: 7 },
  { emoji: "🚀", count: 5 },
  { emoji: "👀", count: 2 }
]

function passwordRules(value) {
  return [
    { label: "At least 12 characters", met: value.length >= 12 },
    { label: "An uppercase letter", met: value !== value.toLowerCase() },
    { label: "A digit", met: /[0-9]/.test(value) },
    { label: "No spaces", met: !value.includes(" ") }
  ]
}

workspaceErrors = [
  { label: "Workspace URL", message: "acme is already taken.", field: "ws-url" },
  { label: "Billing email", message: "Enter a valid email address.", field: "ws-email" }
]

teamItems = [
  SelectItem("priya", { label: "Priya Raman" }),
  SelectItem("mei", { label: "Mei Chen" }),
  SelectItem("diego", { label: "Diego Alvarez" }),
  SelectItem("amara", { label: "Amara Okafor" })
]

runtimeItems = [
  SelectItem("node", { label: "Node.js 24" }),
  SelectItem("bun", { label: "Bun 1.3" }),
  SelectItem("deno", { label: "Deno 2" }),
  SelectItem("python", { label: "Python 3.13" })
]

mentionPeople = [
  { name: "Priya Raman", handle: "priya", role: "Engineering manager" },
  { name: "Lukas Becker", handle: "lukas", role: "Frontend engineer" },
  { name: "Sofia Rossi", handle: "sofia", role: "Data scientist" }
]

formsGroup = Group("forms", [
  Wall([
    Specimen(["Form", "FormControl", "Input", "TextArea", "Select", "SelectItem", "Buttons", "Button"], "Create a project", [
      Form("create-project", {
        fields: [
          FormControl("Name", { control: Input("project-name", { value: $projectName, placeholder: "my-project" }), required: true }),
          FormControl("Region", { control: Select("project-region", { items: regionItems, value: $projectRegion }), hint: "Data stays in the region you pick." }),
          FormControl("Description", { control: TextArea("project-description", { value: $projectDescription, rows: 3 }), optional: true })
        ],
        buttons: Buttons([Button("Cancel", { variant: "ghost" }), Button("Create project", { variant: "primary", type: "submit", icon: "plus" })])
      })
    ]),
    Specimen(["PasswordInput", "RequirementList", "MaskedInput", "PinInput"], "Account security", [
      PasswordInput("new-password", { label: "New password", value: $password, strengthMeter: true, autocomplete: "new-password" }),
      RequirementList(passwordRules($password), { title: "Your password needs" }),
      MaskedInput("recovery-phone", { mask: "(999) 999-9999", value: $phone, label: "Recovery phone", inputMode: "tel" }),
      PinInput("otp", { length: 6, value: $otp, label: "Authenticator code", type: "numeric" })
    ]),
    // A populated ValidationSummary scrolls itself into view and takes focus
    // the moment it appears (right after a failed submit), so it only appears
    // once Save is pressed, or straight away in capture mode.
    Specimen(["ValidationSummary", "FieldSet"], "Validation", [
      ValidationSummary($captureMode || $wsChecked ? workspaceErrors : [], { title: "Fix 2 fields before saving" }),
      FieldSet("Workspace", { helper: "Shown in links and invitations.", children: [
        Input("ws-url", { label: "Workspace URL", value: "acme", error: $captureMode || $wsChecked ? workspaceErrors[0].message : "" }),
        Input("ws-email", { label: "Billing email", value: "billing@acme", type: "email", error: $captureMode || $wsChecked ? workspaceErrors[1].message : "" })
      ] }),
      Button("Save workspace", { variant: "primary", size: "sm", onClick: () => { $wsChecked = true } })
    ]),
    Specimen(["Checkbox", "CheckBoxGroup", "CheckBoxItem", "Radio", "Switch"], "Choices", [
      Checkbox("terms", { label: "I agree to the Acme Cloud terms", value: $agreed }),
      CheckBoxGroup("alerts", { label: "Alert me about", value: $alertPrefs, items: [
        CheckBoxItem("Failed deploys", { name: "deploys", description: "Within a minute of the failure", defaultChecked: true }),
        CheckBoxItem("Budget thresholds", { name: "budget", description: "At 50%, 80% and 100%", defaultChecked: true }),
        CheckBoxItem("Weekly digest", { name: "digest", description: "Mondays at 09:00" })
      ] }),
      Radio("billing-cycle", { label: "Billing cycle", value: $cycle, direction: "row", items: [SelectItem("monthly", { label: "Monthly" }), SelectItem("yearly", { label: "Yearly, save 20%" })] }),
      Switch("autoscale", { label: "Autoscaling", description: "Add nodes while CPU stays above 70%", value: $autoscale })
    ]),
    Specimen(["Combobox", "MultiSelect", "TagInput", "MentionInput"], "Search and pick", [
      Combobox("owner", { label: "Owner", items: teamItems, value: $owner, placeholder: "Search people…" }),
      MultiSelect("runtimes", { label: "Runtimes", items: runtimeItems, value: $runtimes, placeholder: "Add a runtime" }),
      TagInput("labels", { label: "Labels", value: $labels, placeholder: "Add a label", max: 6 }),
      MentionInput("review-note", { label: "Review note", people: mentionPeople, value: $reviewNote, rows: 2 })
    ]),
    Specimen(["DatePicker", "DateRangePicker", "TimePicker", "DateTimePicker"], "Dates and times", [
      DatePicker("launch-date", { label: "Launch date", value: $launchDate, min: "2026-10-01" }),
      DateRangePicker("report-range", { label: "Reporting window", from: $reportFrom, to: $reportTo }),
      Row([
        StackItem(TimePicker("standup", { label: "Stand-up", value: $standup }), { grow: 1 }),
        StackItem(DateTimePicker("code-freeze", { label: "Code freeze", value: $freezeAt }), { grow: 1 })
      ], { gap: "sm", wrap: true })
    ]),
    Specimen(["Slider", "NumberInput", "QuantityStepper", "ColorPicker"], "Numbers and colour", [
      Slider("cpu-cap", { label: "CPU limit", min: 1, max: 16, step: 1, value: $cpuCap, showValue: true, suffix: " vCPU" }),
      Row([
        StackItem(NumberInput("replicas", { label: "Replicas", value: $replicas, min: 1, max: 12 }), { grow: 1 }),
        Column([Text("Seats", { variant: "small-heavy" }), QuantityStepper($seats, { min: 1, max: 50, label: "Seats", onChange: (n) => { $seats = n } })], { gap: "xs" })
      ], { gap: "md", align: "end" }),
      ColorPicker("brand-color", { label: "Brand colour", value: $brandColor, swatches: ["#4f46e5", "#0ea5e9", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6"] })
    ]),
    Specimen(["Button", "ButtonGroup", "ToggleGroup", "SegmentedControl"], "Actions and toggles", [
      Row([Button("Primary", { variant: "primary" }), Button("Secondary", { variant: "secondary" }), Button("Outline", { variant: "outline" }), Button("Ghost", { variant: "ghost" }), Button("Delete", { variant: "danger", icon: "trash" }), Button("Link", { variant: "link" })], { gap: "xs", wrap: true }),
      Row([Button("Saving", { variant: "primary", size: "sm", loading: true }), Button("Disabled", { size: "sm", disabled: true }), Button("Next step", { variant: "secondary", size: "sm", icon: "arrow-right", iconPosition: "trailing" })], { gap: "xs", wrap: true }),
      ButtonGroup([Button("Day"), Button("Week", { variant: "primary" }), Button("Month")], { size: "sm", ariaLabel: "Chart range" }),
      ToggleGroup("view-mode", { items: [["list", "List", "list"], ["grid", "Grid", "grip"], ["board", "Board", "table-columns"]], value: $view, variant: "outline", size: "sm", label: "View" }),
      SegmentedControl(["Hourly", "Daily", "Weekly"], { value: $granularity, size: "sm", label: "Granularity", onChange: (v) => { $granularity = v } })
    ]),
    Specimen(["SearchBar", "InputGroup"], "Search and input groups", [
      SearchBar("docs-search", { placeholder: "Search the Atlas docs…", value: $docsQuery, shortcut: "/" }),
      InputGroup(Input("custom-domain", { placeholder: "atlas" }), { label: "Custom domain", suffix: ".acme.app", hint: "Lowercase letters, digits and dashes." }),
      InputGroup(Input("invoice-search", { placeholder: "Invoice number" }), { icon: "magnifying-glass", action: Button("Find", { variant: "primary", size: "sm" }) })
    ]),
    Specimen(["VariantSelector", "Swatch"], "Product options", [
      VariantSelector(["XS", "S", "M", "L", "XL"], { label: "Size", value: $size, kind: "pill", onChange: (v) => { $size = v } }),
      VariantSelector([{ label: "Graphite", value: "graphite", color: "#334155" }, { label: "Indigo", value: "indigo", color: "#4f46e5" }, { label: "Sand", value: "sand", color: "#d6c4a8" }], { label: "Colour", value: $colorway, kind: "swatch", onChange: (v) => { $colorway = v } }),
      Grid([
        Swatch("Light", { background: "#ffffff", foreground: "#0f172a", colors: ["#4f46e5", "#10b981", "#f59e0b"], selected: true }),
        Swatch("Dark", { background: "#0b1020", foreground: "#e2e8f0", colors: ["#818cf8", "#34d399", "#fbbf24"] }),
        Swatch("Signal", { background: "#111418", foreground: "#d5dbe3", colors: ["#3ea6ff", "#2fbf71", "#f5a623"] })
      ], { columns: 3, gap: "sm" })
    ]),
    Specimen(["FormSection"], "Grouped settings", [
      FormSection("Notifications", { helper: "Where Atlas sends deploy and incident alerts.", children: [
        FormControl("Slack channel", { control: Input("slack-channel", { value: "#atlas-deploys" }) }),
        FormControl("Escalate after", { control: Select("escalate", { items: [SelectItem("5", { label: "5 minutes" }), SelectItem("15", { label: "15 minutes" }), SelectItem("30", { label: "30 minutes" })], value: $escalate }), description: "Pages the on-call engineer." })
      ] })
    ]),
    Specimen(["FileUpload"], "File upload", [
      FileUpload("invoice-import", { label: "Drop CSV invoices or click to browse", hint: "Up to 10 MB each", accept: ".csv", multiple: true, icon: "file-csv" }),
      FileUpload("workspace-logo", { label: "Workspace logo", hint: "Uploading logo.png", accept: "image/*", progress: 64 })
    ]),
    Specimen(["MultiStepForm"], "Multi-step form", [
      MultiStepForm([
        { title: "Workspace", details: "Name and URL", content: [Input("wizard-name", { label: "Workspace name", value: "Acme Cloud" })] },
        { title: "Plan", details: "Pick a tier", content: [Radio("wizard-plan", { label: "Plan", value: $wizPlan, items: [SelectItem("team", { label: "Team · $49 a month" }), SelectItem("business", { label: "Business · $199 a month" })] })] },
        { title: "Invite", details: "Bring the team", content: [TagInput("wizard-invites", { label: "Invite by email", value: ["mei@acme.dev", "lukas@acme.dev"] })] }
      ], { current: $wizStep, stepsLayout: "row", onStepChange: (i) => { $wizStep = i } })
    ]),
    Specimen(["DrawingCanvas", "SignaturePad"], "Freehand input", [
      DrawingCanvas({ width: 320, height: 110, color: "#4f46e5", lineWidth: 3, label: "Sketch the request flow" }),
      SignaturePad({ width: 320, height: 100, label: "Sign to approve the data processing agreement" })
    ]),
    Specimen(["ReactionPicker"], "Reactions", [
      Text("Mei shipped the new onboarding flow to every workspace.", { variant: "body" }),
      ReactionPicker($reactions, { onReact: (emoji) => { $toast.show(`Reacted with ${emoji}`) } })
    ])
  ])
], "base")

