// =============================================================================
// Aktion component showcase — every built-in component on one page.
//
// Grouped the way the catalogue groups them (components.html), each component
// is rendered with realistic content from one fictional workspace: Acme Cloud
// and its edge platform, Atlas. Nothing here is real — names, numbers and
// companies are made up.
//
// This page is also the pull-request screenshot: CI captures it in full on
// every PR (.github/workflows/_screenshots.yml), so a change to any component
// is visible in review. tests/showcase-page.test.ts fails when a registered
// component is missing from this file or a group count below drifts from the
// library — adding a component means adding a specimen here.
//
// Host contract (docs/showcase.html): the footer emits `showcase:ready` once
// it has mounted, and the theme picker emits `showcase:theme`. The host page
// owns the <aktion-app> theme attribute; it applies the picked theme, and
// writes $activeTheme back when the ThemeToggle flips it instead.
//
// `?capture=1` (what the screenshot job loads) pre-opens the dropdown menu and
// pre-runs the form validation, so states a visitor would trigger by hand are
// in the picture. Without it, nothing opens, focuses or scrolls on load.
// =============================================================================

$app(Column([
  SkipLink("showcase-main", { label: "Skip to the components" }),
  ReadingProgress({ gradient: true, height: "3px" }),
  topNav,
  hero,
  Box([layoutGroup, contentGroup, formsGroup, dataGroup, chartsGroup, mediaGroup, navigationGroup, chatGroup, patternsGroup, overlaysGroup, shellGroup, advancedGroup, routingGroup, helpersGroup, wrappersGroup, interopGroup, escapeGroup], { id: "showcase-main", padding: "none" }),
  footer,
  BackToTop({ label: "Back to top", position: "bottom-center" })
], { gap: "none" }))

// ---- Groups -----------------------------------------------------------------
// One source of truth for the section headers, the hero index and the totals.
// The test compares every `count` with the library's componentGroups.
groups = [
  { id: "layout", name: "Layout", count: 34, blurb: "Containers that arrange everything else: stacks, grids, cards, panels, dialogs and dividers. This page is itself one Section per group around a MasonryGrid of cards." },
  { id: "content", name: "Content", count: 27, blurb: "Text, headings, badges, code, icons and loading placeholders, the everyday building blocks of a page." },
  { id: "forms", name: "Forms", count: 44, blurb: "Inputs, pickers, toggles and buttons for collecting, validating and submitting what people enter." },
  { id: "data", name: "Data", count: 24, blurb: "Tables, lists, trees, KPI tiles and calendars for showing records, metrics and orders." },
  { id: "charts", name: "Charts", count: 9, blurb: "Bars, lines, pies, scatter plots, heatmaps and gauges that turn numbers into a picture." },
  { id: "media", name: "Feedback & Media", count: 22, blurb: "People, hints, notices and rich media: avatars, tooltips, toasts, players, maps and animation." },
  { id: "navigation", name: "Navigation", count: 16, blurb: "Breadcrumbs, top bars, menus, tab bars, footers and in-page outlines. This page's own header and footer are a NavBar and a Footer." },
  { id: "chat", name: "Chat", count: 6, blurb: "Message bubbles, titled blocks and suggestion chips for conversational replies." },
  { id: "patterns", name: "Patterns", count: 43, blurb: "Opinionated composites that pack a whole UI idiom into one call: page headers, boards, pricing, states and more. The hero above is a Hero." },
  { id: "overlays", name: "Editors & overlays", count: 8, blurb: "Rich-text and code editors, plus the surfaces that float over a page: sheets, confirmations, menus and floating buttons." },
  { id: "app-shell", name: "App shell", count: 5, blurb: "Complete product surfaces: sidebar navigation, a top bar and master/detail panes in one statement." },
  { id: "advanced", name: "Advanced UI", count: 22, blurb: "Power-user widgets and motion: command palettes, filters, diffs, virtual lists and drag and drop." },
  { id: "routing", name: "Routing", count: 2, blurb: "Path-aware links and animated route views that wire a multi-page app to the router." },
  { id: "helpers", name: "Helpers", count: 8, blurb: "Control-flow and accessibility utilities that wrap a subtree: async states, conditionals, portals and focus." },
  { id: "wrappers", name: "Behaviour wrappers", count: 8, blurb: "Wrap any component to add clicks, hover, keys, focus, visibility, lifecycle, links or raw styling." },
  { id: "interop", name: "Interop", count: 2, blurb: "Bridges to imperative code and to custom elements that own their own DOM." },
  { id: "escape-hatches", name: "Escape hatches", count: 2, blurb: "Last-resort primitives for raw markup and scoped CSS when no component fits." }
]

totalComponents = groups.reduce((sum, g) => sum + g.count, 0)

function groupById(id) {
  return groups.find(g => g.id === id)
}

// A full-width page band per group, tinted on alternate rows.
function Group(id, children, background) {
  const group = groupById(id)
  const number = String(groups.indexOf(group) + 1).padStart(2, "0")
  return Section([Column(children, { gap: "lg" })], {
    id: id,
    eyebrow: `${number} · ${group.count} components`,
    title: group.name,
    subtitle: group.blurb,
    background: background,
    width: "xl",
    padding: "lg"
  })
}

// Mixed-height specimen cards packed into columns.
function Wall(cards) {
  return MasonryGrid(cards, { columns: { base: 1, md: 2, xl: 3 }, gap: "lg" })
}

// For a group with only a few cards: CSS columns balance by height and can
// leave a whole column empty, so these sit in top-aligned grid rows instead.
function Rows(cards) {
  return Grid(cards, { columns: { base: 1, md: 2, xl: 3 }, gap: "lg", alignItems: "start" })
}

// One specimen: the component names it demonstrates, a title, the live render.
function Specimen(names, title, body) {
  return Card([
    Column([
      Text(names.join(" · "), { variant: "small-heavy", tone: "primary" }),
      Text(title, { variant: "large-heavy", as: "h3" })
    ], { gap: "3xs" }),
    Column(body, { gap: "md" })
  ])
}

// ---- Shared fictional data --------------------------------------------------
team = [
  { name: "Priya Raman", role: "Engineering manager", status: "online" },
  { name: "Diego Alvarez", role: "Product designer", status: "busy" },
  { name: "Mei Chen", role: "Product manager", status: "online" },
  { name: "Amara Okafor", role: "Site reliability lead", status: "away" },
  { name: "Lukas Becker", role: "Frontend engineer", status: "offline" },
  { name: "Sofia Rossi", role: "Data scientist", status: "online" },
  { name: "Noah Williams", role: "Backend engineer", status: "online" }
]

regionItems = [
  SelectItem("eu-central-1", { label: "Frankfurt · eu-central-1" }),
  SelectItem("eu-west-1", { label: "Dublin · eu-west-1" }),
  SelectItem("us-east-1", { label: "N. Virginia · us-east-1" }),
  SelectItem("ap-southeast-2", { label: "Sydney · ap-southeast-2" })
]

lastDeployAt = new Date(Date.now() - 3 * 3600000).toISOString()
launchAt = new Date(Date.now() + ((4 * 24 + 6) * 60 + 30) * 60000).toISOString()

// ---- Header -----------------------------------------------------------------
$captureMode = $util.url.query.capture === "1"

themeChoices = [
  { id: "light", label: "Light" },
  { id: "dark", label: "Dark" },
  { id: "shadcn", label: "shadcn/ui" },
  { id: "shadcn-dark", label: "shadcn/ui dark" },
  { id: "mui", label: "Material UI" },
  { id: "mui-dark", label: "Material UI dark" },
  { id: "heroui", label: "HeroUI" },
  { id: "heroui-dark", label: "HeroUI dark" },
  { id: "signal", label: "Signal" },
  { id: "signal-dark", label: "Signal dark" },
  { id: "soft", label: "Soft" }
]

themeItems = themeChoices.map(t => SelectItem(t.id, { label: t.label }))

// Same rule as the host page: an unknown ?theme= falls back to light.
$activeTheme = themeChoices.some(t => t.id === $util.url.query.theme) ? $util.url.query.theme : "light"

function pickTheme(value) {
  $activeTheme = value
  $emit("showcase:theme", { theme: value })
}

topNav = NavBar({
  brand: Brand("Aktion", { logoSrc: "assets/logo.png", version: "Showcase", href: "index.html" }),
  links: [
    Link("Docs", { href: "get-started.html" }),
    Link("Components", { href: "components.html" }),
    Link("Themes", { href: "themes.html" }),
    Link("Playground", { href: "playground.html" })
  ],
  actions: [
    Select("showcase-theme", { items: themeItems, value: $activeTheme, label: "Theme", labelHidden: true, onChange: (value) => pickTheme(value) }),
    IconButton("brands:github", { label: "Aktion on GitHub", variant: "ghost", href: "https://github.com/asfand-dev/aktion" })
  ],
  sticky: true,
  blur: true
})

indexColumns = [
  { title: "Building blocks", ids: ["layout", "content", "forms", "data", "charts", "media"] },
  { title: "Product surfaces", ids: ["navigation", "chat", "patterns", "overlays", "app-shell", "advanced"] },
  { title: "Behaviour and plumbing", ids: ["routing", "helpers", "wrappers", "interop", "escape-hatches"] }
]

function IndexCard(column) {
  const items = column.ids.map(id => groupById(id)).map(g => ({ label: `${g.name} · ${g.count}`, href: `#${g.id}` }))
  return Card([TableOfContents(items, { title: column.title })], { variant: "outlined" })
}

hero = Box([
  Backdrop({ grid: true, blobs: ["#6366f1", "#ec4899", "#22d3ee"], particles: 40, type: "network", speed: 0.5 }),
  Container([
    Hero("Every component, one page.", {
      eyebrow: "aktion-runtime · component showcase",
      subtitle: `All ${totalComponents} built-in components, rendered live with realistic content and grouped the way the catalogue groups them. Every pull request screenshots this page, so a review shows what a change does to the whole library at once.`,
      primary: Button("Browse the catalogue", { variant: "primary", icon: "shapes", href: "components.html" }),
      secondary: Button("Try the playground", { variant: "secondary", icon: "play", href: "playground.html" }),
      highlights: [`${groups.length} groups`, "11 themes, switchable above", "Fictional data, real components"],
      align: "center"
    }),
    MetricStrip([
      Metric(String(totalComponents), { label: "Components", gradient: true }),
      Metric(String(groups.length), { label: "Groups" }),
      Metric("11", { label: "Themes" }),
      Metric("1", { label: "Custom element" })
    ], { columns: 4 }),
    Grid(indexColumns.map(c => IndexCard(c)), { columns: { base: 1, md: 3 }, gap: "md" })
  ], { size: "xl", padding: "lg" })
], { padding: "none", style: "position: relative; overflow: hidden" })

