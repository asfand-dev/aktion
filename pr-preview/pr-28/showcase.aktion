      VirtualGrid($util.range(0, 120).map(i => Card([Column([Icon(assetIcons[i % assetIcons.length]), Text(`asset-${String(i + 1).padStart(3, "0")}`, { variant: "small" })], { gap: "3xs", align: "center" })], { padding: "xs" })), { columns: 4, itemHeight: 72, gap: 8, height: 232 })
    ]),
    Specimen(["Metric", "MetricStrip"], "Headline metrics", [
      MetricStrip([Metric("84k", { label: "MRR, USD", gradient: true }), Metric("12k", { label: "Workspaces", trend: "+3.1%" })], { columns: 2 })
    ]),
    Specimen(["Cart", "OrderSummary", "PriceTag"], "Team store checkout", [
      Cart($cart, { currency: "USD", onQty: (id, qty) => { $cart = $cart.map(i => i.id === id ? { ...i, qty: qty } : i) }, onRemove: (id) => { $cart = $cart.filter(i => i.id !== id) } }),
      OrderSummary([{ label: "Studio headphones", amount: "199.00" }, { label: "Everyday mug × 2", amount: "36.00" }], { subtotal: "235.00", discount: "23.50", shipping: "0.00", tax: "40.18", total: "251.68", currency: "$", note: "Free shipping on orders over $150" }),
      Row([PriceTag(199, { compareAt: 249, currency: "USD", size: "lg" }), PriceTag(49, { currency: "USD", period: "/ seat / month" })], { gap: "lg", align: "center", wrap: true })
    ])
  ]),
  Split(
    Specimen(["CalendarView"], "Release calendar", [
