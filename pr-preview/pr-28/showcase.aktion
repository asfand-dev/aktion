// =============================================================================
// 10 · Editors & overlays
// =============================================================================
$sheetOpen = false
$bottomSheetOpen = false
$confirmOpen = false
$fabLast = "Nothing yet"

releaseNotesHtml = "<h3>Atlas 3.2.1</h3><p>Edge rendering is now <b>generally available</b> in all 34 regions.</p><ul><li>41% lower p95 latency</li><li>Canary deploys on every plan</li></ul>"

handlerSource = "export async function handler(request: Request) {\n  const region = request.headers.get(\"x-atlas-region\") ?? \"eu-central-1\"\n  const started = performance.now()\n  const page = await render(request.url, { region })\n  return new Response(page, {\n    headers: { \"server-timing\": `render;dur=${performance.now() - started}` }\n  })\n}\n"

overlaysGroup = Group("overlays", [
  Rows([
    Specimen(["RichTextEditor"], "Rich text", [
      RichTextEditor("release-notes", { value: releaseNotesHtml, label: "Release notes", minHeight: "150px" })
    ]),
    Specimen(["CodeEditor"], "Code editor", [
      CodeEditor("edge-handler", { value: handlerSource, language: "typescript", filename: "handler.ts", minHeight: "170px", copyable: true })
    ]),
    Specimen(["ContextMenu"], "Context menu", [
      ContextMenu(Card([Column([Row([Icon("file-pdf"), Text("Q4-roadmap.pdf", { variant: "body-heavy" })], { gap: "xs", align: "center" }), Text("Right-click, or long-press on touch, for actions.", { variant: "small", tone: "muted" })], { gap: "xs" })], { variant: "outlined" }), {
        items: [
          { label: "Open", icon: "arrow-up-right-from-square" },
          { label: "Rename", icon: "pen" },
          { label: "Share", icon: "share-nodes" },
          MenuSeparator(),
          { label: "Delete", icon: "trash", variant: "danger" }
        ]
      })
    ]),
    Specimen(["Sheet", "BottomSheet", "ConfirmDialog"], "Sheets and confirmations", [
      Row([
        Button("Deploy details", { variant: "secondary", icon: "table-columns", onClick: () => { $sheetOpen = true } }),
        Button("Share", { variant: "secondary", icon: "share-nodes", onClick: () => { $bottomSheetOpen = true } }),
        Button("Revoke key…", { variant: "danger", icon: "key", onClick: () => { $confirmOpen = true } })
      ], { gap: "sm", wrap: true }),
      Sheet([
        DescriptionList([DescriptionItem("Deploy", { value: "#482" }), DescriptionItem("Service", { value: "atlas-api" }), DescriptionItem("Author", { value: "Priya Raman" }), DescriptionItem("Duration", { value: "2m 58s" })], { columns: 1 })
      ], { open: $sheetOpen, side: "right", title: "Deploy #482", onClose: () => { $sheetOpen = false } }),
      BottomSheet([
        Text("Anyone with the link can view this deploy."),
        Input("share-link", { label: "Link", value: "https://app.acme.dev/d/482", readOnly: true })
      ], { open: $bottomSheetOpen, title: "Share deploy #482", onClose: () => { $bottomSheetOpen = false } }),
      ConfirmDialog("Revoke this API key?", { open: $confirmOpen, message: "Integrations that use it stop working immediately.", confirmLabel: "Revoke", cancelLabel: "Keep the key", tone: "danger", onConfirm: () => { $confirmOpen = false; $toast.success("Key revoked") }, onCancel: () => { $confirmOpen = false } })
    ]),
    Specimen(["SpeedDial", "FloatingActionButton"], "Floating actions", [
      Text("Both are pinned to the viewport: the speed dial bottom-right, the help button bottom-left. The PR screenshot is taken with a page-tall viewport, so there they sit at the very bottom of the page.", { variant: "small" }),
      Row([Text("Last quick action:", { variant: "small", tone: "muted" }), Badge($fabLast, { tone: "primary" })], { gap: "sm", align: "center" }),
      SpeedDial([
        { label: "New deploy", icon: "rocket", onClick: () => { $fabLast = "New deploy" } },
        { label: "Invite someone", icon: "user-plus", onClick: () => { $fabLast = "Invite someone" } },
        { label: "Report an issue", icon: "bug", onClick: () => { $fabLast = "Report an issue" } }
      ], { icon: "plus", position: "bottom-right", label: "Quick actions" }),
