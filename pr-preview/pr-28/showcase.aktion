      Col("Status", deploys.map(d => Badge(d.status, { tone: d.tone }))),
      Col("Duration", deploys.map(d => d.duration), { align: "right" }),
      Col("Cost", deploys.map(d => d.cost), { format: "currency", currency: "USD", align: "right" }),
      Col("Finished", deploys.map(d => d.finished), { format: "date" })
    ], { caption: "The last five production deploys", density: "compact", striped: true }),
    Pagination($deployPage, { totalPages: 12, total: 58, perPage: 5, siblings: 1, onChange: (p) => { $deployPage = p } })
  ]),
  Specimen(["DataGrid"], "Customer accounts", [
    DataGrid([
      Col("Account", accounts.map(a => a.name), { sortable: true, filterable: true }),
      Col("Plan", accounts.map(a => a.plan), { sortable: true, filterable: true }),
      Col("Seats", accounts.map(a => a.seats), { format: "number", align: "right", sortable: true }),
      Col("MRR", accounts.map(a => a.mrr), { format: "currency", currency: "USD", align: "right", sortable: true }),
      Col("Renews", accounts.map(a => a.renews), { format: "date", sortable: true }),
      Col("Health", accounts.map(a => Pill(a.health, { tone: a.healthTone })))
    ], { rowIds: accounts.map(a => a.id), caption: "Accounts", sort: $accountSort, selectable: true, selectedIds: $selectedAccounts, page: $accountPage, perPage: 5, striped: true, density: "compact", exportable: true, highlightOnHover: true })
  ]),
  Wall([
    Specimen(["List", "ListItem"], "Services", [
      List([
        ListItem("Atlas API", { description: "3 deploys today", icon: "server", trailing: [Badge("Healthy", { tone: "success", size: "sm" })] }),
        ListItem("Billing service", { description: "Canary at 25%", icon: "credit-card", active: true, trailing: [Badge("Canary", { tone: "info", size: "sm" })] }),
        ListItem("Search indexer", { description: "Rebuilding shards", icon: "magnifying-glass", tone: "warning", trailing: [Badge("Degraded", { tone: "warning", size: "sm" })] }),
        ListItem("Data pipeline", { description: "Paused by Sofia", icon: "diagram-project", tone: "danger" })
      ], { divided: true })
    ]),
    Specimen(["Tile"], "Quick-stat tiles", [
      Grid([
        Tile("Projects", { icon: "folder-open", value: "24", description: "4 archived", tone: "primary" }),
        Tile("Deploys", { icon: "rocket", value: "318", description: "this month", tone: "success" }),
        Tile("Alerts", { icon: "bell", value: "7", description: "2 unacknowledged", tone: "warning" }),
        Tile("Spend", { icon: "wallet", value: "$9.4k", description: "62% of budget", tone: "info" })
      ], { columns: 2, gap: "sm" })
    ]),
    Specimen(["Progress", "ProgressRing"], "Progress", [
      Progress(68, { label: "Storage · 68 of 100 GB", tone: "primary", showValue: true }),
      Progress(3, { max: 5, label: "Onboarding · step 3 of 5", segments: 5, tone: "success" }),
      Progress(40, { label: "Upload · buffering", buffered: 72, tone: "info", showValue: true }),
      Row([ProgressRing(92, { caption: "SLA", tone: "success" }), ProgressRing(64, { caption: "Budget", tone: "warning" }), ProgressRing(100, { caption: "Backups", icon: "circle-check", tone: "primary" })], { gap: "lg", justify: "around" })
    ]),
    Specimen(["Tree", "TreeNode"], "File tree", [
      Tree([
        TreeNode("atlas", { icon: "folder-open", expanded: true, children: [
          TreeNode("src", { icon: "folder-open", expanded: true, badge: "3", children: [
            TreeNode("app.aktion", { icon: "file-code", active: true }),
            TreeNode("routes.aktion", { icon: "file-code" }),
            TreeNode("theme.json", { icon: "file" })
          ] }),
          TreeNode("tests", { icon: "folder", children: [TreeNode("app.test.ts", { icon: "file-code" })] }),
          TreeNode("README.md", { icon: "file-lines" })
        ] })
      ], { ariaLabel: "Atlas repository" })
    ]),
    Specimen(["ComparisonTable"], "Plan comparison", [
