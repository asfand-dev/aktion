// Chat Widget — a support-chat panel with a header, a scrollable message thread
// of chat bubbles, a typing indicator, quick-reply chips and a composer. The
// bot echoes a canned reply after a short delay to feel live.
$app(Container([Card([Column([head, body, quick, composer], { gap: "md" })])], { size: "sm" }))

$messages = [
  { id: "m1", from: "agent", author: "Aria", body: "Hi! I'm Aria, your assistant. How can I help today?", time: $util.formatDate($util.now(), "h:mm A") }
]
$draft = ""
$typing = false

quickReplies = ["Pricing", "Reset password", "Talk to a human", "Cancel my plan"]
replies = {
  Pricing: "Plans start at $0 for Starter and $24/mo for Pro. Want a feature comparison?",
  "Reset password": "No problem — I've sent a reset link to your email. It expires in 30 minutes.",
  "Talk to a human": "Connecting you to a teammate now. Average wait is under 2 minutes.",
  "Cancel my plan": "I can help with that. Your plan stays active until the end of the cycle. Shall I proceed?"
}

function botReply(text) {
  $typing = true
  setTimeout(() => {
    const answer = replies[text] ?? "Thanks for your message! A teammate will follow up shortly."
    $messages = [...$messages, { id: crypto.randomUUID(), from: "agent", author: "Aria", body: answer, time: $util.formatDate($util.now(), "h:mm A") }]
    $typing = false
  }, 900)
}

function send(text) {
  const msg = (text ?? $draft).trim()
  if (!msg) return
  $messages = [...$messages, { id: crypto.randomUUID(), from: "me", author: "You", body: msg, time: $util.formatDate($util.now(), "h:mm A") }]
  $draft = ""
  botReply(msg)
}

head = Row([
  Avatar("Aria", { status: "online" }),
  StackItem(Column([Text("Aria · Support", { variant: "body-heavy" }), Row([StatusDot("Online", { tone: "success" }), Text("typically replies in minutes", { variant: "small", tone: "muted" })], { gap: "xs", align: "center" })], { gap: "xs" }), { grow: 1 }),
  IconButton("ellipsis", { label: "Options", variant: "ghost", size: "sm" })
], { align: "center", gap: "sm" })

bubbles = $messages.map(m => ChatBubble(m.author, { body: m.body, time: m.time, from: m.from == "me" ? "me" : "agent" }))
typingRow = $typing ? Row([Avatar("Aria", { size: "xs" }), Badge("Aria is typing…", { tone: "neutral", icon: "ellipsis" })], { gap: "xs", align: "center" }) : null

body = ScrollArea(Column([...bubbles, typingRow], { gap: "sm" }), { maxHeight: "320px" })

quick = Row(quickReplies.map(q => Button(q, { variant: "secondary", size: "xs", onClick: () => send(q) })), { gap: "xs", wrap: true })

composer = Row([
  StackItem(Input("draft", { value: $draft, placeholder: "Type a message…" }), { grow: 1 }),
  IconButton("paper-plane", { label: "Send", variant: "primary", disabled: !$draft.trim(), onClick: () => send() })
], { gap: "sm", align: "center" })
