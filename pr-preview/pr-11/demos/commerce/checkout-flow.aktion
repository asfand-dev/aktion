// Checkout Flow — a four-step checkout: basket review with working promo codes,
// validated delivery, a mock payment sheet, then review + a confirmed order.
// Starting point for: any multi-step commerce checkout or long gated wizard.
// Uses: MultiStepForm driven by $step, $store basket, $form + $util.rules,
//        QuantityStepper, MaskedInput/PinInput, live OrderSummary, SuccessState.
$app(Column([nav, body, pageFooter], { gap: "none" }))

// ---------------------------------------------------------------- state ----
$step = 0
$promoInput = ""
$promoCode = ""
$promoError = ""
$giftWrap = false
$shipMethod = "standard"
$billingSame = true
$billLine1 = ""
$billCity = ""
$billPostcode = ""
$payMethod = "card"
$cardName = ""
$cardNumber = ""
$cardExpiry = ""
$cardCvc = ""
$invoiceVat = ""
$terms = false
$placed = false
$orderNo = ""

basket = $store({
  items: [
    { id: "ln-1", sku: "NS-WBR-142", name: "Fjordline Trail Windbreaker", variant: "Slate / M", price: 168, qty: 1, stock: 4, image: "https://picsum.photos/seed/northsound-windbreaker/160/160" },
    { id: "ln-2", sku: "NS-MRW-220", name: "Harbour Merino Base Layer", variant: "Ink / L", price: 74, qty: 2, stock: 12, image: "https://picsum.photos/seed/northsound-merino/160/160" },
    { id: "ln-3", sku: "NS-FLK-006", name: "Cascade 18h Vacuum Flask", variant: "Brushed steel", price: 39, qty: 1, stock: 3, image: "https://picsum.photos/seed/northsound-flask/160/160" }
  ],
  setQty: (s, id, qty) => { s.items = qty <= 0 ? s.items.filter(i => i.id != id) : s.items.map(i => i.id == id ? { ...i, qty } : i) },
  remove: (s, id) => { s.items = s.items.filter(i => i.id != id) }
})

promoCodes = [
  { code: "SPRING15", kind: "percent", value: 15, min: 0, note: "15% off the whole basket" },
  { code: "TAKE20", kind: "fixed", value: 20, min: 120, note: "$20 off baskets over $120" },
  { code: "CREW25", kind: "percent", value: 25, min: 300, note: "25% off baskets over $300" }
]

shipMethods = {
  standard: { label: "Standard courier", detail: "3–5 working days, tracked", price: 6.9, days: 5, icon: "truck" },
  express: { label: "Express overnight", detail: "Next working day before 12:00", price: 18.5, days: 1, icon: "truck-fast" },
  pickup: { label: "Collect in store", detail: "Portland flagship, ready in 2 hours", price: 0, days: 1, icon: "store" }
}
shipOrder = ["standard", "express", "pickup"]

paymentMethods = [{ value: "card", label: "Card", icon: "credit-card" }, { value: "wallet", label: "Wallet", icon: "wallet" }, { value: "invoice", label: "Invoice", icon: "file-invoice-dollar" }]
countries = [{ value: "US", label: "United States" }, { value: "CA", label: "Canada" }, { value: "GB", label: "United Kingdom" }, { value: "DE", label: "Germany" }, { value: "NO", label: "Norway" }]

// ------------------------------------------------------------- computed ----
money = n => $util.currency(n, "USD")
round2 = n => Math.round(n * 100) / 100
itemCount = $util.sum(basket.items.map(i => i.qty))
subtotal = round2($util.sum(basket.items.map(i => i.price * i.qty)))
appliedPromo = promoCodes.find(p => p.code == $promoCode)
discount = appliedPromo ? (appliedPromo.kind == "percent" ? round2(subtotal * appliedPromo.value / 100) : Math.min(appliedPromo.value, subtotal)) : 0
giftWrapPrice = 4.95
giftFee = $giftWrap && basket.items.length > 0 ? giftWrapPrice : 0
freeShipping = subtotal - discount >= 150
shipFee = $shipMethod == "standard" && freeShipping ? 0 : shipMethods[$shipMethod].price
goods = Math.max(0, subtotal - discount + giftFee)
tax = round2(goods * 0.0825)
total = round2(goods + shipFee + tax)
weekdayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

function humanDate(iso) {
  const d = new Date(iso)
  return `${weekdayNames[d.getDay()]} ${d.getDate()} ${monthNames[d.getMonth()]}`
}

etaLabel = humanDate($util.addDays($util.today(), shipMethods[$shipMethod].days))

deliveryRules = {
  name: [$util.rules.required("Who should we address the parcel to?"), $util.rules.minLength(3, "Use the full name on the door")],
  email: [$util.rules.required("The receipt and tracking go here"), $util.rules.email("That email address looks off")],
  phone: [$util.rules.required("Couriers text before they knock"), $util.rules.minLength(10, "Include the area code")],
  line1: [$util.rules.required("Street and number, please"), $util.rules.minLength(6, "Add the house or apartment number")],
  city: [$util.rules.required("Which city are we delivering to?")],
  postcode: [$util.rules.required("We route parcels by postcode"), $util.rules.minLength(4, "That postcode looks too short")],
  country: [$util.rules.required("Pick a destination country")]
}

function goToPayment() { $step = 2 }

delivery = $form({
  values: { name: "", email: "", phone: "", line1: "", line2: "", city: "", postcode: "", country: "US" },
  rules: deliveryRules,
  onSubmit: goToPayment
})

deliveryProblems = $util.rules.validateAll(delivery.values, deliveryRules)
deliveryOk = Object.keys(deliveryProblems).length == 0
billingOk = $billingSame || ($billLine1.length > 5 && $billCity.length > 1 && $billPostcode.length > 3)
cardDigits = $util.replace($cardNumber, " ", "")
expiryMonth = Number($util.substring($cardExpiry, 0, 2))
expiryOk = $cardExpiry.length == 5 && expiryMonth >= 1 && expiryMonth <= 12
cardOk = $cardName.length > 2 && cardDigits.length == 16 && expiryOk && $cardCvc.length == 3
paymentOk = $payMethod == "card" ? cardOk : ($payMethod == "invoice" ? $invoiceVat.length >= 6 : true)
stepValid = [basket.items.length > 0, deliveryOk && billingOk, paymentOk, $terms]
canPlace = basket.items.length > 0 && deliveryOk && billingOk && paymentOk && $terms
cardLast4 = cardDigits.length >= 4 ? $util.substring(cardDigits, cardDigits.length - 4) : ""
cardSummary = cardLast4.length == 4 ? `Card ending ${cardLast4}` : "Card — details pending"
paySummary = $payMethod == "card" ? cardSummary : ($payMethod == "wallet" ? "Northsound Wallet" : `Invoice, net 14 · VAT ${$invoiceVat.length > 5 ? $invoiceVat : "pending"}`)

function countryName(code) { const found = countries.find(c => c.value == code); return found ? found.label : "—" }

deliveryLine = [delivery.values.line1, delivery.values.line2, delivery.values.city, delivery.values.postcode, countryName(delivery.values.country)].filter(part => part && part.length > 0).join(", ")
billingLine = [$billLine1, $billCity, $billPostcode].filter(part => part.length > 0).join(", ")

// -------------------------------------------------------------- actions ----
function applyPromo() {
  const entered = $util.uppercase($util.trim($promoInput))
  if (entered.length == 0) { $promoError = "Type a code first"; return }
  const match = promoCodes.find(p => p.code == entered)
  if (!match) { $promoCode = ""; $promoError = `We do not recognise the code ${entered}`; return }
  if (subtotal < match.min) { $promoCode = ""; $promoError = `${match.code} needs a basket of ${money(match.min)} or more`; return }
  $promoCode = match.code
  $promoError = ""
  $toast.success(`${match.code} applied — ${match.note}`)
}

function clearPromo() { $promoCode = ""; $promoInput = ""; $promoError = "" }

function goStep(target) {
  if (target <= $step) $step = target
  else $toast.info("Finish the current step before skipping ahead")
}

function placeOrder() {
  if (!canPlace) return
  $orderNo = `NS-${$util.uppercase($util.substring($util.uuid(), 0, 6))}`
  $placed = true
}

function startOver() { $placed = false; $step = 0; $terms = false; $orderNo = "" }

// --------------------------------------------------------------- pieces ----
trustRow = Row([
  Pill("256-bit TLS checkout", { tone: "success", icon: "lock" }),
  Pill("30-day free returns", { tone: "info", icon: "rotate-left" }),
  Pill("Carbon-neutral delivery", { tone: "success", icon: "leaf" }),
  Pill("PCI-DSS compliant", { tone: "corporate", icon: "shield-halved" }),
  Pill("4.8 / 5 from 12,480 orders", { tone: "promoting", icon: "star" })
], { gap: "xs", wrap: true })

supportCard = Card([
  SectionHeader("Need help?", { eyebrow: "SUPPORT", subtitle: "Real people, 7am–9pm PT, seven days a week." }),
  Column([
    ActionStripe("Chat with the crew", { description: "Median first reply 90 seconds", icon: "comments", onClick: () => $toast.info("A support agent will join in a moment") }),
    ActionStripe("Call +1 503 555 0147", { description: "Toll-free inside the US and Canada", icon: "phone", onClick: () => $toast.info("Dialling Northsound support…") }),
    ActionStripe("Delivery & returns FAQ", { description: "Cut-off times, tracking, refunds", icon: "circle-question", onClick: () => $toast.info("Opening the help centre") })
  ], { gap: "2xs" })
])

function LineRow(line) {
  return Row([
    StackItem(Image(line.image, { alt: `${line.name}, ${line.variant}`, ratio: "1:1", fit: "cover" }), { basis: "76px", shrink: 0 }),
    StackItem(Column([
      Text(line.name, { variant: "body-heavy" }),
      Text(`${line.variant} · SKU ${line.sku}`, { variant: "small", tone: "muted" }),
      Row([
        Pill(line.stock > 5 ? "In stock" : `Only ${line.stock} left`, { tone: line.stock > 5 ? "success" : "warning", icon: "boxes-stacked" }),
        Text(`${money(line.price)} each`, { variant: "small", tone: "muted" })
      ], { gap: "xs", wrap: true })
    ], { gap: "3xs" }), { grow: 1, minWidth: "170px" }),
    QuantityStepper(line.qty, { min: 1, max: line.stock, size: "sm", label: `Quantity of ${line.name}`, onChange: q => basket.setQty(line.id, q) }),
    StackItem(Text(money(line.price * line.qty), { variant: "body-heavy" }), { basis: "88px" }),
    IconButton("xmark", { label: `Remove ${line.name}`, variant: "ghost", size: "sm", onClick: () => basket.remove(line.id) })
  ], { gap: "md", align: "center", wrap: true, key: line.id })
}

// ------------------------------------------------------------- step one ----
basketStep = Column([
  Card([
    SectionHeader("Your basket", { eyebrow: "STEP 1", subtitle: `${$util.plural(itemCount, "item")} held for 20 minutes`, status: Pill(money(subtotal), { tone: "activating", icon: "basket-shopping" }) }),
    Show(basket.items.length > 0, {
      fallback: EmptyState("Your basket is empty", { description: "Add something from the shop and the checkout will pick up where you left off.", icon: "basket-shopping" }),
      children: Column(basket.items.map(line => LineRow(line)), { gap: "md" })
    })
  ]),
  Card([
    SectionHeader("Promo code", { eyebrow: "SAVINGS", subtitle: "One code per order." }),
    Row([
      StackItem(Input("promo-code", { label: "Promo code", value: $promoInput, placeholder: "SPRING15", error: $promoError.length > 0 ? $promoError : null, hint: appliedPromo ? null : "Try SPRING15, TAKE20 or CREW25" }), { grow: 1, minWidth: "200px" }),
      Button("Apply", { variant: "secondary", icon: "tag", onClick: applyPromo })
    ], { gap: "sm", align: "end", wrap: true }),
    Show(appliedPromo != null, {
      children: Callout("success", { title: `${$promoCode} applied — ${money(discount)} off`, description: appliedPromo ? appliedPromo.note : "", icon: "circle-check", compact: true, actions: [Button("Remove code", { variant: "ghost", size: "sm", icon: "xmark", onClick: clearPromo })] })
    })
  ]),
  Card([
    SectionHeader("Gift options", { eyebrow: "EXTRAS" }),
    Switch("gift-wrap", { label: `Gift wrap this order (+ ${money(giftWrapPrice)})`, value: $giftWrap, description: "Recycled kraft paper, cotton ribbon and a handwritten card. Prices are hidden on the packing slip." })
  ])
], { gap: "lg" })

// ------------------------------------------------------------- step two ----
deliveryErrorList = Object.keys(delivery.errors).filter(k => delivery.errors[k]).map(k => ({ field: k, message: delivery.errors[k] }))

deliveryStep = Column([
  Card([
    SectionHeader("Delivery address", { eyebrow: "STEP 2", subtitle: "We only use this to get the parcel to you." }),
    Show(deliveryErrorList.length > 0, { children: ValidationSummary(deliveryErrorList, { count: true }) }),
    FormSection("Contact", [
      FormControl("Full name", { field: Input("d-name", { value: delivery.values.name, placeholder: "Astrid Lindqvist", autocomplete: "name", onBlur: () => delivery.touch("name") }), error: delivery.errors.name, required: true }),
      Grid([
        FormControl("Email", { field: Input("d-email", { type: "email", value: delivery.values.email, placeholder: "astrid@example.com", autocomplete: "email", onBlur: () => delivery.touch("email") }), error: delivery.errors.email, required: true }),
        FormControl("Phone", { field: MaskedInput("d-phone", { mask: "(999) 999-9999", value: delivery.values.phone, placeholder: "(503) 555-0147", onBlur: () => delivery.touch("phone") }), error: delivery.errors.phone, required: true })
      ], { columns: { base: 1, md: 2 }, gap: "md" })
    ], { helper: "Tracking updates are sent by email and SMS." }),
    FormSection("Address", [
      FormControl("Address line 1", { field: Input("d-line1", { value: delivery.values.line1, placeholder: "1420 SE Belmont Street", autocomplete: "address-line1", onBlur: () => delivery.touch("line1") }), error: delivery.errors.line1, required: true }),
      FormControl("Address line 2", { field: Input("d-line2", { value: delivery.values.line2, placeholder: "Apartment, suite, entry code", autocomplete: "address-line2" }), hint: "Optional" }),
      Grid([
        FormControl("City", { field: Input("d-city", { value: delivery.values.city, placeholder: "Portland", autocomplete: "address-level2", onBlur: () => delivery.touch("city") }), error: delivery.errors.city, required: true }),
        FormControl("Postcode", { field: Input("d-postcode", { value: delivery.values.postcode, placeholder: "97214", autocomplete: "postal-code", onBlur: () => delivery.touch("postcode") }), error: delivery.errors.postcode, required: true }),
        FormControl("Country", { field: Select("d-country", { items: countries, value: delivery.values.country, placeholder: "Choose a country" }), error: delivery.errors.country, required: true })
      ], { columns: { base: 1, md: 3 }, gap: "md" })
    ])
  ]),
  Card([
    SectionHeader("Shipping method", { eyebrow: "SPEED", status: Pill(`Arrives ${etaLabel}`, { tone: "info", icon: "calendar-day" }) }),
    Radio("ship-method", { label: "Shipping method", items: shipOrder.map(k => ({ value: k, label: `${shipMethods[k].label} — ${k == "standard" && freeShipping ? "Free" : money(shipMethods[k].price)} · ${shipMethods[k].detail}` })), value: $shipMethod }),
    Callout(freeShipping ? "success" : "info", { title: freeShipping ? "Free standard shipping unlocked" : `${money(Math.max(0, 150 - (subtotal - discount)))} away from free standard shipping`, description: "Express and in-store collection are unaffected by the free-shipping threshold.", icon: "truck-fast", compact: true })
  ]),
  Card([
    SectionHeader("Billing address", { eyebrow: "INVOICE" }),
    Switch("billing-same", { label: "Billing address is the same as the delivery address", value: $billingSame }),
    Show(!$billingSame, {
      children: FormSection("Billing address", [
        FormControl("Address line 1", { field: Input("b-line1", { value: $billLine1, placeholder: "500 SW Broadway" }), error: $billLine1.length > 0 && $billLine1.length <= 5 ? "Add the street number too" : null, required: true }),
        Grid([
          FormControl("City", { field: Input("b-city", { value: $billCity, placeholder: "Portland" }), required: true }),
          FormControl("Postcode", { field: Input("b-postcode", { value: $billPostcode, placeholder: "97205" }), required: true })
        ], { columns: { base: 1, md: 2 }, gap: "md" })
      ], { helper: "Used on the receipt and the VAT invoice." })
    }),
    Buttons([Button("Check address and continue", { variant: "secondary", icon: "circle-check", onClick: () => delivery.submit(), loading: delivery.submitting })])
  ])
], { gap: "lg" })

// ----------------------------------------------------------- step three ----
cardFields = Column([
  FormControl("Name on card", { field: Input("card-name", { value: $cardName, placeholder: "A LINDQVIST", autocomplete: "cc-name" }), required: true }),
  FormControl("Card number", { field: MaskedInput("card-number", { mask: "9999 9999 9999 9999", value: $cardNumber, placeholder: "4242 4242 4242 4242", inputMode: "numeric" }), error: cardDigits.length > 0 && cardDigits.length < 16 ? "A card number is 16 digits" : null, hint: "Any 16 digits work — nothing is sent anywhere", required: true }),
  Grid([
    FormControl("Expiry", { field: MaskedInput("card-expiry", { mask: "99/99", value: $cardExpiry, placeholder: "04/29", inputMode: "numeric" }), error: $cardExpiry.length == 5 && !expiryOk ? "Months run from 01 to 12" : null, required: true }),
    FormControl("Security code", { field: PinInput("card-cvc", { length: 3, value: $cardCvc, type: "numeric", mask: true, label: "Card security code", labelHidden: true }), hint: "3 digits on the signature strip", required: true })
  ], { columns: { base: 1, sm: 2 }, gap: "md" })
], { gap: "md" })

walletFields = Callout("info", { title: "Approve in your wallet", description: "Placing the order opens your wallet provider to confirm the amount. Nothing is charged until you approve it there.", icon: "wallet" })

invoiceFields = Column([
  Callout("warning", { title: "Business accounts only", description: "Invoices are payable within 14 days. A VAT identifier is required before we can ship.", icon: "file-invoice-dollar", compact: true }),
  FormControl("VAT / tax identifier", { field: Input("invoice-vat", { value: $invoiceVat, placeholder: "US-923-004-118" }), error: $invoiceVat.length > 0 && $invoiceVat.length < 6 ? "That identifier looks too short" : null, required: true })
], { gap: "md" })

paymentStep = Column([
  Card([
    SectionHeader("Payment method", { eyebrow: "STEP 3", subtitle: "Choose how you would like to settle this order." }),
    ToggleGroup("pay-method", { label: "Payment method", items: paymentMethods, value: $payMethod }),
    Show($payMethod == "card", { children: cardFields }),
    Show($payMethod == "wallet", { children: walletFields }),
    Show($payMethod == "invoice", { children: invoiceFields }),
    Show(!paymentOk, { children: Callout("warning", { title: "Finish this step to continue", description: "Continue unlocks once the payment details above are complete.", icon: "triangle-exclamation", compact: true }) })
  ]),
  Card([
    SectionHeader("How your details are handled", { eyebrow: "SECURITY" }),
    Callout("success", { title: "This is a demo checkout", description: "No payment endpoint is contacted and nothing you type leaves this page. In production the card fields would be replaced by a tokenising iframe from the payment provider.", icon: "shield-halved" }),
    Row([Icon("lock", { size: "sm" }), Text("Card data is never stored on Northsound servers.", { variant: "small", tone: "muted" })], { gap: "xs" })
  ])
], { gap: "lg" })

// ------------------------------------------------------------ step four ----
reviewStep = Column([
  Card([
    SectionHeader("Review your order", { eyebrow: "STEP 4", subtitle: "Everything below is exactly what we will charge and ship.", actions: [Button("Edit basket", { variant: "ghost", size: "sm", icon: "pen", onClick: () => { $step = 0 } })] }),
    DescriptionList([
      DescriptionItem("Basket", `${$util.plural(itemCount, "item")} · ${money(subtotal)}`, { icon: "basket-shopping" }),
      DescriptionItem("Promo code", appliedPromo ? `${$promoCode} — ${money(discount)} off` : "None applied", { icon: "tag" }),
      DescriptionItem("Gift wrap", $giftWrap ? `Yes · ${money(giftWrapPrice)}` : "No", { icon: "gift" }),
      DescriptionItem("Deliver to", deliveryLine.length > 3 ? deliveryLine : "Not entered yet", { icon: "location-dot" }),
      DescriptionItem("Contact", `${delivery.values.email.length > 0 ? delivery.values.email : "—"} · ${delivery.values.phone.length > 0 ? delivery.values.phone : "—"}`, { icon: "envelope" }),
      DescriptionItem("Shipping", `${shipMethods[$shipMethod].label} — ${shipFee == 0 ? "Free" : money(shipFee)}`, { icon: shipMethods[$shipMethod].icon }),
      DescriptionItem("Billing", $billingSame ? "Same as delivery" : (billingLine.length > 3 ? billingLine : "Not entered yet"), { icon: "building-columns" }),
      DescriptionItem("Payment", paySummary, { icon: "credit-card" })
    ]),
    Separator("horizontal"),
    Checkbox("terms", { label: "I agree to the terms of sale and the 30-day returns policy", value: $terms, description: "Required before we can take payment.", required: true }),
    Button(`Place order · ${money(total)}`, { variant: "primary", icon: "lock", size: "lg", fullWidth: true, disabled: !canPlace, onClick: placeOrder })
  ]),
  Card([
    SectionHeader("After you press place order", { eyebrow: "WHAT HAPPENS NEXT" }),
    Timeline([
      TimelineItem("Order confirmed", { time: "Instantly", description: "Confirmation email with your order number.", icon: "receipt", tone: "success" }),
      TimelineItem("Picked and packed", { time: "Within 1 working day", description: "Packed plastic-free at our Portland warehouse.", icon: "box-open" }),
      TimelineItem("Handed to the courier", { time: `Arrives ${etaLabel}`, description: shipMethods[$shipMethod].detail, icon: shipMethods[$shipMethod].icon })
    ])
  ])
], { gap: "lg" })

// -------------------------------------------------------------- assembly ----
summaryLines = basket.items.map(i => ({ label: `${i.name} (${i.variant})`, amount: money(i.price * i.qty), qty: i.qty }))
extraLines = $giftWrap && basket.items.length > 0 ? [{ label: "Gift wrap", amount: money(giftWrapPrice) }] : []

summaryCard = Card([
  SectionHeader("Order summary", { eyebrow: "LIVE TOTAL", status: Pill(`Step ${$step + 1} of 4`, { tone: "activating" }) }),
  Progress($step + 1, { max: 4, label: "Checkout progress", tone: "primary" }),
  OrderSummary([...summaryLines, ...extraLines], {
    currency: "USD",
    subtotal: money(subtotal),
    discount: discount > 0 ? `− ${money(discount)}` : null,
    shipping: shipFee == 0 ? "Free" : money(shipFee),
    tax: `${money(tax)} (8.25%)`,
    total: money(total),
    note: "Duties for orders outside the US are collected by the courier.",
    empty: "Nothing in the basket yet."
  }),
  Show(!freeShipping && basket.items.length > 0, { children: Text(`Spend ${money(Math.max(0, 150 - (subtotal - discount)))} more for free standard shipping.`, { variant: "small", tone: "muted" }) })
])

wizard = MultiStepForm({
  steps: [
    { title: "Basket", details: $util.plural(itemCount, "item"), content: basketStep },
    { title: "Delivery", details: shipMethods[$shipMethod].label, content: deliveryStep },
    { title: "Payment", details: paySummary, content: paymentStep },
    { title: "Review", details: money(total), content: reviewStep }
  ],
  current: $step,
  stepsLayout: "row",
  nextLabel: "Continue",
  prevLabel: "Back",
  submitLabel: `Place order · ${money(total)}`,
  nextDisabled: !stepValid[$step],
  clickableSteps: true,
  onSubmit: placeOrder
})

checkoutView = Section([
  Column([
    trustRow,
    Split(Column([wizard], { gap: "lg" }), Column([summaryCard, supportCard], { gap: "lg" }), { ratio: "3/2", gap: "lg", stackAt: "lg", sticky: "right", stickyOffset: "96px", align: "start" })
  ], { gap: "lg" })
], { width: "xl", eyebrow: "CHECKOUT", title: "Secure checkout", subtitle: "Four short steps. Nothing is charged until you place the order." })

confirmationView = Section([
  Column([
    Card([
      SuccessState("Order placed", {
        description: `Thanks ${delivery.values.name.length > 0 ? delivery.values.name : "— your order is in"}. A confirmation is on its way to ${delivery.values.email.length > 0 ? delivery.values.email : "your inbox"}.`,
        icon: "box-open",
        actions: [Button("Track this order", { variant: "primary", icon: "location-crosshairs", onClick: () => $toast.info(`Tracking for ${$orderNo} opens once the courier scans the label`) }), Button("Start a new order", { variant: "ghost", icon: "rotate-left", onClick: startOver })]
      }),
      Separator("horizontal"),
      DescriptionList([
        DescriptionItem("Order number", Badge($orderNo, { tone: "primary", icon: "receipt" }), { icon: "hashtag" }),
        DescriptionItem("Charged today", money(total), { icon: "credit-card" }),
        DescriptionItem("Paid with", paySummary, { icon: "wallet" }),
        DescriptionItem("Estimated arrival", etaLabel, { icon: "calendar-day" }),
        DescriptionItem("Shipping", shipMethods[$shipMethod].label, { icon: shipMethods[$shipMethod].icon }),
        DescriptionItem("Ships to", deliveryLine.length > 3 ? deliveryLine : "Store collection", { icon: "location-dot" })
      ])
    ]),
    Grid([
      Card([
        SectionHeader("What happens next", { eyebrow: "TIMELINE" }),
        Timeline([
          TimelineItem("Payment authorised", { time: "Just now", description: `${money(total)} held on ${paySummary}.`, icon: "circle-check", tone: "success" }),
          TimelineItem("Packing slip printed", { time: "Within 1 working day", description: "Plastic-free packing at our Portland warehouse.", icon: "print" }),
          TimelineItem("Courier collection", { time: `Arrives ${etaLabel}`, description: shipMethods[$shipMethod].detail, icon: shipMethods[$shipMethod].icon })
        ])
      ]),
      supportCard
    ], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" }),
    trustRow
  ], { gap: "lg" })
], { width: "lg", eyebrow: "CONFIRMED", title: `Order ${$orderNo}`, subtitle: "Keep this number handy — support can find everything with it." })

body = Show($placed, { children: confirmationView, fallback: checkoutView })

navItems = ["Basket", "Delivery", "Payment", "Review"].map((label, i) => NavbarItem(label, { icon: ["basket-shopping", "truck", "credit-card", "clipboard-check"][i], active: $step == i, onClick: () => goStep(i) }))

nav = Navbar({
  brand: "Northsound Supply",
  items: navItems,
  actions: [Pill("Secure", { tone: "success", icon: "lock" }), Button("Help", { variant: "ghost", size: "sm", icon: "circle-question", onClick: () => $toast.info("Support is open 7am–9pm PT") }), ThemeToggle()],
  sticky: true,
  collapsible: true
})

pageFooter = Footer({
  brand: "Northsound Supply",
  tagline: "Outdoor kit for people who go out in the weather, not around it.",
  columns: [
    FooterColumn("Orders", { links: [Link("Track a parcel", { href: "#" }), Link("Returns portal", { href: "#" }), Link("Size guide", { href: "#" })] }),
    FooterColumn("Help", { links: [Link("Delivery times", { href: "#" }), Link("Payment options", { href: "#" }), Link("Contact us", { href: "#" })] })
  ],
  legal: "© 2026 Northsound Supply — demo checkout, no real payments are processed."
})
