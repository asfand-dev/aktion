// Dictionary — look up any English word via the free dictionaryapi.dev: see its
// phonetics, play the pronunciation, and read definitions grouped by part of
// speech with examples and synonyms. Starting point for: any reference, glossary
// or lookup tool backed by a search API.
// Uses: $http on submit + .onDone, AudioPlayer, Accordion of meanings, Badge synonyms.
$app(Column([header, searchRow, suggestions, view], { gap: "lg", padding: "md" }))

$word = "serendipity"
$result = null
$queried = ""

function lookup(w) {
  const term = (w ?? $word).trim().toLowerCase()
  if (!term) return
  $queried = term
  $result = $http({ url: `https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(term)}` })
}

// fetch once on mount so the page isn't empty
$effect(() => { if ($result == null) lookup("serendipity") }, ["mount"])

entry = $result && $result.data && Array.isArray($result.data) ? $result.data[0] : null
phonetic = entry ? (entry.phonetic || (entry.phonetics.find(p => p.text) || {}).text || "") : ""
audioSrc = entry ? ((entry.phonetics.find(p => p.audio && p.audio != "") || {}).audio || "") : ""

header = PageHeader("Dictionary", {
  subtitle: "English definitions, phonetics and synonyms",
  badge: Badge("dictionaryapi.dev", { tone: "primary", icon: "book-open" })
})

searchRow = Row([
  StackItem(SearchBar("word", { placeholder: "Look up a word…", value: $word, onSubmit: () => lookup() }), { grow: 1 }),
  Button("Define", { variant: "primary", icon: "magnifying-glass", onClick: () => lookup() })
], { gap: "sm", align: "end" })

words = ["ephemeral", "ubiquitous", "resilient", "nuance", "paradigm", "eloquent"]
suggestions = Row([
  Text("Try:", { variant: "small-heavy", tone: "muted" }),
  ...words.map(w => Button(w, { variant: "ghost", size: "sm", onClick: () => { $word = w; lookup(w) } }))
], { gap: "xs", align: "center", wrap: true })

function meaningCard(m) {
  return AccordionItem($util.capitalize(m.partOfSpeech), {
    children: [Column([
      Column(m.definitions.slice(0, 4).map((d, i) => Column([
        Row([Badge(String(i + 1), { tone: "neutral", size: "xs" }), StackItem(Text(d.definition), { grow: 1 })], { gap: "sm", align: "start" }),
        Show(!!d.example, { children: Quote(d.example || "") })
      ], { gap: "2xs", key: String(i) })), { gap: "md" }),
      Show(m.synonyms && m.synonyms.length > 0, { children: Column([
        Text("Synonyms", { variant: "small-heavy", tone: "muted" }),
        BadgeList((m.synonyms || []).slice(0, 8), { size: "sm" })
      ], { gap: "xs" }) })
    ], { gap: "md" })]
  })
}

function entryView() {
  return Column([
    Card([Row([
      StackItem(Column([
        Text($util.capitalize(entry.word), { variant: "heading" }),
        Show(!!phonetic, { children: Text(phonetic, { variant: "large", tone: "muted" }) })
      ], { gap: "2xs" }), { grow: 1 }),
      Show(!!audioSrc, { children: AudioPlayer(audioSrc, { title: "Pronunciation" }) })
    ], { gap: "md", align: "center" })]),
    Card([
      SectionHeader("Meanings", { eyebrow: `${entry.meanings.length} parts of speech` }),
      Accordion(entry.meanings.map(m => meaningCard(m)))
    ])
  ], { gap: "lg" })
}

view = $result == null
  ? LoadingState("Ready when you are", { description: "Search for a word to see its definition." })
  : Async($result, {
      loading: LoadingState("Looking it up…", { description: `Defining "${$queried}"` }),
      error: ErrorState("Word not found", { description: `We couldn't find "${$queried}". Check the spelling and try again.`, icon: "book", actions: [Button("Clear", { variant: "secondary", onClick: () => { $word = "" } })] }),
      data: entry ? entryView() : EmptyState("No definition", { icon: "book", description: `Nothing found for "${$queried}".` })
    })
