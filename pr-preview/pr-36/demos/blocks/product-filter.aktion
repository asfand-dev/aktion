// Product Filter — an e-commerce listing block with a filter sidebar (category,
// brand, price range, in-stock toggle), a sort + results bar, and a responsive
// product grid that updates live. Sidebar + results layout via GridItem.
$app(Column([header, layout], { gap: "lg", padding: "md" }))

products = [
  { id: 1, name: "Aurora Hoodie", brand: "Northwind", cat: "Apparel", price: 78, rating: 4.6, stock: 12, img: "https://picsum.photos/seed/p1/400/300" },
  { id: 2, name: "Voyager Mug", brand: "Atlas", cat: "Home", price: 24, rating: 4.2, stock: 0, img: "https://picsum.photos/seed/p2/400/300" },
  { id: 3, name: "Pulse Headphones", brand: "Sonic", cat: "Tech", price: 149, rating: 4.8, stock: 5, img: "https://picsum.photos/seed/p3/400/300" },
  { id: 4, name: "Trail Backpack", brand: "Northwind", cat: "Apparel", price: 96, rating: 4.4, stock: 20, img: "https://picsum.photos/seed/p4/400/300" },
  { id: 5, name: "Nova Desk Lamp", brand: "Atlas", cat: "Home", price: 42, rating: 4.1, stock: 8, img: "https://picsum.photos/seed/p5/400/300" },
  { id: 6, name: "Quartz Smartwatch", brand: "Sonic", cat: "Tech", price: 199, rating: 4.7, stock: 3, img: "https://picsum.photos/seed/p6/400/300" },
  { id: 7, name: "Linen Throw", brand: "Atlas", cat: "Home", price: 58, rating: 4.0, stock: 15, img: "https://picsum.photos/seed/p7/400/300" },
  { id: 8, name: "Summit Jacket", brand: "Northwind", cat: "Apparel", price: 164, rating: 4.9, stock: 0, img: "https://picsum.photos/seed/p8/400/300" }
]

$cats = []
$brands = []
$maxPrice = 200
$inStock = false
$sort = "popular"

allCats = $util.unique(products.map(p => p.cat))
allBrands = $util.unique(products.map(p => p.brand))
money = n => $util.format(n, "currency", "USD")

function toggle(list, value, setter) {
  return list.includes(value) ? list.filter(x => x != value) : [...list, value]
}
function toggleCat(c) { $cats = toggle($cats, c) }
function toggleBrand(b) { $brands = toggle($brands, b) }
function clearAll() { $cats = []; $brands = []; $maxPrice = 200; $inStock = false }

filtered = products.filter(p =>
  ($cats.length == 0 || $cats.includes(p.cat)) &&
  ($brands.length == 0 || $brands.includes(p.brand)) &&
  p.price <= $maxPrice &&
  (!$inStock || p.stock > 0)
)
sortFns = {
  popular: (a, b) => b.rating - a.rating,
  priceLow: (a, b) => a.price - b.price,
  priceHigh: (a, b) => b.price - a.price
}
results = [...filtered].sort(sortFns[$sort])

header = PageHeader("Shop all", { subtitle: `${results.length} of ${products.length} products`, breadcrumbs: false })

sidebar = Card([Column([
  Row([SectionHeader("Filters"), Spacer(), Button("Reset", { variant: "ghost", size: "sm", icon: "rotate-left", onClick: clearAll })], { align: "center" }),
  Separator("horizontal"),
  FormControl("Category", { field: Column(allCats.map(c => Checkbox(`cat-${c}`, { label: c, value: $cats.includes(c), onChange: () => toggleCat(c) })), { gap: "xs" }) }),
  FormControl("Brand", { field: Column(allBrands.map(b => Checkbox(`brand-${b}`, { label: b, value: $brands.includes(b), onChange: () => toggleBrand(b) })), { gap: "xs" }) }),
  FormControl(`Max price: ${money($maxPrice)}`, { field: Slider("maxPrice", { min: 20, max: 200, step: 10, value: $maxPrice, showValue: true }) }),
  Switch("inStock", { label: "In stock only", value: $inStock })
], { gap: "md" })])

function productCard(p) {
  return Card([Column([
    Box([Image(p.img, { alt: p.name, ratio: "4:3", fit: "cover" })]),
    Row([Badge(p.cat, { tone: "info", size: "xs" }), Spacer(), p.stock == 0 ? Badge("Sold out", { tone: "danger", size: "xs" }) : p.stock < 6 ? Badge(`${p.stock} left`, { tone: "warning", size: "xs" }) : null], { align: "center" }),
    Text(p.name, { variant: "body-heavy" }),
    Text(p.brand, { variant: "small", tone: "muted" }),
    Row([Rating(p.rating, { max: 5, readonly: true, size: "sm" }), Text(String(p.rating), { variant: "small", tone: "muted" })], { gap: "xs", align: "center" }),
    Row([Text(money(p.price), { variant: "large-heavy", tone: "primary" }), Spacer(), Button("Add", { variant: "primary", size: "sm", icon: "cart-plus", disabled: p.stock == 0, onClick: () => $toast.success(`${p.name} added to cart`) })], { align: "center" })
  ], { gap: "sm" })])
}

resultsArea = Column([
  Toolbar({
    left: [Text(`${results.length} ${$util.plural(results.length, "result")}`, { variant: "small-heavy", tone: "muted" })],
    right: [Select("sort", { items: [SelectItem("popular", { label: "Most popular" }), SelectItem("priceLow", { label: "Price: low to high" }), SelectItem("priceHigh", { label: "Price: high to low" })], value: $sort })]
  }),
  Show(results.length > 0, {
    fallback: EmptyState("No products match", { description: "Try widening your filters.", icon: "box-open", action: Button("Reset filters", { variant: "primary", onClick: clearAll }) }),
    children: Grid(results.map(p => productCard(p)), { columns: { base: 1, sm: 2, lg: 3 }, gap: "md", alignItems: "start" })
  })
], { gap: "md" })

layout = Grid([GridItem(sidebar, { span: "1/4" }), GridItem(resultsArea, { span: "3/4" })], { gap: "lg", alignItems: "start" })
