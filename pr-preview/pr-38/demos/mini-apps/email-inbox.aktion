// Email Inbox — a master/detail mail client: a searchable, filterable message
// list on the left and the selected message (with reply box) on the right.
// Mark read/unread, star, archive and compose. Starting point for: any inbox,
// ticketing queue or notification centre.
// Uses: SplitView, $store({ persist }) mailbox, SearchBar + ToggleGroup filters, ChatBubble reply.
$app(Column([header, SplitView([listPane], [detailPane], { primaryWidth: "340px" })], { gap: "md", padding: "md" }))

mailbox = $store({
  persist: "inbox.mail",
  selected: "m1",
  messages: [
    { id: "m1", from: "Grace Hopper", email: "grace@navy.mil", subject: "Re: Compiler design review", preview: "I pushed the changes you asked for — the parser now…", body: "I pushed the changes you asked for — the parser now handles nested expressions and I added 40 tests. Can you take a look before the demo on Friday?", time: "2026-06-13T09:12:00", read: false, starred: true, folder: "inbox" },
    { id: "m2", from: "Stripe", email: "no-reply@stripe.com", subject: "Your June payout is on the way", preview: "A payout of $4,210.00 is expected to arrive…", body: "A payout of $4,210.00 is expected to arrive in your bank account by June 16. View the full breakdown in your dashboard.", time: "2026-06-13T07:40:00", read: false, starred: false, folder: "inbox" },
    { id: "m3", from: "Alan Turing", email: "alan@enigma.uk", subject: "Lunch tomorrow?", preview: "Fancy grabbing lunch near the office around noon?", body: "Fancy grabbing lunch near the office around noon? There's a new ramen place I've been meaning to try.", time: "2026-06-12T16:05:00", read: true, starred: false, folder: "inbox" },
    { id: "m4", from: "GitHub", email: "noreply@github.com", subject: "[aktion] 3 new pull requests", preview: "There are 3 pull requests awaiting your review…", body: "There are 3 pull requests awaiting your review in asfand-dev/aktion. The oldest has been open for 2 days.", time: "2026-06-12T11:22:00", read: true, starred: false, folder: "inbox" },
    { id: "m5", from: "Katherine Johnson", email: "kj@nasa.gov", subject: "Trajectory numbers", preview: "Attaching the recomputed figures for the launch window.", body: "Attaching the recomputed figures for the launch window. The margins look good — we have a 14-minute window.", time: "2026-06-11T14:48:00", read: true, starred: true, folder: "inbox" }
  ],
  select: (s, id) => { s.selected = id; s.messages = s.messages.map(m => m.id == id ? { ...m, read: true } : m) },
  toggleStar: (s, id) => { s.messages = s.messages.map(m => m.id == id ? { ...m, starred: !m.starred } : m) },
  toggleRead: (s, id) => { s.messages = s.messages.map(m => m.id == id ? { ...m, read: !m.read } : m) },
  archive: (s, id) => { s.messages = s.messages.map(m => m.id == id ? { ...m, folder: "archive" } : m) }
})

$search = ""
$filter = "inbox"
$reply = ""

filtered = mailbox.messages
  .filter(m => $filter == "starred" ? m.starred : $filter == "unread" ? (!m.read && m.folder == "inbox") : m.folder == $filter)
  .filter(m => $search == "" ? true : (m.from + m.subject + m.preview).toLowerCase().includes($search.toLowerCase()))

current = mailbox.messages.find(m => m.id == mailbox.selected)
unread = mailbox.messages.filter(m => !m.read && m.folder == "inbox").length

header = PageHeader("Inbox", {
  subtitle: `${unread} unread`,
  badge: Badge(`${mailbox.messages.filter(m => m.folder == "inbox").length} messages`, { tone: "primary", icon: "envelope" }),
  actions: [Button("Compose", { variant: "primary", icon: "pen-to-square", size: "sm", onClick: () => $toast.show("Compose window would open here", { tone: "info" }) })]
})

function messageRow(m) {
  return OnClick(Box([Row([
    Avatar(m.from, { size: "sm" }),
    StackItem(Column([
      Row([StackItem(Text(m.from, { variant: m.read ? "body" : "body-heavy" }), { grow: 1 }), Text($util.formatDate(m.time, "time"), { variant: "small", tone: "muted" })], { align: "center" }),
      Text(m.subject, { variant: m.read ? "small" : "small-heavy", tone: m.read ? "muted" : "default" }),
      Text(m.preview, { variant: "small", tone: "muted" })
    ], { gap: "2xs" }), { grow: 1 }),
    Show(m.starred, { children: Icon("star", { color: "var(--rui-color-warning)" }) })
  ], { gap: "sm", align: "start" })], {
    key: m.id,
    padding: "sm",
    border: m.id == mailbox.selected ? "strong" : "subtle",
    background: m.id == mailbox.selected ? "muted" : (m.read ? "surface" : "transparent"),
    sx: { borderRadius: "var(--rui-radius-md)", states: { hover: { background: "var(--rui-color-muted)" } } }
  }), { onClick: () => mailbox.select(m.id) })
}

listPane = Column([
  SearchBar("search", { placeholder: "Search mail…", value: $search }),
  ToggleGroup("filter", { items: [
    { value: "inbox", label: "Inbox" },
    { value: "unread", label: "Unread" },
    { value: "starred", label: "Starred" },
    { value: "archive", label: "Archive" }
  ], value: $filter, size: "sm" }),
  Show(filtered.length > 0, {
    fallback: EmptyState("Nothing here", { icon: "inbox", description: "This folder is empty." }),
    children: Column(filtered.map(m => messageRow(m)), { gap: "xs" })
  })
], { gap: "sm" })

detailPane = current
  ? Card([
      Row([
        StackItem(Column([
          Text(current.subject, { variant: "heading" }),
          Row([Avatar(current.from, { size: "sm" }), Column([Text(current.from, { variant: "small-heavy" }), Text(current.email, { variant: "small", tone: "muted" })], { gap: "none" }), Spacer(), Text($util.formatDate(current.time, "datetime"), { variant: "small", tone: "muted" })], { gap: "sm", align: "center" })
        ], { gap: "sm" }), { grow: 1 })
      ]),
      Row([
        IconButton(current.starred ? "star" : "regular:star", { label: "Star", variant: "ghost", size: "sm", onClick: () => mailbox.toggleStar(current.id) }),
        IconButton("envelope", { label: "Mark unread", variant: "ghost", size: "sm", onClick: () => mailbox.toggleRead(current.id) }),
        IconButton("box-archive", { label: "Archive", variant: "ghost", size: "sm", onClick: () => mailbox.archive(current.id) })
      ], { gap: "xs" }),
      Separator("horizontal"),
      Text(current.body),
      Separator("horizontal"),
      SectionHeader("Reply", { eyebrow: "RESPOND" }),
      TextArea("reply", { value: $reply, rows: 4, placeholder: `Reply to ${current.from}…` }),
      Row([
        Button("Send", { variant: "primary", icon: "paper-plane", onClick: () => { if ($reply.trim()) { $toast.success("Reply sent"); $reply = "" } }, disabled: !$reply.trim() }),
        Button("Discard", { variant: "ghost", onClick: () => { $reply = "" } })
      ], { gap: "sm" })
    ])
  : Center([EmptyState("Select a message", { icon: "envelope-open", description: "Pick an email from the list to read it." })], { minHeight: "50vh" })
