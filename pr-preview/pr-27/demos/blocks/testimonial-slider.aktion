// Testimonial Slider — a rotating quote carousel with prev/next controls,
// clickable dot indicators, autoplay that pauses on demand and an aggregate
// rating summary.
$app(Container([Column([head, slide, controls, summary], { gap: "lg" })], { size: "md" }))

quotes = [
  { quote: "Aktion let us replace a 6,000-line component library with a single streaming file. Our LLM features shipped in days, not months.", author: "Jordan Reyes", role: "Eng Lead, Globex", rating: 5 },
  { quote: "The reactivity model is refreshingly simple. One atom kind, and everything just updates. Onboarding new devs is trivial now.", author: "Priya Nair", role: "Staff Engineer, Initech", rating: 5 },
  { quote: "Theme switching at runtime sold our design team instantly. Same code looks great on light, dark and our brand palette.", author: "Marcus Webb", role: "Design Director, Hooli", rating: 4 },
  { quote: "We embedded the web component straight into our Vue app. Zero friction, no wrapper, instant rich UI from the model.", author: "Lena Fischer", role: "CTO, Umbrella", rating: 5 }
]

$i = 0
$playing = true
count = quotes.length

function go(n) { $i = (n + count) % count }
function next() { go($i + 1) }
function prev() { go($i - 1) }
function togglePlay() { $playing = !$playing }

$effect(() => {
  if ($playing) {
    const id = setInterval(() => { $i = ($i + 1) % count }, 4000)
    cleanup(() => clearInterval(id))
  }
}, [$playing])

current = quotes[$i]
avg = $util.round($util.avg(quotes.map(q => q.rating)), 1)

head = Center([Column([
  Badge("Loved by builders", { tone: "primary", icon: "heart" }),
  Text("What teams are saying", { variant: "title" })
], { gap: "xs", align: "center" })])

slide = Card([Column([
  Rating(current.rating, { max: 5, readonly: true }),
  Quote(current.quote, { cite: `${current.author} — ${current.role}`, tone: "primary" }),
  Row([Avatar(current.author), Column([Text(current.author, { variant: "body-heavy" }), Text(current.role, { variant: "small", tone: "muted" })], { gap: "xs" })], { gap: "sm", align: "center" })
], { gap: "md" })])

dots = Row(quotes.map((q, idx) => IconButton(idx == $i ? "circle" : "circle-dot", {
  label: `Go to ${idx + 1}`, variant: "ghost", size: "xs", onClick: () => go(idx)
})), { gap: "xs", align: "center" })

controls = Row([
  IconButton("chevron-left", { label: "Previous", variant: "secondary", onClick: prev }),
  Spacer(),
  dots,
  IconButton($playing ? "pause" : "play", { label: "Toggle autoplay", variant: "ghost", onClick: togglePlay }),
  Spacer(),
  IconButton("chevron-right", { label: "Next", variant: "secondary", onClick: next })
], { align: "center" })

summary = Center([Row([
  Rating(avg, { max: 5, readonly: true, size: "sm" }),
  Text(`${avg} average from ${count} reviews`, { variant: "small", tone: "muted" })
], { gap: "sm", align: "center" })])
