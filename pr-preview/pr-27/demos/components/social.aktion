// Social — 10 reusable people & social components.
$app(Column([header, Column(demos, { gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Social & people", { subtitle: "10 reusable social components", badge: Badge("Components", { tone: "primary", icon: "users" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }

// 1 — avatar with status ring
function UserAvatar(name, { src, status, size = "md" } = {}) {
  return Avatar(name, { src, status, size })
}

// 2 — overlapping avatar stack with +N
function AvatarStack({ people = [], max = 4 } = {}) {
  return AvatarGroup({ items: people, max })
}

// 3 — inline person chip
function UserChip(name, { role, status } = {}) {
  return PersonChip(name, { role, status })
}

// 4 — comment with toolbar actions
function CommentItem(author, { body = "", time = "", avatarSrc } = {}) {
  return Comment(author, { body, time, avatarSrc, actions: [Button("Reply", { variant: "ghost", size: "sm", icon: "reply" }), Button("Like", { variant: "ghost", size: "sm", icon: "heart" })] })
}

// 5 — chat bubble (left/right)
function ChatMessage(author, { body = "", time = "", me = false } = {}) {
  return ChatBubble(author, { body, time, from: me ? "me" : "agent" })
}

// 6 — like/reaction bar with live counts
function ReactionBar({ likes = 0, comments = 0 } = {}) {
  const [liked, setLiked] = $state(false)
  const [n, setN] = $state(likes)
  return Row([
    Button(String(n), { variant: liked ? "primary" : "ghost", size: "sm", icon: "heart", onClick: () => { setLiked(!liked); setN(liked ? n - 1 : n + 1) } }),
    Button(String(comments), { variant: "ghost", size: "sm", icon: "comment" }),
    Button("Share", { variant: "ghost", size: "sm", icon: "share-nodes" })
  ], { gap: "xs", align: "center" })
}

// 7 — follow / following toggle button
function FollowButton(name, {} = {}) {
  const [following, setFollowing] = $state(false)
  return Button(following ? "Following" : "Follow", { variant: following ? "secondary" : "primary", icon: following ? "check" : "user-plus", size: "sm", onClick: () => setFollowing(!following) })
}

// 8 — notification list item
function NotificationItem(title, { message = "", time = "", unread = false, tone = "primary" } = {}) {
  return Notification(title, { message, time, unread, tone, icon: "bell" })
}

// 9 — activity log entry
function ActivityItem(actor, { action = "", target = "", time = "", icon = "user" } = {}) {
  return Row([Avatar(actor, { size: "sm" }), StackItem(Text(`${actor} ${action} ${target}`, { variant: "body" }), { grow: 1 }), Text(time, { variant: "small", tone: "muted" })], { gap: "sm", align: "center" })
}

// 10 — testimonial card
function TestimonialCard(quote, { author = "", role = "", rating = 5 } = {}) {
  return Testimonial(quote, { author, role, rating })
}

people = [{ name: "Ada Lovelace" }, { name: "Linus Torvalds" }, { name: "Grace Hopper" }, { name: "Donald Knuth" }, { name: "Barbara Liskov" }]
demos = [
  Demo("UserAvatar", "Avatar with status", Row([UserAvatar("Ada Lovelace", { status: "online" }), UserAvatar("Linus Torvalds", { status: "busy" }), UserAvatar("Grace Hopper", { status: "away", size: "lg" })], { gap: "md", align: "center" })),
  Demo("AvatarStack", "Overlapping avatars + N", AvatarStack({ people, max: 3 })),
  Demo("UserChip", "Inline person chip", Row([UserChip("Ada Lovelace", { role: "Engineering Lead", status: "online" }), UserChip("Grace Hopper", { role: "Director" })], { gap: "md", wrap: true })),
  Demo("CommentItem", "Comment with actions", CommentItem("Linus Torvalds", { body: "Looks good — can we ship this Friday?", time: "2h ago" })),
  Demo("ChatMessage", "Chat bubbles", Column([ChatMessage("You", { body: "Summarise yesterday's standup.", time: "9:01", me: true }), ChatMessage("Assistant", { body: "Three updates: design shipped, auth moved to next sprint, mobile build green.", time: "9:01" })], { gap: "sm" })),
  Demo("ReactionBar", "Like/comment/share bar", ReactionBar({ likes: 24, comments: 5 })),
  Demo("FollowButton", "Follow ↔ Following", Row([FollowButton("Ada"), FollowButton("Grace")], { gap: "md" })),
  Demo("NotificationItem", "Notification entry", Column([NotificationItem("New trial signup", { message: "Acme Co started a Pro trial.", time: "12m ago", unread: true }), NotificationItem("Storage 80% full", { message: "Consider archiving old projects.", time: "1h ago", tone: "warning" })], { gap: "sm" })),
  Demo("ActivityItem", "Activity feed row", Column([ActivityItem("Asha", { action: "renewed", target: "Team plan", time: "2h ago" }), ActivityItem("Linus", { action: "added", target: "3 seats", time: "yesterday" })], { gap: "sm" })),
  Demo("TestimonialCard", "Quote + author + rating", TestimonialCard("Aktion lets us ship rich UIs without juggling templates.", { author: "Jordan Reyes", role: "Engineering Lead, Globex", rating: 5 }))
]
