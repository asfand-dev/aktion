// Comment Thread — a discussion block with a composer, posting new comments,
// nested replies, like toggles with live counts and relative timestamps. State
// is a flat list keyed by parent for one level of threading.
$app(Container([Column([header, composer, thread], { gap: "lg" })], { size: "md" }))

$comments = [
  { id: "c1", parent: null, author: "Ada Lovelace", body: "This streaming approach is brilliant — the UI fills in as the model thinks.", time: $util.addHours($util.now(), -3), likes: 12, liked: false },
  { id: "c2", parent: "c1", author: "Linus Torvalds", body: "Agreed. No more blank loading screens.", time: $util.addHours($util.now(), -2), likes: 4, liked: false },
  { id: "c3", parent: null, author: "Grace Hopper", body: "Does it work behind a strict CSP?", time: $util.addHours($util.now(), -1), likes: 2, liked: false }
]
$draft = ""
$replyTo = null
$replyDraft = ""

me = "You"
roots = $comments.filter(c => c.parent == null)
repliesOf = id => $comments.filter(c => c.parent == id)

function post() {
  if (!$draft.trim()) return
  $comments = [...$comments, { id: crypto.randomUUID(), parent: null, author: me, body: $draft.trim(), time: $util.now(), likes: 0, liked: false }]
  $draft = ""
}
function startReply(id) { $replyTo = id; $replyDraft = "" }
function cancelReply() { $replyTo = null; $replyDraft = "" }
function postReply(id) {
  if (!$replyDraft.trim()) return
  $comments = [...$comments, { id: crypto.randomUUID(), parent: id, author: me, body: $replyDraft.trim(), time: $util.now(), likes: 0, liked: false }]
  $replyTo = null
  $replyDraft = ""
}
function toggleLike(id) {
  $comments = $comments.map(c => c.id == id ? { ...c, liked: !c.liked, likes: c.liked ? c.likes - 1 : c.likes + 1 } : c)
}

header = PageHeader("Discussion", { subtitle: `${$comments.length} ${$util.plural($comments.length, "comment")}`, breadcrumbs: false })

composer = Card([Row([
  Avatar(me),
  StackItem(Column([
    TextArea("draft", { value: $draft, rows: 2, placeholder: "Add to the discussion…" }),
    Row([Spacer(), Button("Comment", { variant: "primary", icon: "paper-plane", disabled: !$draft.trim(), onClick: post })], { align: "center" })
  ], { gap: "sm" }), { grow: 1 })
], { gap: "sm", align: "start" })])

function commentCard(c, isReply) {
  return Box([Column([
    Row([
      Avatar(c.author, { size: isReply ? "xs" : "sm" }),
      StackItem(Column([
        Row([Text(c.author, { variant: "body-heavy" }), Text($util.formatDate(c.time, "relative"), { variant: "small", tone: "muted" })], { gap: "sm", align: "center" }),
        Text(c.body)
      ], { gap: "xs" }), { grow: 1 })
    ], { gap: "sm", align: "start" }),
    Row([
      Button(String(c.likes), { variant: c.liked ? "primary" : "ghost", size: "xs", icon: "heart", onClick: () => toggleLike(c.id) }),
      isReply ? null : Button("Reply", { variant: "ghost", size: "xs", icon: "reply", onClick: () => startReply(c.id) })
    ], { gap: "xs", align: "center" })
  ], { gap: "sm" })], { padding: "sm", border: "subtle", background: "surface" })
}

function replyBox(id) {
  return Box([Row([
    Avatar(me, { size: "xs" }),
    StackItem(Column([
      Input("replyDraft", { value: $replyDraft, placeholder: "Write a reply…" }),
      Row([Spacer(), Button("Cancel", { variant: "ghost", size: "xs", onClick: cancelReply }), Button("Reply", { variant: "primary", size: "xs", icon: "reply", disabled: !$replyDraft.trim(), onClick: () => postReply(id) })], { gap: "xs", align: "center" })
    ], { gap: "xs" }), { grow: 1 })
  ], { gap: "sm", align: "start" })], { padding: "sm" })
}

function threadItem(c) {
  return Column([
    commentCard(c, false),
    Box([Column([
      ...repliesOf(c.id).map(r => commentCard(r, true)),
      $replyTo == c.id ? replyBox(c.id) : null
    ], { gap: "sm" })], { padding: "sm" })
  ], { gap: "sm" })
}

thread = Column(roots.map(c => threadItem(c)), { gap: "md" })
