// Checkout Form — a two-column checkout: contact + shipping + delivery method +
// payment fields with light validation, beside a sticky order summary. Placing
// the order swaps in a confirmation state.
$app(Container([Column([header, body], { gap: "lg" })], { size: "lg" }))

$email = ""
$name = ""
$address = ""
$city = ""
$zip = ""
$delivery = "standard"
$card = ""
$exp = ""
$cvc = ""
$placed = false

cart = [
  { name: "Aurora Hoodie", price: 78, qty: 1 },
  { name: "Voyager Mug", price: 24, qty: 2 }
]
deliveryOptions = {
  standard: { label: "Standard (5-7 days)", price: 0 },
  express: { label: "Express (2-3 days)", price: 12 },
  overnight: { label: "Overnight", price: 28 }
}
money = n => $util.format(n, "currency", "USD")

subtotal = $util.sum(cart.map(i => i.price * i.qty))
ship = deliveryOptions[$delivery].price
tax = Math.round(subtotal * 0.08)
total = subtotal + ship + tax

emailValid = $email.includes("@") && $email.includes(".")
cardDigits = $card.split(" ").join("").length
canPlace = emailValid && $name.length > 1 && $address.length > 3 && $city.length > 1 && $zip.length >= 4 && cardDigits >= 15 && $exp.length >= 4 && $cvc.length >= 3

function placeOrder() {
  if (!canPlace) return
  $placed = true
}

header = PageHeader("Checkout", { subtitle: "Secure payment · 256-bit encryption", breadcrumbs: false })

contactCard = Card([Column([
  SectionHeader("Contact", { eyebrow: "1" }),
  FormControl("Email", { field: Input("email", { type: "email", value: $email, placeholder: "you@example.com" }), hint: $email.length > 0 && !emailValid ? "Enter a valid email." : null })
], { gap: "md" })])

shippingCard = Card([Column([
  SectionHeader("Shipping address", { eyebrow: "2" }),
  FormControl("Full name", { field: Input("name", { value: $name, placeholder: "Ada Lovelace" }) }),
  FormControl("Street address", { field: Input("address", { value: $address, placeholder: "123 Maple Street" }) }),
  Grid([
    FormControl("City", { field: Input("city", { value: $city, placeholder: "London" }) }),
    FormControl("ZIP / Postcode", { field: Input("zip", { value: $zip, placeholder: "SW1A" }) })
  ], { columns: 2, gap: "md" })
], { gap: "md" })])

deliveryCard = Card([Column([
  SectionHeader("Delivery method", { eyebrow: "3" }),
  Column(Object.keys(deliveryOptions).map(k => OnClick(
    Box([Row([
      Icon($delivery == k ? "circle-dot" : "circle", { color: $delivery == k ? "var(--rui-color-primary)" : null }),
      StackItem(Text(deliveryOptions[k].label, { variant: "body-heavy" }), { grow: 1 }),
      Text(deliveryOptions[k].price == 0 ? "Free" : money(deliveryOptions[k].price), { tone: "muted" })
    ], { align: "center", gap: "sm" })], { padding: "sm", border: "subtle", background: $delivery == k ? "primary" : "surface" }),
    { onClick: () => { $delivery = k } }
  )), { gap: "sm" })
], { gap: "md" })])

paymentCard = Card([Column([
  SectionHeader("Payment", { eyebrow: "4" }),
  FormControl("Card number", { field: Input("card", { value: $card, placeholder: "4242 4242 4242 4242" }) }),
  Grid([
    FormControl("Expiry", { field: Input("exp", { value: $exp, placeholder: "MM/YY" }) }),
    FormControl("CVC", { field: Input("cvc", { value: $cvc, placeholder: "123" }) })
  ], { columns: 2, gap: "md" }),
  Row([Icon("lock", { size: "sm" }), Text("Your payment details are encrypted.", { variant: "small", tone: "muted" })], { gap: "xs", align: "center" })
], { gap: "md" })])

formCol = Column([contactCard, shippingCard, deliveryCard, paymentCard], { gap: "lg" })

summaryCol = Sticky(Card([Column([
  SectionHeader("Order summary"),
  Column(cart.map(i => Row([Text(`${i.qty} × ${i.name}`), Spacer(), Text(money(i.price * i.qty))], { align: "center" })), { gap: "xs" }),
  Separator("horizontal"),
  Row([Text("Subtotal", { tone: "muted" }), Spacer(), Text(money(subtotal))], { align: "center" }),
  Row([Text("Shipping", { tone: "muted" }), Spacer(), Text(ship == 0 ? "Free" : money(ship))], { align: "center" }),
  Row([Text("Tax", { tone: "muted" }), Spacer(), Text(money(tax))], { align: "center" }),
  Separator("horizontal"),
  Row([Text("Total", { variant: "body-heavy" }), Spacer(), Text(money(total), { variant: "title", tone: "primary" })], { align: "center" }),
  Button("Place order", { variant: "primary", icon: "lock", fullWidth: true, disabled: !canPlace, onClick: placeOrder })
], { gap: "sm" })]), { offset: "16px" })

checkoutView = Grid([GridItem(formCol, { span: "2/3" }), GridItem(summaryCol, { span: "1/3" })], { gap: "lg", alignItems: "start" })

confirmView = Card([Center([Column([
  Icon("circle-check", { size: "lg", color: "var(--rui-color-success)" }),
  SectionHeader("Order confirmed!", { subtitle: `Thanks, ${$name}. A receipt is on its way to ${$email}.` }),
  DescriptionList([
    DescriptionItem("Order total", { value: money(total), icon: "receipt" }),
    DescriptionItem("Delivery", { value: deliveryOptions[$delivery].label, icon: "truck" }),
    DescriptionItem("Ships to", { value: `${$address}, ${$city}`, icon: "location-dot" })
  ]),
  Button("Track your order", { variant: "primary", icon: "map-location-dot" })
], { gap: "md", align: "center" })], { minHeight: "260px" })])

body = Show($placed, { fallback: checkoutView, children: confirmView })
