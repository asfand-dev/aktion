// Currency Converter — convert between world currencies using live mid-market
// rates from the free open.er-api.com (no key). Swap currencies, see the
// inverse rate, and scan a quick conversion table. Starting point for: any
// converter, pricing or finance tool backed by a rates API.
// Uses: $query keyed by base currency, Async states, Select pickers, computed conversion.
$app(Column([header, converter, quickTable], { gap: "lg", padding: "md" }))

$amount = 100
$from = "USD"
$to = "EUR"

currencies = [
  { code: "USD", name: "US Dollar" }, { code: "EUR", name: "Euro" },
  { code: "GBP", name: "British Pound" }, { code: "JPY", name: "Japanese Yen" },
  { code: "CHF", name: "Swiss Franc" }, { code: "CAD", name: "Canadian Dollar" },
  { code: "AUD", name: "Australian Dollar" }, { code: "CNY", name: "Chinese Yuan" },
  { code: "INR", name: "Indian Rupee" }, { code: "AED", name: "UAE Dirham" },
  { code: "BRL", name: "Brazilian Real" }, { code: "SGD", name: "Singapore Dollar" }
]
nameOf = code => (currencies.find(c => c.code == code) || { name: code }).name

$rates = $query({ url: `https://open.er-api.com/v6/latest/${$from}`, key: `rates-${$from}`, ttl: 3600000 })

rateMap = $rates.data && $rates.data.rates ? $rates.data.rates : null
rate = rateMap ? (rateMap[$to] ?? 0) : 0
converted = $amount * rate
inverse = rate > 0 ? 1 / rate : 0
updated = $rates.data && $rates.data.time_last_update_utc ? $rates.data.time_last_update_utc : ""

fmt = (n, code) => $util.currency(n, code)

function swap() { const t = $from; $from = $to; $to = t }

header = PageHeader("Currency Converter", {
  subtitle: rate > 0 ? `1 ${$from} = ${$util.round(rate, 4)} ${$to}` : "Live mid-market rates",
  badge: Badge("Live rates", { tone: "success", icon: "money-bill-transfer" })
})

picker = Async($rates, {
  loading: LoadingState("Fetching rates…", { description: `Loading the latest ${$from} rates` }),
  error: ErrorState("Couldn't load rates", { description: "The rates service may be busy — try again.", actions: [Button("Retry", { variant: "primary", icon: "rotate-right", onClick: () => $rates.refetch() })] }),
  data: Column([
    Grid([
      Column([
        FormControl("Amount", { field: NumberInput("amount", { value: $amount, min: 0, step: 10 }) }),
        FormControl("From", { field: Select("from", { items: currencies.map(c => SelectItem(c.code, { label: `${c.code} · ${c.name}` })), value: $from }) })
      ], { gap: "sm" }),
      Center([IconButton("right-left", { label: "Swap currencies", variant: "secondary", size: "lg", onClick: swap })]),
      Column([
        FormControl("Converted", { field: Box([Text(`${$util.round(converted, 2)} ${$to}`, { variant: "body-heavy" })], { padding: "sm", border: "subtle", background: "muted" }) }),
        FormControl("To", { field: Select("to", { items: currencies.map(c => SelectItem(c.code, { label: `${c.code} · ${c.name}` })), value: $to }) })
      ], { gap: "sm" })
    ], { columns: { base: 1, md: 3 }, gap: "md", alignItems: "center" }),
    Center([Text(`${fmt($amount, $from)}  =  ${fmt(converted, $to)}`, { variant: "title" })]),
    Grid([
      StatCard(`1 ${$from}`, { value: `${$util.round(rate, 4)} ${$to}`, icon: "arrow-right-arrow-left", tone: "primary" }),
      StatCard(`1 ${$to}`, { value: `${$util.round(inverse, 4)} ${$from}`, icon: "arrow-right-arrow-left", tone: "info" }),
      StatCard("Updated", { value: updated ? $util.formatDate(updated, "date") : "—", icon: "clock", tone: "default" })
    ], { columns: { base: 1, sm: 3 }, gap: "md" })
  ], { gap: "lg" })
})

converter = Card([SectionHeader("Convert", { eyebrow: "EXCHANGE" }), picker])

quickRows = currencies.filter(c => c.code != $from)
quickTable = Show(rateMap != null, {
  children: Card([
    SectionHeader(`1 ${$from} in other currencies`, { eyebrow: "QUICK TABLE" }),
    Table([
      Col("Currency", quickRows.map(c => Row([Text(c.code, { variant: "body-heavy" }), Text(c.name, { variant: "small", tone: "muted" })], { gap: "sm", align: "center" }))),
      Col(`Rate (per ${$from})`, quickRows.map(c => rateMap && rateMap[c.code] ? String($util.round(rateMap[c.code], 4)) : "—"), { align: "right" }),
      Col("100 " + $from, quickRows.map(c => rateMap && rateMap[c.code] ? fmt(100 * rateMap[c.code], c.code) : "—"), { align: "right" })
    ], { striped: true })
  ])
})
