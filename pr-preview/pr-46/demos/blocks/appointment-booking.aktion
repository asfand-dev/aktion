// Appointment Booking — pick a day from the next week, choose an available time
// slot (booked ones are disabled), enter details and confirm. Slots and the
// summary update live; confirming shows a booking receipt.
$app(Container([Column([header, body], { gap: "lg" })], { size: "md" }))

today = $util.now()
days = $util.range(0, 6).map(n => {
  const ms = $util.addDays(today, n)
  return { offset: n, iso: $util.formatDate(ms, "YYYY-MM-DD"), label: n == 0 ? "Today" : $util.formatDate(ms, "ddd"), date: $util.formatDate(ms, "MMM D") }
})

slots = ["09:00", "09:30", "10:00", "11:00", "13:00", "13:30", "14:00", "15:30", "16:00"]
booked = { "0-10:00": true, "0-13:00": true, "1-09:00": true, "2-15:30": true, "3-11:00": true }

$day = 0
$slot = null
$name = ""
$email = ""
$reason = "consult"
$confirmed = false

isBooked = s => booked[`${$day}-${s}`] === true
emailValid = $email.includes("@") && $email.includes(".")
canConfirm = $slot != null && $name.length > 1 && emailValid
chosenDay = days.find(d => d.offset == $day)

function pickDay(n) { $day = n; $slot = null }
function pickSlot(s) { if (!isBooked(s)) $slot = s }
function confirm() { if (canConfirm) $confirmed = true }
function rebook() { $confirmed = false; $slot = null }

header = PageHeader("Book a session", { subtitle: "30-minute slots · times shown in your local zone", breadcrumbs: false })

dayPicker = Card([Column([
  SectionHeader("Choose a day", { eyebrow: "1" }),
  Grid(days.map(d => OnClick(
    Box([Center([Column([Text(d.label, { variant: "small-heavy" }), Text(d.date, { variant: "small", tone: "muted" })], { gap: "xs", align: "center" })])], { padding: "sm", border: "subtle", background: $day == d.offset ? "primary" : "surface" }),
    { onClick: () => pickDay(d.offset) }
  )), { columns: { base: 4, sm: 7 }, gap: "xs" })
], { gap: "md" })])

slotPicker = Card([Column([
  SectionHeader("Available times", { eyebrow: "2", subtitle: chosenDay ? `${chosenDay.label}, ${chosenDay.date}` : "" }),
  Grid(slots.map(s => Button(s, {
    variant: $slot == s ? "primary" : "secondary", size: "sm", disabled: isBooked(s),
    icon: isBooked(s) ? "ban" : null, onClick: () => pickSlot(s)
  })), { columns: { base: 3, sm: 4 }, gap: "xs" }),
  Row([StatusDot("Available", { tone: "success" }), StatusDot("Booked", { tone: "default" })], { gap: "lg" })
], { gap: "md" })])

details = Card([Column([
  SectionHeader("Your details", { eyebrow: "3" }),
  FormControl("Name", { field: Input("name", { value: $name, placeholder: "Ada Lovelace" }) }),
  FormControl("Email", { field: Input("email", { type: "email", value: $email, placeholder: "you@example.com" }), hint: $email.length > 0 && !emailValid ? "Enter a valid email." : null }),
  FormControl("Reason", { field: Select("reason", { items: [SelectItem("consult", { label: "Consultation" }), SelectItem("demo", { label: "Product demo" }), SelectItem("support", { label: "Support call" })], value: $reason }) })
], { gap: "md" })])

summary = Card([Row([
  Icon("calendar-check", { size: "lg", color: "var(--rui-color-primary)" }),
  StackItem(Column([
    Text($slot ? `${chosenDay.label} at ${$slot}` : "No slot selected", { variant: "body-heavy" }),
    Text($slot ? `${chosenDay.date} · 30 minutes` : "Pick a day and time above", { variant: "small", tone: "muted" })
  ], { gap: "xs" }), { grow: 1 }),
  Button("Confirm booking", { variant: "primary", icon: "check", disabled: !canConfirm, onClick: confirm })
], { align: "center", gap: "md" })])

bookingView = Column([dayPicker, slotPicker, details, summary], { gap: "lg" })

receipt = Card([Column([
  Icon("calendar-check", { size: "lg", color: "var(--rui-color-success)" }),
  SectionHeader("You're booked!", { subtitle: `See you ${chosenDay.label} at ${$slot}` }),
  DescriptionList([
    DescriptionItem("Name", { value: $name, icon: "user" }),
    DescriptionItem("When", { value: `${chosenDay.date} at ${$slot}`, icon: "clock" }),
    DescriptionItem("Type", { value: $util.capitalize($reason), icon: "tag" }),
    DescriptionItem("Confirmation", { value: `Sent to ${$email}`, icon: "envelope" })
  ]),
  Row([Button("Add to calendar", { variant: "secondary", icon: "calendar-plus" }), Button("Book another", { variant: "ghost", onClick: rebook })], { gap: "sm" })
], { gap: "md", align: "center" })])

body = Show($confirmed, { fallback: bookingView, children: receipt })
