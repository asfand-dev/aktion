// Charts — 12 reusable chart & visualization components.
$app(Column([header, Grid(demos, { columns: { base: 1, lg: 2 }, gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Charts", { subtitle: "12 reusable chart components", badge: Badge("Components", { tone: "primary", icon: "chart-column" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }

// 1 — multi-series line chart
function TrendLine(title, { labels = [], series = [] } = {}) {
  return LineChart(labels, { series: series.map(s => Series(s.name, { values: s.values })), title })
}

// 2 — grouped bar chart
function BarSeries(title, { labels = [], series = [] } = {}) {
  return BarChart(labels, { series: series.map(s => Series(s.name, { values: s.values })), title })
}

// 3 — donut / pie chart
function DonutChart(title, { labels = [], values = [] } = {}) {
  return PieChart(labels, { values, title, valueFormat: "percent" })
}

// 4 — filled area trend
function AreaTrend(title, { labels = [], values = [] } = {}) {
  return LineChart(labels, { series: [Series("Value", { values })], title, filled: true })
}

// 5 — inline sparkline
function MiniSpark({ data = [], tone = "primary" } = {}) {
  return Sparkline(data, { tone })
}

// 6 — half-doughnut gauge
function ScoreGauge(label, { value = 0, min = 0, max = 100, tone = "primary" } = {}) {
  return Gauge(value, { min, max, caption: label, tone, size: "lg" })
}

// 7 — circular completion ring
function CompletionRing(label, { value = 0, tone = "primary" } = {}) {
  return ProgressRing(value, { tone, size: "lg", caption: label })
}

// 8 — multi-axis radar
function SkillRadar(title, { axes = [], series = [] } = {}) {
  return RadarChart(axes, { series: series.map(s => Series(s.name, { values: s.values })), title })
}

// 9 — XY scatter plot
function CorrelationScatter(title, { series = [], xLabel = "", yLabel = "" } = {}) {
  return ScatterChart({ series: series.map(s => Series(s.name, { values: s.points })), xLabel, yLabel, title })
}

// 10 — color-intensity heatmap
function ActivityHeatmap(title, { xLabels = [], yLabels = [], values = [], tone = "primary" } = {}) {
  return Heatmap(xLabels, { yLabels, values, title, tone })
}

// 11 — frequency histogram
function Distribution(title, { values = [], binCount = 8 } = {}) {
  return Histogram({ values, binCount, title })
}

// 12 — value + delta + sparkline composite
function KpiWithTrend(label, value, { data = [], delta = "+0%", tone = "success" } = {}) {
  return Box([Column([
    Row([Text(label, { variant: "small-heavy", tone: "muted" }), Spacer(), Badge(delta, { tone, size: "sm", icon: "arrow-trend-up" })], { align: "center" }),
    Text(value, { variant: "title" }),
    Sparkline(data, { tone })
  ], { gap: "sm" })], { padding: "md" })
}

months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]
demos = [
  Demo("TrendLine", "Multi-series line", TrendLine("Traffic", { labels: months, series: [{ name: "Organic", values: [40, 52, 65, 78, 92, 105] }, { name: "Paid", values: [10, 14, 18, 24, 30, 36] }] })),
  Demo("BarSeries", "Grouped bars", BarSeries("Revenue vs cost", { labels: months, series: [{ name: "Revenue", values: [30, 42, 38, 55, 60, 72] }, { name: "Cost", values: [18, 22, 20, 28, 30, 33] }] })),
  Demo("DonutChart", "Share breakdown", DonutChart("Traffic source", { labels: ["Organic", "Referral", "Paid", "Direct"], values: [48, 22, 18, 12] })),
  Demo("AreaTrend", "Filled area", AreaTrend("Signups", { labels: months, values: [120, 145, 138, 180, 210, 260] })),
  Demo("MiniSpark", "Inline sparkline", Column([Row([Text("MRR", { variant: "body-heavy" }), Spacer(), MiniSpark({ data: [10, 12, 11, 15, 18, 22], tone: "success" })], { align: "center" }), Row([Text("Errors", { variant: "body-heavy" }), Spacer(), MiniSpark({ data: [8, 6, 7, 4, 3, 2], tone: "danger" })], { align: "center" })], { gap: "sm" })),
  Demo("ScoreGauge", "Threshold gauge", ScoreGauge("Page speed", { value: 86, tone: "success" })),
  Demo("CompletionRing", "Completion ring", CompletionRing("Quota used", { value: 64 })),
  Demo("SkillRadar", "Capability radar", SkillRadar("Vendor scorecard", { axes: ["Speed", "Quality", "Cost", "Support", "Trust"], series: [{ name: "Atlas", values: [80, 70, 60, 75, 85] }, { name: "Northwind", values: [60, 85, 70, 65, 80] }] })),
  Demo("CorrelationScatter", "XY scatter", CorrelationScatter("Sessions vs conversions", { xLabel: "Sessions", yLabel: "Conversions", series: [{ name: "Cohort A", points: [{ x: 1, y: 2 }, { x: 2, y: 4 }, { x: 3, y: 5 }, { x: 4, y: 7 }] }] })),
  Demo("ActivityHeatmap", "Intensity matrix", ActivityHeatmap("Office capacity", { xLabels: ["Mon", "Tue", "Wed", "Thu", "Fri"], yLabels: ["9am", "12pm", "3pm", "6pm"], values: [[3, 4, 5, 3, 2], [8, 9, 11, 7, 5], [12, 14, 16, 13, 10], [6, 7, 9, 10, 12]] })),
  Demo("Distribution", "Frequency histogram", Distribution("Response times", { values: [84, 112, 78, 95, 110, 102, 88, 124, 90, 116, 95, 130, 70, 99, 105, 118], binCount: 6 })),
  Demo("KpiWithTrend", "Composite KPI", KpiWithTrend("Active users", "2,184", { data: [10, 12, 9, 14, 18, 22], delta: "+18%" }))
]
