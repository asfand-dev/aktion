// Workout Log — log lifts per day, watch weekly volume build, and keep a personal-records board.
// Starting point for: fitness apps, practice/skill loggers, any quantified-self tool.
// Uses: $store({ persist, history }), $form, BarChart weekly volume, Metric countUp PRs.
$app(Column([header, kpis, body, logCard], { gap: "lg", padding: "md" }))

exercises = ["Squat", "Bench press", "Deadlift", "Overhead press", "Row"]
days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

gym = $store({
  persist: "workout.log",
  history: 30,
  sets: [
    { id: "s1", day: 0, exercise: "Squat",          weight: 100, reps: 5 },
    { id: "s2", day: 0, exercise: "Squat",          weight: 100, reps: 5 },
    { id: "s3", day: 0, exercise: "Bench press",    weight: 70,  reps: 8 },
    { id: "s4", day: 2, exercise: "Deadlift",       weight: 140, reps: 3 },
    { id: "s5", day: 2, exercise: "Row",            weight: 60,  reps: 10 },
    { id: "s6", day: 4, exercise: "Bench press",    weight: 72.5, reps: 6 },
    { id: "s7", day: 4, exercise: "Overhead press", weight: 45,  reps: 8 }
  ],
  add:    (s, x) => { s.sets = [...s.sets, x] },
  remove: (s, id) => { s.sets = s.sets.filter(x => x.id != id) }
})

todayIdx = (new Date().getDay() + 6) % 7

addForm = $form({
  values: { exercise: "Squat", weight: 60, reps: 5 },
  rules: {
    weight: [$util.rules.min(1, "Add some weight")],
    reps:   [$util.rules.min(1, "At least one rep")]
  },
  onSubmit: (v) => {
    gym.add({ id: $util.uuid(), day: todayIdx, exercise: v.exercise, weight: Number(v.weight), reps: Number(v.reps) })
  }
})

volume = s => s.weight * s.reps
volumeByDay = days.map((d, i) => Math.round($util.sum(gym.sets.filter(s => s.day == i).map(s => volume(s)))))
totalVolume = $util.sum(volumeByDay)
prFor = e => {
  const lifts = gym.sets.filter(s => s.exercise == e)
  return lifts.length > 0 ? Math.max(...lifts.map(s => s.weight)) : 0
}
trainedDays = days.filter((d, i) => gym.sets.some(s => s.day == i)).length

header = PageHeader("Workout Log", {
  subtitle: "This week's training — sets persist in your browser",
  badge: Badge(`${gym.sets.length} sets`, { tone: "primary", icon: "dumbbell" }),
  actions: [
    Button("Undo", { variant: "ghost", icon: "rotate-left", size: "sm", onClick: () => gym.undo(), disabled: !gym.canUndo }),
    Button("Redo", { variant: "ghost", icon: "rotate-right", size: "sm", onClick: () => gym.redo(), disabled: !gym.canRedo })
  ]
})

kpis = Stats([
  StatCard("Weekly volume", { value: `${$util.format(totalVolume, "number")} kg`, icon: "weight-hanging", tone: "primary" }),
  StatCard("Days trained", { value: `${trainedDays}/7`, icon: "calendar-check", tone: "success" }),
  StatCard("Sets logged", { value: String(gym.sets.length), icon: "list-ol", tone: "info" })
])

chartCard = Card([
  SectionHeader("Volume by day", { eyebrow: "KG × REPS" }),
  BarChart(days, { series: [Series("Volume (kg)", { values: volumeByDay })] })
], { animate: "fade-up" })

prCard = Card([
  SectionHeader("Personal records", { eyebrow: "TOP SINGLE-SET WEIGHT" }),
  MetricStrip(exercises.filter(e => prFor(e) > 0).map(e => Metric(`${prFor(e)}`, { label: e, countUp: true })), { columns: 3 })
], { animate: { preset: "fade-up", delay: 80 } })

addCard = Card([
  SectionHeader(`Log a set — ${days[todayIdx]}`, { eyebrow: "TODAY" }),
  FormControl("Exercise", { field: Select("exercise", { items: exercises.map(e => SelectItem(e, { label: e })), value: addForm.values.exercise }) }),
  Grid([
    FormControl("Weight (kg)", { field: NumberInput("weight", { value: addForm.values.weight, min: 0, step: 2.5, error: addForm.errors.weight }) }),
    FormControl("Reps", { field: NumberInput("reps", { value: addForm.values.reps, min: 1, step: 1, error: addForm.errors.reps }) })
  ], { columns: 2, gap: "md" }),
  Button("Log set", { variant: "primary", icon: "plus", fullWidth: true, onClick: () => addForm.submit() })
], { animate: { preset: "fade-up", delay: 160 } })

body = Grid([chartCard, prCard, addCard], { columns: { base: 1, lg: 3 }, gap: "lg", alignItems: "start" })

setsToday = gym.sets.filter(s => s.day == todayIdx)
logCard = Card([
  SectionHeader(`Today's sets (${days[todayIdx]})`, { eyebrow: "SESSION" }),
  Show(setsToday.length > 0, {
    fallback: EmptyState("Rest day so far", { description: "Log your first set above — undo has your back.", icon: "couch" }),
    children: Table([
      Col("Exercise", { values: setsToday.map(s => Text(s.exercise, { variant: "body-heavy" })) }),
      Col("Weight", { align: "right", values: setsToday.map(s => `${s.weight} kg`) }),
      Col("Reps", { align: "right", values: setsToday.map(s => String(s.reps)) }),
      Col("Volume", { align: "right", values: setsToday.map(s => Badge(`${volume(s)} kg`, { tone: "info", size: "sm" })) }),
      Col("", { align: "right", values: setsToday.map(s => IconButton("trash", { label: "Delete set", variant: "ghost", size: "sm", onClick: () => gym.remove(s.id) })) })
    ], { striped: true })
  })
])
