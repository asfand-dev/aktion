// Chat Messenger — a conversation list beside a live message thread with a
// composer, typing indicator and presence dots. Sending a message echoes an
// auto-reply so the thread feels alive. Starting point for: any chat, support
// inbox or DM feature.
// Uses: SplitView, $store({ persist }) conversations, ChatBubble thread, TypingIndicator, $effect.
$app(Column([header, SplitView([listPane], [threadPane], { primaryWidth: "300px" })], { gap: "md", padding: "md" }))

chat = $store({
  persist: "messenger.state",
  active: "u1",
  people: [
    { id: "u1", name: "Grace Hopper", status: "online", role: "Engineering" },
    { id: "u2", name: "Alan Turing", status: "online", role: "Research" },
    { id: "u3", name: "Katherine Johnson", status: "away", role: "Flight dynamics" },
    { id: "u4", name: "Margaret Hamilton", status: "offline", role: "Software" }
  ],
  threads: {
    u1: [{ from: "them", body: "Did the build pass on main?", time: "09:02" }, { from: "me", body: "Yep, all green ✅", time: "09:03" }],
    u2: [{ from: "them", body: "Got a minute to pair on the cipher?", time: "08:40" }],
    u3: [{ from: "them", body: "Numbers are ready for review.", time: "Yesterday" }],
    u4: [{ from: "them", body: "Shipping the lunar module update tonight.", time: "Mon" }]
  },
  setActive: (s, id) => { s.active = id },
  send: (s, id, body) => {
    const thread = s.threads[id] ?? []
    s.threads = { ...s.threads, [id]: [...thread, { from: "me", body, time: "now" }] }
  },
  receive: (s, id, body) => {
    const thread = s.threads[id] ?? []
    s.threads = { ...s.threads, [id]: [...thread, { from: "them", body, time: "now" }] }
  }
})

$draft = ""
$typing = false

active = chat.people.find(p => p.id == chat.active)
thread = chat.threads[chat.active] ?? []
statusTone = s => s == "online" ? "success" : s == "away" ? "warning" : "neutral"

function send() {
  const body = $draft.trim()
  if (!body) return
  chat.send(chat.active, body)
  $draft = ""
  const target = chat.active
  $typing = true
  setTimeout(() => {
    $typing = false
    const replies = ["Got it, thanks!", "Makes sense 👍", "On it.", "Let me check and get back to you.", "Nice — appreciate it!"]
    chat.receive(target, replies[Math.floor($util.random() * replies.length)])
  }, 1400)
}

lastOf = id => { const t = chat.threads[id] ?? []; return t.length > 0 ? t[t.length - 1].body : "No messages yet" }

header = PageHeader("Messages", {
  subtitle: `${chat.people.filter(p => p.status == "online").length} online`,
  badge: Badge("Direct messages", { tone: "primary", icon: "comments" })
})

function personRow(p) {
  return OnClick(Box([Row([
    Avatar(p.name, { size: "sm", status: p.status }),
    StackItem(Column([
      Text(p.name, { variant: "body-heavy" }),
      Text($util.truncate(lastOf(p.id), 32), { variant: "small", tone: "muted" })
    ], { gap: "none" }), { grow: 1 }),
    StatusDot(p.status, { tone: statusTone(p.status) })
  ], { gap: "sm", align: "center" })], {
    key: p.id,
    padding: "sm",
    border: p.id == chat.active ? "strong" : "subtle",
    background: p.id == chat.active ? "muted" : "surface",
    sx: { borderRadius: "var(--rui-radius-md)", states: { hover: { background: "var(--rui-color-muted)" } } }
  }), { onClick: () => chat.setActive(p.id) })
}

listPane = Column([
  SectionHeader("Conversations"),
  Column(chat.people.map(p => personRow(p)), { gap: "xs" })
], { gap: "sm" })

threadPane = active
  ? Card([
      Row([
        Avatar(active.name, { size: "sm", status: active.status }),
        Column([Text(active.name, { variant: "body-heavy" }), Text(active.role, { variant: "small", tone: "muted" })], { gap: "none" }),
        Spacer(),
        Badge(active.status, { tone: statusTone(active.status), size: "sm" })
      ], { gap: "sm", align: "center" }),
      Separator("horizontal"),
      Column([
        ...thread.map((m, i) => ChatBubble(m.from == "me" ? "You" : active.name, { body: m.body, time: m.time, from: m.from == "me" ? "self" : "other", key: String(i) })),
        Show($typing, { children: TypingIndicator(active.name) })
      ], { gap: "sm" }),
      Separator("horizontal"),
      Row([
        StackItem(OnKeyboard(Input("draft", { value: $draft, placeholder: "Type a message…" }), { onKeyDown: (e) => { if (e.key == "Enter") send() } }), { grow: 1 }),
        Button("Send", { variant: "primary", icon: "paper-plane", onClick: send, disabled: !$draft.trim() })
      ], { gap: "sm", align: "end" })
    ])
  : Center([EmptyState("No conversation selected", { icon: "comments" })], { minHeight: "50vh" })
