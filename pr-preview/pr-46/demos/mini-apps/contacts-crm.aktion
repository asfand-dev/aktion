// Contacts CRM — a searchable, filterable contact directory: stats up top, a
// search + group filter toolbar, a grid of profile cards, a details drawer and
// an add-contact form with validation. Starting point for: any CRM, address
// book or member directory.
// Uses: $store({ persist }), $form + validation, ProfileCard grid, Sheet drawer, Modal.
$app(Column([header, stats, toolbar, directory, detailSheet, addModal], { gap: "lg", padding: "md" }))

groups = ["Lead", "Customer", "Partner", "Vendor"]
groupTone = g => g == "Customer" ? "success" : g == "Lead" ? "info" : g == "Partner" ? "primary" : "warning"

crm = $store({
  persist: "crm.contacts",
  contacts: [
    { id: "p1", name: "Ada Lovelace", role: "CTO, Analytical Engines", email: "ada@analytical.io", phone: "+44 20 7946 0011", group: "Customer", tags: ["VIP", "Enterprise"] },
    { id: "p2", name: "Alan Turing", role: "Head of Research, Enigma", email: "alan@enigma.uk", phone: "+44 161 496 0022", group: "Partner", tags: ["Technical"] },
    { id: "p3", name: "Grace Hopper", role: "Compiler Lead, Navy", email: "grace@navy.mil", phone: "+1 202 555 0033", group: "Customer", tags: ["Champion"] },
    { id: "p4", name: "Katherine Johnson", role: "Mathematician, NASA", email: "kj@nasa.gov", phone: "+1 757 555 0044", group: "Lead", tags: ["Inbound"] },
    { id: "p5", name: "Tim Berners-Lee", role: "Founder, WWW", email: "tim@w3.org", phone: "+41 22 555 0055", group: "Vendor", tags: ["Web"] },
    { id: "p6", name: "Margaret Hamilton", role: "Director, Apollo Software", email: "mh@apollo.io", phone: "+1 281 555 0066", group: "Lead", tags: ["Aerospace"] }
  ],
  add: (s, c) => { s.contacts = [...s.contacts, { ...c, id: $util.uuid(), tags: [] }] },
  remove: (s, id) => { s.contacts = s.contacts.filter(c => c.id != id) }
})

$search = ""
$group = "all"
$openId = null

addForm = $form({
  values: { name: "", role: "", email: "", phone: "", group: "Lead" },
  rules: {
    name: [$util.rules.required("Name is required")],
    email: [$util.rules.required(), $util.rules.email("Enter a valid email")]
  },
  onSubmit: (v) => { crm.add(v); $addOpen = false; addForm.reset() }
})
$addOpen = false

visible = crm.contacts
  .filter(c => $group == "all" ? true : c.group == $group)
  .filter(c => $search == "" ? true : (c.name + c.role + c.email).toLowerCase().includes($search.toLowerCase()))
current = crm.contacts.find(c => c.id == $openId)

header = PageHeader("Contacts", {
  subtitle: `${crm.contacts.length} people across ${groups.length} groups`,
  badge: Badge("CRM", { tone: "primary", icon: "address-book" }),
  actions: [Button("Add contact", { variant: "primary", icon: "user-plus", size: "sm", onClick: () => { addForm.reset(); $addOpen = true } })]
})

stats = Stats(groups.map(g => StatCard(g + "s", { value: String(crm.contacts.filter(c => c.group == g).length), icon: g == "Customer" ? "handshake" : g == "Lead" ? "user-plus" : g == "Partner" ? "people-group" : "truck", tone: groupTone(g) })))

toolbar = Toolbar({
  left: [StackItem(SearchBar("search", { placeholder: "Search by name, role or email…", value: $search }), { grow: 1 })],
  right: [ToggleGroup("group", { items: [{ value: "all", label: "All" }, ...groups.map(g => ({ value: g, label: g }))], value: $group, size: "sm" })]
})

function card(c) {
  return ProfileCard(c.name, {
    role: c.role,
    bio: c.email,
    tags: [c.group, ...c.tags],
    actions: [
      Button("View", { variant: "secondary", size: "sm", icon: "eye", onClick: () => { $openId = c.id } }),
      IconButton("envelope", { label: "Email", variant: "ghost", size: "sm", onClick: () => $toast.show(`Emailing ${c.name}`, { tone: "info" }) })
    ]
  })
}

directory = Show(visible.length > 0, {
  fallback: EmptyState("No contacts found", { icon: "user-slash", description: "Adjust your search or filter, or add a new contact." }),
  children: Grid(visible.map(c => card(c)), { columns: { base: 1, sm: 2, lg: 3 }, gap: "lg" })
})

detailSheet = Sheet(current ? [Column([
  Center([Avatar(current.name, { size: "xl" })]),
  Center([Column([Text(current.name, { variant: "heading" }), Text(current.role, { variant: "small", tone: "muted" })], { gap: "none", align: "center" })]),
  Center([Badge(current.group, { tone: groupTone(current.group) })]),
  Separator("horizontal"),
  DescriptionList([
    DescriptionItem("Email", { value: current.email, icon: "envelope" }),
    DescriptionItem("Phone", { value: current.phone, icon: "phone" }),
    DescriptionItem("Group", { value: current.group, icon: "layer-group" })
  ], { columns: 1 }),
  Show(current.tags.length > 0, { children: BadgeList(current.tags, { size: "sm" }) }),
  Separator("horizontal"),
  Row([
    Button("Email", { variant: "primary", icon: "envelope", onClick: () => $toast.show(`Emailing ${current.name}`, { tone: "info" }) }),
    Button("Delete", { variant: "ghost", icon: "trash", onClick: () => { crm.remove(current.id); $openId = null } })
  ], { gap: "sm" })
], { gap: "md" })] : [], {
  open: current != null,
  side: "right",
  title: "Contact details",
  onClose: () => { $openId = null }
})

addModal = Modal("Add a contact", {
  open: $addOpen,
  closeOnBackdrop: true,
  onClose: () => { $addOpen = false },
  children: [Column([
    FormControl("Name", { field: Input("cname", { value: addForm.values.name, error: addForm.errors.name, onBlur: () => addForm.touch("name") }) }),
    FormControl("Role", { field: Input("crole", { value: addForm.values.role, placeholder: "e.g. Head of Product" }) }),
    FormControl("Email", { field: Input("cemail", { type: "email", value: addForm.values.email, error: addForm.errors.email, onBlur: () => addForm.touch("email") }) }),
    FormControl("Phone", { field: Input("cphone", { value: addForm.values.phone, placeholder: "+1 555 000 0000" }) }),
    FormControl("Group", { field: Select("cgroup", { items: groups.map(g => SelectItem(g, { label: g })), value: addForm.values.group }) })
  ], { gap: "md" })],
  footer: [
    Button("Cancel", { variant: "ghost", onClick: () => { $addOpen = false } }),
    Button("Save contact", { variant: "primary", icon: "check", onClick: () => addForm.submit() })
  ]
})
