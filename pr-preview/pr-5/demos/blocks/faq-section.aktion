// FAQ Section — searchable, category-filtered frequently-asked-questions with
// an accordion body, a result count and a "still need help" contact card.
$app(Container([Column([head, toolbar, list, contact], { gap: "lg" })], { size: "md" }))

faqs = [
  { q: "How do I install Aktion?", a: "Add the package with npm and import the web component, or drop the CDN script tag into your page. The custom element registers itself automatically.", cat: "Getting started" },
  { q: "Does it work without a build step?", a: "Yes. The runtime parses .aktion source at runtime, so you can stream it straight from an LLM and render progressively with no bundler.", cat: "Getting started" },
  { q: "Which frameworks are supported?", a: "It is a standard web component, so it works in React, Vue, Angular, Svelte, or plain HTML with identical behaviour.", cat: "Integration" },
  { q: "Can I theme it to match my brand?", a: "Pass the theme attribute for a built-in look, or call $theme with a token map for custom colours, radius and fonts.", cat: "Theming" },
  { q: "How is state persisted?", a: "Reactive atoms live for the element's lifetime. Use $storage for localStorage, sessionStorage or cookies, or serialize/hydrate from the host.", cat: "State" },
  { q: "Is it safe to render model output?", a: "Yes. HTMLTag and Styles are sanitised, on* handlers and unsafe URLs are dropped, and the parser treats unknown references as empty.", cat: "Security" }
]

$q = ""
$cat = "all"
cats = ["all", ...$util.unique(faqs.map(f => f.cat))]

matches = faqs.filter(f =>
  ($cat == "all" || f.cat == $cat) &&
  ($q == "" || f.q.toLowerCase().includes($q.toLowerCase()) || f.a.toLowerCase().includes($q.toLowerCase()))
)

head = Center([Column([
  Badge("Help center", { tone: "primary", icon: "circle-question" }),
  Text("Frequently asked questions", { variant: "title" }),
  Text("Search the docs or browse by topic.", { variant: "small", tone: "muted" })
], { gap: "xs", align: "center" })])

toolbar = Card([Column([
  SearchBar("q", { placeholder: "Search questions…", value: $q }),
  Row([
    ToggleGroup("cat", { items: cats.map(c => ({ value: c, label: c == "all" ? "All" : c })), value: $cat, size: "sm" }),
    Spacer(),
    Text(`${matches.length} ${$util.plural(matches.length, "result")}`, { variant: "small", tone: "muted" })
  ], { align: "center", wrap: true })
], { gap: "md" })])

list = Show(matches.length > 0, {
  fallback: EmptyState("No matching questions", { description: "Try a different search or category.", icon: "magnifying-glass" }),
  children: Accordion(matches.map(f => AccordionItem(f.q, { children: [Column([Text(f.a), Badge(f.cat, { tone: "info", size: "sm" })], { gap: "sm" })] })))
})

contact = Card([Row([
  Icon("headset", { size: "lg", color: "var(--rui-color-primary)" }),
  StackItem(Column([Text("Still need help?", { variant: "body-heavy" }), Text("Our team usually replies within a few hours.", { variant: "small", tone: "muted" })], { gap: "xs" }), { grow: 1 }),
  Button("Contact support", { variant: "primary", icon: "comment" })
], { align: "center", gap: "md" })])
