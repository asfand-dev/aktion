// Chess Clock — a two-player tap clock with time controls, increments and flag detection.
// Standalone widget for: board-game nights, debate timers, pair-programming rotations.
// Uses: SegmentedControl time controls, sx typography + states, animate, $effect("every").
$app(Column([header, clocks, controls], { gap: "lg", padding: "md" }))

controlsMap = {
  "Bullet 1+0":  { mins: 1, inc: 0 },
  "Blitz 3+2":   { mins: 3, inc: 2 },
  "Rapid 10+5":  { mins: 10, inc: 5 },
  "Classical 30": { mins: 30, inc: 0 }
}

$control = "Blitz 3+2"
$whiteMs = 180000
$blackMs = 180000
$turn = ""
$flagged = ""
$moves = 0

function fmtClock(ms) {
  const total = Math.max(0, Math.ceil(ms / 1000))
  const m = Math.floor(total / 60)
  const s = total % 60
  return `${m}:${String(s).padStart(2, "0")}`
}

// 100ms resolution while a side is on the move
$effect(() => {
  if ($turn && !$flagged) {
    if ($turn == "white") {
      $whiteMs = $whiteMs - 100
      if ($whiteMs <= 0) { $whiteMs = 0; $flagged = "white" }
    } else {
      $blackMs = $blackMs - 100
      if ($blackMs <= 0) { $blackMs = 0; $flagged = "black" }
    }
  }
}, ["every(100)"])

function tap(side) {
  if ($flagged) return
  const inc = controlsMap[$control].inc * 1000
  if (!$turn) { $turn = side == "white" ? "black" : "white"; return }
  if ($turn != side) return
  if (side == "white") { $whiteMs = $whiteMs + inc; $turn = "black" }
  else { $blackMs = $blackMs + inc; $turn = "white" }
  $moves = $moves + 1
}

function reset(name) {
  const c = controlsMap[name ?? $control]
  $whiteMs = c.mins * 60000
  $blackMs = c.mins * 60000
  $turn = ""
  $flagged = ""
  $moves = 0
}

function pickControl(name) {
  $control = name
  reset(name)
}

header = PageHeader("Chess Clock", {
  subtitle: "Tap your own clock after moving — increment is added automatically",
  badge: Badge($flagged ? `${$flagged == "white" ? "White" : "Black"} flagged!` : $turn ? `${$turn == "white" ? "White" : "Black"} to move` : "Tap either side to start", {
    tone: $flagged ? "danger" : $turn ? "primary" : "neutral",
    icon: "chess-knight"
  })
})

clockFace = (side, ms) => OnClick(
  Card([Center([Column([
    Eyebrow(side == "white" ? "WHITE" : "BLACK"),
    Text(fmtClock(ms), {
      variant: "title",
      sx: { fontSize: "4rem", weight: 700 },
      style: "font-variant-numeric: tabular-nums; line-height: 1;",
      tone: $flagged == side ? "danger" : $turn == side ? "primary" : "default"
    }),
    Show($flagged == side, { children: Badge("Time's up", { tone: "danger", icon: "flag" }) }),
    Show($turn == side && !$flagged, { children: Badge("Your move", { tone: "primary", size: "sm" }) })
  ], { gap: "sm", align: "center" })], { minHeight: "180px" })], {
    sx: {
      cursor: "pointer",
      border: $turn == side ? "strong" : "subtle",
      states: { hover: { shadow: "lg" } }
    },
    animate: $flagged == side ? "wiggle" : "fade"
  }),
  { onClick: () => tap(side) }
)

clocks = Grid([
  clockFace("white", $whiteMs),
  clockFace("black", $blackMs)
], { columns: { base: 1, sm: 2 }, gap: "lg" })

controls = Card([
  Row([
    SegmentedControl(Object.keys(controlsMap), { value: $control, onChange: pickControl }),
    Spacer(),
    Badge(`${$moves} moves`, { tone: "info", size: "sm" }),
    Button("Reset", { variant: "secondary", icon: "rotate-left", onClick: () => reset(null) })
  ], { gap: "md", align: "center", wrap: true }),
  Text(`Increment: +${controlsMap[$control].inc}s per move`, { variant: "small", tone: "muted" })
])
