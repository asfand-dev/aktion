// Admin Dashboard — a full SaaS back-office shell: a fixed sidebar, a top bar
// with search, and four router-driven pages (Overview, Customers, Orders,
// Settings). Sidebar items navigate via the built-in router and auto-highlight
// the active page. Starting point for: any admin panel / internal tool.
// Uses: AppShell + Sidebar + $router, $store shared data, DataGrid, charts, Stats.
$app(AppShell(mainSidebar, [pages], { topbar: topbar, collapsible: true }))

money = n => $util.currency(n, "USD")

db = $store({
  customers: [
    { id: "c1", name: "Ada Lovelace", email: "ada@calc.io", plan: "Pro", mrr: 79, status: "active", since: "2025-02-11" },
    { id: "c2", name: "Alan Turing", email: "alan@enigma.uk", plan: "Team", mrr: 199, status: "active", since: "2025-04-02" },
    { id: "c3", name: "Grace Hopper", email: "grace@navy.mil", plan: "Pro", mrr: 79, status: "trialing", since: "2026-05-20" },
    { id: "c4", name: "Katherine Johnson", email: "kj@nasa.gov", plan: "Enterprise", mrr: 899, status: "active", since: "2024-11-30" },
    { id: "c5", name: "Linus Torvalds", email: "linus@kernel.org", plan: "Free", mrr: 0, status: "churned", since: "2025-01-09" },
    { id: "c6", name: "Margaret Hamilton", email: "mh@apollo.io", plan: "Team", mrr: 199, status: "active", since: "2025-08-14" }
  ],
  orders: [
    { id: "#1042", customer: "Ada Lovelace", total: 79, status: "paid", date: "2026-06-11" },
    { id: "#1041", customer: "Katherine Johnson", total: 899, status: "paid", date: "2026-06-10" },
    { id: "#1040", customer: "Grace Hopper", total: 0, status: "pending", date: "2026-06-10" },
    { id: "#1039", customer: "Margaret Hamilton", total: 199, status: "paid", date: "2026-06-09" },
    { id: "#1038", customer: "Alan Turing", total: 199, status: "refunded", date: "2026-06-08" },
    { id: "#1037", customer: "Ada Lovelace", total: 79, status: "paid", date: "2026-06-07" }
  ]
})

prefs = $store({
  persist: "admin.prefs",
  workspace: "Northwind Inc.",
  emailDigests: true,
  twoFactor: false,
  setWorkspace: (s, v) => { s.workspace = v }
})

$search = ""

activeCustomers = db.customers.filter(c => c.status == "active").length
mrr = $util.sum(db.customers.filter(c => c.status != "churned").map(c => c.mrr))
revenue = $util.sum(db.orders.filter(o => o.status == "paid").map(o => o.total))

statusTone = s => s == "active" || s == "paid" ? "success" : s == "trialing" || s == "pending" ? "warning" : s == "churned" || s == "refunded" ? "danger" : "neutral"

mainSidebar = Sidebar([
  SidebarSection("Workspace", { items: [
    SidebarItem("Overview", { icon: "gauge-high", to: "/" }),
    SidebarItem("Customers", { icon: "users", to: "/customers", badge: String(db.customers.length) }),
    SidebarItem("Orders", { icon: "receipt", to: "/orders", badge: String(db.orders.filter(o => o.status == "pending").length) })
  ]}),
  SidebarSection("Account", { items: [
    SidebarItem("Settings", { icon: "gear", to: "/settings" })
  ]})
], {
  brand: prefs.workspace,
  tagline: "Admin console",
  footer: [PersonChip("Jordan Lee", { role: "Owner", status: "online" })]
})

topbar = Row([
  StackItem(SearchBar("search", { placeholder: "Search customers, orders…", value: $search, shortcut: "/" }), { grow: 1 }),
  IconButton("bell", { label: "Notifications", variant: "ghost" }),
  Avatar("Jordan Lee", { size: "sm" })
], { gap: "sm", align: "center" })

// ---- Pages -----------------------------------------------------------------
function OverviewPage() {
  return Column([
    PageHeader("Overview", { subtitle: "Your business at a glance", badge: Badge("Live", { tone: "success" }) }),
    Stats([
      StatCard("MRR", { value: money(mrr), trend: "up", delta: "+8.2%", icon: "arrow-trend-up", tone: "primary" }),
      StatCard("Revenue (paid)", { value: money(revenue), trend: "up", delta: "+4.1%", icon: "sack-dollar", tone: "success" }),
      StatCard("Active customers", { value: String(activeCustomers), icon: "users", tone: "info" }),
      StatCard("Pending orders", { value: String(db.orders.filter(o => o.status == "pending").length), icon: "hourglass-half", tone: "warning" })
    ]),
    Grid([
      Card([SectionHeader("Revenue trend", { eyebrow: "LAST 6 MONTHS" }), LineChart(["Jan", "Feb", "Mar", "Apr", "May", "Jun"], { series: [Series("Revenue", { values: [820, 932, 901, 1290, 1330, 1450] })], filled: true })]),
      Card([SectionHeader("Plan mix", { eyebrow: "CUSTOMERS" }), PieChart(["Free", "Pro", "Team", "Enterprise"], { values: [1, 2, 2, 1], valueFormat: "percent" })])
    ], { columns: { base: 1, lg: 2 }, gap: "lg" }),
    Card([
      SectionHeader("Recent orders", { eyebrow: "ACTIVITY", actions: [Button("View all", { variant: "ghost", size: "sm", icon: "arrow-right", onClick: () => route.navigate("/orders") })] }),
      Table([
        Col("Order", db.orders.slice(0, 5).map(o => o.id)),
        Col("Customer", db.orders.slice(0, 5).map(o => o.customer)),
        Col("Status", db.orders.slice(0, 5).map(o => Badge(o.status, { tone: statusTone(o.status), size: "sm" }))),
        Col("Total", db.orders.slice(0, 5).map(o => money(o.total)), { align: "right" }),
        Col("Date", db.orders.slice(0, 5).map(o => RelativeTime(o.date)))
      ], { striped: true })
    ])
  ], { gap: "lg" })
}

function CustomersPage() {
  const rows = $search ? db.customers.filter(c => (c.name + c.email).toLowerCase().includes($search.toLowerCase())) : db.customers
  return Column([
    PageHeader("Customers", { subtitle: `${db.customers.length} total · ${activeCustomers} active`, actions: [Button("Invite", { variant: "primary", icon: "user-plus", size: "sm" })] }),
    Card([
      Show(rows.length > 0, {
        fallback: EmptyState("No matching customers", { icon: "user-slash", description: "Try a different search term." }),
        children: DataGrid({
          columns: [
            Col("Name", { values: rows.map(c => PersonChip(c.name, { role: c.email })), sortable: true }),
            Col("Plan", { values: rows.map(c => Badge(c.plan, { tone: "info", size: "sm" })) }),
            Col("MRR", { values: rows.map(c => money(c.mrr)), align: "right", sortable: true }),
            Col("Status", { values: rows.map(c => Badge(c.status, { tone: statusTone(c.status), size: "sm" })) }),
            Col("Since", { values: rows.map(c => $util.formatDate(c.since, "date")), sortable: true })
          ],
          rowIds: rows.map(c => c.id),
          striped: true,
          perPage: 8,
          exportable: true,
          exportFilename: "customers.csv"
        })
      })
    ])
  ], { gap: "lg" })
}

$orderFilter = "all"
function OrdersPage() {
  const rows = $orderFilter == "all" ? db.orders : db.orders.filter(o => o.status == $orderFilter)
  return Column([
    PageHeader("Orders", { subtitle: `${db.orders.length} orders · ${money(revenue)} collected` }),
    Toolbar({
      left: [Text("Filter", { variant: "small-heavy", tone: "muted" }), ToggleGroup("orderFilter", { items: [
        { value: "all", label: "All" },
        { value: "paid", label: "Paid" },
        { value: "pending", label: "Pending" },
        { value: "refunded", label: "Refunded" }
      ], value: $orderFilter, size: "sm" })],
      right: [Button("Export", { variant: "secondary", icon: "download", size: "sm" })]
    }),
    Card([
      Show(rows.length > 0, {
        fallback: EmptyState("No orders in this state", { icon: "receipt" }),
        children: Table([
          Col("Order", rows.map(o => Text(o.id, { variant: "body-heavy" }))),
          Col("Customer", rows.map(o => o.customer)),
          Col("Status", rows.map(o => Badge(o.status, { tone: statusTone(o.status), size: "sm" }))),
          Col("Total", rows.map(o => money(o.total)), { align: "right" }),
          Col("Date", rows.map(o => $util.formatDate(o.date, "date")))
        ], { striped: true })
      })
    ])
  ], { gap: "lg" })
}

function SettingsPage() {
  return Column([
    PageHeader("Settings", { subtitle: "Manage your workspace and security" }),
    Card([
      SectionHeader("Workspace", { eyebrow: "GENERAL" }),
      FormControl("Workspace name", { field: Input("ws", { value: prefs.workspace }) }),
      Switch("digests", { label: "Weekly email digests", value: prefs.emailDigests, description: "A Monday summary of revenue and signups." })
    ]),
    Card([
      SectionHeader("Security", { eyebrow: "ACCOUNT" }),
      Switch("twofa", { label: "Two-factor authentication", value: prefs.twoFactor, description: "Require a code at sign-in." }),
      Button("Change password", { variant: "secondary", icon: "key", size: "sm" })
    ]),
    Card([
      SectionHeader("Danger zone", { eyebrow: "IRREVERSIBLE" }),
      Callout("danger", { title: "Delete workspace", description: "This permanently removes all customers and orders.", icon: "triangle-exclamation" }),
      Button("Delete workspace", { variant: "danger", icon: "trash", size: "sm" })
    ])
  ], { gap: "lg" })
}

pages = $router({
  "/": OverviewPage(),
  "/customers": CustomersPage(),
  "/orders": OrdersPage(),
  "/settings": SettingsPage(),
  default: OverviewPage()
})
