// Sketchpad — freehand drawing with colours and brush sizes, plus a signature capture pane.
// Starting point for: annotation tools, signature flows, whiteboards, kids' apps.
// Uses: DrawingCanvas (PNG out), SignaturePad, SegmentedControl, sx, $util.viewport awareness.
$app(Column([header, body], { gap: "lg", padding: "md" }))

inkColors = ["#1f2937", "#6366f1", "#ef4444", "#22c55e", "#f59e0b"]
$ink = "#1f2937"
$brush = "3"
$strokes = 0
$lastPng = ""
$signature = ""

header = PageHeader("Sketchpad", {
  subtitle: "Draw with mouse, finger or stylus — export as PNG",
  badge: Badge(`${$strokes} strokes`, { tone: $strokes > 0 ? "primary" : "neutral", icon: "paintbrush" })
})

colorDot = c => OnClick(
  Box([Text("", { variant: "small" })], {
    sx: { w: "28px", h: "28px", radius: "circle", border: $ink == c ? "strong" : "subtle", cursor: "pointer" },
    style: `background: ${c};`
  }),
  { onClick: () => { $ink = c } }
)

toolbar = Row([
  Text("Ink", { variant: "small-heavy", tone: "muted" }),
  Row(inkColors.map(c => colorDot(c)), { gap: "xs" }),
  Separator("vertical"),
  Text("Brush", { variant: "small-heavy", tone: "muted" }),
  SegmentedControl(["1", "3", "6", "12"], { value: $brush, onChange: (b) => { $brush = b } })
], { gap: "md", align: "center", wrap: true })

canvasCard = Card([
  SectionHeader("Canvas", { eyebrow: "DRAW HERE" }),
  toolbar,
  // key remounts the canvas when ink/brush change so new strokes pick up the settings
  DrawingCanvas({
    width: 560,
    height: 320,
    color: $ink,
    lineWidth: Number($brush),
    clearable: true,
    onChange: (n) => { $strokes = n },
    onEnd: (png) => { $lastPng = png },
    key: `canvas-${$ink}-${$brush}`
  }),
  Show(!!$lastPng, {
    children: Row([
      Badge("PNG captured", { tone: "success", size: "sm", icon: "image" }),
      Text(`${Math.round($lastPng.length / 1024)} KB data URL — ready to upload or download`, { variant: "small", tone: "muted" })
    ], { gap: "sm", align: "center" })
  })
], { animate: "fade-up" })

signCard = Card([
  SectionHeader("Sign here", { eyebrow: "SIGNATURE", subtitle: "A focused pad with a baseline — great for checkout and consent flows" }),
  SignaturePad({ width: 400, height: 160, onChange: (png) => { $signature = png } }),
  Show(!!$signature, {
    fallback: Text("Awaiting signature…", { variant: "small", tone: "muted" }),
    children: Callout("success", { title: "Signature captured", description: "The PNG data URL is in state — POST it with your form.", icon: "file-signature", compact: true })
  })
], { animate: { preset: "fade-up", delay: 80 } })

body = Grid([canvasCard, signCard], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" })
