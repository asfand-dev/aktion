// Reading List — shelve books as to-read / reading / finished, rate them and track page progress.
// Starting point for: media trackers (books, films, games), wishlist apps.
// Uses: SegmentedControl shelves, Rating, $store({ persist }), $form, FlipList reorder animation.
$app(Column([header, kpis, toolbar, shelfView, addCard], { gap: "lg", padding: "md" }))

shelves = ["to-read", "reading", "finished"]
shelfLabel = s => s == "to-read" ? "To read" : s == "reading" ? "Reading" : "Finished"

library = $store({
  persist: "books.shelf",
  books: [
    { id: "b1", title: "Project Hail Mary", author: "Andy Weir",        shelf: "finished", rating: 5, pages: 476, page: 476 },
    { id: "b2", title: "The Pragmatic Programmer", author: "Hunt & Thomas", shelf: "reading", rating: 0, pages: 352, page: 120 },
    { id: "b3", title: "Tomorrow, and Tomorrow, and Tomorrow", author: "Gabrielle Zevin", shelf: "reading", rating: 0, pages: 416, page: 38 },
    { id: "b4", title: "Snow Crash", author: "Neal Stephenson", shelf: "to-read", rating: 0, pages: 440, page: 0 },
    { id: "b5", title: "Thinking, Fast and Slow", author: "Daniel Kahneman", shelf: "to-read", rating: 0, pages: 499, page: 0 }
  ],
  moveTo:   (s, id, shelf) => { s.books = s.books.map(b => b.id == id ? { ...b, shelf, page: shelf == "finished" ? b.pages : b.page } : b) },
  rate:     (s, id, rating) => { s.books = s.books.map(b => b.id == id ? { ...b, rating } : b) },
  progress: (s, id, page) => { s.books = s.books.map(b => b.id == id ? { ...b, page: Math.min(b.pages, Math.max(0, page)) } : b) },
  add:      (s, b) => { s.books = [b, ...s.books] },
  remove:   (s, id) => { s.books = s.books.filter(b => b.id != id) }
})

$shelf = "reading"

addForm = $form({
  values: { title: "", author: "", pages: 300 },
  rules: {
    title:  [$util.rules.required("What's the title?")],
    author: [$util.rules.required("Who wrote it?")]
  },
  onSubmit: (v) => {
    library.add({ id: $util.uuid(), title: v.title, author: v.author, shelf: "to-read", rating: 0, pages: Number(v.pages) || 0, page: 0 })
    addForm.reset()
  }
})

onShelf = library.books.filter(b => b.shelf == $shelf)
finished = library.books.filter(b => b.shelf == "finished")
avgRating = finished.filter(b => b.rating > 0).length > 0
  ? Math.round($util.avg(finished.filter(b => b.rating > 0).map(b => b.rating)) * 10) / 10
  : 0

header = PageHeader("Reading List", {
  subtitle: `${library.books.length} books across three shelves · saved locally`,
  badge: Badge(`${finished.length} finished`, { tone: "success", icon: "book" })
})

kpis = Stats([
  StatCard("On the pile", { value: String(library.books.filter(b => b.shelf == "to-read").length), icon: "layer-group", tone: "info" }),
  StatCard("In progress", { value: String(library.books.filter(b => b.shelf == "reading").length), icon: "bookmark", tone: "primary" }),
  StatCard("Avg. rating", { value: avgRating > 0 ? `${avgRating} / 5` : "—", icon: "star", tone: "warning" })
])

toolbar = Row([
  SegmentedControl(shelves, { value: $shelf, onChange: (s) => { $shelf = s } }),
  Spacer(),
  Badge(`${onShelf.length} on this shelf`, { tone: "neutral" })
], { gap: "md", align: "center", wrap: true })

moveButtons = b => Row(shelves.filter(s => s != b.shelf).map(s =>
  Button(shelfLabel(s), { variant: "ghost", size: "xs", icon: s == "finished" ? "check" : "arrow-right", onClick: () => library.moveTo(b.id, s) })
), { gap: "xs", wrap: true })

bookCard = b => Card([
  Row([
    StackItem(Column([
      Text(b.title, { variant: "large-heavy" }),
      Text(b.author, { variant: "small", tone: "muted" })
    ], { gap: "none" }), { grow: 1 }),
    IconButton("trash", { label: "Remove book", variant: "ghost", size: "sm", onClick: () => library.remove(b.id) })
  ], { align: "start" }),
  Show(b.shelf == "reading", {
    children: Column([
      Progress(b.pages > 0 ? Math.round((b.page / b.pages) * 100) : 0, { max: 100, tone: "primary", showValue: true }),
      Row([
        Text(`Page ${b.page} of ${b.pages}`, { variant: "small", tone: "muted" }),
        Spacer(),
        Button("+25 pages", { variant: "secondary", size: "xs", icon: "forward", onClick: () => library.progress(b.id, b.page + 25) })
      ], { align: "center" })
    ], { gap: "sm" })
  }),
  Show(b.shelf == "finished", {
    children: Rating({ value: b.rating, interactive: true, onChange: (r) => library.rate(b.id, r), label: b.rating > 0 ? `${b.rating} of 5` : "Rate it" })
  }),
  moveButtons(b)
], { key: b.id, sx: { states: { hover: { shadow: "md", translateY: "-2px" } } } })

shelfView = Show(onShelf.length > 0, {
  fallback: EmptyState(`Nothing on the ${shelfLabel($shelf)} shelf`, { description: "Add a book below or move one across shelves.", icon: "book-open" }),
  children: FlipList(onShelf.map(b => bookCard(b)), { duration: 250 })
})

addCard = Card([
  SectionHeader("Add a book", { eyebrow: "NEW" }),
  Grid([
    FormControl("Title", { field: Input("title", { placeholder: "e.g. Dune", value: addForm.values.title, error: addForm.errors.title, onBlur: () => addForm.touch("title") }) }),
    FormControl("Author", { field: Input("author", { placeholder: "e.g. Frank Herbert", value: addForm.values.author, error: addForm.errors.author, onBlur: () => addForm.touch("author") }) }),
    FormControl("Pages", { field: NumberInput("pages", { value: addForm.values.pages, min: 1, step: 10 }) })
  ], { columns: { base: 1, md: 3 }, gap: "md" }),
  Button("Add to the pile", { variant: "primary", icon: "plus", fullWidth: true, onClick: () => addForm.submit(), disabled: !addForm.values.title || !addForm.values.author })
])
