// Data Table — a full-featured table block: search, status filter chips,
// sortable columns, row selection with a bulk-action bar, and pagination.
$app(Column([header, toolbar, bulk, table, footer], { gap: "md", padding: "md" }))

orders = [
  { id: "ORD-1042", customer: "Ada Lovelace", total: 248, status: "paid", date: "2026-06-01" },
  { id: "ORD-1043", customer: "Linus Torvalds", total: 89, status: "pending", date: "2026-06-02" },
  { id: "ORD-1044", customer: "Grace Hopper", total: 1320, status: "paid", date: "2026-06-02" },
  { id: "ORD-1045", customer: "Donald Knuth", total: 56, status: "refunded", date: "2026-06-03" },
  { id: "ORD-1046", customer: "Barbara Liskov", total: 410, status: "pending", date: "2026-06-03" },
  { id: "ORD-1047", customer: "Alan Turing", total: 980, status: "paid", date: "2026-06-04" },
  { id: "ORD-1048", customer: "Margaret Hamilton", total: 175, status: "paid", date: "2026-06-04" },
  { id: "ORD-1049", customer: "Edsger Dijkstra", total: 64, status: "refunded", date: "2026-06-05" },
  { id: "ORD-1050", customer: "Katherine Johnson", total: 530, status: "pending", date: "2026-06-05" },
  { id: "ORD-1051", customer: "Tim Berners-Lee", total: 720, status: "paid", date: "2026-06-06" },
  { id: "ORD-1052", customer: "Radia Perlman", total: 295, status: "paid", date: "2026-06-06" },
  { id: "ORD-1053", customer: "Vint Cerf", total: 142, status: "pending", date: "2026-06-07" }
]

$q = ""
$status = "all"
$sortBy = "date"
$sortDir = "desc"
$page = 1
$selected = []
perPage = 5

money = n => $util.format(n, "currency", "USD")
statusTone = s => s == "paid" ? "success" : s == "pending" ? "warning" : "danger"

filtered = orders.filter(o =>
  ($status == "all" || o.status == $status) &&
  ($q == "" || o.id.toLowerCase().includes($q.toLowerCase()) || o.customer.toLowerCase().includes($q.toLowerCase()))
)
sorted = $util.sort(filtered, $sortBy, $sortDir)
totalPages = Math.max(1, Math.ceil(sorted.length / perPage))
pageClamped = Math.min($page, totalPages)
visible = $util.slice(sorted, (pageClamped - 1) * perPage, pageClamped * perPage)

function sortBy(field) {
  if ($sortBy == field) { $sortDir = $sortDir == "asc" ? "desc" : "asc" }
  else { $sortBy = field; $sortDir = "asc" }
}

sortIcon = field => $sortBy != field ? "sort" : $sortDir == "asc" ? "sort-up" : "sort-down"

function toggleRow(id) {
  $selected = $selected.includes(id) ? $selected.filter(x => x != id) : [...$selected, id]
}
function clearSelection() { $selected = [] }

header = PageHeader("Orders", { subtitle: `${orders.length} total · ${filtered.length} matching`, breadcrumbs: false })

toolbar = Toolbar({
  left: [
    SearchBar("q", { placeholder: "Search id or customer…", value: $q }),
    ToggleGroup("status", { items: [
      { value: "all", label: "All" },
      { value: "paid", label: "Paid" },
      { value: "pending", label: "Pending" },
      { value: "refunded", label: "Refunded" }
    ], value: $status, size: "sm" })
  ],
  right: [
    Button(`Sort: ${$util.capitalize($sortBy)} ${$sortDir == "asc" ? "↑" : "↓"}`, { variant: "ghost", icon: sortIcon($sortBy), size: "sm", onClick: () => sortBy($sortBy) }),
    Button("New order", { variant: "primary", icon: "plus", size: "sm" })
  ]
})

bulk = Show($selected.length > 0, {
  children: Card([Row([
    Icon("check-double", { color: "var(--rui-color-info)" }),
    StackItem(Text(`${$selected.length} selected`, { variant: "body-heavy" }), { grow: 1 }),
    Button("Mark paid", { variant: "primary", size: "sm", icon: "check" }),
    Button("Clear", { variant: "ghost", size: "sm", onClick: clearSelection })
  ], { align: "center", gap: "sm" })])
})

table = Card([Table([
  Col("", { values: visible.map(o => Checkbox(`sel-${o.id}`, { value: $selected.includes(o.id), onChange: () => toggleRow(o.id) })) }),
  Col("Order", { values: visible.map(o => Text(o.id, { variant: "body-heavy" })), onClick: (v, i) => $toast.show(`Open ${visible[i].id}`) }),
  Col("Customer", { values: visible.map(o => Row([Avatar(o.customer, { size: "xs" }), Text(o.customer)], { gap: "sm", align: "center" })) }),
  Col("Date", { values: visible.map(o => o.date) }),
  Col("Status", { values: visible.map(o => Badge(o.status, { tone: statusTone(o.status), size: "sm" })) }),
  Col("Total", { align: "right", values: visible.map(o => Text(money(o.total), { variant: "body-heavy" })) })
], { striped: true })])

footer = Row([
  Text(`Page ${pageClamped} of ${totalPages}`, { variant: "small", tone: "muted" }),
  Spacer(),
  Pagination($page, { totalPages, total: sorted.length, perPage })
], { align: "center" })
