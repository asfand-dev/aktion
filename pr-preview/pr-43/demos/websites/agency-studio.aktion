// Northlight Studio — the complete marketing site for an independent brand + product design
// studio: hero, client logos, services, a filterable work gallery with case-study modals,
// the studio process, proof, the team, and a working enquiry form.
// Starting point for: design studios, agencies, consultancies, creative portfolios.
// Uses: $theme branding, NavBar + ThemeToggle, Backdrop hero with Display + GradientText,
//        LogoCloud, Bento services, FilterPill filtering, lazy Modal case study, Steps process,
//        MetricStrip, ProfileCard team, $form enquiry with SuccessState, Reveal, Footer.
$app(Column([skip, nav, hero, clients, services, work, process, metrics, proof, team, contact, pageFooter, toTop], { gap: "none" }))

$theme({
  colors: { primary: "#d4552f", accent: "#0f9b8e" },
  radius: { md: "14px", lg: "22px", button: "10px", input: "10px" },
  font: { family: "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif", familyHeading: "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif", weightHeading: "800" },
  fonts: { import: ["Inter:400,600,800"] }
})

$filter = "All"
$caseId = "meridian"
$caseOpen = false
$phase = 1
$quote = 0
$sent = false

img = (seed, w, h) => `https://picsum.photos/seed/${seed}/${w}/${h}`

works = [
  { id: "meridian", title: "Meridian Roasters", category: "Branding", year: "2026", client: "Meridian Roasters", seed: "northlight-meridian", tags: ["Identity", "Packaging"], meta: "Identity · 9 weeks", blurb: "A specialty roaster rebuilt around a single rising-sun mark and a palette that survives kraft paper.", summary: "Meridian had eleven bag designs and no system. We reduced them to one mark, three inks and a grid a small print run can actually hold, then wrote the wholesale playbook that keeps it consistent across 60 cafés.", scope: "Identity, packaging, wholesale toolkit", timeline: "Jan – Mar 2026", outcome: "Wholesale enquiries up 64% in the first quarter after launch", quote: "They found the idea we had been circling for four years and made it printable.", cite: "Priya Raval, Founder" },
  { id: "northbank", title: "Northbank", category: "Branding", year: "2025", client: "Northbank Building Society", seed: "northlight-northbank", tags: ["Identity", "Editorial"], meta: "Identity · 14 weeks", blurb: "A 160-year-old building society given a voice that sounds like a person rather than a policy document.", summary: "We kept the crest, dropped the gradients, and rewrote 400 pages of customer copy against a tone-of-voice model the branch staff helped build. The result reads like advice, not compliance.", scope: "Identity refresh, verbal identity, editorial system", timeline: "Feb – May 2025", outcome: "Complaints about 'confusing letters' down 41%", quote: "Our branch managers now quote the tone guide back at us. That never happens.", cite: "Tom Ashworth, Brand Director" },
  { id: "cadence", title: "Cadence Health", category: "Product", year: "2026", client: "Cadence Health", seed: "northlight-cadence", tags: ["Product", "Design system"], meta: "Product · 18 weeks", blurb: "A clinician-facing triage app redesigned around the twelve seconds a nurse actually has.", summary: "We shadowed three wards for a fortnight, cut the triage flow from nine screens to four, and shipped a 68-component design system the in-house team now extends without us.", scope: "Research, product design, design system", timeline: "Mar – Jul 2026", outcome: "Median triage time down from 4m 10s to 2m 25s", quote: "The first release our nurses did not need training for.", cite: "Dr Amara Osei, Clinical Lead" },
  { id: "kestrel", title: "Kestrel Robotics", category: "Product", year: "2025", client: "Kestrel Robotics", seed: "northlight-kestrel", tags: ["Product", "Data viz"], meta: "Product · 12 weeks", blurb: "Fleet telemetry for warehouse robots, designed for a control room with terrible lighting.", summary: "Every chart was rebuilt for glanceability at three metres, with a colour system that holds up under sodium lighting and for the two operators on the team with deuteranopia.", scope: "Product design, data visualisation, accessibility audit", timeline: "Aug – Oct 2025", outcome: "Incident acknowledgement time halved across four sites", quote: "We stopped printing dashboards. That is the whole review.", cite: "Marek Nowak, Head of Operations" },
  { id: "fernweh", title: "Fernweh", category: "Motion", year: "2026", client: "Fernweh Travel", seed: "northlight-fernweh", tags: ["Motion", "Film"], meta: "Motion · 7 weeks", blurb: "A 90-second brand film and a motion system that survives being cropped to a nine-second story.", summary: "One shoot, one grade, one motion grammar — then a kit of 24 pre-composed cutdowns so the in-house team never has to open After Effects to post on a Tuesday.", scope: "Brand film, motion system, social toolkit", timeline: "Apr – May 2026", outcome: "Paid social cost per booking down 28%", quote: "We have made 200 posts from that one shoot and it still looks like us.", cite: "Lena Brandt, Marketing Lead" },
  { id: "palladio", title: "Palladio", category: "Motion", year: "2025", client: "Palladio Architects", seed: "northlight-palladio", tags: ["Motion", "Exhibition"], meta: "Motion · 6 weeks", blurb: "A generative title sequence for an architecture practice's Venice Biennale room.", summary: "Drawings from thirty years of the archive were traced into one continuous line that redraws itself across three synced projectors, with a fallback loop for the day the network fails.", scope: "Generative motion, exhibition install, fallback system", timeline: "Jun – Jul 2025", outcome: "Room featured in four national design reviews", quote: "Visitors sat on the floor and watched it loop. Twice.", cite: "Giulia Ferri, Partner" },
  { id: "harbour", title: "Harbour & Co", category: "Web", year: "2026", client: "Harbour & Co", seed: "northlight-harbour", tags: ["Web", "Commerce"], meta: "Web · 10 weeks", blurb: "A sixty-product homeware shop that loads in under a second on a train.", summary: "We rebuilt the storefront around a photography grid rather than a carousel, moved the size guide into the buy box, and cut the checkout from five steps to two.", scope: "Web design, storefront build, checkout redesign", timeline: "Jan – Mar 2026", outcome: "Mobile conversion up 2.1 points, returns down 19%", quote: "The first agency that argued us out of a homepage carousel. They were right.", cite: "Sam Oduya, Managing Director" },
  { id: "orchard", title: "Orchard Journal", category: "Web", year: "2025", client: "Orchard Journal", seed: "northlight-orchard", tags: ["Web", "Editorial"], meta: "Web · 8 weeks", blurb: "An independent food quarterly with a reading experience worth paying for.", summary: "A typographic system built for long-form on a phone, a subscriber wall that does not insult the reader, and an archive that finally makes eleven years of back issues findable.", scope: "Editorial web design, subscription flow, archive", timeline: "Sep – Oct 2025", outcome: "Paid subscriptions up 3.4× within six months", quote: "Our readers email us about the typography. Willingly.", cite: "Cara Nyström, Editor" }
]

serviceList = [
  { title: "Brand identity", icon: "pen-nib", filter: "Branding", span: "hero", body: "Positioning, naming, marks, type and the printed system underneath — built as rules a team can hold rather than a PDF nobody opens. Every identity ships with a live token set and a two-hour handover." },
  { title: "Verbal identity", icon: "quote-left", filter: "Branding", span: "tile", body: "Tone models, naming architecture and the copy that proves it works." },
  { title: "Design systems", icon: "shapes", filter: "Product", span: "tile", body: "Component libraries your engineers extend without asking us first." },
  { title: "Product design", icon: "mobile-screen", filter: "Product", span: "wide", body: "Research, flows and interface design for teams shipping weekly — with the accessibility audit built into the sprint, not bolted on at the end." },
  { title: "Motion & film", icon: "film", filter: "Motion", span: "wide", body: "Brand films, generative sequences and motion grammars that stay on-brand once they are cut down to nine seconds for social." },
  { title: "Web & commerce", icon: "window-maximize", filter: "Web", span: "wide", body: "Storefronts, editorial sites and marketing pages that load fast on a bad connection and convert on a small screen." }
]

phases = [
  { label: "Discover", title: "01 · Discover", summary: "Two weeks of listening before anyone opens a design tool.", duration: "2 weeks", details: "Interviews, audit, competitive teardown", deliverables: [{ label: "Stakeholder interviews", note: "8–14 conversations, transcribed and coded", icon: "comments" }, { label: "Audit & teardown", note: "Every touchpoint you own, scored", icon: "magnifying-glass-chart" }, { label: "Positioning brief", note: "One page, signed off before week three", icon: "file-lines" }] },
  { label: "Define", title: "02 · Define", summary: "Three routes, one decision, no design-by-committee.", duration: "3 weeks", details: "Territories, routes, a single signed direction", deliverables: [{ label: "Three territories", note: "Genuinely different, all defensible", icon: "code-branch" }, { label: "Live critique", note: "Your team in the room, not a deck by email", icon: "users-viewfinder" }, { label: "Signed direction", note: "One route, written rationale", icon: "signature" }] },
  { label: "Build", title: "03 · Build", summary: "The long middle, run in public with weekly Friday reviews.", duration: "5–9 weeks", details: "Systems, assets, components, copy", deliverables: [{ label: "Design system", note: "Tokens, components, usage rules", icon: "shapes" }, { label: "Applied assets", note: "Every artefact the launch actually needs", icon: "layer-group" }, { label: "Friday reviews", note: "Same time each week, recorded", icon: "calendar-check" }] },
  { label: "Land", title: "04 · Land", summary: "Handover that survives us leaving the building.", duration: "2 weeks", details: "Handover, training, 90-day check-in", deliverables: [{ label: "Working files", note: "Yours outright, no licence games", icon: "folder-open" }, { label: "Team training", note: "Two sessions, recorded and captioned", icon: "chalkboard-user" }, { label: "90-day review", note: "We come back and measure it", icon: "arrow-rotate-left" }] }
]

quotes = [
  { quote: "Northlight ask better questions than anyone we have hired. The identity is good; the thinking behind it is why we are on our fourth project together.", author: "Priya Raval", role: "Founder, Meridian Roasters", seed: "northlight-priya", rating: 5 },
  { quote: "They shipped a design system our engineers actually kept using six months after the invoice. I have never been able to say that before.", author: "Dr Amara Osei", role: "Clinical Lead, Cadence Health", seed: "northlight-amara", rating: 5 },
  { quote: "We briefed four studios. Northlight were the only ones who talked us out of half the scope before quoting for the rest — and still delivered early.", author: "Sam Oduya", role: "Managing Director, Harbour & Co", seed: "northlight-sam", rating: 5 }
]

people = [
  { name: "Iris Calloway", role: "Founder & Creative Director", seed: "northlight-iris", bio: "Twenty years of identity work, still does the sketching herself.", tags: ["Identity", "Strategy"] },
  { name: "Dev Anand", role: "Design Director, Product", seed: "northlight-dev", bio: "Ex-clinical software. Believes research is cheaper than rework.", tags: ["Product", "Research"] },
  { name: "Mara Lindqvist", role: "Motion Lead", seed: "northlight-mara", bio: "Cuts everything to nine seconds before she cuts it to ninety.", tags: ["Motion", "Film"] },
  { name: "Owen Bekele", role: "Studio Producer", seed: "northlight-owen", bio: "Keeps eleven designers and four clients on the same Friday.", tags: ["Delivery", "Ops"] }
]

budgets = [
  { value: "under25", label: "Under £25k" },
  { value: "25-60", label: "£25k – £60k" },
  { value: "60-120", label: "£60k – £120k" },
  { value: "over120", label: "£120k and up" },
  { value: "unsure", label: "Not sure yet — help us scope it" }
]

categories = ["All", "Branding", "Product", "Motion", "Web"]
filterIcons = { All: "grip", Branding: "pen-nib", Product: "mobile-screen", Motion: "film", Web: "window-maximize" }
countFor = c => c == "All" ? works.length : works.filter(w => w.category == c).length
shownWork = $filter == "All" ? works : works.filter(w => w.category == $filter)
activeCase = works.find(w => w.id == $caseId)
activePhase = phases[$phase]
activeQuote = quotes[$quote]

function showCategory(c) {
  $filter = c
  $toast.info(`Showing ${countFor(c)} ${c == "All" ? "projects" : c.toLowerCase() + " projects"}`)
}

function openCase(id) { $caseId = id; $caseOpen = true }
function nextPhase() { $phase = ($phase + 1) % phases.length }
function cycleQuote(step) { $quote = ($quote + step + quotes.length) % quotes.length }

function ServiceCard(s) {
  return Card([
    Icon(s.icon, { size: "lg", color: "var(--rui-color-primary)" }),
    Heading(s.title, { size: "sm" }),
    Text(s.body, { variant: "body", tone: "muted" }),
    Text(`View ${s.filter.toLowerCase()} work`, { variant: "small-heavy", tone: "primary" })
  ], { onClick: () => showCategory(s.filter), sx: { states: { hover: { translateY: "-3px", shadow: "lg" } }, h: "full", textAlign: "left" } })
}

function WorkCard(w, i) {
  return MediaCard(w.title, {
    imageSrc: img(w.seed, 640, 400),
    description: w.blurb,
    tags: w.tags,
    meta: w.meta,
    badge: w.category,
    actions: [Button("Read the case study", { variant: "ghost", size: "sm", icon: "arrow-right", onClick: () => openCase(w.id) })],
    onClick: () => openCase(w.id),
    key: w.id,
    animate: { preset: "fade-up", delay: i * 60 },
    sx: { states: { hover: { translateY: "-4px", shadow: "lg" } }, h: "full" }
  })
}

skip = SkipLink("main", { label: "Skip to main content" })

nav = NavBar({
  brand: Brand("Northlight Studio"),
  links: [Link("Services", { href: "#services" }), Link("Work", { href: "#work" }), Link("Process", { href: "#process" }), Link("Studio", { href: "#team" })],
  actions: [ThemeToggle(), Button("Start a project", { variant: "primary", size: "sm", icon: "pen-nib", href: "#contact", onClick: () => { $sent = false } })],
  sticky: true,
  blur: true
})

hero = Section([
  Backdrop({ grid: true, blobs: ["var(--rui-color-primary)", "var(--rui-color-accent)"], particles: 26, type: "drift" }),
  Column([
    Eyebrow("INDEPENDENT DESIGN STUDIO · LONDON & LISBON"),
    Display(["We design brands that ", GradientText("earn a second look", { gradient: "warm" })], { size: "hero", align: "center", balance: true }),
    Text("Northlight is a twelve-person studio building identities, products and motion for founders who would rather be remembered than merely noticed.", { variant: "large", tone: "muted", align: "center" }),
    Row([
      Button("Start a project", { variant: "primary", size: "lg", icon: "pen-nib", href: "#contact", onClick: () => { $sent = false } }),
      Button("See selected work", { variant: "secondary", size: "lg", icon: "images", href: "#work", onClick: () => showCategory("All") })
    ], { gap: "md", justify: "center", wrap: true }),
    Row([
      StatusDot("Booking from July 2026", { tone: "success", pulse: true }),
      Text("136 projects shipped since 2014 · 4 D&AD pencils", { variant: "small", tone: "muted" })
    ], { gap: "sm", justify: "center", wrap: true })
  ], { gap: "lg", align: "center", sx: { py: "2xl" } })
], { background: "base", width: "lg", align: "center", padding: "lg", id: "main" })

partners = [{ name: "Meridian Roasters", icon: "mug-hot" }, { name: "Cadence Health", icon: "heart-pulse" }, { name: "Northbank", icon: "building-columns" }, { name: "Fernweh Travel", icon: "plane" }, { name: "Kestrel Robotics", icon: "robot" }, { name: "Harbour & Co", icon: "basket-shopping" }]

clients = Section([
  LogoCloud(partners.map(p => LogoChip(p.name, { icon: p.icon })), { label: "Recent partners" })
], { background: "soft", padding: "sm" })

servicesGrid = Bento(serviceList.map(s => BentoCell(ServiceCard(s), { span: s.span })), { columns: 4, gap: "md", rowHeight: { base: "230px", md: "195px" } })

services = Section([
  Reveal(servicesGrid, { animation: "fade-up" }),
  Text("Every card filters the gallery below — pick a discipline to see it in practice.", { variant: "small", tone: "muted", align: "center" })
], { eyebrow: "WHAT WE DO", title: "Four disciplines, one team, no handoffs", subtitle: "One live project per discipline at a time — nothing sits in a queue behind somebody else's launch date.", background: "base", width: "xl", align: "center", id: "services" })

filterBar = Row(categories.map(c => FilterPill(c, { active: $filter == c, count: countFor(c), icon: filterIcons[c], onToggle: () => showCategory(c) })), { gap: "sm", justify: "center", wrap: true })

caseBody = Column([
  Image(img(activeCase.seed, 960, 540), { alt: `${activeCase.title} — ${activeCase.category.toLowerCase()} case study`, ratio: "16:9" }),
  Row([Badge(activeCase.category, { tone: "primary", size: "sm" }), Pill(activeCase.year, { tone: "neutral" }), BadgeList(activeCase.tags, { tone: "info", size: "sm" })], { gap: "sm", wrap: true }),
  Text(activeCase.summary, { variant: "body" }),
  DescriptionList([
    DescriptionItem("Client", activeCase.client, { icon: "building" }),
    DescriptionItem("Scope", activeCase.scope, { icon: "list-check" }),
    DescriptionItem("Timeline", activeCase.timeline, { icon: "calendar-days" }),
    DescriptionItem("Outcome", activeCase.outcome, { icon: "arrow-trend-up" })
  ]),
  Quote(activeCase.quote, { cite: activeCase.cite })
], { gap: "md" })

caseModal = Modal(activeCase.title, {
  open: $caseOpen,
  size: "lg",
  lazy: true,
  closeOnBackdrop: true,
  onClose: () => { $caseOpen = false },
  children: [caseBody],
  footer: [
    Button("Close", { variant: "ghost", onClick: () => { $caseOpen = false } }),
    Button("Ask about a project like this", { variant: "primary", icon: "envelope", onClick: () => { $caseOpen = false; $sent = false; $toast.success(`We'll send the ${activeCase.title} write-up over`) } })
  ]
})

work = Section([
  filterBar,
  Reveal(Grid(shownWork.map((w, i) => WorkCard(w, i)), { columns: { base: 1, sm: 2, lg: 3 }, gap: "lg", alignItems: "stretch" }), { animation: "fade-up" }),
  Text(`Showing ${shownWork.length} of ${works.length} projects`, { variant: "small", tone: "muted", align: "center" }),
  caseModal
], { eyebrow: "SELECTED WORK", title: "Eight projects, one obsession with craft", subtitle: "Filter by discipline, then open any card for the full case study.", background: "soft", width: "xl", align: "center", id: "work" })

processSteps = Steps(phases.map((p, i) => ({ title: p.title, details: p.details, active: i == $phase, status: i < $phase ? "complete" : i == $phase ? "active" : "pending" })))

phaseDetail = Card([
  SectionHeader(activePhase.title, {
    eyebrow: `PHASE ${$phase + 1} OF ${phases.length}`,
    subtitle: activePhase.summary,
    status: Pill(activePhase.duration, { tone: "activating" }),
    actions: [Button("Next phase", { variant: "ghost", size: "sm", icon: "arrow-right", onClick: nextPhase })]
  }),
  List(activePhase.deliverables.map(d => ListItem(d.label, { description: d.note, icon: d.icon })), { divided: true })
])

process = Section([
  ToggleGroup("phase", { items: phases.map((p, i) => ({ value: i, label: p.label })), value: $phase, label: "Studio process phase", size: "sm" }),
  Reveal(Split(processSteps, { right: phaseDetail, ratio: "2/3", gap: "xl", stackAt: "md", align: "start" }), { animation: "fade-up" })
], { eyebrow: "HOW WE WORK", title: "Four phases, twelve to sixteen weeks", subtitle: "Pick a phase to see exactly what lands and when. A full identity runs all four; a motion sprint runs Discover and Build.", background: "base", width: "lg", align: "center", id: "process" })

metrics = Section([
  Reveal(MetricStrip([Metric("2014", { label: "Studio founded" }), Metric("136", { label: "Projects shipped", countUp: true }), Metric("11 wks", { label: "Average engagement", countUp: true }), Metric("94%", { label: "Repeat client work", countUp: true })], { columns: 4 }), { animation: "zoom" })
], { background: "brand", padding: "md", align: "center" })

proof = Section([
  Reveal(Card([
    Testimonial(activeQuote.quote, { author: activeQuote.author, role: activeQuote.role, avatarSrc: img(activeQuote.seed, 128, 128), rating: activeQuote.rating }),
    Row([
      IconButton("chevron-left", { label: "Previous testimonial", variant: "ghost", onClick: () => cycleQuote(-1) }),
      Text(`${$quote + 1} of ${quotes.length}`, { variant: "small", tone: "muted" }),
      IconButton("chevron-right", { label: "Next testimonial", variant: "ghost", onClick: () => cycleQuote(1) })
    ], { gap: "sm", justify: "center" })
  ]), { animation: "fade-up" })
], { eyebrow: "IN THEIR WORDS", title: "The reference calls we are proudest of", background: "base", width: "md", align: "center" })

function TeamCard(p) {
  return ProfileCard(p.name, {
    role: p.role,
    avatarSrc: img(p.seed, 240, 240),
    bio: p.bio,
    tags: p.tags,
    actions: [Button("Say hello", { variant: "ghost", size: "sm", icon: "envelope", onClick: () => $toast.success(`${p.name} usually replies within a day`) })],
    key: p.name
  })
}

team = Section([
  Reveal(Grid(people.map(p => TeamCard(p)), { columns: { base: 1, sm: 2, lg: 4 }, gap: "lg" }), { animation: "fade-up" })
], { eyebrow: "THE STUDIO", title: "Twelve people, no account managers", subtitle: "The person who pitches your project is the person who makes it.", background: "soft", width: "lg", align: "center", id: "team" })

enquiry = $form({
  values: { name: "", email: "", budget: "25-60", brief: "" },
  rules: {
    name: [$util.rules.required("Tell us who we are talking to")],
    email: [$util.rules.required("We need somewhere to reply"), $util.rules.email("That email does not look right")],
    brief: [$util.rules.required("A sentence or two is plenty"), $util.rules.minLength(20, "Give us a little more to go on")]
  },
  onSubmit: (v) => { $sent = true; $toast.success(`Thanks ${v.name} — Owen will reply within one working day`) }
})

enquiryCard = Card([
  SectionHeader("Tell us about the project", { eyebrow: "ENQUIRY", subtitle: "Four fields. A real person reads every one." }),
  Grid([
    FormControl("Your name", { field: Input("nlName", { placeholder: "Alex Whitfield", value: enquiry.values.name, error: enquiry.errors.name, onBlur: () => enquiry.touch("name") }), required: true }),
    FormControl("Work email", { field: Input("nlEmail", { type: "email", placeholder: "alex@company.com", value: enquiry.values.email, error: enquiry.errors.email, onBlur: () => enquiry.touch("email") }), required: true })
  ], { columns: { base: 1, md: 2 }, gap: "md" }),
  FormControl("Budget range", { field: Select("nlBudget", { items: budgets.map(b => SelectItem(b.value, { label: b.label })), value: enquiry.values.budget }), hint: "A range is fine — it tells us what shape of team to propose." }),
  FormControl("What are you building?", { field: TextArea("nlBrief", { rows: 5, placeholder: "We are launching a second product line and the current identity will not stretch to cover it…", value: enquiry.values.brief, error: enquiry.errors.brief, onBlur: () => enquiry.touch("brief") }), required: true }),
  Button("Send the brief", { variant: "primary", size: "lg", icon: "paper-plane", fullWidth: true, loading: enquiry.submitting, onClick: () => enquiry.submit() })
])

sentCard = Card([
  SuccessState("Brief received", {
    description: "Owen has it. You will hear back within one working day, from a designer rather than a form letter.",
    icon: "paper-plane",
    actions: [Button("Send another brief", { variant: "secondary", icon: "rotate-left", onClick: () => { $sent = false; enquiry.reset() } })]
  })
])

contactAside = Column([
  Heading("Start a project", { size: "section" }),
  Text("We take on about a dozen projects a year. If the fit is wrong we will say so on the first call and point you somewhere better.", { variant: "large", tone: "muted" }),
  DescriptionList([
    DescriptionItem("Email", "hello@northlight.studio", { icon: "envelope" }),
    DescriptionItem("Studios", "Shoreditch, London · Príncipe Real, Lisbon", { icon: "location-dot" }),
    DescriptionItem("Availability", "Booking from July 2026", { icon: "calendar-days" }),
    DescriptionItem("Typical engagement", "£25k – £120k over 8–18 weeks", { icon: "sack-dollar" })
  ], { columns: 1 }),
  Callout("info", { title: "Not ready to brief us yet?", description: "Ask for the studio dossier — twelve case studies, rates and the process in full.", icon: "book-open", actions: [Button("Request the dossier", { variant: "secondary", size: "sm", icon: "download", onClick: () => $toast.success("The dossier is on its way to your inbox") })] })
], { gap: "md" })

contact = Section([
  Reveal(Split(contactAside, { right: Show($sent, { children: sentCard, fallback: enquiryCard }), ratio: "2/3", gap: "xl", stackAt: "md", align: "start" }), { animation: "fade-up" })
], { background: "base", width: "lg", padding: "lg", id: "contact" })

socials = [
  { icon: "instagram", name: "Instagram", href: "https://instagram.com/northlightstudio" },
  { icon: "dribbble", name: "Dribbble", href: "https://dribbble.com/northlightstudio" },
  { icon: "linkedin", name: "LinkedIn", href: "https://linkedin.com/company/northlight-studio" }
]

pageFooter = Footer({
  brand: Brand("Northlight Studio"),
  tagline: "Brand and product design for teams shipping something new.",
  columns: [
    FooterColumn("Studio", { links: [Link("Services", { href: "#services" }), Link("How we work", { href: "#process" }), Link("The team", { href: "#team" })] }),
    // These four are live filters, not decoration: each one sets the gallery
    // category on the way to #work, so the section it lands on is already filtered.
    FooterColumn("Work", { links: categories.filter(c => c != "All").map(c => Link(`${c} work`, { href: "#work", onClick: () => showCategory(c) })) }),
    FooterColumn("Contact", { links: [Link("Start a project", { href: "#contact" }), Link("hello@northlight.studio", { href: "mailto:hello@northlight.studio" })] })
  ],
  social: socials.map(s => IconButton(`brands:${s.icon}`, { label: `Northlight Studio on ${s.name}`, variant: "ghost", href: s.href })),
  legal: "© 2026 Northlight Studio Ltd · Registered in England 09214477 · Demo site"
})

toTop = BackToTop("Back to top", { showAfter: 600 })
