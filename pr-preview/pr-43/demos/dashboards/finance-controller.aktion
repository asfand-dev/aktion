// Finance / controller dashboard — the quarterly close for Meridian Field Systems.
// Cash, burn and runway are computed from the ledger, budget-vs-actual reconciles to
// the P&L, the receivables grid ages itself, and two sliders re-forecast year-end cash.
// Starting point for: any FP&A, treasury, receivables or spend-control console.
// Uses: $store ledger + status transitions, DataGrid + Drawer detail, FilterPill filters,
//       BarChart / LineChart / PieChart, Slider-driven projection, $util.currency.
$app(Column([header, kpis, chartRow, budgetCard, invoiceCard, bottomRow, approvalsCard, invoiceDrawer], { gap: "lg", padding: "md" }))

$period = "2026-Q4"
$invoiceFilter = "all"
$invoiceSort = { key: "Due", direction: "asc" }
$openInvoice = null
$growth = 4
$hires = 3
today = "2026-12-18"
money = n => $util.currency(n, "USD")
share = n => `${$util.round(n * 100, 1)}%`
fmtDate = d => $util.formatDate(d, "YYYY-MM-DD")
// ---- Ledger ------------------------------------------------------------------
periods = [
  { id: "2026-Q1", label: "Q1 2026", asOf: "2026-03-31", months: ["Jan", "Feb", "Mar"], revenue: [1180000, 1245000, 1310000], expenses: [1478000, 1492000, 1507000], budget: 4400000 },
  { id: "2026-Q2", label: "Q2 2026", asOf: "2026-06-30", months: ["Apr", "May", "Jun"], revenue: [1362000, 1418000, 1495000], expenses: [1624000, 1638000, 1651000], budget: 4980000 },
  { id: "2026-Q3", label: "Q3 2026", asOf: "2026-09-30", months: ["Jul", "Aug", "Sep"], revenue: [1556000, 1624000, 1702000], expenses: [1776000, 1790000, 1802000], budget: 5250000 },
  { id: "2026-Q4", label: "Q4 2026", asOf: "2026-12-18", months: ["Oct", "Nov", "Dec"], revenue: [1788000, 1861000, 1944000], expenses: [1962000, 1968000, 1975000], budget: 6010000 }
]
expenseMix = [
  { name: "Payroll & benefits", weight: 0.52, icon: "users" },
  { name: "Cloud & infrastructure", weight: 0.16, icon: "cloud" },
  { name: "Sales & marketing", weight: 0.14, icon: "bullhorn" },
  { name: "Contractors", weight: 0.07, icon: "helmet-safety" },
  { name: "Facilities", weight: 0.06, icon: "building" },
  { name: "Travel & other", weight: 0.05, icon: "plane" }
]
departments = [
  { name: "Engineering", plan: 0.36, actual: 0.38, lead: "Priya Raman" },
  { name: "Sales", plan: 0.20, actual: 0.19, lead: "Marcus Feld" },
  { name: "Marketing", plan: 0.15, actual: 0.13, lead: "Elena Vasquez" },
  { name: "Customer Success", plan: 0.11, actual: 0.11, lead: "Tomás Rivera" },
  { name: "Operations", plan: 0.09, actual: 0.10, lead: "Hannah Lund" },
  { name: "General & admin", plan: 0.09, actual: 0.09, lead: "David Okonkwo" }
]
accounts = {
  "Northwind Traders": { owner: "Marcus Feld", segment: "Enterprise" },
  "Vireo Health Group": { owner: "Elena Vasquez", segment: "Strategic" },
  "Cobalt Freight Systems": { owner: "Hannah Lund", segment: "Mid-market" },
  "Ardent Manufacturing": { owner: "Marcus Feld", segment: "Mid-market" },
  "Larkspur Media": { owner: "Tomás Rivera", segment: "SMB" },
  "Sable & Finch LLP": { owner: "Tomás Rivera", segment: "SMB" },
  "Halcyon Robotics": { owner: "Priya Raman", segment: "Enterprise" },
  "Meridian Public Schools": { owner: "Elena Vasquez", segment: "Public sector" }
}

books = $store({
  invoices: [
    { id: "INV-2025-0402", period: "2026-Q1", customer: "Cobalt Freight Systems", amount: 55600, status: "overdue", issued: "2025-12-04", due: "2026-01-03", seats: 40 },
    { id: "INV-2026-0114", period: "2026-Q1", customer: "Northwind Traders", amount: 148500, status: "paid", issued: "2026-01-08", due: "2026-02-07", seats: 120, paidOn: "2026-02-05" },
    { id: "INV-2026-0126", period: "2026-Q1", customer: "Ardent Manufacturing", amount: 83200, status: "overdue", issued: "2026-01-22", due: "2026-02-21", seats: 65 },
    { id: "INV-2026-0133", period: "2026-Q1", customer: "Vireo Health Group", amount: 212400, status: "overdue", issued: "2026-02-02", due: "2026-03-04", seats: 180 },
    { id: "INV-2026-0140", period: "2026-Q1", customer: "Cobalt Freight Systems", amount: 64750, status: "sent", issued: "2026-03-06", due: "2026-04-05", seats: 48 },
    { id: "INV-2026-0148", period: "2026-Q1", customer: "Larkspur Media", amount: 38900, status: "draft", issued: "2026-03-16", due: "2026-04-15", seats: 28 },
    { id: "INV-2026-0155", period: "2026-Q2", customer: "Larkspur Media", amount: 46900, status: "overdue", issued: "2026-03-10", due: "2026-04-09", seats: 32 },
    { id: "INV-2026-0163", period: "2026-Q2", customer: "Northwind Traders", amount: 162000, status: "paid", issued: "2026-04-07", due: "2026-05-07", seats: 132, paidOn: "2026-05-04" },
    { id: "INV-2026-0182", period: "2026-Q2", customer: "Vireo Health Group", amount: 228600, status: "overdue", issued: "2026-05-05", due: "2026-06-04", seats: 192 },
    { id: "INV-2026-0190", period: "2026-Q2", customer: "Meridian Public Schools", amount: 119400, status: "overdue", issued: "2026-04-28", due: "2026-05-28", seats: 240 },
    { id: "INV-2026-0197", period: "2026-Q2", customer: "Cobalt Freight Systems", amount: 71250, status: "sent", issued: "2026-06-02", due: "2026-07-02", seats: 52 },
    { id: "INV-2026-0199", period: "2026-Q2", customer: "Sable & Finch LLP", amount: 74300, status: "draft", issued: "2026-06-19", due: "2026-07-19", seats: 55 },
    { id: "INV-2026-0201", period: "2026-Q3", customer: "Meridian Public Schools", amount: 63400, status: "overdue", issued: "2026-06-16", due: "2026-07-16", seats: 128 },
    { id: "INV-2026-0208", period: "2026-Q3", customer: "Halcyon Robotics", amount: 104800, status: "paid", issued: "2026-07-06", due: "2026-08-05", seats: 84, paidOn: "2026-08-03" },
    { id: "INV-2026-0215", period: "2026-Q3", customer: "Northwind Traders", amount: 176500, status: "paid", issued: "2026-07-14", due: "2026-08-13", seats: 144, paidOn: "2026-08-11" },
    { id: "INV-2026-0223", period: "2026-Q3", customer: "Vireo Health Group", amount: 241300, status: "overdue", issued: "2026-07-27", due: "2026-08-26", seats: 204 },
    { id: "INV-2026-0231", period: "2026-Q3", customer: "Ardent Manufacturing", amount: 88900, status: "sent", issued: "2026-09-08", due: "2026-10-08", seats: 70 },
    { id: "INV-2026-0238", period: "2026-Q3", customer: "Larkspur Media", amount: 42600, status: "draft", issued: "2026-09-21", due: "2026-10-21", seats: 30 },
    { id: "INV-2026-0244", period: "2026-Q4", customer: "Larkspur Media", amount: 41800, status: "overdue", issued: "2026-09-15", due: "2026-10-15", seats: 30 },
    { id: "INV-2026-0252", period: "2026-Q4", customer: "Northwind Traders", amount: 184200, status: "paid", issued: "2026-10-06", due: "2026-11-05", seats: 150, paidOn: "2026-11-03" },
    { id: "INV-2026-0261", period: "2026-Q4", customer: "Sable & Finch LLP", amount: 79800, status: "paid", issued: "2026-10-19", due: "2026-11-18", seats: 58, paidOn: "2026-11-16" },
    { id: "INV-2026-0270", period: "2026-Q4", customer: "Vireo Health Group", amount: 256900, status: "overdue", issued: "2026-10-02", due: "2026-11-01", seats: 216 },
    { id: "INV-2026-0278", period: "2026-Q4", customer: "Cobalt Freight Systems", amount: 93400, status: "overdue", issued: "2026-10-30", due: "2026-11-29", seats: 68 },
    { id: "INV-2026-0284", period: "2026-Q4", customer: "Ardent Manufacturing", amount: 132600, status: "sent", issued: "2026-11-24", due: "2026-12-24", seats: 105 },
    { id: "INV-2026-0291", period: "2026-Q4", customer: "Meridian Public Schools", amount: 57300, status: "draft", issued: "2026-12-11", due: "2027-01-10", seats: 115 }
  ],
  approvals: [
    { id: "AP-4412", vendor: "Helios Cloud", amount: 84500, category: "Cloud & infrastructure", requester: "Priya Raman", submitted: "2026-12-09", status: "pending", note: "Reserved-capacity renewal, 12 months" },
    { id: "AP-4415", vendor: "Brightpath Recruiting", amount: 46200, category: "Payroll & benefits", requester: "Hannah Lund", submitted: "2026-12-10", status: "pending", note: "Two staff engineer placements" },
    { id: "AP-4418", vendor: "Quarry Analytics", amount: 29800, category: "Sales & marketing", requester: "Elena Vasquez", submitted: "2026-12-12", status: "pending", note: "Q1 demand-gen retainer" },
    { id: "AP-4421", vendor: "Fairview Facilities", amount: 18400, category: "Facilities", requester: "David Okonkwo", submitted: "2026-12-15", status: "pending", note: "HVAC service contract, Denver depot" },
    { id: "AP-4407", vendor: "Ironbridge Legal", amount: 62000, category: "General & admin", requester: "David Okonkwo", submitted: "2026-12-02", status: "approved", note: "Master services agreement review", decidedOn: "2026-12-05" },
    { id: "AP-4409", vendor: "Solstice Events", amount: 108000, category: "Sales & marketing", requester: "Marcus Feld", submitted: "2026-12-04", status: "rejected", note: "User conference deposit — deferred to FY27", decidedOn: "2026-12-08" }
  ],
  remind: (s, ids) => { s.invoices = s.invoices.map(i => ids.includes(i.id) ? { ...i, reminders: (i.reminders ?? 0) + 1, status: i.status == "draft" ? "sent" : i.status } : i) },
  settle: (s, id, on) => { s.invoices = s.invoices.map(i => i.id == id ? { ...i, status: "paid", paidOn: on } : i) },
  reopen: (s, id) => { s.invoices = s.invoices.map(i => i.id == id ? { ...i, status: "sent", paidOn: null } : i) },
  decide: (s, ids, verdict, on) => { s.approvals = s.approvals.map(a => ids.includes(a.id) ? { ...a, status: verdict, decidedOn: on } : a) }
})

// ---- Derived period figures ---------------------------------------------------
openingBalance = 12400000
periodIndex = periods.filter(p => p.id < $period).length
activePeriod = periods[periodIndex]
prevPeriod = periodIndex > 0 ? periods[periodIndex - 1] : null
revenueOf = p => $util.sum(p.revenue)
expenseOf = p => $util.sum(p.expenses)
netOf = p => revenueOf(p) - expenseOf(p)
openingCash = openingBalance + $util.sum(periods.slice(0, periodIndex).map(p => netOf(p)))
revenueTotal = revenueOf(activePeriod)
expenseTotal = expenseOf(activePeriod)
netCash = revenueTotal - expenseTotal
closingCash = openingCash + netCash
monthlyBurn = (0 - netCash) / activePeriod.months.length
runwayMonths = monthlyBurn > 0 ? closingCash / monthlyBurn : 0
cashPath = activePeriod.months.map((m, i) => openingCash + $util.sum(activePeriod.revenue.slice(0, i + 1)) - $util.sum(activePeriod.expenses.slice(0, i + 1)))
revenueDelta = prevPeriod ? (revenueTotal - revenueOf(prevPeriod)) / revenueOf(prevPeriod) : 0
prevBurn = prevPeriod ? (0 - netOf(prevPeriod)) / prevPeriod.months.length : 0
burnDelta = prevPeriod ? monthlyBurn - prevBurn : 0
// Split a total across weights so the parts always add back up to the whole.
function allocate(total, weights) {
  const head = weights.slice(0, weights.length - 1).map(w => Math.round(total * w))
  return [...head, total - $util.sum(head)]
}
expenseAmounts = allocate(expenseTotal, expenseMix.map(c => c.weight))
deptBudgets = allocate(activePeriod.budget, departments.map(d => d.plan))
deptActuals = allocate(expenseTotal, departments.map(d => d.actual))
deptRows = departments.map((d, i) => ({ name: d.name, lead: d.lead, budget: deptBudgets[i], actual: deptActuals[i], variance: deptActuals[i] - deptBudgets[i] }))
totalVariance = expenseTotal - activePeriod.budget

// ---- Receivables --------------------------------------------------------------
periodInvoices = books.invoices.filter(i => i.period == $period)
invoicedTotal = $util.sum(periodInvoices.map(i => i.amount))
collectedTotal = $util.sum(periodInvoices.filter(i => i.status == "paid").map(i => i.amount))
outstanding = periodInvoices.filter(i => i.status == "sent" || i.status == "overdue")
outstandingTotal = $util.sum(outstanding.map(i => i.amount))
overdueCount = periodInvoices.filter(i => i.status == "overdue").length
visibleInvoices = $invoiceFilter == "all" ? periodInvoices : periodInvoices.filter(i => i.status == $invoiceFilter)
daysLate = inv => $util.diffDays(inv.due, activePeriod.asOf)
ageBucket = inv => daysLate(inv) > 60 ? 2 : daysLate(inv) > 30 ? 1 : 0
bucketTotal = b => $util.sum(outstanding.filter(i => ageBucket(i) == b).map(i => i.amount))
bucketCount = b => outstanding.filter(i => ageBucket(i) == b).length
statusOrder = ["all", "paid", "sent", "overdue", "draft"]
statusTone = s => s == "paid" ? "success" : s == "sent" ? "info" : s == "overdue" ? "danger" : "neutral"
statusIcon = s => s == "paid" ? "circle-check" : s == "sent" ? "paper-plane" : s == "overdue" ? "triangle-exclamation" : s == "draft" ? "file-pen" : "layer-group"
statusLabel = s => s == "all" ? "All" : $util.capitalize(s)
countFor = s => s == "all" ? periodInvoices.length : periodInvoices.filter(i => i.status == s).length
invNet = inv => Math.round(inv.amount / 1.0825)
invTax = inv => inv.amount - invNet(inv)
function invoiceLines(inv) {
  const net = invNet(inv)
  const licence = Math.round(net * 0.62)
  const services = Math.round(net * 0.23)
  return [{ label: `Field platform licence · ${inv.seats} seats`, amount: money(licence) }, { label: "Implementation & onboarding", amount: money(services) }, { label: "Premium support, 12 months", amount: money(net - licence - services) }]
}
function invoiceTrail(inv) {
  const late = daysLate(inv) > 0 && inv.status != "paid"
  const trail = [
    TimelineItem("Invoice issued", { time: fmtDate(inv.issued), icon: "file-invoice-dollar", tone: "info", description: `Net 30 · owner ${accounts[inv.customer].owner}` }),
    TimelineItem(late ? `Payment due — ${daysLate(inv)} days late` : "Payment due", { time: fmtDate(inv.due), icon: "calendar-day", tone: late ? "danger" : "default" }),
    inv.status == "paid" ? TimelineItem("Payment received", { time: fmtDate(inv.paidOn ?? activePeriod.asOf), icon: "circle-check", tone: "success", description: `${money(inv.amount)} settled by ACH transfer` }) : null,
    (inv.reminders ?? 0) > 0 ? TimelineItem(`${$util.plural(inv.reminders, "reminder")} sent`, { time: fmtDate(activePeriod.asOf), icon: "bell", tone: "warning", description: "Dunning sequence running from the controller queue" }) : null
  ]
  return trail.filter(x => x)
}
function ageChip(inv) {
  const d = daysLate(inv)
  if (inv.status == "paid") return Badge("Settled", { tone: "success", size: "xs", icon: "check" })
  if (inv.status == "draft") return Badge("Not issued", { tone: "neutral", size: "xs" })
  if (d <= 0) return Badge(`Due in ${0 - d}d`, { tone: "info", size: "xs" })
  return Badge(`${d}d late`, { tone: d > 60 ? "danger" : d > 30 ? "warning" : "neutral", size: "xs" })
}

// ---- Actions ------------------------------------------------------------------
function toggleStatus(s) { $invoiceFilter = $invoiceFilter == s ? "all" : s }
function openInvoiceRow(index, row, id) { $openInvoice = id }
function closeInvoice() { $openInvoice = null }
function remindOne(id) { books.remind([id]); $toast.info(`Reminder queued for ${id}`) }
function remindAll() { books.remind(outstanding.map(i => i.id)); $toast.info($util.plural(outstanding.length, "reminder") + " queued") }
function settleInvoice(id) { books.settle(id, activePeriod.asOf); $toast.success(`${id} marked as paid`) }
function reopenInvoice(id) { books.reopen(id); $toast.warning(`${id} reopened — payment reversed`) }
function decideOne(id, verdict) { books.decide([id], verdict, today); $toast.show(`${id} ${verdict}`, { tone: verdict == "approved" ? "success" : "warning" }) }
function approveQueue() { books.decide(pendingApprovals.map(a => a.id), "approved", today); $toast.success("Approval queue cleared") }
function exportPack() { $toast.success(`${activePeriod.label} board pack queued for download`) }
// ---- Scenario forecast --------------------------------------------------------
hireCost = 11800
function forecast(growthPct, hiresPerMonth) {
  let rev = $util.last(activePeriod.revenue)
  let exp = $util.last(activePeriod.expenses)
  let cash = closingCash
  const path = []
  for (let m of $util.range(1, 12)) {
    rev = rev * (1 + growthPct / 100)
    exp = exp * 1.008 + hiresPerMonth * hireCost
    cash = cash + rev - exp
    path.push(Math.round(cash))
  }
  return { path: path, endCash: Math.round(cash), exitNet: Math.round(rev - exp) }
}
scenario = forecast($growth, $hires)
monthsSolvent = scenario.path.filter(v => v > 0).length
exitRunway = scenario.exitNet < 0 ? scenario.endCash / (0 - scenario.exitNet) : 0
scenarioTone = scenario.endCash <= 0 ? "danger" : scenario.exitNet >= 0 ? "success" : exitRunway < 24 ? "warning" : "info"
scenarioRunway = scenario.endCash <= 0 ? `Cash out in month ${monthsSolvent + 1}` : scenario.exitNet >= 0 ? "Cash-flow positive" : exitRunway > 120 ? "10+ years at exit burn" : `${$util.round(exitRunway, 0)} months at exit burn`

// ---- Sections -----------------------------------------------------------------
periodSelect = Select("period", { items: periods.map(p => ({ value: p.id, label: p.label })), value: $period, label: "Reporting period", labelHidden: true })
header = PageHeader("Finance control", {
  subtitle: `Meridian Field Systems · ${activePeriod.label} close · ${money(outstandingTotal)} receivables outstanding`,
  breadcrumbs: ["Finance", "Controller", activePeriod.label],
  status: Badge(netCash >= 0 ? "Cash generative" : "Net burn", { tone: netCash >= 0 ? "success" : "warning", icon: "money-bill-trend-up" }),
  actions: [periodSelect, Button("Export board pack", { variant: "secondary", size: "sm", icon: "file-arrow-down", onClick: exportPack })]
})
kpis = Stats([
  StatCard("Cash position", { value: money(closingCash), trend: netCash >= 0 ? "up" : "down", delta: `${netCash >= 0 ? "+" : ""}${money(netCash)}`, icon: "vault", tone: "primary", spark: cashPath, hint: `Opened the quarter at ${money(openingCash)}` }),
  StatCard("Revenue", { value: money(revenueTotal), trend: prevPeriod ? (revenueDelta >= 0 ? "up" : "down") : "flat", delta: prevPeriod ? `${revenueDelta >= 0 ? "+" : ""}${share(revenueDelta)}` : "First period on record", icon: "sack-dollar", tone: "success", spark: activePeriod.revenue, hint: prevPeriod ? `vs. ${money(revenueOf(prevPeriod))} in ${prevPeriod.label}` : "Opening quarter of FY26" }),
  StatCard("Monthly burn", { value: `${money(Math.round(monthlyBurn))}/mo`, trend: prevPeriod ? (burnDelta > 0 ? "up" : "down") : "flat", delta: prevPeriod ? `${burnDelta > 0 ? "+" : "-"}${money(Math.round(Math.abs(burnDelta)))}/mo vs. ${prevPeriod.label}` : "Baseline quarter", icon: "fire", tone: monthlyBurn > 200000 ? "danger" : "warning", hint: `${money(netCash)} net for the quarter` }),
  StatCard("Runway", { value: `${$util.round(runwayMonths, 1)} months`, icon: "gauge-high", tone: runwayMonths > 36 ? "success" : runwayMonths > 18 ? "warning" : "danger", hint: "At the current quarter's burn rate" })
], { layout: "grid", columns: 4 })

plCard = Card([
  SectionHeader("Revenue vs. operating expense", { eyebrow: "P&L", subtitle: `${money(revenueTotal)} in, ${money(expenseTotal)} out across ${activePeriod.label}`, status: Badge(`${share(revenueTotal / expenseTotal)} cost coverage`, { tone: revenueTotal >= expenseTotal ? "success" : "warning" }) }),
  BarChart(activePeriod.months, { series: [Series("Revenue", { values: activePeriod.revenue }), Series("Operating expense", { values: activePeriod.expenses })], height: 250, yAxisLabel: "USD", ariaLabel: `Monthly revenue against operating expense for ${activePeriod.label}` })
])
cashCard = Card([
  SectionHeader("Cash balance", { eyebrow: "TREASURY", subtitle: `${money(openingCash)} opening → ${money(closingCash)} closing`, status: StatusDot(netCash >= 0 ? "Building" : "Drawing down", { tone: netCash >= 0 ? "success" : "warning", pulse: true }) }),
  LineChart(activePeriod.months, { series: [Series("Cash balance", { values: cashPath })], filled: true, height: 250, yAxisLabel: "USD", ariaLabel: `Month-end cash balance across ${activePeriod.label}` })
])
chartRow = Grid([plCard, cashCard], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" })

function varianceBadge(d) {
  const pct = $util.round(d.variance / d.budget * 100, 1)
  return Badge(`${d.variance > 0 ? "+" : ""}${pct}% · ${money(d.variance)}`, { tone: d.variance > 0 ? (pct > 5 ? "danger" : "warning") : "success", size: "xs", icon: d.variance > 0 ? "arrow-up" : "arrow-down" })
}
budgetCard = Card([
  SectionHeader("Budget vs. actual", { eyebrow: "BY DEPARTMENT", subtitle: `Plan ${money(activePeriod.budget)} · actual ${money(expenseTotal)}`, status: Badge(totalVariance > 0 ? `${money(totalVariance)} over plan` : `${money(0 - totalVariance)} under plan`, { tone: totalVariance > 0 ? "danger" : "success" }) }),
  Table([
    Col("Department", { values: deptRows.map(d => Text(d.name, { variant: "body-heavy" })) }),
    Col("Owner", { values: deptRows.map(d => d.lead) }),
    Col("Budget", { values: deptRows.map(d => money(d.budget)), align: "right" }),
    Col("Actual", { values: deptRows.map(d => money(d.actual)), align: "right" }),
    Col("Consumed", { values: deptRows.map(d => Progress(d.actual, { max: d.budget, tone: d.variance > 0 ? "danger" : "success" })), width: "180px" }),
    Col("Variance", { values: deptRows.map(d => varianceBadge(d)), align: "right" })
  ], { striped: true, density: "compact", ariaLabel: `Departmental budget versus actual for ${activePeriod.label}` }),
  Callout(totalVariance > 0 ? "warning" : "success", { title: totalVariance > 0 ? "Spend is running ahead of plan" : "Spend is inside plan", description: `Departmental actuals reconcile exactly to the ${money(expenseTotal)} operating expense reported on the P&L above.`, icon: "scale-balanced", compact: true })
])

agingBands = [{ label: "Current & 0–30 days", tone: "success" }, { label: "31–60 days", tone: "warning" }, { label: "60+ days", tone: "danger" }]
agingItems = agingBands.map((band, b) => ({ label: band.label, value: money(bucketTotal(b)), hint: $util.plural(bucketCount(b), "invoice"), tone: band.tone }))
agingStrip = Stats([...agingItems, { label: "Total outstanding", value: money(outstandingTotal), hint: `${share(outstandingTotal / invoicedTotal)} of invoiced`, tone: "primary" }], { layout: "strip" })
invoiceGrid = DataGrid({
  columns: [
    Col("Invoice", { values: visibleInvoices.map(i => Text(i.id, { variant: "body-heavy" })) }),
    Col("Customer", { values: visibleInvoices.map(i => i.customer), sortable: true, filterable: true }),
    Col("Segment", { values: visibleInvoices.map(i => Badge(accounts[i.customer].segment, { tone: "neutral", size: "xs" })) }),
    Col("Status", { values: visibleInvoices.map(i => Badge($util.capitalize(i.status), { tone: statusTone(i.status), size: "sm", icon: statusIcon(i.status) })) }),
    Col("Due", { values: visibleInvoices.map(i => i.due), sortable: true, render: v => fmtDate(v) }),
    Col("Age", { values: visibleInvoices.map(i => ageChip(i)), align: "center" }),
    Col("Amount", { values: visibleInvoices.map(i => i.amount), align: "right", sortable: true, render: v => money(v) })
  ],
  rowIds: visibleInvoices.map(i => i.id), sort: $invoiceSort, striped: true, density: "compact", perPage: 8, maxHeight: "480px", onRowClick: openInvoiceRow,
  caption: `Receivables for ${activePeriod.label} — select a row for the full invoice`
})

invoiceCard = Card([
  SectionHeader("Accounts receivable", { eyebrow: "INVOICE LEDGER", subtitle: `${money(invoicedTotal)} invoiced · ${money(collectedTotal)} collected · ${money(outstandingTotal)} open`, status: Badge($util.plural(overdueCount, "overdue invoice"), { tone: overdueCount > 0 ? "danger" : "success", icon: "triangle-exclamation" }) }),
  Toolbar({ left: statusOrder.map(s => FilterPill(statusLabel(s), { active: $invoiceFilter == s, count: countFor(s), icon: statusIcon(s), onToggle: () => toggleStatus(s) })), right: [Button("Chase all open", { variant: "secondary", size: "sm", icon: "bell", disabled: outstanding.length == 0, onClick: remindAll })] }),
  agingStrip,
  Show(visibleInvoices.length > 0, { fallback: EmptyState("Nothing in this state", { description: "Every invoice for this quarter sits in another status.", icon: "file-invoice-dollar" }), children: invoiceGrid })
])
expenseCard = Card([
  SectionHeader("Operating expense mix", { eyebrow: "COST STRUCTURE", subtitle: `${money(expenseTotal)} across ${expenseMix.length} categories` }),
  PieChart(expenseMix.map(c => c.name), { values: expenseAmounts, donut: true, valueFormat: "percent", size: 220, legendPosition: "bottom", ariaLabel: `Operating expense by category for ${activePeriod.label}` }),
  List(expenseMix.map((c, i) => ListItem(c.name, { icon: c.icon, description: share(expenseAmounts[i] / expenseTotal), trailing: [Text(money(expenseAmounts[i]), { variant: "body-heavy" })] })), { divided: true })
])

scenarioCard = Card([
  SectionHeader("Scenario forecast", { eyebrow: "12 MONTHS FORWARD", subtitle: `Projected from the ${money(closingCash)} ${activePeriod.label} closing balance`, status: Badge(scenarioRunway, { tone: scenarioTone }) }),
  Slider("growth", { label: "Monthly revenue growth", min: 0, max: 12, step: 0.5, value: $growth, suffix: "%", showValue: true, marks: [0, 4, 8, 12] }),
  Slider("hires", { label: "Net new hires per month", min: 0, max: 12, step: 1, value: $hires, showValue: true, marks: [0, 6, 12], hint: `Fully loaded at ${money(hireCost)} per head per month` }),
  DescriptionList([
    DescriptionItem("Cash in 12 months", { value: money(scenario.endCash), icon: "vault" }),
    DescriptionItem("Exit monthly net", { value: `${scenario.exitNet >= 0 ? "+" : ""}${money(scenario.exitNet)}`, icon: "scale-balanced" }),
    DescriptionItem("Outcome", { value: Badge(scenarioRunway, { tone: scenarioTone }), icon: "gauge-high" })
  ], { columns: 1 }),
  LineChart($util.range(1, 12).map(m => `M${m}`), { series: [Series("Projected cash", { values: scenario.path })], filled: true, height: 200, ariaLabel: "Projected cash balance over the next twelve months under the selected growth and hiring assumptions" })
])
bottomRow = Grid([expenseCard, scenarioCard], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" })

pendingApprovals = books.approvals.filter(a => a.status == "pending")
decidedApprovals = books.approvals.filter(a => a.status != "pending")
pendingValue = $util.sum(pendingApprovals.map(a => a.amount))
function approvalRow(a) {
  return ListItem(`${a.vendor} · ${money(a.amount)}`, { icon: "file-signature", description: `${a.category} — ${a.note}. Raised by ${a.requester} on ${fmtDate(a.submitted)}.`, trailing: [Button("Approve", { variant: "primary", size: "sm", icon: "check", onClick: () => decideOne(a.id, "approved") }), Button("Reject", { variant: "ghost", size: "sm", icon: "xmark", onClick: () => decideOne(a.id, "rejected") })] })
}
approvalsCard = Card([
  SectionHeader("Spend approvals", { eyebrow: "CONTROLLER QUEUE", subtitle: `${money(pendingValue)} awaiting sign-off · live queue as of ${fmtDate(today)}`, status: Badge($util.plural(pendingApprovals.length, "request"), { tone: pendingApprovals.length > 0 ? "warning" : "success" }), actions: [Button("Approve everything", { variant: "secondary", size: "sm", icon: "clipboard-check", disabled: pendingApprovals.length == 0, onClick: approveQueue })] }),
  Show(pendingApprovals.length > 0, { fallback: EmptyState("Queue clear", { description: "Every purchase request has been decided. New ones land here as they are raised.", icon: "clipboard-check" }), children: List(pendingApprovals.map(a => approvalRow(a)), { divided: true }) }),
  Separator("horizontal", { label: "Decision log" }),
  Timeline(decidedApprovals.map(a => TimelineItem(`${a.vendor} — ${$util.capitalize(a.status)}`, { time: fmtDate(a.decidedOn ?? a.submitted), icon: a.status == "approved" ? "circle-check" : "circle-xmark", tone: a.status == "approved" ? "success" : "danger", description: `${money(a.amount)} · ${a.category} · requested by ${a.requester}` })))
])

openInvoice = books.invoices.find(i => i.id == $openInvoice)
function invoiceDetail(inv) {
  return Column([
    Row([Badge($util.capitalize(inv.status), { tone: statusTone(inv.status), icon: statusIcon(inv.status) }), ageChip(inv), Spacer(), Text(money(inv.amount), { variant: "title" })], { align: "center", gap: "sm" }),
    DescriptionList([
      DescriptionItem("Customer", { value: inv.customer, icon: "building-columns" }), DescriptionItem("Segment", { value: accounts[inv.customer].segment, icon: "layer-group" }),
      DescriptionItem("Account owner", { value: accounts[inv.customer].owner, icon: "user-tie" }), DescriptionItem("Issued", { value: fmtDate(inv.issued), icon: "calendar-plus" }),
      DescriptionItem("Due", { value: fmtDate(inv.due), icon: "calendar-day" }), DescriptionItem("Reminders sent", { value: String(inv.reminders ?? 0), icon: "bell" })
    ]),
    SectionHeader("Line items", { eyebrow: "BILLING DETAIL" }),
    OrderSummary(invoiceLines(inv), { subtotal: money(invNet(inv)), tax: money(invTax(inv)), total: money(inv.amount), currency: "USD", note: "Net 30 terms · 8.25% sales tax · remitted to Meridian Field Systems, account ****4419" }),
    SectionHeader("Payment history", { eyebrow: "AUDIT TRAIL" }),
    Timeline(invoiceTrail(inv))
  ], { gap: "md" })
}
function invoiceActions(inv) {
  if (inv.status == "paid") return [Button("Reopen invoice", { variant: "ghost", icon: "rotate-left", onClick: () => reopenInvoice(inv.id) }), Button("Done", { variant: "secondary", onClick: closeInvoice })]
  return [Button("Send reminder", { variant: "secondary", icon: "bell", onClick: () => remindOne(inv.id) }), Button("Mark as paid", { variant: "primary", icon: "circle-check", onClick: () => settleInvoice(inv.id) })]
}
invoiceDrawer = Drawer(openInvoice ? `${openInvoice.id} · ${openInvoice.customer}` : "Invoice", {
  open: $openInvoice != null, side: "right", width: "560px", onClose: closeInvoice,
  children: openInvoice ? [invoiceDetail(openInvoice)] : [Text("Select a row in the receivables ledger to inspect an invoice.", { tone: "muted" })],
  footer: openInvoice ? invoiceActions(openInvoice) : []
})
