// Buttons — 10 reusable, fully-functional button components.
$app(Column([header, Column(demos, { gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Buttons", { subtitle: "10 reusable button components", badge: Badge("Components", { tone: "primary", icon: "hand-pointer" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }

// 1 — primary/secondary/ghost/danger action button
function ActionButton(label, { icon, variant = "primary", onClick } = {}) {
  return Button(label, { variant, icon, onClick: onClick || (() => {}) })
}

// 2 — button that shows a spinner for 1.5s on click
function LoadingButton(label, { variant = "primary", icon = "cloud-arrow-up" } = {}) {
  const [loading, setLoading] = $state(false)
  return Button(loading ? "Working…" : (label || "Save"), { variant, icon, loading, onClick: () => { setLoading(true); setTimeout(() => setLoading(false), 1500) } })
}

// 3 — icon-only button with accessible label
function IconAction(icon, { label, variant = "secondary", size = "md", onClick } = {}) {
  return IconButton(icon, { label: label || icon, variant, size, onClick: onClick || (() => {}) })
}

// 4 — copy-to-clipboard button with confirmation
function ClipboardButton(text, { label = "Copy" } = {}) {
  const [done, setDone] = $state(false)
  return Button(done ? "Copied!" : label, { variant: done ? "secondary" : "primary", icon: done ? "check" : "copy", onClick: () => { navigator.clipboard.writeText(text || ""); setDone(true); setTimeout(() => setDone(false), 1400) } })
}

// 5 — pressed/un-pressed toggle button
function ToggleButton(label, { icon = "star" } = {}) {
  const [on, setOn] = $state(false)
  return Button(label || "Favorite", { variant: on ? "primary" : "secondary", icon, onClick: () => setOn(!on) })
}

// 6 — increment/decrement counter as a button group
function CounterButtons({ initial = 0 } = {}) {
  const [n, setN] = $state(initial)
  return Row([
    IconButton("minus", { label: "Decrease", variant: "secondary", onClick: () => setN(n - 1) }),
    Box([Text(String(n), { variant: "body-heavy" })], { padding: "sm" }),
    IconButton("plus", { label: "Increase", variant: "secondary", onClick: () => setN(n + 1) })
  ], { gap: "sm", align: "center" })
}

// 7 — destructive button guarded by a confirm modal
function ConfirmButton(label, { onConfirm, message } = {}) {
  const [open, setOpen] = $state(false)
  return Column([
    Button(label || "Delete account", { variant: "danger", icon: "trash", onClick: () => setOpen(true) }),
    Modal("Please confirm", { open, closeOnBackdrop: true, onClose: () => setOpen(false), children: [Text(message || "This action cannot be undone.")], footer: [Button("Cancel", { variant: "ghost", onClick: () => setOpen(false) }), Button("Confirm", { variant: "danger", onClick: () => { if (onConfirm) onConfirm(); setOpen(false) } })] })
  ])
}

// 8 — primary action paired with an overflow menu
function SplitButton(label, { onClick, items = [] } = {}) {
  return Row([
    Button(label || "Save", { variant: "primary", onClick: onClick || (() => {}) }),
    DropdownMenu({ trigger: IconButton("chevron-down", { label: "More options", variant: "primary" }), items: items.map(i => MenuItem(i, { icon: "angle-right" })) })
  ], { gap: "xs", align: "center" })
}

// 9 — full-width call-to-action
function CtaButton(label, { icon = "arrow-right", onClick } = {}) {
  return Button(label || "Get started", { variant: "primary", icon, iconPosition: "trailing", size: "lg", fullWidth: true, onClick: onClick || (() => {}) })
}

// 10 — external link rendered as a button
function LinkButton(label, { href = "https://example.com", icon = "arrow-up-right-from-square" } = {}) {
  return Link(Button(label || "Open docs", { variant: "secondary", icon }), { href, external: true })
}

demos = [
  Demo("ActionButton", "Variant-driven action button", Row([ActionButton("Primary"), ActionButton("Secondary", { variant: "secondary" }), ActionButton("Ghost", { variant: "ghost" }), ActionButton("Danger", { variant: "danger", icon: "trash" })], { wrap: true, gap: "md", align: "center" })),
  Demo("LoadingButton", "Shows a spinner for 1.5s on click", Row([LoadingButton("Save changes"), LoadingButton("Upload", { variant: "secondary", icon: "upload" })], { wrap: true, gap: "md" })),
  Demo("IconAction", "Icon-only button with a11y label", Row([IconAction("pen", { label: "Edit" }), IconAction("trash", { label: "Delete", variant: "danger" }), IconAction("gear", { label: "Settings", variant: "ghost" }), IconAction("heart", { label: "Like", variant: "primary" })], { gap: "md", align: "center" })),
  Demo("ClipboardButton", "Copies text, confirms for 1.4s", Row([ClipboardButton("hello@aktion.dev"), ClipboardButton("npm i aktion-runtime", { label: "Copy install" })], { wrap: true, gap: "md" })),
  Demo("ToggleButton", "Stateful pressed toggle", Row([ToggleButton("Favorite"), ToggleButton("Pin", { icon: "thumbtack" }), ToggleButton("Mute", { icon: "bell-slash" })], { gap: "md" })),
  Demo("CounterButtons", "Independent per-instance counters", Row([CounterButtons(), CounterButtons({ initial: 10 })], { gap: "xl" })),
  Demo("ConfirmButton", "Guards a destructive action with a modal", ConfirmButton("Delete account")),
  Demo("SplitButton", "Primary action + overflow menu", SplitButton("Save", { items: ["Save and close", "Save as draft", "Save a copy"] })),
  Demo("CtaButton", "Full-width marketing CTA", CtaButton("Start free trial")),
  Demo("LinkButton", "External link styled as a button", LinkButton("Open docs"))
]
