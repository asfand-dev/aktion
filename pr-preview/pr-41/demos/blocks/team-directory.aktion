// Team Directory — searchable people grid with department filter, sort, a live
// headcount strip and a profile drawer that opens for the selected member.
$app(Column([header, stats, toolbar, grid, drawer], { gap: "lg", padding: "md" }))

people = [
  { id: "p1", name: "Ada Lovelace", role: "Engineering Lead", dept: "Engineering", email: "ada@acme.io", location: "London", status: "online" },
  { id: "p2", name: "Grace Hopper", role: "Director of Eng", dept: "Engineering", email: "grace@acme.io", location: "New York", status: "busy" },
  { id: "p3", name: "Don Norman", role: "Head of Design", dept: "Design", email: "don@acme.io", location: "San Diego", status: "online" },
  { id: "p4", name: "Julie Zhuo", role: "Product Designer", dept: "Design", email: "julie@acme.io", location: "Remote", status: "away" },
  { id: "p5", name: "Brian Chesky", role: "VP Product", dept: "Product", email: "brian@acme.io", location: "Berlin", status: "online" },
  { id: "p6", name: "Melanie Perkins", role: "Product Manager", dept: "Product", email: "mel@acme.io", location: "Sydney", status: "offline" },
  { id: "p7", name: "Seth Godin", role: "Marketing Lead", dept: "Marketing", email: "seth@acme.io", location: "Boston", status: "online" },
  { id: "p8", name: "Ann Handley", role: "Content Strategist", dept: "Marketing", email: "ann@acme.io", location: "Remote", status: "busy" }
]

$q = ""
$dept = "all"
$sort = "name"
$openId = null

depts = ["all", ...$util.unique(people.map(p => p.dept))]
statusTone = s => s == "online" ? "success" : s == "busy" ? "danger" : s == "away" ? "warning" : "default"

filtered = $util.sort(people.filter(p =>
  ($dept == "all" || p.dept == $dept) &&
  ($q == "" || p.name.toLowerCase().includes($q.toLowerCase()) || p.role.toLowerCase().includes($q.toLowerCase()))
), $sort, "asc")

selected = people.find(p => p.id == $openId)

function openMember(id) { $openId = id }
function closeMember() { $openId = null }

header = PageHeader("Team directory", { subtitle: `${people.length} people across ${depts.length - 1} departments`, breadcrumbs: false, actions: [Button("Invite", { variant: "primary", icon: "user-plus", size: "sm" })] })

online = people.filter(p => p.status == "online").length
stats = Stats([
  StatCard("Headcount", { value: String(people.length), icon: "users" }),
  StatCard("Online now", { value: String(online), icon: "circle", tone: "success" }),
  StatCard("Departments", { value: String(depts.length - 1), icon: "sitemap", tone: "info" }),
  StatCard("Remote", { value: String(people.filter(p => p.location == "Remote").length), icon: "house-laptop", tone: "warning" })
])

toolbar = Toolbar({
  left: [SearchBar("q", { placeholder: "Search name or role…", value: $q }), ToggleGroup("dept", { items: depts.map(d => ({ value: d, label: d == "all" ? "All" : d })), value: $dept, size: "sm" })],
  right: [Select("sort", { items: [SelectItem("name", { label: "Name" }), SelectItem("dept", { label: "Department" }), SelectItem("role", { label: "Role" })], value: $sort })]
})

function personCard(p) {
  return OnClick(Card([Column([
    Row([Avatar(p.name, { status: p.status }), StackItem(Column([Text(p.name, { variant: "body-heavy" }), Text(p.role, { variant: "small", tone: "muted" })], { gap: "xs" }), { grow: 1 }), StatusDot(p.status, { tone: statusTone(p.status) })], { align: "center", gap: "sm" }),
    Separator("horizontal"),
    Row([Icon("building", { size: "sm" }), Text(p.dept, { variant: "small" }), Spacer(), Icon("location-dot", { size: "sm" }), Text(p.location, { variant: "small" })], { align: "center", gap: "xs" })
  ], { gap: "sm" })]), { onClick: () => openMember(p.id) })
}

grid = Show(filtered.length > 0, {
  fallback: EmptyState("No people found", { description: "Adjust your search or filters.", icon: "user-slash" }),
  children: Grid(filtered.map(p => personCard(p)), { columns: { base: 1, sm: 2, lg: 3 }, gap: "md" })
})

drawer = Drawer(selected ? selected.name : "Member", {
  open: $openId != null, side: "right", onClose: closeMember,
  children: selected ? [Column([
    Center([Column([Avatar(selected.name, { size: "lg", status: selected.status }), Text(selected.name, { variant: "title" }), Text(selected.role, { variant: "small", tone: "muted" })], { gap: "xs", align: "center" })]),
    DescriptionList([
      DescriptionItem("Department", { value: selected.dept, icon: "building" }),
      DescriptionItem("Email", { value: selected.email, icon: "envelope" }),
      DescriptionItem("Location", { value: selected.location, icon: "location-dot" }),
      DescriptionItem("Status", { value: $util.capitalize(selected.status), icon: "circle" })
    ])
  ], { gap: "lg" })] : [Text("No member selected")],
  footer: selected ? [Button("Message", { variant: "secondary", icon: "comment" }), Button("View profile", { variant: "primary", icon: "arrow-right" })] : []
})
