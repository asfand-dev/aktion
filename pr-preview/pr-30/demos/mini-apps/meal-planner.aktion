// Meal Planner — plan breakfast, lunch and dinner across the week from a recipe
// library, then auto-generate a consolidated shopping list and a calorie tally
// per day. Starting point for: any weekly planner, scheduler or roster builder.
// Uses: $store({ persist }) plan map, Modal recipe picker, aggregation with $util, Stats.
$app(Column([header, stats, planner, Grid([shoppingCard, libraryCard], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" }), pickModal], { gap: "lg", padding: "md" }))

days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
meals = ["Breakfast", "Lunch", "Dinner"]
mealIcon = m => m == "Breakfast" ? "mug-saucer" : m == "Lunch" ? "bowl-food" : "utensils"

recipes = [
  { id: "r1", name: "Oatmeal & Berries", kcal: 320, items: ["Oats", "Blueberries", "Milk", "Honey"] },
  { id: "r2", name: "Avocado Toast", kcal: 290, items: ["Bread", "Avocado", "Eggs", "Chili flakes"] },
  { id: "r3", name: "Greek Salad", kcal: 410, items: ["Cucumber", "Tomato", "Feta", "Olives", "Olive oil"] },
  { id: "r4", name: "Chicken Wrap", kcal: 520, items: ["Tortilla", "Chicken", "Lettuce", "Yogurt"] },
  { id: "r5", name: "Salmon & Rice", kcal: 610, items: ["Salmon", "Rice", "Broccoli", "Lemon"] },
  { id: "r6", name: "Veggie Stir-fry", kcal: 480, items: ["Tofu", "Rice", "Peppers", "Soy sauce"] },
  { id: "r7", name: "Pasta Pomodoro", kcal: 560, items: ["Pasta", "Tomato", "Basil", "Parmesan"] }
]
recipeById = $util.keyBy(recipes, "id")

plan = $store({
  persist: "mealplan.week",
  cells: {},
  set: (s, key, id) => { s.cells = { ...s.cells, [key]: id } },
  clear: (s, key) => { const next = { ...s.cells }; delete next[key]; s.cells = next },
  reset: (s) => { s.cells = {} }
})

$pick = null // { day, meal } | null

cellKey = (d, m) => `${d}-${m}`
assignedCount = Object.keys(plan.cells).length

caloriesFor = d => $util.sum(meals.map(m => { const id = plan.cells[cellKey(d, m)]; return id ? recipeById[id].kcal : 0 }))

function shoppingList() {
  const counts = {}
  for (let key of Object.keys(plan.cells)) {
    const r = recipeById[plan.cells[key]]
    if (!r) continue
    for (let item of r.items) counts[item] = (counts[item] ?? 0) + 1
  }
  return Object.keys(counts).sort().map(name => ({ name, count: counts[name] }))
}
shopping = shoppingList()

header = PageHeader("Meal Planner", {
  subtitle: `${assignedCount} of ${days.length * meals.length} slots planned`,
  badge: Badge(`${shopping.length} ingredients`, { tone: "primary", icon: "basket-shopping" }),
  actions: [Button("Clear week", { variant: "ghost", icon: "trash", size: "sm", onClick: () => plan.reset(), disabled: assignedCount == 0 })]
})

stats = Stats([
  StatCard("Slots planned", { value: `${assignedCount}/${days.length * meals.length}`, icon: "calendar-check", tone: "primary" }),
  StatCard("Avg kcal/day", { value: String(Math.round($util.avg(days.map(d => caloriesFor(d))) || 0)), icon: "fire", tone: "warning" }),
  StatCard("Shopping items", { value: String(shopping.length), icon: "basket-shopping", tone: "success" })
])

function cell(d, m) {
  const id = plan.cells[cellKey(d, m)]
  const r = id ? recipeById[id] : null
  return Box([Column([
    Row([Icon(mealIcon(m), { size: "sm" }), Text(m, { variant: "small-heavy", tone: "muted" })], { gap: "xs", align: "center" }),
    r
      ? Row([StackItem(Text(r.name, { variant: "small" }), { grow: 1 }), IconButton("xmark", { label: "Remove", variant: "ghost", size: "xs", onClick: () => plan.clear(cellKey(d, m)) })], { align: "center" })
      : Button("Add", { variant: "ghost", size: "sm", icon: "plus", fullWidth: true, onClick: () => { $pick = { day: d, meal: m } } })
  ], { gap: "2xs" })], { padding: "sm", border: "subtle", background: r ? "surface" : "muted", sx: { borderRadius: "var(--rui-radius-sm)" } })
}

function dayColumn(d) {
  return Card([
    Row([StackItem(Text(d, { variant: "body-heavy" }), { grow: 1 }), Badge(`${caloriesFor(d)} kcal`, { tone: "neutral", size: "xs" })], { align: "center" }),
    Column(meals.map(m => cell(d, m)), { gap: "xs" })
  ])
}

planner = Grid(days.map(d => dayColumn(d)), { columns: { base: 1, sm: 2, md: 4, lg: 7 }, gap: "md", alignItems: "start" })

shoppingCard = Card([
  SectionHeader("Shopping list", { eyebrow: "AUTO-GENERATED" }),
  Show(shopping.length > 0, {
    fallback: EmptyState("Nothing to buy yet", { icon: "basket-shopping", description: "Plan some meals and your shopping list appears here." }),
    children: Grid(shopping.map(s => Row([
      Checkbox(`buy-${s.name}`, { label: s.name }),
      Spacer(),
      Show(s.count > 1, { children: Badge(`×${s.count}`, { tone: "neutral", size: "xs" }) })
    ], { align: "center", key: s.name })), { columns: { base: 1, sm: 2 }, gap: "xs" })
  })
])

libraryCard = Card([
  SectionHeader("Recipe library", { eyebrow: "DRAG-FREE PICKER", subtitle: "Tap a slot above to assign one of these" }),
  Column(recipes.map(r => Row([
    Icon("bowl-food", { color: "var(--rui-color-primary)" }),
    StackItem(Column([Text(r.name, { variant: "small-heavy" }), Text(r.items.join(" · "), { variant: "small", tone: "muted" })], { gap: "none" }), { grow: 1 }),
    Badge(`${r.kcal} kcal`, { tone: "warning", size: "xs" })
  ], { gap: "sm", align: "center", key: r.id })), { gap: "sm" })
])

pickModal = Modal($pick ? `${$pick.meal} · ${$pick.day}` : "Pick a recipe", {
  open: $pick != null,
  closeOnBackdrop: true,
  onClose: () => { $pick = null },
  children: [Column(recipes.map(r => OnClick(Box([Row([
    Icon("bowl-food", { color: "var(--rui-color-primary)" }),
    StackItem(Column([Text(r.name, { variant: "body-heavy" }), Text(r.items.join(", "), { variant: "small", tone: "muted" })], { gap: "none" }), { grow: 1 }),
    Badge(`${r.kcal} kcal`, { tone: "warning", size: "sm" })
  ], { gap: "sm", align: "center" })], { padding: "sm", border: "subtle", background: "surface", sx: { borderRadius: "var(--rui-radius-md)", states: { hover: { background: "var(--rui-color-muted)" } } } }), {
    onClick: () => { if ($pick) { plan.set(cellKey($pick.day, $pick.meal), r.id); $pick = null } }
  })), { gap: "sm" })]
})
