// Breathing Coach — guided box breathing with an animated pacer, presets and a session log.
// Starting point for: wellness apps, focus timers, micro-break tools.
// Uses: animate pulse pacer, SegmentedControl presets, $store({ persist }) session history, Transition.
$app(Column([header, body], { gap: "lg", padding: "md" }))

presets = {
  box:     { label: "Box 4-4-4-4",   phases: [{ name: "Inhale", secs: 4 }, { name: "Hold", secs: 4 }, { name: "Exhale", secs: 4 }, { name: "Hold", secs: 4 }] },
  relax:   { label: "Relax 4-7-8",   phases: [{ name: "Inhale", secs: 4 }, { name: "Hold", secs: 7 }, { name: "Exhale", secs: 8 }] },
  energise: { label: "Energise 6-2", phases: [{ name: "Inhale", secs: 6 }, { name: "Exhale", secs: 2 }] }
}

sessions = $store({
  persist: "breath.sessions",
  log: [],
  record: (s, entry) => { s.log = [entry, ...s.log].slice(0, 8) }
})

$preset = "box"
$running = false
$phaseIdx = 0
$phaseLeft = 4
$cycles = 0

phases = presets[$preset].phases
phase = phases[$phaseIdx] ?? phases[0]

$effect(() => {
  if ($running) {
    if ($phaseLeft > 1) { $phaseLeft = $phaseLeft - 1 }
    else {
      const next = ($phaseIdx + 1) % phases.length
      if (next == 0) $cycles = $cycles + 1
      $phaseIdx = next
      $phaseLeft = phases[next].secs
    }
  }
}, ["every(1000)"])

function start() {
  $phaseIdx = 0
  $phaseLeft = phases[0].secs
  $cycles = 0
  $running = true
}

function stop() {
  if ($cycles > 0) {
    sessions.record({ preset: presets[$preset].label, cycles: $cycles, at: $util.now() })
  }
  $running = false
}

function pickPreset(p) {
  $preset = p
  $running = false
  $phaseIdx = 0
  $phaseLeft = presets[p].phases[0].secs
  $cycles = 0
}

phaseTone = phase.name == "Inhale" ? "primary" : phase.name == "Exhale" ? "success" : "warning"

header = PageHeader("Breathing Coach", {
  subtitle: "Follow the circle — in through the nose, out through the mouth",
  badge: Badge($running ? `${$cycles} cycles` : "Ready", { tone: $running ? "success" : "neutral", icon: "wind" })
})

// The pacer: a pulsing disc whose label and colour track the current phase.
pacer = Center([Column([
  Box([Center([Column([
    Text(phase.name, { variant: "title", tone: phaseTone }),
    Text($running ? `${$phaseLeft}s` : "—", { variant: "large-heavy", tone: "muted" })
  ], { gap: "xs", align: "center" })], { minHeight: "100%" })], {
    sx: { w: "200px", h: "200px", radius: "circle", border: "strong", bg: "surface", shadow: "lg" },
    animate: $running ? { preset: "pulse", duration: 2000, repeat: true } : "fade",
    key: `pacer-${$running}-${$phaseIdx}`
  }),
  Text($running ? "Match your breath to the rhythm" : "Press start when you're comfortable", { variant: "small", tone: "muted" })
], { gap: "md", align: "center" })], { minHeight: "280px" })

controls = Column([
  SegmentedControl(Object.keys(presets), { value: $preset, onChange: pickPreset }),
  Text(presets[$preset].phases.map(p => `${p.name} ${p.secs}s`).join(" → "), { variant: "small", tone: "muted" }),
  Row([
    Button($running ? "End session" : "Start breathing", { variant: $running ? "secondary" : "primary", icon: $running ? "stop" : "play", size: "lg", onClick: () => { if ($running) stop(); else start() } })
  ], { justify: "center" })
], { gap: "md", align: "center" })

sessionCard = Card([
  SectionHeader("Session", { eyebrow: presets[$preset].label.toUpperCase() }),
  pacer,
  controls
], { animate: "fade-up" })

logCard = Card([
  SectionHeader("Recent sessions", { eyebrow: "LOG", subtitle: "Saved in this browser" }),
  Show(sessions.log.length > 0, {
    fallback: EmptyState("No sessions yet", { description: "Finish at least one full cycle and end the session to log it.", icon: "spa" }),
    children: Timeline(sessions.log.map(e => TimelineItem(`${e.preset} · ${e.cycles} cycle${e.cycles == 1 ? "" : "s"}`, {
      time: $util.formatDate(e.at, "h:mm A"),
      icon: "circle-check",
      tone: "success"
    })))
  })
], { animate: { preset: "fade-up", delay: 80 } })

body = Grid([sessionCard, logCard], { columns: { base: 1, md: 2 }, gap: "lg", alignItems: "start" })
