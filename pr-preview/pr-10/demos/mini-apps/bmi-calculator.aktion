// BMI Calculator — enter height & weight in metric or imperial units and see
// your Body Mass Index, the WHO category, a healthy-weight range and a visual
// gauge. Starting point for: any health / fitness metric calculator.
// Uses: SegmentedControl unit switch, Slider + NumberInput, Gauge, Callout, computed values.
$app(Column([header, Grid([inputs, results], { columns: { base: 1, md: 2 }, gap: "lg", alignItems: "start" }), scale], { gap: "lg", padding: "md" }))

$unit = "metric"
$cm = 175
$kg = 72
$inch = 69
$lb = 159

// normalise to metres + kilograms regardless of the active unit system
meters = $unit == "metric" ? $cm / 100 : $inch * 0.0254
kilos = $unit == "metric" ? $kg : $lb * 0.453592

bmi = meters > 0 ? kilos / (meters * meters) : 0
bmiRounded = $util.round(bmi, 1)

function categoryFor(b) {
  if (b < 18.5) return { label: "Underweight", tone: "info", icon: "feather" }
  if (b < 25) return { label: "Healthy", tone: "success", icon: "heart-pulse" }
  if (b < 30) return { label: "Overweight", tone: "warning", icon: "triangle-exclamation" }
  return { label: "Obese", tone: "danger", icon: "circle-exclamation" }
}
cat = categoryFor(bmi)

// healthy weight range (BMI 18.5–24.9) for the current height
lowKg = 18.5 * meters * meters
highKg = 24.9 * meters * meters
fmtWeight = (kg) => $unit == "metric" ? `${$util.round(kg, 1)} kg` : `${$util.round(kg / 0.453592, 0)} lb`

header = PageHeader("BMI Calculator", {
  subtitle: "Body Mass Index with WHO categories",
  badge: Badge(cat.label, { tone: cat.tone, icon: cat.icon })
})

metricFields = Column([
  FormControl(`Height — ${$cm} cm`, { field: Slider("cm", { min: 120, max: 220, step: 1, value: $cm, showValue: true }) }),
  FormControl(`Weight — ${$kg} kg`, { field: Slider("kg", { min: 35, max: 180, step: 1, value: $kg, showValue: true }) })
], { gap: "md" })

imperialFields = Column([
  FormControl(`Height — ${$inch} in`, { field: Slider("inch", { min: 48, max: 84, step: 1, value: $inch, showValue: true }) }),
  FormControl(`Weight — ${$lb} lb`, { field: Slider("lb", { min: 80, max: 400, step: 1, value: $lb, showValue: true }) })
], { gap: "md" })

inputs = Card([
  SectionHeader("Your measurements", { eyebrow: "INPUTS" }),
  Row([Text("Units", { variant: "small-heavy", tone: "muted" }), Spacer(), SegmentedControl(["metric", "imperial"], { value: $unit, onChange: (v) => { $unit = v } })], { align: "center" }),
  Separator("horizontal"),
  $unit == "metric" ? metricFields : imperialFields
], { animate: "fade-up" })

results = Card([
  SectionHeader("Your result", { eyebrow: "BMI" }),
  Center([Gauge(bmi, { min: 10, max: 40, caption: `BMI ${bmiRounded}`, tone: cat.tone, size: "lg" })]),
  DescriptionList([
    DescriptionItem("Category", { value: cat.label, icon: cat.icon }),
    DescriptionItem("Healthy range", { value: `${fmtWeight(lowKg)} – ${fmtWeight(highKg)}`, icon: "ruler" })
  ], { columns: 1 }),
  Callout(cat.tone == "success" ? "success" : "info", {
    title: cat.tone == "success" ? "You're in a healthy range" : `BMI suggests: ${cat.label.toLowerCase()}`,
    description: "BMI is a rough screening tool — it ignores muscle, age and build. Talk to a clinician for real advice.",
    icon: "circle-info", compact: true
  })
], { animate: { preset: "fade-up", delay: 80 } })

bands = [
  { label: "Underweight", range: "< 18.5", tone: "info" },
  { label: "Healthy", range: "18.5 – 24.9", tone: "success" },
  { label: "Overweight", range: "25 – 29.9", tone: "warning" },
  { label: "Obese", range: "≥ 30", tone: "danger" }
]

scale = Card([
  SectionHeader("WHO categories"),
  Grid(bands.map(b => Tile(b.label, {
    value: b.range,
    tone: b.tone,
    icon: b.label == cat.label ? "location-crosshairs" : null,
    description: b.label == cat.label ? "You are here" : null
  })), { columns: { base: 2, md: 4 }, gap: "sm" })
])
