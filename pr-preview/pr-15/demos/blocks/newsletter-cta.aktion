// Newsletter CTA — a subscribe block with topic preferences, frequency choice,
// inline validation, a success state and a small social-proof footer.
$app(Center([Container([card], { size: "sm" })], { minHeight: "70vh" }))

$email = ""
$frequency = "weekly"
$topics = { product: true, engineering: false, design: false }
$subscribed = false

emailValid = $email.includes("@") && $email.includes(".")
chosen = Object.keys($topics).filter(k => $topics[k])
canSubscribe = emailValid && chosen.length > 0

function toggleTopic(key) { $topics = { ...$topics, [key]: !$topics[key] } }
function subscribe() {
  if (!canSubscribe) return
  $subscribed = true
}
function reset() {
  $subscribed = false
  $email = ""
}

topics = [
  { key: "product", label: "Product updates", icon: "box" },
  { key: "engineering", label: "Engineering deep-dives", icon: "code" },
  { key: "design", label: "Design & UX", icon: "pen-ruler" }
]

successView = Card([Center([Column([
  Icon("envelope-circle-check", { size: "lg", color: "var(--rui-color-success)" }),
  SectionHeader("You're subscribed!", { subtitle: `Confirmation sent to ${$email}` }),
  Text(`You'll get ${$frequency} emails on ${chosen.length} ${$util.plural(chosen.length, "topic")}.`, { variant: "small", tone: "muted" }),
  Button("Manage preferences", { variant: "secondary", icon: "sliders", onClick: reset })
], { gap: "md", align: "center" })], { minHeight: "240px" })])

form = Card([Column([
  Column([
    Badge("Newsletter", { tone: "primary", icon: "newspaper" }),
    Text("Join 12,000+ builders", { variant: "title" }),
    Text("Curated insights in your inbox. No spam, unsubscribe anytime.", { variant: "small", tone: "muted" })
  ], { gap: "xs" }),
  FormControl("Email address", {
    field: Input("email", { type: "email", value: $email, placeholder: "you@example.com" }),
    hint: $email.length > 0 && !emailValid ? "Enter a valid email." : null
  }),
  FormControl("What interests you?", {
    field: Column(topics.map(t => Checkbox(t.key, { label: t.label, value: $topics[t.key], onChange: () => toggleTopic(t.key) })), { gap: "xs" })
  }),
  FormControl("How often?", {
    field: ToggleGroup("frequency", { items: [{ value: "daily", label: "Daily" }, { value: "weekly", label: "Weekly" }, { value: "monthly", label: "Monthly" }], value: $frequency, size: "sm" })
  }),
  Button("Subscribe", { variant: "primary", icon: "paper-plane", fullWidth: true, disabled: !canSubscribe, onClick: subscribe }),
  Row([Icon("lock", { size: "sm" }), Text("We respect your privacy.", { variant: "small", tone: "muted" })], { gap: "xs", align: "center" })
], { gap: "md" })])

card = Show($subscribed, { fallback: form, children: successView })
