// Recipe Box — a personal recipe manager: search, tag filters, favourites and a detail panel.
// Starting point for: any personal-collection / CRUD app (recipes, plants, records, gear…).
// Uses: $store({ persist }), $form with rules, Sheet detail view, sx hover states, animate.
$app(Column([header, toolbar, gallery, detailSheet, addModal], { gap: "lg", padding: "md" }))

box = $store({
  persist: "recipes.box",
  recipes: [
    { id: "r1", name: "Weeknight ramen", time: 25, servings: 2, tags: ["Dinner", "Quick"], fav: true,
      ingredients: "2 packs ramen noodles\n4 cups chicken stock\n2 eggs\n2 scallions\n1 tbsp miso", steps: "Simmer the stock with miso.\nCook noodles 3 minutes.\nSoft-boil the eggs.\nAssemble and top with scallions." },
    { id: "r2", name: "Overnight oats", time: 5, servings: 1, tags: ["Breakfast", "Healthy"], fav: false,
      ingredients: "1/2 cup rolled oats\n1/2 cup milk\n1 tbsp chia seeds\nBerries\nHoney", steps: "Mix everything in a jar.\nRefrigerate overnight.\nTop with berries before serving." },
    { id: "r3", name: "Sheet-pan salmon", time: 30, servings: 4, tags: ["Dinner", "Healthy"], fav: true,
      ingredients: "4 salmon fillets\n500g baby potatoes\n2 cups broccoli\nOlive oil\nLemon", steps: "Roast potatoes 15 min at 220°C.\nAdd salmon + broccoli.\nRoast 12 more minutes.\nFinish with lemon." },
    { id: "r4", name: "Mug brownie", time: 4, servings: 1, tags: ["Dessert", "Quick"], fav: false,
      ingredients: "4 tbsp flour\n2 tbsp cocoa\n3 tbsp sugar\n3 tbsp milk\n1 tbsp oil", steps: "Stir everything in a mug.\nMicrowave 70 seconds.\nLet it rest one minute." }
  ],
  toggleFav: (s, id) => { s.recipes = s.recipes.map(r => r.id == id ? { ...r, fav: !r.fav } : r) },
  add:       (s, r) => { s.recipes = [r, ...s.recipes] },
  remove:    (s, id) => { s.recipes = s.recipes.filter(r => r.id != id) }
})

allTags = ["Breakfast", "Dinner", "Dessert", "Quick", "Healthy"]
$q = ""
$tag = "all"
$openId = ""
$addOpen = false

addForm = $form({
  values: { name: "", time: 20, servings: 2, tag: "Dinner", ingredients: "", steps: "" },
  rules: {
    name:        [$util.rules.required("Name the dish"), $util.rules.minLength(3)],
    ingredients: [$util.rules.required("List at least one ingredient")],
    steps:       [$util.rules.required("Describe the method")]
  },
  onSubmit: (v) => {
    box.add({ id: $util.uuid(), name: v.name, time: Number(v.time) || 0, servings: Number(v.servings) || 1, tags: [v.tag], fav: false, ingredients: v.ingredients, steps: v.steps })
    $addOpen = false
    addForm.reset()
  }
})

visible = box.recipes.filter(r =>
  ($tag == "all" || r.tags.includes($tag)) &&
  (!$q || r.name.toLowerCase().includes($q.toLowerCase()))
)
current = box.recipes.find(r => r.id == $openId)

header = PageHeader("Recipe Box", {
  subtitle: `${box.recipes.length} recipes · ${box.recipes.filter(r => r.fav).length} favourites · saved locally`,
  badge: Badge("Personal collection", { tone: "primary", icon: "utensils" }),
  actions: [Button("Add recipe", { variant: "primary", icon: "plus", onClick: () => { addForm.reset(); $addOpen = true } })]
})

toolbar = Row([
  StackItem(SearchBar("q", { placeholder: "Search recipes…", value: $q }), { grow: 1 }),
  SegmentedControl(["all", ...allTags], { value: $tag, onChange: (t) => { $tag = t } })
], { gap: "md", align: "center", wrap: true })

recipeCard = (r, i) => Card([
  Row([
    StackItem(Text(r.name, { variant: "large-heavy" }), { grow: 1 }),
    IconButton(r.fav ? "heart" : "heart-crack", { label: "Toggle favourite", variant: r.fav ? "primary" : "ghost", size: "sm", onClick: () => box.toggleFav(r.id) })
  ], { align: "center" }),
  Row([
    Badge(`${r.time} min`, { tone: "info", size: "sm", icon: "clock" }),
    Badge(`Serves ${r.servings}`, { tone: "neutral", size: "sm", icon: "user-group" })
  ], { gap: "xs" }),
  BadgeList(r.tags, { size: "sm" }),
  Button("Open recipe", { variant: "secondary", icon: "book-open", fullWidth: true, onClick: () => { $openId = r.id } })
], {
  key: r.id,
  animate: { preset: "fade-up", delay: Math.min(i, 7) * 50 },
  sx: { states: { hover: { translateY: "-3px", shadow: "lg" } } }
})

gallery = Show(visible.length > 0, {
  fallback: EmptyState("Nothing matches", { description: "Try another search or tag — or add the recipe you're craving.", icon: "plate-wheat" }),
  children: Grid(visible.map((r, i) => recipeCard(r, i)), { columns: { base: 1, sm: 2, lg: 4 }, gap: "lg" })
})

detailBody = current
  ? Column([
      Row([
        Badge(`${current.time} min`, { tone: "info", icon: "clock" }),
        Badge(`Serves ${current.servings}`, { tone: "neutral", icon: "user-group" }),
        BadgeList(current.tags, { size: "sm" })
      ], { gap: "xs", wrap: true }),
      Text("Ingredients", { variant: "large-heavy" }),
      List(current.ingredients.split("\n").filter(x => x).map(x => ListItem(x, { icon: "circle-check" }))),
      Separator("horizontal", { label: "method" }),
      Column(current.steps.split("\n").filter(x => x).map((s, i) => Row([
        Badge(String(i + 1), { tone: "primary", size: "sm" }),
        StackItem(Text(s, { variant: "body" }), { grow: 1 })
      ], { gap: "sm", align: "start" })), { gap: "sm" }),
      Row([
        Button("Delete recipe", { variant: "danger", icon: "trash", onClick: () => { box.remove(current.id); $openId = "" } }),
        Spacer(),
        Button("Close", { variant: "secondary", onClick: () => { $openId = "" } })
      ], { gap: "sm" })
    ], { gap: "md" })
  : Text("", { variant: "small" })

detailSheet = Sheet([detailBody], {
  open: !!current,
  side: "right",
  title: current ? current.name : "Recipe",
  onClose: () => { $openId = "" }
})

addModal = Modal("Add a recipe", {
  open: $addOpen,
  closeOnBackdrop: true,
  onClose: () => { $addOpen = false },
  children: [Column([
    FormControl("Name", { field: Input("rName", { placeholder: "e.g. Lemon pasta", value: addForm.values.name, error: addForm.errors.name, onBlur: () => addForm.touch("name") }) }),
    Grid([
      FormControl("Minutes", { field: NumberInput("rTime", { value: addForm.values.time, min: 1, step: 5 }) }),
      FormControl("Servings", { field: NumberInput("rServ", { value: addForm.values.servings, min: 1, step: 1 }) }),
      FormControl("Tag", { field: Select("rTag", { items: allTags.map(t => SelectItem(t, { label: t })), value: addForm.values.tag }) })
    ], { columns: 3, gap: "sm" }),
    FormControl("Ingredients (one per line)", { field: TextArea("rIng", { rows: 4, value: addForm.values.ingredients, error: addForm.errors.ingredients, onBlur: () => addForm.touch("ingredients") }) }),
    FormControl("Steps (one per line)", { field: TextArea("rSteps", { rows: 4, value: addForm.values.steps, error: addForm.errors.steps, onBlur: () => addForm.touch("steps") }) })
  ], { gap: "md" })],
  footer: [
    Button("Cancel", { variant: "ghost", onClick: () => { $addOpen = false } }),
    Button("Save recipe", { variant: "primary", icon: "check", onClick: () => addForm.submit(), disabled: !addForm.values.name })
  ]
})
