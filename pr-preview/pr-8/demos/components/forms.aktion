// Forms — 9 reusable composite form components (controlled via $state).
$app(Column([header, Grid(demos, { columns: { base: 1, lg: 2 }, gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Forms", { subtitle: "9 reusable form components", badge: Badge("Components", { tone: "primary", icon: "rectangle-list" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }

// 1 — login form
function LoginForm() {
  const [email, setEmail] = $state("")
  const [pw, setPw] = $state("")
  const valid = email.includes("@") && pw.length >= 6
  return Column([
    FormControl("Email", { field: Input("email", { type: "email", value: email, onChange: setEmail, placeholder: "you@example.com" }) }),
    FormControl("Password", { field: PasswordInput("pw", { value: pw, onChange: setPw, placeholder: "Your password" }) }),
    Row([Checkbox("remember", { label: "Remember me" }), Spacer(), Link("Forgot?", { href: "#" })], { align: "center" }),
    Button("Sign in", { variant: "primary", fullWidth: true, icon: "right-to-bracket", disabled: !valid })
  ], { gap: "md" })
}

// 2 — signup form with terms gate
function SignupForm() {
  const [name, setName] = $state("")
  const [email, setEmail] = $state("")
  const [pw, setPw] = $state("")
  const [agree, setAgree] = $state(false)
  return Column([
    FormControl("Full name", { field: Input("name", { value: name, onChange: setName, placeholder: "Ada Lovelace" }) }),
    FormControl("Email", { field: Input("email2", { type: "email", value: email, onChange: setEmail, placeholder: "you@example.com" }) }),
    FormControl("Password", { field: PasswordInput("pw2", { value: pw, onChange: setPw, strengthMeter: true }) }),
    Checkbox("agree", { label: "I agree to the Terms of Service", value: agree, onChange: setAgree }),
    Button("Create account", { variant: "primary", fullWidth: true, disabled: !(name && email.includes("@") && pw.length >= 8 && agree) })
  ], { gap: "md" })
}

// 3 — contact form
function ContactForm() {
  const [name, setName] = $state("")
  const [email, setEmail] = $state("")
  const [msg, setMsg] = $state("")
  return Column([
    Grid([FormControl("Name", { field: Input("cn", { value: name, onChange: setName }) }), FormControl("Email", { field: Input("ce", { type: "email", value: email, onChange: setEmail }) })], { columns: { base: 1, sm: 2 }, gap: "md" }),
    FormControl("Message", { field: TextArea("cm", { value: msg, onChange: setMsg, rows: 4, placeholder: "How can we help?" }) }),
    Button("Send message", { variant: "primary", icon: "paper-plane", disabled: !(name && email.includes("@") && msg) })
  ], { gap: "md" })
}

// 4 — newsletter signup with success state
function NewsletterForm() {
  const [email, setEmail] = $state("")
  const [done, setDone] = $state(false)
  return done
    ? Callout("success", { title: "You're subscribed!", description: `We'll email ${email}.`, icon: "circle-check" })
    : Row([StackItem(Input("nl", { type: "email", value: email, onChange: setEmail, placeholder: "you@example.com" }), { grow: 1 }), Button("Subscribe", { variant: "primary", icon: "envelope", disabled: !email.includes("@"), onClick: () => setDone(true) })], { gap: "sm", align: "end" })
}

// 5 — search + filter bar
function SearchFilters() {
  const [q, setQ] = $state("")
  const [cat, setCat] = $state("all")
  const [sort, setSort] = $state("new")
  return Column([
    SearchBar("sfq", { placeholder: "Search…", value: q, onChange: setQ }),
    Row([
      StackItem(Select("cat", { items: [SelectItem("all", { label: "All categories" }), SelectItem("apparel", { label: "Apparel" }), SelectItem("tech", { label: "Tech" })], value: cat, onChange: setCat }), { grow: 1 }),
      StackItem(Select("sort", { items: [SelectItem("new", { label: "Newest" }), SelectItem("price", { label: "Price" }), SelectItem("pop", { label: "Popular" })], value: sort, onChange: setSort }), { grow: 1 })
    ], { gap: "sm" })
  ], { gap: "md" })
}

// 6 — settings switch list bound to an object
function SettingsList() {
  const [s, setS] = $state({ notif: true, marketing: false, twofa: true })
  const set = (k, v) => setS({ ...s, [k]: v })
  return Column([
    Switch("notif", { label: "Push notifications", value: s.notif, onChange: v => set("notif", v) }),
    Switch("marketing", { label: "Marketing emails", value: s.marketing, onChange: v => set("marketing", v) }),
    Switch("twofa", { label: "Two-factor auth", description: "Strongly recommended", value: s.twofa, onChange: v => set("twofa", v) })
  ], { gap: "sm" })
}

// 7 — feedback form with rating + success
function FeedbackForm() {
  const [rating, setRating] = $state(0)
  const [msg, setMsg] = $state("")
  const [sent, setSent] = $state(false)
  return sent
    ? SuccessState("Thanks for your feedback!", { description: "We read every response.", icon: "heart" })
    : Column([
        FormControl("How was your experience?", { field: Rating(rating, { interactive: true, value: rating, max: 5, onChange: setRating }) }),
        FormControl("Comments", { field: TextArea("fb", { value: msg, onChange: setMsg, rows: 3, placeholder: "Tell us more…" }) }),
        Button("Submit feedback", { variant: "primary", disabled: rating == 0, onClick: () => setSent(true) })
      ], { gap: "md" })
}

// 8 — address form
function AddressForm() {
  const [street, setStreet] = $state("")
  const [city, setCity] = $state("")
  const [zip, setZip] = $state("")
  return Column([
    FormControl("Street", { field: Input("st", { value: street, onChange: setStreet, placeholder: "123 Maple St" }) }),
    Grid([FormControl("City", { field: Input("ci", { value: city, onChange: setCity }) }), FormControl("ZIP", { field: MaskedInput("zip", { mask: "99999", value: zip, onChange: setZip }) })], { columns: 2, gap: "md" }),
    Button("Save address", { variant: "primary", icon: "location-dot" })
  ], { gap: "md" })
}

// 9 — labelled field group / section
function FieldGroup(label, { helper, fields = [] } = {}) {
  return FormSection(label, { helper, children: fields })
}

demos = [
  Demo("LoginForm", "Email + password sign in", LoginForm()),
  Demo("SignupForm", "Signup with strength + terms", SignupForm()),
  Demo("ContactForm", "Name / email / message", ContactForm()),
  Demo("NewsletterForm", "Inline subscribe + success", NewsletterForm()),
  Demo("SearchFilters", "Search + category + sort", SearchFilters()),
  Demo("SettingsList", "Switch list → object", SettingsList()),
  Demo("FeedbackForm", "Rating + comment", FeedbackForm()),
  Demo("AddressForm", "Address fields", AddressForm()),
  Demo("FieldGroup", "Grouped form section", FieldGroup("Profile", { helper: "Shown on your public page", fields: [FormControl("Display name", { field: Input("dn", { placeholder: "ada" }) }), FormControl("Headline", { field: Input("hl", { placeholder: "Engineer & tinkerer" }) })] }))
]
