// AI Content Studio — pick a template, fill a validated brief, generate three marketing
// variants, then edit, diff, file and meter them. The model is a MOCK: no network and no
// API calls — canned copy from inline data revealed behind a setTimeout "thinking" delay.
// Starting point for: any AI generation surface with variants, a library and credit metering.
// Uses: $form, $store (voice/library/usage), pending→resolved setTimeout, Markdown, DiffViewer, DataGrid, BarChart, Drawer.
$app(Column([header, upgradeBanner, templateGallery, briefRow, resultsSection, compareCard, libraryCard, usageCard, previewDrawer], { gap: "lg", padding: "md" }))

// ---- Inline catalogues (invented models, priced per million tokens) ---------
modelList = [
  { id: "flash", name: "Lumen 3 Flash", inPrice: 0.35, outPrice: 1.1, tps: 210, weight: 1, blurb: "Fast drafts — best for volume" },
  { id: "studio", name: "Lumen 3 Studio", inPrice: 1.25, outPrice: 5, tps: 118, weight: 1.8, blurb: "Balanced quality and speed" },
  { id: "pro", name: "Lumen 3 Pro", inPrice: 4, outPrice: 16, tps: 54, weight: 3, blurb: "Long-form, strongest reasoning" }]
templates = [
  { id: "blog", label: "Blog post", icon: "newspaper", description: "900 words, SEO-shaped", credits: 6, audience: "Marketing leaders", tone: "insightful", words: 900, keywords: ["retention", "activation", "lifecycle"] },
  { id: "product", label: "Product description", icon: "tag", description: "PDP copy with feature bullets", credits: 2, audience: "Online shoppers", tone: "confident", words: 180, keywords: ["waterproof", "24h battery"] },
  { id: "ad", label: "Ad copy", icon: "bullhorn", description: "Paid social, three hooks", credits: 2, audience: "Cold traffic", tone: "punchy", words: 80, keywords: ["free trial", "no card"] },
  { id: "email", label: "Email sequence", icon: "envelope-open-text", description: "Five-touch nurture flow", credits: 8, audience: "Trial users", tone: "helpful", words: 420, keywords: ["onboarding", "day 3"] },
  { id: "social", label: "Social thread", icon: "hashtag", description: "Seven posts with a hook", credits: 3, audience: "Practitioners", tone: "punchy", words: 240, keywords: ["benchmark", "teardown"] }]

// Canned generations — four angles per template so a re-roll always finds a fresh one.
bank = {
  blog: [
    { angle: "Data-led explainer", body: "Most lifecycle programmes are measured at signup and forgotten by day 30 — which is where **{topic}** stops being a slogan and becomes a P&L line.\n\n- Instrument the first 72 hours, not the first click\n- Tie every send to one observed behaviour\n- Report activation weekly, beside pipeline\n\nTeams that do this recover 6–9% of first-year revenue without buying a single extra lead." },
    { angle: "Contrarian take", body: "The uncomfortable read on **{topic}**: the funnel is fine, the second week is not.\n\nPaid spend flatters the dashboard for a quarter; the cohort curve tells the truth two quarters later. Across 40 mid-market accounts, the teams that cut acquisition 15% and moved it into onboarding ended the year ahead on net revenue." },
    { angle: "Practitioner playbook", body: "A working sequence for **{topic}**, in the order we would actually ship it.\n\n1. Pick one activation event you can defend in a room\n2. Baseline it by cohort, not by month\n3. Ship two interventions, kill the weaker one in 14 days\n4. Only then buy more traffic\n\nNo revolutionary tooling required — a warehouse table and a weekly review is enough." },
    { angle: "Customer story", body: "Northwind's growth team inherited a 41% day-30 drop and a mandate to fix **{topic}** without new headcount.\n\nThey rewrote three emails, moved the setup checklist above the fold, and reported activation next to pipeline. Day-30 retention reached 58% in a quarter and support tickets fell 22% — mostly because people finished setup." }],
  product: [
    { angle: "Benefit-first", body: "**{topic}** — built for the days that do not go to plan.\n\n- Sealed to IP68, so rain is a non-event\n- 24 hours of real playback, not lab playback\n- Pairs to two devices at once and remembers both\n\nCharge it for ten minutes before you leave and it will outlast the trip home." },
    { angle: "Spec-led", body: "**{topic}**\n\n40mm drivers · 24h battery · IP68 · USB-C · 246g\n\nThe housing is a single magnesium shell, so nothing rattles at volume. Firmware ships over the app and takes under a minute. Two-year warranty, replaceable earpads, no proprietary cable to lose." },
    { angle: "Objection-handling", body: "Wondering whether **{topic}** is worth the step up from the model below it?\n\nThe honest answer: only if you wear them more than an hour a day. You are paying for the sealed housing and the battery, not a revolutionary sound signature. If you mostly listen at a desk, buy the cheaper pair." },
    { angle: "Lifestyle", body: "Some mornings the commute is a podcast. Some mornings it is weather. **{topic}** was built for both.\n\nA sealed shell that shrugs off a downpour, a battery that survives a forgotten charge, and a fit that stops being noticeable somewhere around minute three." }],
  ad: [
    { angle: "Problem hook", body: "**Your onboarding is where the money leaks.**\n\n{topic} — see the drop-off in your own funnel in under four minutes. Free trial, no card, cancel from the settings page.\n\n→ *Start the trial*" },
    { angle: "Proof hook", body: "**58% day-30 retention. Same product, better first week.**\n\nThat is what Northwind got from {topic}. Free trial, no card required, no call with sales.\n\n→ *See how they did it*" },
    { angle: "Curiosity hook", body: "**The metric your board never asks about.**\n\nMost teams report signups. The teams that grow report {topic}. Fourteen days free, no card.\n\n→ *Try it on your own data*" },
    { angle: "Direct offer", body: "**{topic}, set up in an afternoon.**\n\nConnect the warehouse, pick one activation event, get a cohort chart your CFO will actually read. Free for 14 days.\n\n→ *Connect a warehouse*" }],
  email: [
    { angle: "Welcome + one job", body: "**Subject: one thing before you explore**\n\nThanks for starting a trial. Most people who get value from {topic} do the same thing first: connect one data source and pick one activation event.\n\nThat is it for today. Reply if the connector list is missing yours — we add them weekly." },
    { angle: "Day 3 nudge", body: "**Subject: your first cohort chart**\n\nYou connected a source on Monday, so there is enough history for a first cohort view of {topic}.\n\n- Open Cohorts → *Day 30*\n- Compare last month against the month before\n- Send the chart to one colleague\n\nIf it looks wrong, the activation event is usually too generous." },
    { angle: "Value recap", body: "**Subject: what your trial found**\n\nEight days in, here is what {topic} surfaced on your workspace: a 41% day-30 drop concentrated in accounts that never finished setup.\n\nThe fix is rarely a new feature. It is usually the order of the first three screens." },
    { angle: "Last-day close", body: "**Subject: your trial ends tomorrow**\n\nNo pressure and no countdown timer. If {topic} has not earned a line in the budget, close the tab — we keep the workspace for 30 days in case you come back.\n\nIf it has, the Team plan is $290 a month and takes one click to leverage." }],
  social: [
    { angle: "Teardown thread", body: "**1/ We read 40 onboarding flows to understand {topic}. Nine were good. Here is what those nine did.**\n\n2/ They asked for one decision on screen one. Not five.\n\n3/ They showed real data inside four minutes — sample data if the account was empty.\n\n7/ None of them mentioned synergy. Not once." },
    { angle: "Benchmark thread", body: "**1/ Median day-30 retention in our B2B sample: 43%. Top decile: 71%. {topic} explains most of that gap.**\n\n2/ It is not pricing — both groups price within 12% of each other.\n\n5/ It is whether setup finishes in one sitting.\n\n7/ Chart and method in the reply." },
    { angle: "Hot take thread", body: "**1/ Unpopular: your acquisition team is not the problem. {topic} is.**\n\n2/ Paid gets blamed because it is measurable.\n\n4/ The second week has no owner in most orgs, so nobody defends it in planning.\n\n7/ Give it an owner before you give it a budget." },
    { angle: "Build-in-public thread", body: "**1/ We rebuilt our own onboarding around {topic} last month. Numbers, warts and all.**\n\n2/ Setup completion: 54% → 71%.\n\n3/ Day-30 retention: 46% → 58%.\n\n5/ Support tickets down 22%, all from the setup category.\n\n7/ What failed: a revolutionary interactive tour nobody finished." }]
}

// ---- Stores: brand voice, saved library, credit meter ----------------------
presets = { northwind: { warmth: 62, boldness: 48 }, launch: { warmth: 70, boldness: 84 }, enterprise: { warmth: 22, boldness: 30 } }
swaps = { revolutionary: "genuinely new", leverage: "put to work", synergy: "shared upside", "cutting-edge": "current", "world-class": "well-built" }
openers = { "warm-bold": "Let us skip the throat-clearing.", "warm-measured": "Here is what we keep seeing, plainly put.", "even-bold": "One number reframes this whole conversation.", "even-measured": "A short read, with the caveats left in.", "formal-bold": "The case is stronger than the category admits.", "formal-measured": "This note sets out the evidence and its limits." }

voice = $store({
  persist: "studio.voice",
  warmth: 62, boldness: 48, banned: ["revolutionary", "leverage", "synergy"],
  sample: "We build tools that get out of the way. Short sentences. Real numbers. No adjective doing work a metric could do.",
  setWarmth: (s, v) => { s.warmth = v }, setBoldness: (s, v) => { s.boldness = v },
  setBanned: (s, v) => { s.banned = v }, setSample: (s, v) => { s.sample = v },
  applyPreset: (s, id) => { const p = presets[id] ?? presets.northwind; s.warmth = p.warmth; s.boldness = p.boldness }
})

lib = $store({
  persist: "studio.library",
  items: [
    { id: "p1", title: "Activation beats acquisition in 2026", type: "Blog post", status: "published", words: 912, updated: 1754380000000, body: "**A short read, with the caveats left in.**\n\nMost lifecycle programmes are measured at signup and forgotten by day 30." },
    { id: "p2", title: "Harbour 40 — sealed over-ear", type: "Product description", status: "approved", words: 168, updated: 1754290000000, body: "**Harbour 40 — built for the days that do not go to plan.**\n\n- Sealed to IP68\n- 24 hours of real playback" },
    { id: "p3", title: "Trial nurture — five touches", type: "Email sequence", status: "draft", words: 438, updated: 1754210000000, body: "**Subject: one thing before you explore**\n\nThanks for starting a trial." },
    { id: "p4", title: "Onboarding teardown thread", type: "Social thread", status: "approved", words: 231, updated: 1754120000000, body: "**1/ We read 40 onboarding flows. Nine were good.**" },
    { id: "p5", title: "Cold traffic — problem hook", type: "Ad copy", status: "draft", words: 62, updated: 1754040000000, body: "**Your onboarding is where the money leaks.**" }],
  add: (s, item) => { s.items = [item, ...s.items] },
  setStatus: (s, id, status) => { s.items = s.items.map(i => i.id == id ? { ...i, status: status, updated: $util.now() } : i) },
  remove: (s, id) => { s.items = s.items.filter(i => i.id != id) }
})

usage = $store({
  persist: "studio.usage",
  limit: 2400,
  byDay: [{ day: "Mon", credits: 214 }, { day: "Tue", credits: 388 }, { day: "Wed", credits: 296 }, { day: "Thu", credits: 451 }, { day: "Fri", credits: 330 }, { day: "Sat", credits: 96 }, { day: "Sun", credits: 172 }],
  spend: (s, n) => { const last = s.byDay.length - 1; s.byDay = s.byDay.map((d, i) => i == last ? { ...d, credits: d.credits + n } : d) }
})

// ---- State + pure helpers ---------------------------------------------------
$template = "blog"
$edits = []
$running = false
$rerolling = ""
$editingId = ""
$editDraft = ""
$lastCredits = 96
$lastRunAt = 1754400000000
$leftId = "v1"
$rightId = "v2"
$libQuery = ""
$libStatus = "all"
$previewId = ""

noise = ["\n", "*", "_", "#", "·", ">", "|"]
wordCount = text => noise.reduce((a, c) => a.split(c).join(" "), text).split(" ").filter(w => w.length > 0).length
tokensOf = text => Math.round(wordCount(text) * 1.34)
money = n => `$${n.toFixed(4)}`
templateById = id => templates.find(t => t.id == id) ?? templates[0]
modelById = id => modelList.find(m => m.id == id) ?? modelList[0]
bankFor = id => bank[id] ?? bank.blog
editOf = id => { const e = $edits.find(x => x.id == id); return e ? e.body : null }
voiceKey = () => `${voice.warmth > 60 ? "warm" : voice.warmth > 30 ? "even" : "formal"}-${voice.boldness > 55 ? "bold" : "measured"}`
openerFor = () => openers[voiceKey()] ?? openers["even-measured"]
scrub = text => voice.banned.reduce((acc, w) => acc.split(w).join(swaps[w] ?? "—"), text)
swapHits = text => voice.banned.filter(w => text.includes(w)).length
statusTone = s => s == "published" ? "success" : s == "approved" ? "info" : "neutral"

function readability(text) {
  const avg = wordCount(text) / Math.max(1, text.split(".").length - 1 + text.split("?").length - 1)
  return avg < 15 ? { label: "Easy · grade 7", tone: "success" } : avg < 21 ? { label: "Plain · grade 10", tone: "info" } : { label: "Dense · grade 13", tone: "warning" }
}

function compose(v) {
  const topic = v.spec.topic.trim().length > 0 ? v.spec.topic.trim() : templateById(v.spec.template).label.toLowerCase()
  const kw = v.spec.keywords.length > 0 ? `\n\n_Keywords woven in: ${v.spec.keywords.join(" · ")}_` : ""
  const avoid = v.spec.avoid.trim().length > 0 ? `\n\n_Avoiding: ${v.spec.avoid.trim()}_` : ""
  return `**${openerFor()}**\n\n${v.raw.split("{topic}").join(topic)}${kw}${avoid}`
}

sourceOf = v => editOf(v.id) ?? compose(v)
bodyOf = v => scrub(sourceOf(v))

function makeVariant(spec, slot, idx) {
  const pick = bankFor(spec.template)[idx % bankFor(spec.template).length]
  const m = modelById(spec.model)
  return { id: `v${slot + 1}`, slot: slot, idx: idx, angle: pick.angle, raw: pick.body, spec: spec, model: m, latency: `${(0.4 + spec.words * 1.34 / m.tps).toFixed(1)}s` }
}

seedSpec = { template: "blog", topic: "Why activation beats acquisition in 2026", audience: "Marketing leaders", tone: "insightful", words: 900, keywords: ["retention", "activation", "lifecycle"], avoid: "hype adjectives, exclamation marks", model: "studio" }
$variants = [0, 1, 2].map(i => makeVariant(seedSpec, i, i))

// ---- The brief form ---------------------------------------------------------
audiences = ["Marketing leaders", "Online shoppers", "Cold traffic", "Trial users", "Practitioners", "Engineering managers"]
tones = [{ value: "insightful", label: "Insightful" }, { value: "confident", label: "Confident" }, { value: "punchy", label: "Punchy" }, { value: "helpful", label: "Helpful" }, { value: "playful", label: "Playful" }]
voiceItems = [{ value: "northwind", label: "Northwind — plain and specific" }, { value: "launch", label: "Launch mode — bold and short" }, { value: "enterprise", label: "Enterprise — measured and precise" }]
modelItems = modelList.map(m => ({ value: m.id, label: `${m.name} · $${m.inPrice}/$${m.outPrice} per M tokens` }))
fieldLabels = { topic: "Topic or angle", audience: "Audience" }

brief = $form({
  values: { topic: seedSpec.topic, audience: "Marketing leaders", tone: "insightful", words: 900, keywords: ["retention", "activation", "lifecycle"], preset: "northwind", model: "studio", avoid: "hype adjectives, exclamation marks" },
  rules: {
    topic: [$util.rules.required("Give the model something to write about"), $util.rules.minLength(8, "Too short to brief a model on")],
    audience: [$util.rules.required("Say who this is for")]
  },
  onSubmit: v => runGeneration(v)
})

activeTpl = templateById($template)
activeModel = modelById(brief.values.model)
lengthUnits = Math.ceil(brief.values.words / 150)
estimate = Math.max(3, Math.round((activeTpl.credits + lengthUnits) * activeModel.weight * 3))
used = $util.sum(usage.byDay.map(d => d.credits))
pct = Math.min(100, Math.round(used / usage.limit * 100))
briefErrors = Object.keys(brief.errors ?? {}).filter(k => brief.errors[k]).map(k => ({ label: fieldLabels[k] ?? k, message: brief.errors[k], field: k }))
promptTokens = 180 + tokensOf(`${brief.values.topic} ${brief.values.audience} ${brief.values.keywords.join(" ")} ${brief.values.avoid}`)

// ---- Actions ----------------------------------------------------------------
function pickTemplate(t) {
  $template = t.id
  brief.setValues({ audience: t.audience, tone: t.tone, words: t.words, keywords: t.keywords })
  $toast.info(`${t.label} brief loaded`)
}

function runGeneration(values) {
  if ($running) return
  const cost = estimate
  const spec = { template: $template, topic: values.topic, audience: values.audience, tone: values.tone, words: values.words, keywords: values.keywords ?? [], avoid: values.avoid ?? "", model: values.model }
  $running = true; $edits = []; $editingId = ""
  setTimeout(() => {
    $variants = [0, 1, 2].map(i => makeVariant(spec, i, i))
    $leftId = "v1"; $rightId = "v2"; $lastCredits = cost; $lastRunAt = $util.now()
    usage.spend(cost); $running = false
    $toast.success(`Three variants ready · ${cost} credits`)
  }, 1400)
}

function reroll(v) {
  if ($rerolling.length > 0 || $running) return
  const taken = $variants.filter(x => x.id != v.id).map(x => x.idx)
  const free = bankFor(v.spec.template).map((p, i) => i).filter(i => !taken.includes(i) && i != v.idx)
  const next = free.length > 0 ? free[0] : (v.idx + 1) % bankFor(v.spec.template).length
  const cost = Math.max(1, Math.round(estimate / 3))
  $rerolling = v.id; $edits = $edits.filter(e => e.id != v.id)
  setTimeout(() => {
    $variants = $variants.map(x => x.id == v.id ? makeVariant(x.spec, x.slot, next) : x)
    usage.spend(cost); $rerolling = ""
    $toast.info(`New take drafted · ${cost} credits`)
  }, 900)
}

function toggleEdit(v) {
  if ($editingId != v.id) { $editDraft = sourceOf(v); $editingId = v.id; return }
  $edits = [...$edits.filter(e => e.id != v.id), { id: v.id, body: $editDraft }]
  $editingId = ""; $toast.success("Edit applied to this variant")
}

function saveVariant(v) {
  const body = bodyOf(v)
  lib.add({ id: $util.uuid(), title: `${v.angle} — ${$util.truncate(v.spec.topic, 40)}`, type: templateById(v.spec.template).label, status: "draft", words: wordCount(body), updated: $util.now(), body: body })
  $toast.success("Saved to library as a draft")
}

function resetBrief() {
  brief.reset(); $template = "blog"; $edits = []; $editingId = ""
  $toast.info("Brief reset to the workspace default")
}

// ---- Header, banner, template gallery --------------------------------------
header = PageHeader("Content Studio", {
  breadcrumbs: ["Northwind Growth", "Content Studio"],
  subtitle: `${lib.items.length} pieces in the library · mock model, nothing leaves the browser`,
  status: Badge(activeTpl.label, { tone: "primary", icon: activeTpl.icon }),
  actions: [Pill(`${used} / ${usage.limit} credits`, { tone: pct > 80 ? "warning" : "success", icon: "bolt" }), Button("Reset brief", { variant: "ghost", size: "sm", icon: "rotate-left", onClick: resetBrief })]
})

upgradeBanner = Show(pct > 80, {
  children: Banner(`You have used ${pct}% of this period's credits`, {
    message: `${Math.max(0, usage.limit - used)} left. This brief costs ${estimate} on ${activeModel.name}.`,
    tone: "warning", icon: "gauge-high",
    action: Button("Upgrade to Scale 10k", { variant: "primary", icon: "arrow-up", onClick: () => $toast.info("Billing is disabled in this demo") })
  })
})

templateGallery = Card([
  SectionHeader("Templates", { eyebrow: "START HERE", subtitle: "Picking one rewrites the brief below — audience, tone, length and keywords" }),
  Grid(templates.map(t => Tile(t.label, { icon: t.icon, value: `${t.credits} cr`, description: t.description, tone: t.id == $template ? "primary" : "default", selected: t.id == $template, onClick: () => pickTemplate(t) })), { columns: { base: 1, sm: 2, lg: 5 }, gap: "md" })
])

// ---- Brief + brand voice ----------------------------------------------------
briefCard = Card([
  SectionHeader("Brief", { eyebrow: activeTpl.label, subtitle: activeTpl.description, status: Badge(`${estimate} credits`, { tone: "primary", icon: "coins" }) }),
  Show(briefErrors.length > 0, { children: ValidationSummary(briefErrors, { count: true }) }),
  FormSection("What to write", [
    FormControl("Topic or angle", { field: Input("topic", { value: brief.values.topic, placeholder: "Why activation beats acquisition", error: brief.errors.topic, onBlur: () => brief.touch("topic") }) }),
    FormControl("Audience", { field: Select("audience", { items: audiences, value: brief.values.audience, error: brief.errors.audience }) })
  ]),
  FormSection("How it should read", [
    FormControl("Tone", { field: ToggleGroup("tone", { items: tones, value: brief.values.tone, size: "sm", label: "Tone", onChange: v => brief.setField("tone", v) }) }),
    Slider("words", { label: "Target length", min: 60, max: 1400, step: 20, value: brief.values.words, showValue: true, suffix: " words", marks: [60, 400, 900, 1400], onChange: v => brief.setField("words", v) }),
    TagInput("keywords", { label: "Keywords to include", value: brief.values.keywords, placeholder: "Add a keyword…", suggestions: ["retention", "activation", "cohort", "onboarding", "benchmark"], onChange: v => brief.setField("keywords", v) })
  ]),
  FormSection("Guardrails", [
    FormControl("Brand voice", { field: Select("preset", { items: voiceItems, value: brief.values.preset, onChange: v => { brief.setField("preset", v); voice.applyPreset(v) } }) }),
    FormControl("Model", { field: Select("model", { items: modelItems, value: brief.values.model, onChange: v => brief.setField("model", v) }), hint: activeModel.blurb }),
    TextArea("avoid", { label: "Avoid", value: brief.values.avoid, rows: 2, placeholder: "Words, claims or formats the model must not use", onChange: v => brief.setField("avoid", v) })
  ]),
  Separator("horizontal", { label: "Estimated run" }),
  DescriptionList([
    DescriptionItem("Template base", `${activeTpl.credits} credits`, { icon: "layer-group" }), DescriptionItem("Length", `${lengthUnits} × 150 words`, { icon: "ruler-horizontal" }),
    DescriptionItem("Model", `${activeModel.name} ×${activeModel.weight}`, { icon: "microchip" }), DescriptionItem("Prompt", `${promptTokens} tokens in`, { icon: "keyboard" })
  ], { columns: 2 }),
  Buttons([Button("Generate 3 variants", { variant: "primary", icon: "wand-magic-sparkles", loading: $running, onClick: () => brief.submit() }), Button("Clear results", { variant: "ghost", icon: "eraser", disabled: $variants.length == 0, onClick: () => { $variants = []; $edits = [] } })])
])

voiceCard = Card([
  SectionHeader("Brand voice", { eyebrow: "GUARDRAILS", subtitle: "Re-applied to every variant as it renders — move a slider and the framing changes", status: Pill(voiceKey(), { tone: "corporate" }) }),
  Slider("warmth", { label: "Warmth", min: 0, max: 100, value: voice.warmth, showValue: true, suffix: "%", hint: "Formal at the low end, conversational at the high end", onChange: v => voice.setWarmth(v) }),
  Slider("boldness", { label: "Boldness", min: 0, max: 100, value: voice.boldness, showValue: true, suffix: "%", hint: "Measured claims at the low end, strong claims at the high end", onChange: v => voice.setBoldness(v) }),
  TagInput("banned", { label: "Banned words", value: voice.banned, placeholder: "Add a banned word…", suggestions: ["revolutionary", "leverage", "synergy", "cutting-edge", "world-class"], hint: "Swapped for an on-brand alternative in every rendered variant", onChange: v => voice.setBanned(v) }),
  TextArea("sample", { label: "Sample of on-brand writing", value: voice.sample, rows: 3, hint: "Reference only — the mock model does not read it", onChange: v => voice.setSample(v) }),
  Callout("info", { title: `Current opener: “${openerFor()}”`, description: `Derived from warmth ${voice.warmth}% and boldness ${voice.boldness}%.`, icon: "quote-left", compact: true })
])

briefRow = Grid([briefCard, voiceCard], { columns: { base: 1, lg: 2 }, gap: "lg" })

// ---- Results: pending → three variants -------------------------------------
pendingCard = Card([
  SectionHeader("Drafting three variants", { eyebrow: activeModel.name, subtitle: `${brief.values.words} words · ${activeTpl.label} · usually back in ${(0.4 + brief.values.words * 1.34 / activeModel.tps).toFixed(1)}s` }),
  Row([LoadingDots("Thinking"), Text("Planning structure, drafting, then checking against your banned words…", { variant: "small", tone: "muted" })], { gap: "sm", align: "center" }),
  Grid([Skeleton({ lines: 5 }), Skeleton({ lines: 5 }), Skeleton({ lines: 5 })], { columns: { base: 1, lg: 3 }, gap: "lg" })
])

emptyResults = Card([EmptyState("No variants yet", { icon: "wand-magic-sparkles", description: "Pick a template, tune the brief, and generate three drafts to compare.", actions: [Button("Generate 3 variants", { variant: "primary", icon: "play", onClick: () => brief.submit() })] })])

function variantPane(v, busy, editing, body) {
  if (busy) return Column([LoadingDots("Re-rolling this variant"), Skeleton({ lines: 4 })], { gap: "sm" })
  if (editing) return TextArea(`edit-${v.id}`, { label: "Edit this variant", value: $editDraft, rows: 10, hint: "Markdown — kept against this slot until you regenerate it" })
  return ScrollArea([Prose([Markdown(body)], { size: "sm" })], { maxHeight: "240px" })
}

function variantCard(v) {
  const source = sourceOf(v)
  const body = scrub(source); const tok = tokensOf(body); const read = readability(body)
  const hits = swapHits(source); const editing = $editingId == v.id; const busy = $rerolling == v.id
  return Card([
    Row([Column([Text(v.angle, { variant: "body-heavy" }), Text(`${v.model.name} · ${v.latency}`, { variant: "small", tone: "muted" })], { gap: "3xs" }), Spacer(), Badge(read.label, { tone: read.tone, size: "sm" })], { gap: "sm", align: "center" }),
    Row([
      Pill(`${wordCount(body)} words`, { tone: "neutral" }), Pill(`${tok} tokens`, { tone: "neutral" }),
      Pill(money(promptTokens / 1000000 * v.model.inPrice + tok / 1000000 * v.model.outPrice), { tone: "activating" }),
      hits > 0 ? Pill(`${hits} rewritten`, { tone: "warning", icon: "shield" }) : Pill("On voice", { tone: "success", icon: "check" })
    ], { gap: "xs", wrap: true }),
    Separator("horizontal"),
    variantPane(v, busy, editing, body),
    Row([
      CopyButton(body, { label: "Copy", copiedLabel: "Copied" }), Button("Regenerate", { variant: "ghost", size: "sm", icon: "rotate", disabled: busy, onClick: () => reroll(v) }),
      Button(editing ? "Apply edit" : "Edit", { variant: "ghost", size: "sm", icon: editing ? "check" : "pen", disabled: busy, onClick: () => toggleEdit(v) }),
      Button("Save", { variant: "secondary", size: "sm", icon: "bookmark", disabled: busy, onClick: () => saveVariant(v) })
    ], { gap: "xs", wrap: true })
  ], { key: v.id })
}

runTotals = { words: $util.sum($variants.map(v => wordCount(bodyOf(v)))), tokens: $util.sum($variants.map(v => tokensOf(bodyOf(v)))), cost: $util.sum($variants.map(v => promptTokens / 1000000 * v.model.inPrice + tokensOf(bodyOf(v)) / 1000000 * v.model.outPrice)) }

variantsSection = Column([
  Card([
    SectionHeader("Generated variants", { eyebrow: "LAST RUN", subtitle: `${$variants.length} drafts · ${$lastCredits} credits spent`, actions: [Button("Regenerate all", { variant: "secondary", size: "sm", icon: "rotate", loading: $running, onClick: () => brief.submit() })] }),
    Stats([
      { label: "Total words", value: String(runTotals.words), hint: "Across all three drafts" }, { label: "Output tokens", value: String(runTotals.tokens), hint: "At 1.34 tokens per word" },
      { label: "Inference cost", value: money(runTotals.cost), hint: `${activeModel.name} list price`, tone: "primary" }, { label: "Finished", value: $util.formatDate($lastRunAt, "h:mm A"), hint: "Mock latency" }
    ], { layout: "strip" })
  ]),
  Grid($variants.map(v => variantCard(v)), { columns: { base: 1, lg: 3 }, gap: "lg" })
], { gap: "md" })

resultsSection = $running ? pendingCard : ($variants.length > 0 ? variantsSection : emptyResults)

// ---- Compare two variants ---------------------------------------------------
variantOptions = $variants.map(v => ({ value: v.id, label: `${v.id.toUpperCase()} · ${v.angle}` }))
leftV = $variants.find(v => v.id == $leftId) ?? $variants[0]
rightV = $variants.find(v => v.id == $rightId) ?? $variants[1]

function diffPane() {
  if (!leftV || !rightV) return EmptyState("Pick two different variants", { icon: "code-compare" })
  return DiffViewer({ left: bodyOf(leftV), right: bodyOf(rightV), mode: "split", leftTitle: leftV.angle, rightTitle: rightV.angle, lineNumbers: true, maxHeight: 300 })
}

compareCard = Card([
  SectionHeader("Compare two variants", { eyebrow: "DIFF", subtitle: "Line-level diff, including any edits you have applied", actions: [Button("Swap sides", { variant: "ghost", size: "sm", icon: "right-left", disabled: $variants.length < 2, onClick: () => { const l = $leftId; $leftId = $rightId; $rightId = l } })] }),
  Show($variants.length > 1, {
    fallback: EmptyState("Nothing to compare yet", { icon: "code-compare", description: "Generate a run — the diff picks the drafts up automatically." }),
    children: Column([Grid([FormControl("Left", { field: Select("leftPick", { items: variantOptions, value: $leftId }) }), FormControl("Right", { field: Select("rightPick", { items: variantOptions, value: $rightId }) })], { columns: { base: 1, md: 2 }, gap: "md" }), diffPane()], { gap: "md" })
  })
])

// ---- Library + preview drawer -----------------------------------------------
statusItems = [{ value: "draft", label: "Draft" }, { value: "approved", label: "Approved" }, { value: "published", label: "Published" }]
libRows = lib.items.filter(i => ($libStatus == "all" || i.status == $libStatus) && (i.title + " " + i.type).toLowerCase().includes($libQuery.toLowerCase()))
previewItem = lib.items.find(i => i.id == $previewId)

libraryCard = Card([
  SectionHeader("Library", { eyebrow: "SAVED PIECES", subtitle: `${lib.items.length} saved · ${lib.items.filter(i => i.status == "published").length} published`, status: Badge(`${libRows.length} shown`, { tone: "neutral" }) }),
  Toolbar({
    searchable: true, searchPlaceholder: "Search saved pieces…", searchValue: $libQuery,
    left: [ToggleGroup("libStatus", { items: [{ value: "all", label: "All" }, ...statusItems], value: $libStatus, size: "sm", label: "Filter by status" })],
    right: [Button("Refresh", { variant: "ghost", size: "sm", icon: "arrows-rotate", onClick: () => $toast.info(`${libRows.length} pieces match the current filters`) })] }),
  Show(libRows.length > 0, {
    fallback: EmptyState("Nothing matches those filters", { icon: "folder-open", description: "Clear the search or switch the status filter." }),
    children: DataGrid({
      columns: [
        Col("Title", { values: libRows.map(i => Text(i.title, { variant: "body-heavy", lines: 2 })), sortable: true, width: "32%" }),
        Col("Type", { values: libRows.map(i => Badge(i.type, { tone: "info", size: "sm" })), filterable: true }),
        Col("Words", { values: libRows.map(i => i.words), align: "right", sortable: true }),
        Col("Status", { values: libRows.map(i => ToggleGroup(`st-${i.id}`, { items: statusItems, value: i.status, size: "sm", label: `Status for ${i.title}`, onChange: v => lib.setStatus(i.id, v) })) }),
        Col("Updated", { values: libRows.map(i => RelativeTime(i.updated)), sortable: true }),
        Col("", { align: "right", values: libRows.map(i => Row([IconButton("eye", { label: `Preview ${i.title}`, variant: "ghost", size: "sm", onClick: () => { $previewId = i.id } }), IconButton("trash", { label: `Delete ${i.title}`, variant: "ghost", size: "sm", onClick: () => { lib.remove(i.id); $toast.info("Removed from library") } })], { gap: "xs" })) })
      ],
      rowIds: libRows.map(i => i.id), striped: true, perPage: 6, exportable: true, exportFilename: "content-library.csv"
    })
  })
])

function previewBody() {
  if (!previewItem) return EmptyState("Nothing selected", { icon: "file-lines", description: "Open a saved piece from the library table." })
  return Column([
    Row([Badge(previewItem.type, { tone: "info", size: "sm" }), Pill(previewItem.status, { tone: statusTone(previewItem.status) }), Spacer(), Text(`${previewItem.words} words`, { variant: "small", tone: "muted" })], { gap: "xs", align: "center" }),
    Separator("horizontal"), Prose([Markdown(previewItem.body)], { size: "sm" }),
    ToggleGroup("previewStatus", { items: statusItems, value: previewItem.status, size: "sm", label: "Change status", onChange: v => lib.setStatus(previewItem.id, v) })
  ], { gap: "md" })
}

previewDrawer = Drawer(previewItem ? previewItem.title : "Preview", { open: $previewId.length > 0, children: [previewBody()], side: "right", width: "560px", onClose: () => { $previewId = "" } })

// ---- Credit usage -----------------------------------------------------------
usageCard = Card([
  SectionHeader("Credit usage", { eyebrow: "THIS BILLING PERIOD", subtitle: "Every generation and re-roll above spends from this budget", status: Badge(`${pct}% used`, { tone: pct > 80 ? "warning" : "success" }) }),
  Progress(pct, { max: 100, label: `${used} of ${usage.limit} credits`, tone: pct > 80 ? "warning" : "primary", showValue: true }),
  BarChart(usage.byDay.map(d => d.day), { series: [Series("Credits", { values: usage.byDay.map(d => d.credits) })], height: 200, yAxisLabel: "Credits", ariaLabel: "Credits consumed per day over the last seven days" }),
  Stats([
    { label: "Spent today", value: String(usage.byDay[usage.byDay.length - 1].credits), hint: "Includes this session" }, { label: "Daily average", value: String(Math.round(used / usage.byDay.length)), hint: "Last 7 days" },
    { label: "Remaining", value: String(Math.max(0, usage.limit - used)), hint: `${Math.floor(Math.max(0, usage.limit - used) / Math.max(1, estimate))} more runs at this brief`, tone: pct > 80 ? "warning" : "success" }, { label: "Last run", value: `${$lastCredits} cr`, hint: $util.formatDate($lastRunAt, "MMM D, h:mm A") }
  ], { layout: "strip" })
])
