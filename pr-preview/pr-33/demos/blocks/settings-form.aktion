// Settings Form — a grouped account-settings block: profile, notification
// switches, appearance, security, and a danger zone. Tracks a dirty state and
// only enables Save when something changed; Save / Reset act on a snapshot.
$app(Container([Column([header, profile, notifications, appearance, security, danger, bar], { gap: "lg" })], { size: "md" }))

defaults = { name: "Ada Lovelace", email: "ada@acme.io", bio: "Building reactive interfaces.", emailNotif: true, pushNotif: false, weekly: true, density: "comfortable", language: "en", twofa: true }

$form = $storage.get("settings.block") ?? { ...defaults }
$saved = { ...$form }

dirty = JSON.stringify($form) != JSON.stringify($saved)
set = (k, v) => $form = { ...$form, [k]: v }

function save() {
  $saved = { ...$form }
  $storage.set("settings.block", $form)
  $toast.success("Settings saved")
}
function reset() { $form = { ...$saved } }
function deleteAccount() { $toast.error("Account deletion requested") }

header = PageHeader("Settings", { subtitle: "Manage your account and preferences", breadcrumbs: false, status: dirty ? Badge("Unsaved changes", { tone: "warning", icon: "circle-exclamation" }) : Badge("All saved", { tone: "success", icon: "circle-check" }) })

profile = Card([Column([
  SectionHeader("Profile", { eyebrow: "ACCOUNT", subtitle: "Shown on your public page" }),
  Row([Avatar($form.name, { size: "lg" }), Button("Change photo", { variant: "secondary", size: "sm", icon: "camera" })], { gap: "md", align: "center" }),
  FormControl("Display name", { field: Input("name", { value: $form.name, onChange: v => set("name", v) }) }),
  FormControl("Email", { field: Input("email", { type: "email", value: $form.email, onChange: v => set("email", v) }) }),
  FormControl("Bio", { field: TextArea("bio", { value: $form.bio, rows: 3, onChange: v => set("bio", v) }) })
], { gap: "md" })])

notifications = Card([Column([
  SectionHeader("Notifications", { eyebrow: "PREFERENCES" }),
  Switch("emailNotif", { label: "Email notifications", description: "Product news and security alerts", value: $form.emailNotif, onChange: v => set("emailNotif", v) }),
  Switch("pushNotif", { label: "Push notifications", description: "Real-time activity on your devices", value: $form.pushNotif, onChange: v => set("pushNotif", v) }),
  Switch("weekly", { label: "Weekly digest", description: "A summary every Monday morning", value: $form.weekly, onChange: v => set("weekly", v) })
], { gap: "md" })])

appearance = Card([Column([
  SectionHeader("Appearance", { eyebrow: "DISPLAY" }),
  FormControl("Density", { field: ToggleGroup("density", { items: [{ value: "comfortable", label: "Comfortable" }, { value: "compact", label: "Compact" }], value: $form.density, onChange: v => set("density", v) }) }),
  FormControl("Language", { field: Select("language", { items: [SelectItem("en", { label: "English" }), SelectItem("fr", { label: "Français" }), SelectItem("de", { label: "Deutsch" })], value: $form.language, onChange: v => set("language", v) }) })
], { gap: "md" })])

security = Card([Column([
  SectionHeader("Security", { eyebrow: "PROTECTION" }),
  Switch("twofa", { label: "Two-factor authentication", description: "Strongly recommended", value: $form.twofa, onChange: v => set("twofa", v) }),
  Row([Button("Change password", { variant: "secondary", icon: "key" }), Button("View active sessions", { variant: "ghost", icon: "desktop" })], { gap: "sm", wrap: true })
], { gap: "md" })])

danger = Card([Column([
  SectionHeader("Danger zone", { eyebrow: "IRREVERSIBLE" }),
  Callout("Delete account", { description: "This permanently removes your account and all data. This cannot be undone.", icon: "triangle-exclamation", variant: "danger" }),
  Row([Spacer(), Button("Delete my account", { variant: "danger", icon: "trash", onClick: deleteAccount })], { align: "center" })
], { gap: "md" })])

bar = Sticky(Card([Row([
  Text(dirty ? "You have unsaved changes" : "Everything is up to date", { variant: "small", tone: dirty ? "warning" : "muted" }),
  Spacer(),
  Button("Reset", { variant: "ghost", disabled: !dirty, onClick: reset }),
  Button("Save changes", { variant: "primary", icon: "floppy-disk", disabled: !dirty, onClick: save })
], { align: "center" })]), { side: "bottom", offset: "16px" })
