// Markdown Notes — a two-pane notebook with live preview, search and autosave.
// Uses: $store({ persist }), Split panes, Prose preview, RelativeTime, ConfirmDialog, sx states.
$app(Column([header, body, confirmDelete], { gap: "lg", padding: "md" }))

notebook = $store({
  persist: "notes.book",
  notes: [
    { id: "n1", title: "Welcome 👋", body: "# Welcome to Notes\n\nThis editor speaks **Markdown**.\n\n- Click a note on the left to open it\n- Edit in the *Write* tab\n- See it rendered in *Preview*\n\n> Everything autosaves to your browser.", updated: 0 },
    { id: "n2", title: "Project ideas", body: "## Ideas\n\n1. Offline-first todo app\n2. RSS reader with tags\n3. A tiny aktion game\n\n**Next:** sketch the data model, then ship a rough prototype this week.", updated: 0 },
    { id: "n3", title: "Shopping list", body: "### Groceries\n\n- Coffee beans\n- Oat milk\n- Sourdough\n- Tomatoes", updated: 0 }
  ],
  active: "n1",
  select: (s, id) => { s.active = id },
  patch:  (s, id, field, val) => { s.notes = s.notes.map(n => n.id == id ? { ...n, [field]: val, updated: $util.now() } : n) },
  create: (s, note) => { s.notes = [note, ...s.notes]; s.active = note.id },
  remove: (s, id) => {
    s.notes = s.notes.filter(n => n.id != id)
    if (s.active == id && s.notes.length > 0) s.active = s.notes[0].id
  }
})

$q = ""
$deleteId = ""

filtered = $q
  ? notebook.notes.filter(n => (n.title + " " + n.body).toLowerCase().includes($q.toLowerCase()))
  : notebook.notes
current = notebook.notes.find(n => n.id == notebook.active) ?? notebook.notes[0]

function newNote() {
  notebook.create({ id: $util.uuid(), title: "Untitled note", body: "# New note\n\nStart writing…", updated: $util.now() })
  $q = ""
}

header = PageHeader("Markdown Notes", {
  subtitle: `${notebook.notes.length} notes · autosaved locally`,
  actions: [Button("New note", { onClick: newNote, variant: "primary", icon: "feather" })]
})

confirmDelete = ConfirmDialog("Delete this note?", {
  open: !!$deleteId,
  message: "The note is removed from this browser permanently.",
  tone: "danger",
  confirmLabel: "Delete note",
  onConfirm: () => { notebook.remove($deleteId); $deleteId = "" },
  onCancel: () => { $deleteId = "" }
})

noteRow = n => OnClick(
  Box([Column([
    Row([
      StackItem(Text(n.title, { variant: "body-heavy" }), { grow: 1 }),
      IconButton("trash", { label: "Delete note", variant: "ghost", size: "sm", onClick: () => { $deleteId = n.id } })
    ], { align: "center" }),
    Text(n.body.replaceAll("#", "").replaceAll("*", "").replaceAll(">", "").trim().slice(0, 48) || "Empty", { variant: "small", tone: "muted" }),
    Show(n.updated > 0, { children: RelativeTime(n.updated) })
  ], { gap: "xs" })], {
    padding: "sm", border: "subtle",
    background: n.id == notebook.active ? "primary" : "surface",
    sx: { states: { hover: { translateX: "2px", shadow: "sm" } } }
  }),
  { onClick: () => notebook.select(n.id) }
)

list = Card([
  SearchBar("q", { placeholder: "Search notes…", value: $q }),
  Show(filtered.length > 0, {
    fallback: EmptyState("No matches", { icon: "magnifying-glass" }),
    children: ScrollArea([Column(filtered.map(n => noteRow(n)), { gap: "sm" })], { maxHeight: "62vh" })
  })
])

editor = Show(!!current, {
  fallback: EmptyState("No note selected", { description: "Create a note to get started.", icon: "note-sticky", action: Button("New note", { onClick: newNote, variant: "primary" }) }),
  children: Card([
    Input("title", { value: current.title, onChange: v => notebook.patch(current.id, "title", v), placeholder: "Note title" }),
    Tabs([
      TabItem("write", { label: "Write", icon: "pen", children: [
        TextArea("body", { value: current.body, onChange: v => notebook.patch(current.id, "body", v), rows: 18, placeholder: "Write Markdown here…" })
      ] }),
      TabItem("preview", { label: "Preview", icon: "eye", children: [
        Box([Prose([Markdown(current.body)])], { padding: "md", border: "subtle", background: "surface" })
      ] })
    ], { defaultValue: "write" }),
    Show(current.updated > 0, { children: Row([Text("Last edited", { variant: "small", tone: "muted" }), RelativeTime(current.updated)], { gap: "xs", align: "center" }) })
  ])
})

body = Split(list, { right: editor, ratio: "1/2", gap: "lg", stackAt: "md" })
