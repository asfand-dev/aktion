// Event Planner — a month calendar with event chips, a live countdown and quick scheduling.
// Starting point for: booking tools, editorial calendars, team planners.
// Uses: Calendar (keyboard nav + event chips), CountdownTimer, $store({ persist }), $form, RelativeTime.
$app(Column([header, body, upcoming], { gap: "lg", padding: "md" }))

planner = $store({
  persist: "events.planner",
  events: [
    { id: "v1", date: "2026-06-15", label: "Design review",   color: "#6366f1" },
    { id: "v2", date: "2026-06-18", label: "Team offsite",    color: "#22c55e" },
    { id: "v3", date: "2026-06-18", label: "Dinner w/ Sam",   color: "#f59e0b" },
    { id: "v4", date: "2026-06-24", label: "Launch day 🚀",   color: "#ef4444" },
    { id: "v5", date: "2026-07-02", label: "Quarterly recap", color: "#06b6d4" }
  ],
  add:    (s, e) => { s.events = [...s.events, e] },
  remove: (s, id) => { s.events = s.events.filter(e => e.id != id) }
})

$selected = $util.formatDate($util.now(), "YYYY-MM-DD")

addForm = $form({
  values: { label: "", color: "#6366f1" },
  rules: { label: [$util.rules.required("Name the event")] },
  onSubmit: (v) => {
    planner.add({ id: $util.uuid(), date: $selected, label: v.label, color: v.color })
    addForm.reset()
  }
})

sorted = [...planner.events].sort((a, b) => a.date < b.date ? -1 : 1)
today = $util.formatDate($util.now(), "YYYY-MM-DD")
nextEvent = sorted.find(e => e.date >= today)
onSelected = planner.events.filter(e => e.date == $selected)

header = PageHeader("Event Planner", {
  subtitle: `${planner.events.length} events scheduled · saved locally`,
  badge: Badge(nextEvent ? `Next: ${nextEvent.label}` : "Nothing scheduled", { tone: nextEvent ? "primary" : "neutral", icon: "calendar-day" })
})

calendarCard = Card([
  SectionHeader("Calendar", { eyebrow: "MONTH VIEW", subtitle: "Click a day to select it — arrow keys work too" }),
  Calendar({
    selected: $selected,
    events: planner.events.map(e => ({ date: e.date, label: e.label, color: e.color })),
    onSelect: (d) => { $selected = d },
    firstDay: 1
  })
])

countdownCard = Show(!!nextEvent, {
  children: Card([
    SectionHeader("Counting down", { eyebrow: "NEXT UP" }),
    Center([Column([
      Text(nextEvent ? nextEvent.label : "", { variant: "large-heavy" }),
      CountdownTimer(nextEvent ? `${nextEvent.date}T09:00:00` : "", { endLabel: "It's happening!" }),
      Text(nextEvent ? $util.formatDate(nextEvent.date, "MMM D, YYYY") : "", { variant: "small", tone: "muted" })
    ], { gap: "sm", align: "center" })], { minHeight: "120px" })
  ], { animate: "fade-up" })
})

dayPanel = Card([
  SectionHeader($util.formatDate($selected, "MMM D, YYYY"), { eyebrow: "SELECTED DAY", subtitle: onSelected.length == 0 ? "Free — add something below" : `${onSelected.length} event${onSelected.length == 1 ? "" : "s"}` }),
  Show(onSelected.length > 0, {
    children: Column(onSelected.map(e => Row([
      Badge("●", { tone: "neutral", size: "sm", style: `color: ${e.color};` }),
      StackItem(Text(e.label, { variant: "body-heavy" }), { grow: 1 }),
      IconButton("trash", { label: "Remove event", variant: "ghost", size: "sm", onClick: () => planner.remove(e.id) })
    ], { gap: "sm", align: "center" })), { gap: "sm" })
  }),
  Separator("horizontal", { label: "add" }),
  FormControl("Event name", { field: Input("evLabel", { placeholder: "e.g. Standup, gym, deadline…", value: addForm.values.label, error: addForm.errors.label, onBlur: () => addForm.touch("label") }) }),
  FormControl("Colour", { field: ColorPicker("evColor", { value: addForm.values.color }) }),
  Button("Add to this day", { variant: "primary", icon: "calendar-plus", fullWidth: true, onClick: () => addForm.submit(), disabled: !addForm.values.label })
])

body = Grid([calendarCard, Column([countdownCard, dayPanel], { gap: "lg" })], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" })

upcoming = Card([
  SectionHeader("Upcoming", { eyebrow: "AGENDA" }),
  Show(sorted.filter(e => e.date >= today).length > 0, {
    fallback: EmptyState("Nothing ahead", { description: "Pick a day on the calendar and add your first event.", icon: "calendar-plus" }),
    children: Timeline(sorted.filter(e => e.date >= today).slice(0, 6).map(e => TimelineItem(e.label, {
      time: $util.formatDate(e.date, "MMM D"),
      icon: "calendar-day",
      tone: e.date == today ? "primary" : "neutral"
    })))
  })
])
