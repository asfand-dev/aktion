// World Clock — track the current time across multiple cities, add or remove
// time zones, and switch between 12- and 24-hour formats. The clock ticks once
// a second. Starting point for: any timezone / scheduling-aware app.
// Uses: $effect("every(1000)"), Intl.DateTimeFormat, $store({ persist }), Grid of cards.
$app(Column([header, addRow, grid], { gap: "lg", padding: "md" }))

$now = Date.now()
$h24 = false

// re-read the wall clock every second
$effect(() => { $now = Date.now() }, ["every(1000)"])

zones = $store({
  persist: "worldclock.zones",
  list: ["America/Los_Angeles", "America/New_York", "Europe/London", "Europe/Berlin", "Asia/Tokyo"],
  add: (s, tz) => { if (tz && !s.list.includes(tz)) s.list = [...s.list, tz] },
  remove: (s, tz) => { s.list = s.list.filter(z => z != tz) }
})

$pick = "Asia/Dubai"

catalog = [
  "America/Los_Angeles", "America/Denver", "America/Chicago", "America/New_York",
  "America/Sao_Paulo", "Europe/London", "Europe/Paris", "Europe/Berlin",
  "Europe/Moscow", "Africa/Cairo", "Asia/Dubai", "Asia/Kolkata",
  "Asia/Singapore", "Asia/Shanghai", "Asia/Tokyo", "Australia/Sydney", "Pacific/Auckland"
]

cityName = tz => (tz.split("/")[1] ?? tz).split("_").join(" ")

function timeIn(tz) {
  try {
    return new Intl.DateTimeFormat("en-US", { timeZone: tz, hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: !$h24 }).format($now)
  } catch (e) { return "--:--" }
}
function dateIn(tz) {
  try {
    return new Intl.DateTimeFormat("en-US", { timeZone: tz, weekday: "short", month: "short", day: "numeric" }).format($now)
  } catch (e) { return "" }
}
function hourIn(tz) {
  try {
    return Number(new Intl.DateTimeFormat("en-US", { timeZone: tz, hour: "numeric", hour12: false }).format($now))
  } catch (e) { return 12 }
}
function periodOf(tz) {
  const h = hourIn(tz)
  if (h >= 6 && h < 12) return { label: "Morning", tone: "info", icon: "mug-hot" }
  if (h >= 12 && h < 18) return { label: "Afternoon", tone: "warning", icon: "sun" }
  if (h >= 18 && h < 22) return { label: "Evening", tone: "primary", icon: "cloud-moon" }
  return { label: "Night", tone: "neutral", icon: "moon" }
}

localTime = new Intl.DateTimeFormat("en-US", { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: !$h24 }).format($now)

header = PageHeader("World Clock", {
  subtitle: `Local time ${localTime}`,
  badge: Badge(`${zones.list.length} cities`, { tone: "primary", icon: "earth-americas" }),
  actions: [SegmentedControl(["12h", "24h"], { value: $h24 ? "24h" : "12h", onChange: (v) => { $h24 = v == "24h" } })]
})

addRow = Card([Row([
  StackItem(Select("pick", { items: catalog.map(tz => SelectItem(tz, { label: cityName(tz) + " · " + tz })), value: $pick }), { grow: 1 }),
  Button("Add city", { variant: "primary", icon: "plus", onClick: () => zones.add($pick) })
], { gap: "sm", align: "end" })])

function clockCard(tz) {
  const p = periodOf(tz)
  return Card([Column([
    Row([
      StackItem(Column([
        Text(cityName(tz), { variant: "body-heavy" }),
        Text(dateIn(tz), { variant: "small", tone: "muted" })
      ], { gap: "none" }), { grow: 1 }),
      IconButton("xmark", { label: "Remove", variant: "ghost", size: "sm", onClick: () => zones.remove(tz) })
    ], { align: "start" }),
    Text(timeIn(tz), { variant: "title", style: "font-variant-numeric: tabular-nums;" }),
    Row([Badge(p.label, { tone: p.tone, icon: p.icon, size: "sm" }), Spacer(), Text(tz.split("/")[0], { variant: "small", tone: "muted" })], { align: "center" })
  ], { gap: "sm" })], {
    key: tz,
    sx: { states: { hover: { translateY: "-2px", shadow: "md" } } }
  })
}

grid = Show(zones.list.length > 0, {
  fallback: EmptyState("No cities yet", { icon: "earth-americas", description: "Add a time zone above to start tracking it." }),
  children: Grid(zones.list.map(tz => clockCard(tz)), { columns: { base: 1, sm: 2, lg: 3 }, gap: "md" })
})
