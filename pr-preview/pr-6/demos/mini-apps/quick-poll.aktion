// Quick Poll — write a question, share it, collect votes and watch results fill live.
// Starting point for: voting widgets, retro boards, audience Q&A tools.
// Uses: $store({ persist }), Transition results reveal, Confetti for the winner, QRCode share, sx.
$app(Column([header, body], { gap: "lg", padding: "md" }))

poll = $store({
  persist: "poll.current",
  question: "Where should the team offsite be?",
  options: [
    { id: "o1", label: "Lisbon", votes: 7 },
    { id: "o2", label: "Kyoto", votes: 11 },
    { id: "o3", label: "Mexico City", votes: 5 },
    { id: "o4", label: "Cape Town", votes: 9 }
  ],
  voted: false,
  vote:    (s, id) => { if (!s.voted) { s.options = s.options.map(o => o.id == id ? { ...o, votes: o.votes + 1 } : o); s.voted = true } },
  reset:   (s) => { s.voted = false },
  fresh:   (s, q, opts) => { s.question = q; s.options = opts; s.voted = false },
  setQuestion: (s, q) => { s.question = q }
})

$editing = false
$draftQ = ""
$draftOpts = ""

totalVotes = $util.sum(poll.options.map(o => o.votes))
maxVotes = poll.options.length > 0 ? Math.max(...poll.options.map(o => o.votes)) : 0
pctOf = o => totalVotes > 0 ? Math.round((o.votes / totalVotes) * 100) : 0
winners = poll.options.filter(o => o.votes == maxVotes && maxVotes > 0)

function startEdit() {
  $draftQ = poll.question
  $draftOpts = poll.options.map(o => o.label).join("\n")
  $editing = true
}

function saveEdit() {
  const opts = $draftOpts.split("\n").map(x => x.trim()).filter(x => x)
  if (!$draftQ || opts.length < 2) return
  poll.fresh($draftQ, opts.map(label => ({ id: $util.uuid(), label, votes: 0 })))
  $editing = false
}

header = PageHeader("Quick Poll", {
  subtitle: `${totalVotes} votes so far · stored locally`,
  badge: Badge(poll.voted ? "You voted" : "Vote open", { tone: poll.voted ? "success" : "primary", icon: "check-to-slot" }),
  actions: [
    Button("Vote again", { variant: "ghost", size: "sm", icon: "rotate-left", onClick: () => poll.reset(), disabled: !poll.voted }),
    Button("New poll", { variant: "secondary", size: "sm", icon: "pen", onClick: startEdit })
  ]
})

voteButton = o => Button(o.label, {
  variant: "secondary",
  size: "lg",
  fullWidth: true,
  icon: "circle",
  onClick: () => poll.vote(o.id)
})

resultRow = o => Column([
  Row([
    StackItem(Text(o.label, { variant: "body-heavy" }), { grow: 1 }),
    Show(winners.some(w => w.id == o.id), { children: Badge("Leading", { tone: "success", size: "xs", icon: "crown" }) }),
    Text(`${o.votes} · ${pctOf(o)}%`, { variant: "small", tone: "muted" })
  ], { gap: "sm", align: "center" }),
  Progress(pctOf(o), { max: 100, tone: winners.some(w => w.id == o.id) ? "success" : "primary" })
], { gap: "xs", key: o.id })

voteCard = Card([
  SectionHeader(poll.question, { eyebrow: "CAST YOUR VOTE" }),
  Show(!poll.voted, {
    fallback: Column([
      Show(winners.length > 0, { children: Confetti({ fire: true, count: 50 }) }),
      ...poll.options.map(o => resultRow(o)),
      Separator("horizontal"),
      Text(winners.length == 1 ? `"${winners[0].label}" is ahead with ${maxVotes} votes.` : "It's a tie!", { variant: "body-heavy", tone: "success" })
    ], { gap: "md" }),
    children: Column(poll.options.map(o => voteButton(o)), { gap: "sm" })
  })
], { animate: "fade-up" })

shareCard = Card([
  SectionHeader("Share", { eyebrow: "GET MORE VOTES" }),
  Center([Column([
    QRCode(`https://example.com/poll?q=${encodeURIComponent(poll.question)}`, { size: 150 }),
    Text("In a real app this would deep-link to the poll", { variant: "small", tone: "muted" })
  ], { gap: "sm", align: "center" })])
], { animate: { preset: "fade-up", delay: 80 } })

editCard = Card([
  SectionHeader("New poll", { eyebrow: "EDIT" }),
  FormControl("Question", { field: Input("draftQ", { value: $draftQ, placeholder: "Ask anything…" }) }),
  FormControl("Options (one per line, min 2)", { field: TextArea("draftOpts", { rows: 5, value: $draftOpts }) }),
  Row([
    Button("Cancel", { variant: "ghost", onClick: () => { $editing = false } }),
    Button("Start poll", { variant: "primary", icon: "check", onClick: saveEdit, disabled: !$draftQ || $draftOpts.split("\n").filter(x => x.trim()).length < 2 })
  ], { gap: "sm", justify: "end" })
])

body = $editing
  ? editCard
  : Grid([voteCard, shareCard], { columns: { base: 1, md: 2 }, gap: "lg", alignItems: "start" })
