// QR Studio — generate QR codes for links, Wi-Fi access, contact cards and plain text.
// Standalone utility you can drop into any app (event badges, table menus, device onboarding).
// Uses: QRCode (offline encoder), SegmentedControl modes, $form, CopyButton, $store({ persist }).
$app(Column([header, body], { gap: "lg", padding: "md" }))

modes = ["link", "wifi", "contact", "text"]
$mode = "link"

draft = $store({
  persist: "qr.draft",
  url: "https://aktion.dev",
  ssid: "HomeWifi",
  wifiPass: "",
  wifiSec: "WPA",
  setSec: (s, v) => { s.wifiSec = v },
  name: "Ada Lovelace",
  phone: "+44 20 7946 0958",
  email: "ada@example.com",
  text: "Hello from Aktion!"
})

// Encode the active mode into the standard payload format QR readers expect.
payload = $mode == "link" ? draft.url
  : $mode == "wifi" ? `WIFI:T:${draft.wifiSec};S:${draft.ssid};P:${draft.wifiPass};;`
  : $mode == "contact" ? `MECARD:N:${draft.name};TEL:${draft.phone};EMAIL:${draft.email};;`
  : draft.text

header = PageHeader("QR Studio", {
  subtitle: "Codes are generated offline — nothing leaves your browser",
  badge: Badge(`${payload.length} chars`, { tone: payload.length > 200 ? "warning" : "success", icon: "qrcode" })
})

linkFields = Column([
  FormControl("URL", { field: Input("url", { placeholder: "https://…", value: draft.url }) }),
  Callout("info", { title: "Tip", description: "Short URLs scan faster — fewer characters means a coarser, more forgiving grid.", icon: "lightbulb", compact: true })
], { gap: "md" })

wifiFields = Column([
  FormControl("Network name (SSID)", { field: Input("ssid", { value: draft.ssid }) }),
  FormControl("Password", { field: Input("wifiPass", { value: draft.wifiPass, placeholder: "Leave empty for open networks" }) }),
  FormControl("Security", { field: SegmentedControl(["WPA", "WEP", "nopass"], { value: draft.wifiSec, onChange: (v) => draft.setSec(v) }) })
], { gap: "md" })

contactFields = Column([
  FormControl("Name", { field: Input("name", { value: draft.name }) }),
  FormControl("Phone", { field: Input("phone", { value: draft.phone }) }),
  FormControl("Email", { field: Input("email", { value: draft.email }) })
], { gap: "md" })

textFields = FormControl("Text", { field: TextArea("text", { rows: 5, value: draft.text, placeholder: "Any text up to a few hundred characters" }) })

editor = Card([
  SectionHeader("Content", { eyebrow: "WHAT TO ENCODE" }),
  SegmentedControl(modes, { value: $mode, onChange: (m) => { $mode = m } }),
  $mode == "link" ? linkFields : $mode == "wifi" ? wifiFields : $mode == "contact" ? contactFields : textFields
], { animate: "fade-up" })

preview = Card([
  SectionHeader("Preview", { eyebrow: "SCAN ME" }),
  Center([Column([
    Box([QRCode(payload, { size: 220 })], { padding: "md", background: "surface", border: "subtle", sx: { radius: "lg" } }),
    Text($mode == "wifi" ? "Scan to join the network" : $mode == "contact" ? "Scan to save the contact" : "Scan with any camera app", { variant: "small", tone: "muted" }),
    CopyButton(payload, { label: "Copy raw payload" })
  ], { gap: "md", align: "center" })], { minHeight: "300px" })
], { animate: { preset: "fade-up", delay: 80 } })

body = Grid([editor, preview], { columns: { base: 1, md: 2 }, gap: "lg", alignItems: "start" })
