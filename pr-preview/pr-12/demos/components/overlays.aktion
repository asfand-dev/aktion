// Overlays — 9 reusable modal, drawer, popover & menu components (per-instance state).
$app(Column([header, Grid(demos, { columns: { base: 1, lg: 2 }, gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Overlays", { subtitle: "9 reusable overlay components", badge: Badge("Components", { tone: "primary", icon: "layer-group" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }

// 1 — button that opens a modal dialog
function DialogButton(label, { title = "Dialog", body = "" } = {}) {
  $open = false
  return Column([
    Button(label || "Open dialog", { variant: "primary", icon: "window-maximize", onClick: () => { $open = true } }),
    Modal(title, { open: $open, closeOnBackdrop: true, onClose: () => { $open = false }, children: [Text(body)], footer: [Button("Close", { variant: "ghost", onClick: () => { $open = false } }), Button("Save", { variant: "primary", onClick: () => { $open = false } })] })
  ])
}

// 2 — button that opens a side drawer
function SidePanel(label, { title = "Panel", body = "", side = "right" } = {}) {
  $open = false
  return Column([
    Button(label || "Open panel", { variant: "secondary", icon: "table-columns", onClick: () => { $open = true } }),
    Drawer(title, { open: $open, side, onClose: () => { $open = false }, children: [Text(body)], footer: [Button("Done", { variant: "primary", onClick: () => { $open = false } })] })
  ])
}

// 3 — click-triggered popover with rich content
function InfoPopover(label, { title = "More info", content = "" } = {}) {
  return Popover({ trigger: Button(label || "Details", { variant: "ghost", icon: "circle-info" }), title, content: [Text(content)] })
}

// 4 — hover tooltip
function HintTooltip(label, { hint = "Helpful hint", side = "top" } = {}) {
  return Tooltip(hint, { trigger: Button(label || "Hover me", { variant: "secondary" }), side })
}

// 5 — rich hover preview card
function ProfilePreview(name, { role = "", bio = "" } = {}) {
  return HoverCard({ trigger: Link(`@${name}`, { variant: "subtle" }), content: [Row([Avatar(name, { size: "sm" }), Column([Text(name, { variant: "body-heavy" }), Text(role, { variant: "small", tone: "muted" })], { gap: "xs" })], { gap: "sm", align: "center" }), Text(bio, { variant: "small" })] })
}

// 6 — right-click context menu on any node
function RowContextMenu(label, { items = [] } = {}) {
  return ContextMenu({ target: Box([Center([Text(label || "Right-click me", { tone: "muted" })], { minHeight: "56px" })], { padding: "sm", border: "subtle", background: "surface" }), items: items.map(i => i.separator ? MenuSeparator() : MenuItem(i.label, { icon: i.icon, variant: i.variant })) })
}

// 7 — image lightbox
function ImageLightbox({ images = [] } = {}) {
  return Lightbox(images)
}

// 8 — destructive action confirmed via modal
function ConfirmModal(label, { message = "Are you sure?", onConfirm } = {}) {
  $open = false
  return Column([
    Button(label || "Remove", { variant: "danger", icon: "trash", onClick: () => { $open = true } }),
    Modal("Confirm action", { open: $open, onClose: () => { $open = false }, children: [Callout("warning", { title: message, icon: "triangle-exclamation", compact: true })], footer: [Button("Cancel", { variant: "ghost", onClick: () => { $open = false } }), Button("Confirm", { variant: "danger", onClick: () => { if (onConfirm) onConfirm(); $open = false } })] })
  ])
}

// 9 — bottom sheet (drawer from the bottom)
function SheetButton(label, { title = "Sheet", body = "" } = {}) {
  $open = false
  return Column([
    Button(label || "Open sheet", { variant: "secondary", icon: "up-down", onClick: () => { $open = true } }),
    Drawer(title, { open: $open, side: "bottom", onClose: () => { $open = false }, children: [Text(body)] })
  ])
}

demos = [
  Demo("DialogButton", "Opens a modal", DialogButton("Edit profile", { title: "Edit profile", body: "Update your display name and bio here." })),
  Demo("SidePanel", "Opens a side drawer", SidePanel("Filters", { title: "Filters", body: "Refine the list using these controls." })),
  Demo("InfoPopover", "Click-triggered popover", InfoPopover("What's this?", { title: "Billing cycle", content: "You're charged on the 1st of each month." })),
  Demo("HintTooltip", "Hover tooltip", Row([HintTooltip("Save", { hint: "Saves your changes (Cmd+S)" }), HintTooltip("Archive", { hint: "Move to archive", side: "bottom" })], { gap: "md" })),
  Demo("ProfilePreview", "Hover to preview a profile", ProfilePreview("ada", { role: "Engineering Lead", bio: "Pioneer of computing." })),
  Demo("RowContextMenu", "Right-click for actions", RowContextMenu("Right-click this card", { items: [{ label: "Open", icon: "arrow-up-right-from-square" }, { label: "Rename", icon: "pen" }, { separator: true }, { label: "Delete", icon: "trash", variant: "danger" }] })),
  Demo("ImageLightbox", "Click to zoom", ImageLightbox({ images: ["https://picsum.photos/seed/a/600/400", "https://picsum.photos/seed/b/600/400", "https://picsum.photos/seed/c/600/400"] })),
  Demo("ConfirmModal", "Destructive confirm flow", ConfirmModal("Delete item", { message: "This permanently deletes the item." })),
  Demo("SheetButton", "Bottom sheet", SheetButton("Open sheet", { title: "Quick actions", body: "Slide-up panel for mobile-friendly actions." }))
]
