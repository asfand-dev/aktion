// The Frontier — an independent tech magazine homepage with a working reader.
// Starting point for: publications, blogs, changelogs, any content-led marketing site.
// Uses: $theme branding, NavBar + cover Hero + Section rhythm + Footer, Reveal, a MediaCard grid
//        filtered live by SearchBar + ToggleGroup with real Pagination, a Split sidebar, a Drawer
//        reader (ReadingProgress / TableOfContents / Prose / ShareButtons / Rating), $form + SuccessState.
$app(Column([nav, hero, trust, topics, latest, newsletter, reader, pageFooter], { gap: "none" }))

$theme({
  colors: { primary: "#b23a2f", accent: "#1f6f6b" },
  font: { family: "Inter, system-ui, sans-serif", familyHeading: "Fraunces, Georgia, serif" },
  fonts: { import: ["Fraunces:600,700", "Inter:400,500,700"] },
  radius: { sm: "6px", md: "8px", lg: "14px", button: "6px", input: "6px" }
})

// ---------- state ----------
$q = ""
$cat = "All"
$page = 1
$readerOpen = false
$openId = "a1"
$toc = "#summary"
$rating = 0
$applause = 214
$saved = []
$longRead = true
$subscribed = false

// ---------- data ----------
desks = [
  { label: "Infrastructure", icon: "server", tone: "primary", blurb: "Cables, datacentres, power — the plumbing nobody photographs." },
  { label: "Hardware", icon: "microchip", tone: "info", blurb: "Silicon, supply chains and the machines under the desk." },
  { label: "Engineering", icon: "code-branch", tone: "success", blurb: "How working systems actually get built, and kept alive." },
  { label: "Policy", icon: "scale-balanced", tone: "warning", blurb: "Regulation explained by people who read the annexes." },
  { label: "Design", icon: "pen-ruler", tone: "danger", blurb: "Interfaces, type, and the craft of making software legible." },
  { label: "Culture", icon: "users", tone: "default", blurb: "Teams, hiring, burnout and the humans behind the commits." }
]

articles = [
  { id: "a1", title: "Inside the datacentre that runs on the tide", deck: "Orkney's tidal racks have held 99.98% uptime for two years. We spent a week watching the water do the work.", author: "Priya Raghunathan", role: "Infrastructure correspondent", category: "Infrastructure", date: "2026-08-03", minutes: 16, reads: 84200, tags: ["Energy", "Datacenters", "Scotland"], seed: "frontier-tide", lede: "The Fall of Warness moves fast enough to knock a diver off her feet twice a day, on a schedule published two centuries in advance. That predictability is the entire pitch.", detail: "Wind farms need batteries because wind is a rumour. Tides are arithmetic: the operators size their racks against a lunar calendar and shed batch jobs into the slack-water windows.", pull: "We do not forecast our power. We look it up." },
  { id: "a2", title: "The quiet death of the standalone GPU", deck: "Unified memory is eating discrete graphics from the bottom up, one thin laptop at a time.", author: "Mira Chandrasekar", role: "Hardware editor", category: "Hardware", date: "2026-07-28", minutes: 11, reads: 61800, tags: ["Silicon", "GPUs", "Laptops"], seed: "frontier-gpu", lede: "Three years ago a discrete GPU was the difference between a machine that could edit video and one that could not. On this month's bench it is the difference between 40 and 46 minutes.", detail: "The interesting number is not throughput, it is the PCIe round trip that unified memory deletes. Shops shipping inference on device are quietly rewriting their kernels around it.", pull: "The bus was always the bottleneck. We just kept buying wider cards instead." },
  { id: "a3", title: "We rebuilt our search index on a $40 mini PC", deck: "A weekend experiment that has now served 4.2 million queries from a shelf in a spare room.", author: "Dev Okonkwo", role: "Senior writer", category: "Engineering", date: "2026-07-22", minutes: 8, reads: 57400, tags: ["Search", "Self-hosting", "Cost"], seed: "frontier-index", lede: "The whole corpus is 3.1 GB. It fits in RAM on a machine that costs less than one month of the managed cluster it replaced, and the p99 went down rather than up.", detail: "We are not arguing that everyone should unplug from their provider. We are arguing that almost nobody measures the real working-set size before paying for elasticity they never use.", pull: "Elastic infrastructure is wonderful, right up until your data stops growing." },
  { id: "a4", title: "The EU Model Registry, without the acronyms", deck: "What genuinely changes for teams shipping models in Europe next spring, and what is press release.", author: "Halldóra Reyn", role: "Policy correspondent", category: "Policy", date: "2026-07-19", minutes: 14, reads: 49100, tags: ["Regulation", "Europe", "AI"], seed: "frontier-registry", lede: "Annex III is where the obligations live, and it runs to eleven pages. Most of the coverage so far has been written from the summary, which runs to two.", detail: "The registration duty attaches to the deployer, not the vendor — a distinction that quietly moves the compliance cost onto every mid-sized company fine-tuning an off-the-shelf model.", pull: "Read the annex. The press release is not the law." },
  { id: "a5", title: "Six months inside a four-day week", deck: "Kestrel Labs cut Fridays and kept the roadmap. Here is the ledger, including the parts that hurt.", author: "Tomas Beier", role: "Culture writer", category: "Culture", date: "2026-07-15", minutes: 9, reads: 44600, tags: ["Work", "Teams", "Hiring"], seed: "frontier-fourday", lede: "Shipping velocity held. Support response times did not, for the first eleven weeks, and the fix was neither heroic nor cheap: they hired two people.", detail: "A four-day week is a scheduling change that surfaces every unstated dependency in a company. Kestrel found nine of them. Three turned out to be a single person named Ana.", pull: "We did not find four days of slack. We found four days of undocumented process." },
  { id: "a6", title: "Why your dark mode still looks broken", deck: "Contrast is not a colour swap, and eight otherwise excellent design systems keep proving it.", author: "June Alvarez", role: "Design editor", category: "Design", date: "2026-07-11", minutes: 6, reads: 41300, tags: ["Design", "Accessibility", "Color"], seed: "frontier-dark", lede: "Invert the palette and the elevation system inverts with it — shadows stop reading as depth, so every card in the interface flattens into the background at once.", detail: "The systems that hold up do one unglamorous thing: they define surface tokens by role rather than by lightness, then let each theme decide what that role looks like.", pull: "Dark mode is not a filter. It is a second design system with the same names." },
  { id: "a7", title: "The repair ship that reroutes your Tuesday", deck: "One vessel, 4,000 metres of cold Atlantic, and the least glamorous job holding the internet together.", author: "Priya Raghunathan", role: "Infrastructure correspondent", category: "Infrastructure", date: "2026-07-05", minutes: 12, reads: 38900, tags: ["Networks", "Cables", "Shipping"], seed: "frontier-cable", lede: "There are roughly sixty cable repair ships in service worldwide. The median age of the fleet is older than the median age of its crews, and nobody is building replacements.", detail: "A break off West Africa is a routing problem for ninety seconds and a logistics problem for nineteen days. The second number never appears on a status page.", pull: "Redundancy buys you time. Somebody still has to go and get the cable." },
  { id: "a8", title: "Rust is finally boring, and that is the point", deck: "The language stopped being a personality and started being a dependency. Both camps should be pleased.", author: "Dev Okonkwo", role: "Senior writer", category: "Engineering", date: "2026-06-30", minutes: 7, reads: 35200, tags: ["Rust", "Languages", "Tooling"], seed: "frontier-rust", lede: "The clearest signal is not adoption numbers, it is the tone of the pull requests: nobody announces the rewrite anymore, they just merge it three files at a time.", detail: "Boring is a compliment in infrastructure. It means the interesting arguments have moved up the stack, where they belong, and the compiler has stopped being a topic of conversation.", pull: "A language has arrived when its release notes are dull." },
  { id: "a9", title: "Battery chemistry's unglamorous decade", deck: "Sodium-ion will not win a keynote. It might quietly win the grid, and the grid is the bigger prize.", author: "Mira Chandrasekar", role: "Hardware editor", category: "Hardware", date: "2026-06-24", minutes: 10, reads: 31700, tags: ["Energy", "Batteries", "Grid"], seed: "frontier-sodium", lede: "It is heavier and less dense, and for a stationary rack sitting in a field outside Bilbao neither of those is a disadvantage worth paying lithium prices to avoid.", detail: "The supply-chain argument does most of the work here. Sodium is not a geopolitical asset, which makes a twenty-year procurement contract a great deal easier to sign.", pull: "Nobody fights a war over sodium. That is the whole feature." },
  { id: "a10", title: "The maintainer who said no", deck: "How one 'wontfix' reset expectations for a package with two hundred thousand dependents.", author: "Halldóra Reyn", role: "Policy correspondent", category: "Culture", date: "2026-06-18", minutes: 5, reads: 29400, tags: ["Open source", "Community", "Governance"], seed: "frontier-wontfix", lede: "The issue had 1,400 thumbs-up and a Fortune 100 logo in the thread. It was closed with a two-sentence comment that has since been quoted in four conference talks.", detail: "What followed was not a fork but a funding round: three of the loudest downstream users now pay for a support contract, the outcome every maintainer guide recommends and almost nobody reaches.", pull: "Saying no is a maintenance strategy, not a temper." }
]

// ---------- derived ----------
cover = (a, w, h) => `https://picsum.photos/seed/${a.seed}/${w}/${h}`
face = name => `https://picsum.photos/seed/frontier-${$util.slugify(name)}/96/96`
byId = id => articles.find(a => a.id == id) || articles[0]
haystack = a => `${a.title} ${a.deck} ${a.author} ${a.category} ${a.tags.join(" ")}`.toLowerCase()
matches = a => ($cat == "All" || a.category == $cat) && ($q.trim() == "" || haystack(a).includes($q.trim().toLowerCase()))

featured = articles[0]
current = byId($openId)
categories = ["All"].concat(desks.map(d => d.label))
popularTags = $util.unique(articles.map(a => a.tags).flat()).slice(0, 12)
mostRead = articles.slice().sort((a, b) => b.reads - a.reads).slice(0, 5)
filtered = articles.filter(matches)
perPage = 4
totalPages = Math.max(1, Math.ceil(filtered.length / perPage))
page = Math.min($page, totalPages)
pageItems = filtered.slice((page - 1) * perPage, page * perPage)

function setDesk(label) { $cat = label; $page = 1 }
function search(v) { $q = v; $page = 1 }
function closeReader() { $readerOpen = false }
function openArticle(id) { $openId = id; $toc = "#summary"; $readerOpen = true }
function nextArticle(id) { openArticle(articles[(articles.findIndex(a => a.id == id) + 1) % articles.length].id) }
function applaud() { $applause += 1; $toast.success("Thanks — the desk sees every clap") }
function clearFilters() { $cat = "All"; $q = ""; $page = 1; $toast.info("Filters cleared — showing every story") }

function toggleSave(id) {
  const on = $saved.includes(id)
  $saved = on ? $saved.filter(x => x != id) : [...$saved, id]
  $toast.success(on ? `Removed “${byId(id).title}”` : `Saved “${byId(id).title}” for later`)
}

// ---------- masthead + featured story ----------
nav = NavBar({
  brand: Brand("The Frontier", { href: "#top", version: "Est. 2019" }),
  links: [Link("Latest", { href: "#latest" }), Link("Sections", { href: "#topics" }), Link("Newsletter", { href: "#newsletter" })],
  actions: [
    Show($util.breakpoint.md, { children: SearchBar("nav-search", { placeholder: "Search 900+ stories…", value: $q, shortcut: "/", ariaLabel: "Search The Frontier", onChange: search }) }),
    ThemeToggle(),
    Button("Subscribe", { variant: "primary", size: "sm", icon: "envelope", onClick: () => $toast.info("The signup form is at the foot of the page — it takes one field") })
  ],
  sticky: true,
  blur: true
})

hero = Section([
  Reveal(
    Column([
      Hero(featured.title, {
        eyebrow: "THE BIG READ",
        subtitle: featured.deck,
        imageSrc: cover(featured, 1400, 720),
        layout: "cover",
        height: "440px",
        overlay: 0.66,
        caption: `${featured.category} · ${featured.minutes} min read · ${$util.formatDate(featured.date, "MMM D, YYYY")}`,
        actions: [
          Button("Read the story", { variant: "primary", size: "lg", icon: "book-open", onClick: () => openArticle(featured.id) }),
          Button("Save for later", { variant: "secondary", size: "lg", icon: "bookmark", onClick: () => toggleSave(featured.id) })
        ]
      }),
      Row([
        Badge(featured.category, { tone: "primary", icon: "bolt" }),
        AuthorByline(featured.author, { avatar: face(featured.author), role: featured.role, date: $util.formatDate(featured.date, "MMM D, YYYY"), readingTime: `${featured.minutes} min read` }),
        Spacer(),
        BadgeList(featured.tags, { tone: "neutral", size: "sm" })
      ], { gap: { base: "sm", md: "md" }, wrap: true })
    ], { gap: "md" }),
    { animation: "fade-up", threshold: 0.05 }
  )
], { background: "base", width: "xl", padding: "lg", id: "top" })

trust = Section([
  MetricStrip([
    Metric("1.2M", { label: "Monthly readers" }),
    Metric("41208", { label: "Newsletter subscribers", countUp: true }),
    Metric("0", { label: "Ads on this page" }),
    Metric("94%", { label: "Funded by readers, not sponsors" })
  ], { columns: 4 })
], { background: "brand", width: "lg", padding: "md", align: "center" })

topics = Section([
  Reveal(FeatureGrid(desks.map(d => FeatureItem(d.label, { description: d.blurb, icon: d.icon, tone: d.tone, onClick: () => setDesk(d.label) })), { columns: 3 }), { animation: "fade-up" })
], { background: "soft", width: "xl", align: "center", id: "topics", eyebrow: "SECTIONS", title: "Six desks, one obsession", subtitle: "Pick a desk — the story list below filters to it straight away." })

// ---------- the story grid ----------
function StoryCard(a) {
  return MediaCard(a.title, {
    imageSrc: cover(a, 640, 360),
    description: a.deck,
    tags: a.tags,
    badge: a.category,
    meta: `${a.author} · ${$util.formatDate(a.date, "MMM D")} · ${a.minutes} min read`,
    onClick: () => openArticle(a.id),
    actions: [
      Button("Read", { variant: "ghost", size: "sm", icon: "arrow-right", iconPosition: "trailing", onClick: () => openArticle(a.id) }),
      Button($saved.includes(a.id) ? "Saved" : "Save", { variant: "ghost", size: "sm", icon: "bookmark", onClick: () => toggleSave(a.id) })
    ]
  })
}

storyList = Column([
  Toolbar({
    left: [ScrollArea([ToggleGroup("desk", { items: categories, value: $cat, size: "sm", variant: "ghost", label: "Filter stories by desk", onChange: setDesk })], { direction: "horizontal", maxHeight: "72px" })],
    right: [Text(`${filtered.length} of ${articles.length} stories`, { variant: "small", tone: "muted" })]
  }),
  SearchBar("story-search", { placeholder: "Search titles, authors and tags…", value: $q, ariaLabel: "Search stories", onChange: search }),
  Show(filtered.length > 0, {
    fallback: EmptyState("Nothing matches that yet", { icon: "newspaper", description: "Try a different desk, or clear the search and start again.", actions: [Button("Clear filters", { variant: "primary", icon: "rotate-left", onClick: clearFilters })] }),
    children: Column([
      Grid(pageItems.map(a => StoryCard(a)), { columns: { base: 1, md: 2 }, gap: { base: "md", md: "lg" } }),
      Pagination({ page: page, totalPages: totalPages, total: filtered.length, perPage: perPage, onChange: p => { $page = p } })
    ], { gap: "lg" })
  })
], { gap: "lg" })

sidebar = Column([
  Card([
    SectionHeader("Most read this week", { eyebrow: "READERS" }),
    List(mostRead.map(a => ListItem(a.title, { description: `${a.author} · ${$util.format(a.reads, "compact")} reads`, onClick: () => openArticle(a.id) })), { ordered: true, divided: true })
  ]),
  Card([
    SectionHeader("Popular tags", { eyebrow: "ARCHIVE" }),
    BadgeList(popularTags, { tone: "info", size: "sm" }),
    Text("Every story is filed under at least two tags — it is how nine years of back issues stay findable.", { variant: "small", tone: "muted" })
  ]),
  Card([
    SectionHeader("Author spotlight", { eyebrow: "THE DESK" }),
    ProfileCard("Priya Raghunathan", {
      role: "Infrastructure correspondent",
      avatarSrc: face("Priya Raghunathan"),
      bio: "Eleven years on the cable-and-concrete beat. Writes from Edinburgh, files from wherever the repair ship happens to be.",
      tags: ["Networks", "Energy", "Datacenters"],
      actions: [
        Button("Read her latest", { variant: "primary", size: "sm", icon: "book-open", onClick: () => openArticle("a1") }),
        Button("Follow", { variant: "secondary", size: "sm", icon: "bell", onClick: () => $toast.success("You'll get a note whenever Priya files") })
      ]
    })
  ]),
  Card([
    SectionHeader("Your reading list", { eyebrow: "SAVED", status: Badge(String($saved.length), { tone: "primary", size: "sm" }) }),
    Show($saved.length > 0, {
      fallback: Text("Nothing saved yet — hit Save on any story and it lands here.", { variant: "small", tone: "muted" }),
      children: Column([
        List($saved.map(id => ListItem(byId(id).title, { description: `${byId(id).minutes} min · ${byId(id).author}`, icon: "bookmark", onClick: () => openArticle(id) })), { divided: true }),
        Button("Clear the list", { variant: "ghost", size: "sm", icon: "trash", onClick: () => { $saved = []; $toast.info("Reading list cleared") } })
      ], { gap: "sm" })
    })
  ])
], { gap: "lg" })

latest = Section([
  Split(storyList, { right: sidebar, ratio: "2/1", gap: "xl", stackAt: "lg", sticky: "right", stickyOffset: "96px", align: "start" })
], { background: "base", width: "xl", id: "latest", eyebrow: "LATEST", title: "Fresh from the desk", subtitle: "Filtered live — the search box and the desk switcher both narrow the list below." })

// ---------- reading view ----------
readerToc = [{ label: "The short version", href: "#summary" }, { label: "What we found", href: "#found" }, { label: "What it means", href: "#next" }]

function ReaderBody(a) {
  return Prose([
    Heading("The short version", { level: 3, id: "summary" }),
    Text(a.deck, { variant: "large", tone: "muted", as: "p" }),
    Heading("What we found", { level: 3, id: "found" }),
    Text(a.lede, { as: "p" }),
    Text(a.detail, { as: "p" }),
    Quote(a.pull, { cite: `${a.author}, ${a.role}` }),
    Heading("What it means", { level: 3, id: "next" }),
    Text(`We are staying on this one. If you work in ${a.category.toLowerCase()} and think we have it wrong, the desk reads every reply to the Thursday email.`, { as: "p" })
  ], { size: "md" })
}

reader = Drawer(current.title, {
  open: $readerOpen,
  width: "860px",
  side: "right",
  onClose: closeReader,
  children: [Column([
    ReadingProgress({ gradient: true, height: "4px" }),
    Row([Badge(current.category, { tone: "primary", size: "sm" }), Pill(`${current.minutes} min read`, { tone: "neutral", icon: "clock" }), StatusDot(`${$util.format(current.reads, "compact")} reads`, { tone: "success", pulse: true })], { gap: "sm", wrap: true }),
    AuthorByline(current.author, { avatar: face(current.author), role: current.role, date: $util.formatDate(current.date, "MMM D, YYYY"), readingTime: `${current.minutes} min read` }),
    Image(cover(current, 900, 480), { alt: `Cover photograph for “${current.title}”`, ratio: "16:9", caption: "Photograph commissioned for The Frontier" }),
    Split(
      TableOfContents(readerToc, { title: "In this article", activeHref: $toc, onSelect: h => { $toc = h } }),
      { right: ReaderBody(current), ratio: "1/2", gap: "lg", stackAt: "md", align: "start" }
    ),
    Separator({ label: "Filed under" }),
    BadgeList(current.tags, { tone: "info", size: "sm" }),
    Card([
      SectionHeader("Was this worth your time?", { eyebrow: "READER FEEDBACK" }),
      Row([
        Rating({ value: $rating, max: 5, interactive: true, allowClear: true, label: $rating > 0 ? `You rated this ${$rating} of 5` : "Rate this story", onChange: v => { $rating = v; $toast.success(`Logged ${v} of 5 — thank you`) } }),
        Spacer(),
        Button(`Applause · ${$applause}`, { variant: "secondary", size: "sm", icon: "hands-clapping", onClick: applaud })
      ], { gap: "md", wrap: true }),
      Separator(),
      Row([Text("Share this story", { variant: "small-heavy", tone: "muted" }), ShareButtons(`https://thefrontier.press/stories/${current.seed}`, { title: current.title, networks: ["twitter", "linkedin", "mastodon", "email", "copy"] })], { gap: "md", wrap: true, justify: "between" })
    ])
  ], { gap: "lg" })],
  footer: [Row([
    Button($saved.includes($openId) ? "Saved" : "Save for later", { variant: "secondary", icon: "bookmark", onClick: () => toggleSave($openId) }),
    Spacer(),
    Button("Next story", { variant: "ghost", icon: "arrow-right", iconPosition: "trailing", onClick: () => nextArticle($openId) }),
    Button("Close", { variant: "primary", onClick: closeReader })
  ], { gap: "sm", wrap: true })]
})

// ---------- newsletter ----------
signup = $form({
  values: { email: "" },
  rules: { email: [$util.rules.required("We need somewhere to send it"), $util.rules.email("That address does not look right")] },
  onSubmit: v => { $subscribed = true; $toast.success(`The Frontier Weekly is on its way to ${v.email}`) }
})

signupForm = Column([
  Input("nl-email", { label: "Email address", type: "email", placeholder: "you@studio.dev", autocomplete: "email", value: signup.values.email, error: signup.errors.email, onBlur: () => signup.touch("email") }),
  Switch("nl-long", { label: "Also send the Sunday long read", value: $longRead, description: "One extra essay a week, never more than 2,000 words." }),
  Button("Subscribe free", { variant: "primary", size: "lg", fullWidth: true, icon: "paper-plane", loading: signup.submitting, onClick: () => signup.submit() }),
  Text("One click to unsubscribe. We have never sold the list and never will.", { variant: "small", tone: "muted", align: "center" })
], { gap: "md" })

confirmed = SuccessState("You're on the list", {
  description: "Check your inbox for a one-click confirmation. The next issue goes out Thursday morning.",
  icon: "envelope-circle-check",
  actions: [Button("Add another address", { variant: "secondary", icon: "plus", onClick: () => { $subscribed = false; signup.reset() } })]
})

newsletter = Section([
  Reveal(Card([
    Split(
      Column([
        Eyebrow("THE FRONTIER WEEKLY"),
        Display(["One email. Six stories. ", GradientText("Thursday, 07:00", { gradient: "brand" })], { size: "lg", balance: true }),
        Text("No roundup filler and no sponsored slot — just what the desk actually read this week, with a line on why it mattered.", { tone: "muted" }),
        Row([StatusDot("41,208 subscribers", { tone: "success" }), Pill("No ads, ever", { tone: "promoting", icon: "shield" }), Pill("Reader funded", { tone: "corporate", icon: "heart" })], { gap: "sm", wrap: true })
      ], { gap: "sm" }),
      { right: Show($subscribed, { fallback: signupForm, children: confirmed }), ratio: "1/1", gap: "xl", stackAt: "md", align: "center" }
    )
  ]), { animation: "fade-up" })
], { background: "soft", width: "lg", id: "newsletter" })

pageFooter = Footer({
  brand: Brand("The Frontier"),
  tagline: "Independent technology reporting since 2019. No investors, no sponsored posts.",
  columns: [
    FooterColumn("Sections", { links: desks.slice(0, 4).map(d => Link(d.label, { href: "#topics" })) }),
    FooterColumn("The paper", { links: [Link("About us", { href: "#" }), Link("The desk", { href: "#" }), Link("Corrections", { href: "#" }), Link("Pitch a story", { href: "#" })] }),
    FooterColumn("Read", { links: [Link("Latest", { href: "#latest" }), Link("Newsletter", { href: "#newsletter" }), Link("RSS", { href: "#" })] })
  ],
  legal: "© 2026 The Frontier Press — a demo publication, every byline invented."
})
