// Analytics Overview — a product/web analytics console for Larkspur, an invented
// privacy-first analytics SaaS. The date range (24h/7d/30d/90d) and the audience
// segment recompute every KPI, chart, funnel, heatmap and table below them; the
// top-pages grid sorts, searches and pages, and a row click opens a detail drawer.
// Starting point for: any web / product analytics, growth or reporting dashboard.
// Uses: $store data, range+segment derived metrics, LineChart / PieChart / Heatmap,
//       DataGrid (sort + search + paging), Progress funnel, Drawer detail, Callout insights.
$app(Column([pageHeader, filterBar, kpiRow, trendRow, engagementRow, pagesCard, breakdownRow, insightsCard, detailDrawer], { gap: "lg" }))

// ---- Reactive state + the inline dataset ------------------------------------
$range = "30d"
$segment = "all"
$metric = "sessions"
$compare = true
$search = ""
$sort = { key: "Views", direction: "desc" }
$page = 1
$openPath = ""
asOf = "2026-06-09"
db = $store({
  pages: [
    { path: "/", title: "Larkspur — product analytics for teams", share: 0.196, bounce: 34.8, secs: 71, delta: 6.4 },
    { path: "/pricing", title: "Pricing & plans", share: 0.134, bounce: 47.2, secs: 128, delta: 11.2 },
    { path: "/product/session-replay", title: "Session replay", share: 0.101, bounce: 39.5, secs: 164, delta: -4.1 },
    { path: "/docs/quickstart", title: "Quickstart guide", share: 0.094, bounce: 22.6, secs: 241, delta: 8.7 },
    { path: "/blog/privacy-first-analytics", title: "Privacy-first analytics in 2026", share: 0.078, bounce: 61.4, secs: 96, delta: 24.3 },
    { path: "/integrations/slack", title: "Slack integration", share: 0.062, bounce: 41.9, secs: 112, delta: -2.8 },
    { path: "/signup", title: "Create your workspace", share: 0.058, bounce: 18.3, secs: 187, delta: 3.6 },
    { path: "/docs/api/events", title: "Events API reference", share: 0.051, bounce: 26.1, secs: 268, delta: 5.2 },
    { path: "/customers/northwind", title: "How Northwind cut churn 22%", share: 0.043, bounce: 52.7, secs: 143, delta: -9.4 },
    { path: "/changelog", title: "Changelog", share: 0.037, bounce: 44.5, secs: 88, delta: 1.9 },
    { path: "/compare/heap", title: "Larkspur vs Heap", share: 0.031, bounce: 58.2, secs: 105, delta: 14.6 },
    { path: "/status", title: "System status", share: 0.024, bounce: 71.3, secs: 42, delta: -1.2 }
  ],
  countries: [
    { name: "United States", share: 0.286, cvr: 4.1 },
    { name: "Germany", share: 0.152, cvr: 3.6 },
    { name: "United Kingdom", share: 0.118, cvr: 4.4 },
    { name: "India", share: 0.094, cvr: 1.8 },
    { name: "Canada", share: 0.071, cvr: 3.9 },
    { name: "Netherlands", share: 0.058, cvr: 5.2 },
    { name: "Brazil", share: 0.039, cvr: 1.4 }
  ],
  live: [
    { page: "/pricing", city: "Berlin", country: "Germany", device: "Desktop", seconds: 42, segment: "new" },
    { page: "/docs/quickstart", city: "Austin", country: "United States", device: "Desktop", seconds: 168, segment: "signed-in" },
    { page: "/", city: "Manchester", country: "United Kingdom", device: "Mobile", seconds: 12, segment: "new" },
    { page: "/product/session-replay", city: "Toronto", country: "Canada", device: "Desktop", seconds: 96, segment: "returning" },
    { page: "/signup", city: "Amsterdam", country: "Netherlands", device: "Tablet", seconds: 57, segment: "trial" },
    { page: "/blog/privacy-first-analytics", city: "Bengaluru", country: "India", device: "Mobile", seconds: 24, segment: "returning" }
  ]
})

// ---- The two knobs every number on the page hangs off ------------------------
ranges = {
  "24h": { label: "last 24 hours", points: 8, mult: 0.09, unit: "3-hour blocks", days: 1 },
  "7d": { label: "last 7 days", points: 7, mult: 1, unit: "days", days: 7 },
  "30d": { label: "last 30 days", points: 6, mult: 4.3, unit: "weeks", days: 30 },
  "90d": { label: "last 90 days", points: 6, mult: 12.8, unit: "fortnights", days: 90 }
}
bucketLabels = {
  "24h": ["00:00", "03:00", "06:00", "09:00", "12:00", "15:00", "18:00", "21:00"],
  "7d": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
  "30d": ["May 5", "May 12", "May 19", "May 26", "Jun 2", "Jun 9"],
  "90d": ["Mar 17", "Mar 31", "Apr 14", "Apr 28", "May 12", "May 26"]
}
segments = [
  { value: "all", label: "All traffic", weight: 1, cvr: 3.4, bounce: 41.2, engage: 1 },
  { value: "new", label: "New visitors", weight: 0.63, cvr: 2.1, bounce: 52.6, engage: 0.74 },
  { value: "returning", label: "Returning visitors", weight: 0.37, cvr: 5.6, bounce: 28.4, engage: 1.38 },
  { value: "signed-in", label: "Signed-in users", weight: 0.24, cvr: 8.9, bounce: 18.7, engage: 1.82 },
  { value: "trial", label: "Enterprise trials", weight: 0.06, cvr: 12.4, bounce: 14.3, engage: 2.15 }
]
rangeItems = [{ value: "24h", label: "24h" }, { value: "7d", label: "7d" }, { value: "30d", label: "30d" }, { value: "90d", label: "90d" }]
cfg = ranges[$range] || ranges["30d"]
labels = bucketLabels[$range] || bucketLabels["30d"]
seg = segments.find(s => s.value == $segment) || segments[0]
buckets = $util.range(0, cfg.points - 1)
curve = [1180, 1342, 1275, 1490, 1612, 1548, 1704, 1436]
priorCurve = [1094, 1210, 1233, 1301, 1388, 1425, 1471, 1352]
engageCurve = [186, 201, 194, 213, 208, 221, 199, 205]
priorEngageCurve = [178, 189, 187, 199, 202, 205, 191, 196]
minuteCurve = [21, 26, 24, 31, 28, 35, 33, 29, 38, 41, 36, 44]
sessions = buckets.map(i => Math.round(curve[i] * cfg.mult * seg.weight))
priorSessions = buckets.map(i => Math.round(priorCurve[i] * cfg.mult * seg.weight))
visitors = sessions.map(v => Math.round(v * 0.68))
priorVisitors = priorSessions.map(v => Math.round(v * 0.68))
pageViews = sessions.map(v => Math.round(v * 2.4))
priorPageViews = priorSessions.map(v => Math.round(v * 2.4))
engagement = buckets.map(i => Math.round(engageCurve[i] * seg.engage))
priorEngagement = buckets.map(i => Math.round(priorEngageCurve[i] * seg.engage))
totalSessions = $util.sum(sessions)
priorTotal = $util.sum(priorSessions)
totalVisitors = $util.sum(visitors)
priorVisitorTotal = $util.sum(priorVisitors)
totalViews = $util.sum(pageViews)
priorViews = $util.sum(priorPageViews)
avgSeconds = Math.round($util.avg(engagement))
priorAvgSeconds = Math.round($util.avg(priorEngagement))
bounce = $util.round(seg.bounce - cfg.days * 0.012, 1)
priorBounce = $util.round(seg.bounce + 0.9, 1)
bounceSpark = buckets.map(i => $util.round(bounce + ((i % 3) - 1) * 1.4, 1))
conversions = Math.round(totalSessions * seg.cvr / 100)
cvr = totalSessions > 0 ? $util.round((conversions / totalSessions) * 100, 2) : 0
liveSeries = minuteCurve.map(v => Math.max(1, Math.round(v * seg.weight * (1 + cfg.days * 0.002))))
activeNow = $util.last(liveSeries)
viewsPerMinute = $util.round(activeNow * 0.8, 1)
liveVisitors = db.live.filter(v => $segment == "all" || v.segment == $segment)

// ---- Formatting + tone helpers ----------------------------------------------
compactNum = n => $util.format(n, "compact")
durationText = s => Math.floor(s / 60) + "m " + Math.round(s % 60) + "s"
pctChange = (now, before) => before == 0 ? 0 : $util.round(((now - before) / before) * 100, 1)
deltaLabel = n => (n > 0 ? "+" : "") + n + "%"
trendOf = n => n > 0 ? "up" : n < 0 ? "down" : "flat"
toneOf = (n, goodUp) => n == 0 ? "default" : (n > 0) == goodUp ? "success" : "warning"
trendTone = n => n >= 0 ? "success" : "danger"
stepTone = n => n >= 60 ? "success" : n >= 25 ? "info" : "warning"
bounceTone = n => n >= 55 ? "danger" : n >= 40 ? "warning" : "success"
deviceIcon = d => d == "Mobile" ? "mobile-screen-button" : d == "Tablet" ? "tablet-screen-button" : "desktop"
pageByPath = path => db.pages.find(p => p.path == path) || db.pages[0]
sessionsDelta = pctChange(totalSessions, priorTotal)

// ---- Actions -----------------------------------------------------------------
function setRange(value) { $range = value; $page = 1 }
function setSegment(value) { $segment = value; $page = 1; $openPath = "" }
function setSearch(value) { $search = value; $page = 1 }
function setMetric(value) { $metric = value }
function setCompare(value) { $compare = value }
function resetFilters() { $range = "30d"; $segment = "all"; $search = ""; $page = 1 }
function removeChip(value) { if (value == seg.label) $segment = "all"; if (value == cfg.label) $range = "30d"; $page = 1 }
function openPage(index, row, id) { $openPath = id }
function closeDrawer() { $openPath = "" }
function exportPages() { $toast.success(`Exported ${pageRows.length} pages for the ${cfg.label}`) }
function refreshData() { $toast.info(`Refreshed — ${compactNum(totalSessions)} sessions in the ${cfg.label}`) }
function addToReport() { $toast.success(`${$openPath} added to the Monday growth report`); $openPath = "" }

// ---- 1. Page header + 2. filter toolbar -------------------------------------
headerActions = [
  Pill(`${activeNow} visitors online`, { tone: "success", icon: "signal" }),
  Button("Export CSV", { variant: "secondary", size: "sm", icon: "download", onClick: exportPages }),
  IconButton("rotate", { label: "Refresh analytics data", variant: "ghost", size: "sm", onClick: refreshData })
]
pageHeader = PageHeader("Product analytics", { subtitle: `larkspur.io · ${cfg.label} · data through ${$util.formatDate(asOf, "MMM D, YYYY")}`, breadcrumbs: ["Larkspur", "Insights", "Overview"], status: Badge("Live", { tone: "success", icon: "tower-broadcast" }), actions: headerActions })
filterControls = [
  Text("Range", { variant: "small-heavy", tone: "muted" }),
  ToggleGroup("range", { items: rangeItems, value: $range, onChange: setRange, size: "sm", label: "Date range" }),
  Text("Segment", { variant: "small-heavy", tone: "muted" }),
  Select("segment", { items: segments.map(s => ({ value: s.value, label: s.label })), value: $segment, onChange: setSegment, label: "Audience segment", labelHidden: true })
]
appliedChips = FilterChips([seg.label, cfg.label], { onRemove: removeChip, onClear: resetFilters, clearLabel: "Reset" })
filterBar = Toolbar({ left: filterControls, right: [StatusDot(`${compactNum(totalSessions)} sessions`, { tone: "info" }), appliedChips] })

// ---- 3. KPI row --------------------------------------------------------------
function Kpi(label, value, now, before, icon, goodUp, spark, hint) {
  return StatCard(label, { value: value, trend: trendOf(pctChange(now, before)), delta: deltaLabel(pctChange(now, before)), tone: toneOf(pctChange(now, before), goodUp), icon: icon, spark: spark, hint: hint })
}
kpiRow = Stats([
  Kpi("Sessions", compactNum(totalSessions), totalSessions, priorTotal, "chart-line", true, sessions, `vs ${compactNum(priorTotal)} previous period`),
  Kpi("Unique visitors", compactNum(totalVisitors), totalVisitors, priorVisitorTotal, "users", true, visitors, `${$util.round(totalSessions / Math.max(totalVisitors, 1), 2)} sessions per visitor`),
  Kpi("Page views", compactNum(totalViews), totalViews, priorViews, "eye", true, pageViews, `${$util.round(totalViews / Math.max(totalSessions, 1), 1)} views per session`),
  Kpi("Avg. engagement", durationText(avgSeconds), avgSeconds, priorAvgSeconds, "stopwatch", true, engagement, `median ${durationText(Math.round(avgSeconds * 0.72))}`),
  Kpi("Bounce rate", `${bounce}%`, bounce, priorBounce, "arrow-turn-down", false, bounceSpark, `${compactNum(Math.round(totalSessions * bounce / 100))} single-page sessions`)
], { layout: "grid", columns: 5 })

// ---- 4. Trend + traffic sources ---------------------------------------------
metricItems = [{ value: "sessions", label: "Sessions" }, { value: "visitors", label: "Visitors" }, { value: "views", label: "Page views" }]
seriesByMetric = { sessions: sessions, visitors: visitors, views: pageViews }
priorByMetric = { sessions: priorSessions, visitors: priorVisitors, views: priorPageViews }
currentSeries = seriesByMetric[$metric] || sessions
priorSeries = priorByMetric[$metric] || priorSessions
metricLabel = (metricItems.find(m => m.value == $metric) || metricItems[0]).label
chartSeries = $compare ? [Series("This period", { values: currentSeries }), Series("Previous period", { values: priorSeries })] : [Series("This period", { values: currentSeries })]
chartControls = [
  ToggleGroup("metric", { items: metricItems, value: $metric, onChange: setMetric, size: "sm", variant: "outline", label: "Chart metric" }),
  Switch("compare", { label: "Compare", value: $compare, onChange: setCompare })
]
trendCard = GridItem(Card([
  SectionHeader(`${metricLabel} over time`, { eyebrow: "TREND", subtitle: `${cfg.points} ${cfg.unit} · ${seg.label.toLowerCase()} · ${deltaLabel(sessionsDelta)} in sessions`, actions: chartControls }),
  LineChart(labels, { series: chartSeries, filled: !$compare, height: 260, yAxisLabel: metricLabel, ariaLabel: `${metricLabel} by ${cfg.unit} for the ${cfg.label}, ${seg.label.toLowerCase()}` })
]), { span: "2/3" })

sourceNames = ["Organic search", "Direct", "Referral", "Paid social", "Email", "Affiliates"]
sourceShares = { all: [0.34, 0.22, 0.16, 0.14, 0.09, 0.05], new: [0.41, 0.13, 0.19, 0.16, 0.07, 0.04], returning: [0.24, 0.38, 0.12, 0.09, 0.11, 0.06], "signed-in": [0.14, 0.57, 0.08, 0.05, 0.1, 0.06], trial: [0.19, 0.31, 0.21, 0.07, 0.14, 0.08] }
segShares = sourceShares[$segment] || sourceShares.all
sourceValues = segShares.map(s => Math.round(totalSessions * s))
topSourceIndex = segShares.indexOf($util.max(segShares))
topSourceName = sourceNames[topSourceIndex]
topSourceShare = $util.round(segShares[topSourceIndex] * 100, 1)
sourcesCard = GridItem(Card([
  SectionHeader("Traffic sources", { eyebrow: "ACQUISITION", subtitle: `${topSourceName} leads with ${topSourceShare}% of sessions` }),
  PieChart(sourceNames, { values: sourceValues, donut: true, valueFormat: "percent", size: 200, legendPosition: "bottom", ariaLabel: `Sessions by traffic source for the ${cfg.label}` })
]), { span: "1/3" })
trendRow = Grid([trendCard, sourcesCard], { columns: { base: 1, lg: 3 }, gap: "lg", alignItems: "start" })

// ---- 5. Acquisition funnel + realtime ---------------------------------------
funnelSteps = [{ label: "Sessions started", share: 1, icon: "globe" }, { label: "Viewed pricing", share: 0.412, icon: "tag" }, { label: "Started signup", share: 0.186, icon: "user-plus" }, { label: "Verified email", share: 0.138, icon: "envelope-circle-check" }, { label: "Activated workspace", share: seg.cvr / 100, icon: "rocket" }]
funnel = funnelSteps.map((s, i) => ({ label: s.label, icon: s.icon, count: Math.round(totalSessions * s.share), lost: i == 0 ? 0 : Math.round(totalSessions * (funnelSteps[i - 1].share - s.share)), share: $util.round(s.share * 100, 1), step: i == 0 ? 100 : $util.round((s.share / funnelSteps[i - 1].share) * 100, 1) }))
worstStep = funnel.slice(1).reduce((a, b) => a.step <= b.step ? a : b, funnel[1])
function FunnelRow(stage) {
  return Column([
    Progress(stage.share, { max: 100, tone: stepTone(stage.step), label: stage.label }),
    Row([Text(`${compactNum(stage.count)} sessions · ${stage.share}% of all traffic`, { variant: "small", tone: "muted" }), Spacer(), Badge(`${stage.step}% step`, { tone: stepTone(stage.step), icon: stage.icon, size: "xs" })], { gap: "xs" })
  ], { gap: "3xs" })
}
funnelCard = GridItem(Card([
  SectionHeader("Acquisition funnel", { eyebrow: "CONVERSION", subtitle: `${compactNum(conversions)} activations · ${cvr}% end to end · ${seg.label.toLowerCase()}`, status: Pill(`${worstStep.step}% at ${worstStep.label.toLowerCase()}`, { tone: "warning" }) }),
  Column(funnel.map(s => FunnelRow(s)), { gap: "sm" })
]), { span: "2/3" })

liveCounter = Column([
  Text("Active visitors", { variant: "small-heavy", tone: "muted" }),
  Row([Icon("user-group", { size: "lg", color: "var(--rui-color-primary)" }), CountUp(activeNow, { suffix: " online" })], { gap: "xs" }),
  Text(`${viewsPerMinute} page views / minute`, { variant: "small", tone: "muted" })
], { gap: "3xs" })
realtimeCard = GridItem(Card([
  SectionHeader("Right now", { eyebrow: "REALTIME", subtitle: "Rolling 12-minute window", status: StatusDot("Live", { tone: "success", pulse: true }) }),
  Row([liveCounter, Spacer(), Sparkline(liveSeries, { tone: "primary", width: 110, height: 44, label: "Active visitors over the last 12 minutes" })], { gap: "sm" }),
  Separator(),
  List(liveVisitors.map(v => ListItem(v.page, { description: `${v.city}, ${v.country} · ${v.device}`, icon: deviceIcon(v.device), trailing: [Badge(`${v.seconds}s`, { tone: "neutral", size: "xs" })] })), { divided: true, gap: "3xs", emptyLabel: "No visitors from this segment are online right now" })
]), { span: "1/3" })
engagementRow = Grid([funnelCard, realtimeCard], { columns: { base: 1, lg: 3 }, gap: "lg", alignItems: "start" })

// ---- 6. Top pages ------------------------------------------------------------
trackedShare = $util.round($util.sum(db.pages.map(p => p.share)) * 100, 1)
filteredPages = db.pages.filter(p => $search == "" || (p.path + " " + p.title).toLowerCase().includes($search.toLowerCase()))
pageRows = filteredPages.map(p => ({ ...p, views: Math.round(totalViews * p.share), visitors: Math.round(totalVisitors * p.share * 0.92) }))
pageTrend = p => buckets.map(i => Math.round(curve[i] * cfg.mult * seg.weight * 2.4 * p.share * (1 + (p.delta / 100) * (i / cfg.points))))
function pathCell(value) { return Column([Text(value, { variant: "body-heavy" }), Text(pageByPath(value).title, { variant: "small", tone: "muted", truncate: true })], { gap: "3xs" }) }
function secondsCell(value) { return durationText(value) }
function bounceCell(value) { return Badge(`${value}%`, { tone: bounceTone(value), size: "sm" }) }
function trendCell(p) { return Row([Sparkline(pageTrend(p), { tone: trendTone(p.delta), width: 64, height: 22, label: `${p.path} view trend` }), Badge(deltaLabel(p.delta), { tone: trendTone(p.delta), size: "xs" })], { gap: "2xs", justify: "end" }) }

pagesGrid = DataGrid([
  Col("Page", pageRows.map(p => p.path), { sortable: true, width: "250px", render: pathCell }),
  Col("Views", pageRows.map(p => p.views), { format: "number", align: "right", sortable: true }),
  Col("Visitors", pageRows.map(p => p.visitors), { format: "number", align: "right", sortable: true }),
  Col("Avg. time", pageRows.map(p => p.secs), { align: "right", sortable: true, render: secondsCell, headerTooltip: "Average engaged time on page" }),
  Col("Bounce", pageRows.map(p => p.bounce), { align: "right", sortable: true, render: bounceCell }),
  Col("Trend", pageRows.map(p => trendCell(p)), { align: "right" })
], { rowIds: pageRows.map(p => p.path), sort: $sort, page: $page, perPage: 6, density: "compact", striped: true, stickyHeader: false, onRowClick: openPage, exportable: true, exportFilename: "larkspur-top-pages.csv" })
noMatches = EmptyState("No pages match that filter", { icon: "file-circle-question", description: "Clear the search to see every tracked page again.", action: Button("Clear filters", { variant: "primary", icon: "filter-circle-xmark", onClick: resetFilters }) })
pagesCard = Card([
  SectionHeader("Top pages", { eyebrow: "CONTENT", subtitle: `${pageRows.length} of ${db.pages.length} tracked pages · ${trackedShare}% of ${compactNum(totalViews)} views`, status: Pill(`Sorted by ${($sort.key || "views").toLowerCase()}`, { tone: "neutral", icon: "arrow-down-wide-short" }) }),
  Toolbar({ left: [SearchBar("page-search", { placeholder: "Filter by path or title…", value: $search, onChange: setSearch, ariaLabel: "Filter tracked pages" })], right: [Pill(seg.label, { tone: "corporate", icon: "user-group" }), Pill(cfg.label, { tone: "neutral", icon: "calendar-days" })] }),
  Show(pageRows.length > 0, { fallback: noMatches, children: pagesGrid })
])

// ---- 7. Device + geography ---------------------------------------------------
dayParts = ["00–06", "06–12", "12–18", "18–24"]
deviceNames = ["Desktop", "Mobile", "Tablet"]
deviceShares = { all: [0.54, 0.39, 0.07], new: [0.44, 0.49, 0.07], returning: [0.62, 0.31, 0.07], "signed-in": [0.71, 0.24, 0.05], trial: [0.78, 0.18, 0.04] }
dayPartWeight = [0.14, 0.31, 0.36, 0.19]
segDevices = deviceShares[$segment] || deviceShares.all
deviceMatrix = segDevices.map(d => dayPartWeight.map(w => Math.round(totalSessions * d * w)))
deviceCard = Card([
  SectionHeader("Sessions by device and hour", { eyebrow: "BEHAVIOUR", subtitle: `Mobile is ${$util.round(segDevices[1] * 100, 1)}% of ${seg.label.toLowerCase()}` }),
  Heatmap(dayParts, { yLabels: deviceNames, values: deviceMatrix, valueFormat: "compact", tone: "primary", ariaLabel: `Sessions by device and time of day for the ${cfg.label}` })
])

geoRows = db.countries.map(c => ({ name: c.name, cvr: c.cvr, sessions: Math.round(totalSessions * c.share) }))
topGeo = $util.max(geoRows.map(c => c.sessions))
geoCovered = $util.round($util.sum(db.countries.map(c => c.share)) * 100, 1)
geoCard = Card([
  SectionHeader("Top countries", { eyebrow: "GEOGRAPHY", subtitle: `${geoCovered}% of sessions in the ${cfg.label}` }),
  Table([
    Col("Country", geoRows.map(c => c.name)),
    Col("Sessions", geoRows.map(c => compactNum(c.sessions)), { align: "right" }),
    Col("Share", geoRows.map(c => Progress(c.sessions, { max: topGeo, tone: "info", label: c.name })), { width: "150px" }),
    Col("Conv.", geoRows.map(c => Badge(`${c.cvr}%`, { tone: c.cvr >= 4 ? "success" : c.cvr >= 2.5 ? "info" : "neutral", size: "xs" })), { align: "right" })
  ], { density: "compact", striped: true, ariaLabel: "Sessions by country" })
])
breakdownRow = Grid([deviceCard, geoCard], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" })

// ---- 8. Insights & anomalies -------------------------------------------------
noisiestPage = db.pages.reduce((a, b) => a.bounce >= b.bounce ? a : b, db.pages[0])
risingPage = db.pages.reduce((a, b) => a.delta >= b.delta ? a : b, db.pages[0])
bounceGap = $util.round(noisiestPage.bounce - bounce, 1)

insights = [
  Callout(sessionsDelta >= 0 ? "success" : "warning", { live: false, icon: sessionsDelta >= 0 ? "arrow-trend-up" : "arrow-trend-down", title: `Sessions are ${deltaLabel(sessionsDelta)} against the previous period`, description: `${compactNum(totalSessions)} sessions in the ${cfg.label} versus ${compactNum(priorTotal)} in the period before, for ${seg.label.toLowerCase()}.` }),
  Callout("warning", { live: false, icon: "filter-circle-xmark", title: `Biggest drop-off: only ${worstStep.step}% reach ${worstStep.label.toLowerCase()}`, description: `${compactNum(worstStep.lost)} sessions leave the funnel at that step. Instrument the individual form fields to see where they stall.` }),
  Callout(bounceGap > 15 ? "danger" : "info", { live: false, icon: "arrow-turn-down", title: `${noisiestPage.path} bounces at ${noisiestPage.bounce}%`, description: `That is ${bounceGap} points above the ${bounce}% site average — the page answers the question and ends the visit.` }),
  Callout("success", { live: false, icon: "fire-flame-curved", title: `${risingPage.path} is up ${deltaLabel(risingPage.delta)}`, description: `"${risingPage.title}" now pulls ${compactNum(Math.round(totalViews * risingPage.share))} views, ${$util.round(risingPage.share * 100, 1)}% of everything tracked.` }),
  Callout(topSourceShare > 45 ? "warning" : "info", { live: false, icon: "diagram-project", title: `${topSourceName} is ${topSourceShare}% of this segment`, description: `${compactNum(sourceValues[topSourceIndex])} of ${compactNum(totalSessions)} sessions arrive through a single channel. Concentration above 45% is worth diversifying.` })
]
insightsCard = Card([
  SectionHeader("Insights & anomalies", { eyebrow: "AUTOMATED", subtitle: `${insights.length} findings for ${seg.label.toLowerCase()} over the ${cfg.label}`, actions: [Button("Open full report", { variant: "ghost", size: "sm", icon: "arrow-up-right-from-square", onClick: refreshData })] }),
  Grid(insights, { columns: { base: 1, md: 2 }, gap: "md" })
])

// ---- 9. Page detail drawer ---------------------------------------------------
selectedPage = db.pages.find(p => p.path == $openPath)
function referrerRows(p) {
  return sourceNames.map((n, i) => ListItem(n, { description: `${$util.round(segShares[i] * 100, 1)}% of this page's traffic`, icon: "arrow-right-to-bracket", trailing: [Text(compactNum(Math.round(sourceValues[i] * p.share * 1.08)), { variant: "small-heavy" })] }))
}
function pageFacts(p) {
  return DescriptionList([DescriptionItem("Avg. time on page", durationText(p.secs), { icon: "stopwatch" }), DescriptionItem("Bounce rate", `${p.bounce}%`, { icon: "arrow-turn-down" }), DescriptionItem("Share of views", `${$util.round(p.share * 100, 1)}%`, { icon: "chart-pie" }), DescriptionItem("Segment", seg.label, { icon: "user-group" })], { columns: 1 })
}

function PageDetail(p) {
  return Column([
    Row([Badge(p.path, { tone: "primary", icon: "link", size: "sm" }), Spacer(), Pill(cfg.label, { tone: "neutral" })], { gap: "sm" }),
    Text(p.title, { variant: "large-heavy", as: "h3" }),
    Stats([{ label: "Views", value: compactNum(Math.round(totalViews * p.share)) }, { label: "Visitors", value: compactNum(Math.round(totalVisitors * p.share * 0.92)) }, { label: "Bounce", value: `${p.bounce}%`, tone: bounceTone(p.bounce) }], { layout: "strip" }),
    Card([
      SectionHeader("Views over the period", { eyebrow: "TREND", status: Badge(deltaLabel(p.delta), { tone: trendTone(p.delta), icon: p.delta >= 0 ? "arrow-trend-up" : "arrow-trend-down", size: "sm" }) }),
      Sparkline(pageTrend(p), { tone: trendTone(p.delta), width: "100%", height: 64, label: `${p.path} views per ${cfg.unit}` }),
      Text(`${labels[0]} → ${$util.last(labels)}`, { variant: "small", tone: "muted" })
    ]),
    Card([SectionHeader("Referrers", { eyebrow: "SOURCES", subtitle: `Modelled from the ${seg.label.toLowerCase()} channel mix` }), List(referrerRows(p), { divided: true, gap: "3xs" })]),
    Card([
      SectionHeader("Engagement quality", { eyebrow: "DETAIL" }),
      Row([ProgressRing($util.round(100 - p.bounce, 1), { max: 100, caption: "Engaged", tone: bounceTone(p.bounce), size: "lg" }), pageFacts(p)], { gap: "lg", align: "center" })
    ])
  ], { gap: "md" })
}

drawerBody = selectedPage ? PageDetail(selectedPage) : EmptyState("No page selected", { icon: "file-lines", description: "Pick a row in the top-pages table to inspect it." })
drawerFooter = [Button("Close", { variant: "secondary", onClick: closeDrawer }), Button("Add to report", { variant: "primary", icon: "file-circle-plus", onClick: addToReport })]
detailDrawer = Drawer("Page detail", { open: $openPath != "", children: [drawerBody], width: "520px", side: "right", onClose: closeDrawer, footer: drawerFooter })