// Commerce — 9 reusable e-commerce components.
$app(Column([header, Column(demos, { gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Commerce", { subtitle: "9 reusable commerce components", badge: Badge("Components", { tone: "primary", icon: "bag-shopping" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }
money = n => $util.format(n, "currency", "USD")

// 1 — price tag with period
function PriceLabel(amount, { period = "", strike } = {}) {
  return Row([
    strike ? Text(money(strike), { tone: "muted", style: "text-decoration: line-through;" }) : null,
    Text(money(amount), { variant: "title", tone: "primary" }),
    period ? Text(period, { variant: "small", tone: "muted" }) : null
  ], { gap: "xs", align: "end" })
}

// 2 — quantity stepper
function QtyStepper({ initial = 1, min = 0, max = 99 } = {}) {
  const [q, setQ] = $state(initial)
  return Row([
    IconButton("minus", { label: "Decrease", variant: "secondary", size: "sm", disabled: q <= min, onClick: () => setQ(q - 1) }),
    Box([Text(String(q), { variant: "body-heavy" })], { padding: "xs" }),
    IconButton("plus", { label: "Increase", variant: "secondary", size: "sm", disabled: q >= max, onClick: () => setQ(q + 1) })
  ], { gap: "sm", align: "center" })
}

// 3 — cart line item
function CartLine(name, { price = 0, qty = 1, img, onRemove } = {}) {
  return Row([
    StackItem(Image(img, { alt: name, ratio: "1:1", fit: "cover" }), { basis: "56px" }),
    StackItem(Column([Text(name, { variant: "body-heavy" }), Text(`Qty ${qty}`, { variant: "small", tone: "muted" })], { gap: "xs" }), { grow: 1 }),
    Text(money(price * qty), { variant: "body-heavy" }),
    IconButton("trash", { label: "Remove", variant: "ghost", size: "sm", onClick: onRemove || (() => {}) })
  ], { gap: "md", align: "center" })
}

// 4 — order summary with subtotal/tax/shipping/total
function CartSummary({ items = [], shipping = 0, taxPct = 0 } = {}) {
  const sub = $util.sum(items.map(i => i.price * (i.qty || 1)))
  const tax = sub * taxPct / 100
  const total = sub + tax + shipping
  return Column([
    ...items.map(i => Row([Text(`${i.qty || 1} × ${i.name}`), Spacer(), Text(money(i.price * (i.qty || 1)))], { align: "center" })),
    Separator("horizontal"),
    Row([Text("Subtotal", { tone: "muted" }), Spacer(), Text(money(sub))], { align: "center" }),
    Row([Text("Tax", { tone: "muted" }), Spacer(), Text(money(tax))], { align: "center" }),
    Row([Text("Shipping", { tone: "muted" }), Spacer(), Text(shipping == 0 ? "Free" : money(shipping))], { align: "center" }),
    Separator("horizontal"),
    Row([Text("Total", { variant: "body-heavy" }), Spacer(), Text(money(total), { variant: "large-heavy", tone: "primary" })], { align: "center" })
  ], { gap: "xs" })
}

// 5 — coupon / promo code field
function CouponField({} = {}) {
  const [code, setCode] = $state("")
  const [applied, setApplied] = $state("")
  return applied
    ? Row([Badge(`${applied} applied`, { tone: "success", icon: "tag" }), Button("Remove", { variant: "ghost", size: "sm", onClick: () => { setApplied(""); setCode("") } })], { gap: "sm", align: "center" })
    : Row([StackItem(Input("coupon", { placeholder: "Promo code", value: code, onChange: setCode }), { grow: 1 }), Button("Apply", { variant: "secondary", disabled: !code, onClick: () => setApplied(code.toUpperCase()) })], { gap: "sm", align: "end" })
}

// 6 — checkout step indicator
function CheckoutSteps({ current = 0 } = {}) {
  const steps = ["Cart", "Shipping", "Payment", "Review"]
  return Steps(steps.map((s, i) => ({ title: s, active: i == current, details: i < current ? "Done" : null })))
}

// 7 — product rating with review count
function ProductRating({ value = 0, count = 0 } = {}) {
  return Row([Rating(value, { readonly: true, size: "sm" }), Text(`${value} (${count} reviews)`, { variant: "small", tone: "muted" })], { gap: "sm", align: "center" })
}

// 8 — add-to-cart button that becomes a stepper
function AddToCart(name, { price = 0 } = {}) {
  const [qty, setQty] = $state(0)
  return qty == 0
    ? Button(`Add · ${money(price)}`, { variant: "primary", icon: "cart-plus", onClick: () => setQty(1) })
    : Row([IconButton("minus", { label: "Decrease", variant: "secondary", size: "sm", onClick: () => setQty(qty - 1) }), Text(`${qty} in cart`, { variant: "body-heavy" }), IconButton("plus", { label: "Increase", variant: "secondary", size: "sm", onClick: () => setQty(qty + 1) })], { gap: "sm", align: "center" })
}

// 9 — stock status badge from quantity
function StockStatus(qty) {
  return qty <= 0
    ? Badge("Out of stock", { tone: "danger", icon: "circle-xmark", size: "sm" })
    : qty < 10
      ? Badge(`Only ${qty} left`, { tone: "warning", icon: "triangle-exclamation", size: "sm" })
      : Badge("In stock", { tone: "success", icon: "circle-check", size: "sm" })
}

demos = [
  Demo("PriceLabel", "Price with optional strike-through", Row([PriceLabel(29, { period: "/mo" }), PriceLabel(19, { period: "/mo", strike: 29 })], { gap: "xl", wrap: true })),
  Demo("QtyStepper", "Bounded quantity stepper", Row([QtyStepper({ initial: 1 }), QtyStepper({ initial: 3, max: 5 })], { gap: "xl" })),
  Demo("CartLine", "Cart line item", Column([CartLine("Aurora Hoodie", { price: 78, qty: 1, img: "https://picsum.photos/seed/h/120" }), CartLine("Voyager Mug", { price: 24, qty: 2, img: "https://picsum.photos/seed/mug/120" })], { gap: "sm" })),
  Demo("CartSummary", "Subtotal → total breakdown", CartSummary({ items: [{ name: "Hoodie", price: 78, qty: 1 }, { name: "Mug", price: 24, qty: 2 }], shipping: 0, taxPct: 8 })),
  Demo("CouponField", "Apply / remove promo code", CouponField()),
  Demo("CheckoutSteps", "Checkout progress", CheckoutSteps({ current: 2 })),
  Demo("ProductRating", "Stars + review count", ProductRating({ value: 4.5, count: 248 })),
  Demo("AddToCart", "Add button → quantity stepper", Row([AddToCart("Hoodie", { price: 78 }), AddToCart("Mug", { price: 24 })], { gap: "xl", wrap: true })),
  Demo("StockStatus", "Stock badge from quantity", Row([StockStatus(0), StockStatus(4), StockStatus(120)], { gap: "sm", wrap: true }))
]
