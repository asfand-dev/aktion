{
  "name": "aktion-runtime",
  "version": "0.5.11",
  "description": "Aktion is a single web component that turns a compact, streaming-first DSL into a rich, interactive UI inside its shadow DOM. Works in React, Vue, Angular, Svelte, plain HTML — or no framework at all.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./test": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/testing.js"
    },
    "./devtools": {
      "types": "./dist/types/devtools/index.d.ts",
      "import": "./dist/devtools.js"
    },
    "./language": {
      "types": "./dist/types/language-api.d.ts",
      "import": "./dist/language.js"
    },
    "./vite": {
      "types": "./dist/types/plugin/index.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./aktion-modules": {
      "types": "./dist/types/aktion-modules.d.ts"
    },
    "./style.css": "./dist/aktion.css",
    "./system_prompt.txt": "./dist/system_prompt.txt",
    "./system_prompt_chat.txt": "./dist/system_prompt_chat.txt"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "npm run build && vite",
    "build": "tsc -p tsconfig.build.json && vite build && vite build --config vite.testing.config.ts && vite build --config vite.devtools.config.ts && vite build --config vite.language.config.ts && vite build --config vite.plugin.config.ts && node scripts/emit-prompt.mjs && node scripts/emit-entry.mjs",
    "build:lib": "vite build",
    "build:test": "vite build --config vite.testing.config.ts",
    "build:devtools": "vite build --config vite.devtools.config.ts",
    "build:language": "vite build --config vite.language.config.ts",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "build:prompt": "node scripts/emit-prompt.mjs",
    "build:entry": "node scripts/emit-entry.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.4",
    "@vitest/web-worker": "^2.1.4",
    "happy-dom": "^15.7.4"
  },
  "keywords": [
    "llm",
    "ai",
    "web-components",
    "aktion",
    "generative-ui",
    "rich-ui",
    "custom-elements"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asfand-dev/aktion.git"
  },
  "homepage": "https://asfand-dev.github.io/aktion/",
  "bugs": {
    "url": "https://github.com/asfand-dev/aktion/issues"
  },
  "license": "MIT"
}
