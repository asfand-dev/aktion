# Postgres connection string (pooled) used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection used by `prisma db push` / migrations.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
# 32+ byte random secret for signing session tokens: `openssl rand -hex 32`
AUTH_SECRET=""

# AI design generation via OpenRouter (https://openrouter.ai/keys).
# Any hosted model id works; strong coding models design best.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
