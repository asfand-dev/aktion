{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vscode", "node"],
    "baseUrl": ".",
    "paths": {
      "aktion-runtime/language": [
        "../../dist/types/language-api.d.ts",
        "../../src/language-api.ts"
      ]
    }
  },
  "include": ["src"]
}
