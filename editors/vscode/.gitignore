node_modules/
dist/
snippets/
*.vsix

# esbuild fallback bundles. `scripts/load-surface.mjs` now writes them to
# `os.tmpdir()`, but two ~691 KB copies were once committed here and went stale
# (they snapshotted a 197-component surface). Belt-and-braces so a future
# generator can never re-introduce them.
scripts/.gen-*.tmp.mjs

# The repo root ignores `.vscode` globally, but the extension's launch/build
# config is part of this package — re-include it so F5 works out of the box.
!.vscode/
!.vscode/launch.json
!.vscode/tasks.json
.env
