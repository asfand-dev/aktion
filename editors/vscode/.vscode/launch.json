{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Aktion Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../../examples/vite-compiler"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build extension"
    }
  ]
}
