{
  "name": "aktion-vscode",
  "displayName": "Aktion",
  "description": "Rich language support for Aktion (.aktion) files: syntax + semantic highlighting, diagnostics with quick fixes, hover, completions, signature help, cross-file go-to-definition, find references, rename, document + workspace outline, formatting, and snippets. Covers all 26 $-builtins — $state, $memo, $ref, $reducer, $id, $effect, $optimistic, $http, $query, $mutation, $socket, $sse, $script, $head, $dom, $form, $store, $router, $theme, $i18n, $storage, $console, $toast, $emit, $app, $util — plus sx/animate universal props, 6 built-in themes, and the full 281-component library (incl. Mount / WebComponent interop). Also highlights Aktion code embedded in <aktion-app> tags inside HTML files.",
  "version": "0.6.3",
  "publisher": "AsfandiyarKhan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "aktion",
    "generative-ui",
    "dsl",
    "web-components",
    "reactive",
    "llm",
    "ai-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/asfand-dev/aktion.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://asfand-dev.github.io/aktion/",
  "bugs": {
    "url": "https://github.com/asfand-dev/aktion/issues"
  },
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The extension only parses and pretty-prints Aktion source — it never evaluates it, spawns a process, or loads workspace configuration."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Cross-file go-to-definition needs a local filesystem; every other feature works on virtual documents."
    }
  },
  "activationEvents": [
    "workspaceContains:**/*.aktion"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aktion",
        "aliases": [
          "Aktion"
        ],
        "extensions": [
          ".aktion"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "aktion",
        "scopeName": "source.aktion",
        "path": "./syntaxes/aktion.tmLanguage.json"
      },
      {
        "scopeName": "aktion-app.injection.html",
        "path": "./syntaxes/aktion-html-injection.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.aktion": "aktion"
        }
      }
    ],
    "snippets": [
      {
        "language": "aktion",
        "path": "./snippets/aktion.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "aktion.copySystemPrompt",
        "title": "Copy System Prompt (for an LLM)",
        "category": "Aktion"
      },
      {
        "command": "aktion.showLanguageReference",
        "title": "Show Language Reference",
        "category": "Aktion"
      },
      {
        "command": "aktion.insertComponent",
        "title": "Insert Component…",
        "category": "Aktion"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aktion.insertComponent",
          "when": "editorLangId == aktion"
        }
      ]
    },
    "configuration": {
      "title": "Aktion",
      "properties": {
        "aktion.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Report Aktion parse errors, schema errors and lint warnings while you type."
        },
        "aktion.diagnostics.debounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "description": "Idle time before a changed document is re-analysed. 0 analyses on every keystroke. Open and save always publish immediately."
        },
        "aktion.maxFileSizeKb": {
          "type": "number",
          "default": 512,
          "minimum": 0,
          "description": "Skip diagnostics for documents larger than this (KB). 0 disables the cap."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "scopes": {
          "namespace": [
            "entity.name.namespace",
            "support.type"
          ],
          "class": [
            "entity.name.type.class",
            "support.class"
          ],
          "class.defaultLibrary": [
            "support.class.aktion",
            "support.class"
          ],
          "class.declaration": [
            "entity.name.type.class"
          ],
          "function": [
            "entity.name.function",
            "support.function"
          ],
          "function.defaultLibrary": [
            "support.function.aktion",
            "support.function"
          ],
          "function.declaration": [
            "entity.name.function"
          ],
          "variable": [
            "variable.other.aktion",
            "variable.other"
          ],
          "variable.declaration": [
            "variable.other.aktion.declaration",
            "variable.other.aktion"
          ],
          "property": [
            "variable.other.property"
          ],
          "keyword": [
            "keyword"
          ],
          "number": [
            "constant.numeric"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[aktion]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "gen-snippets": "node scripts/gen-snippets.mjs",
    "gen-grammar": "node scripts/gen-grammar.mjs",
    "build": "npm run typecheck && npm run gen-snippets && npm run gen-grammar && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.0.0",
    "aktion-runtime": "^0.6.3",
    "esbuild": "^0.21.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.6.3"
  }
}
