{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aktion (embedded in HTML)",
  "scopeName": "aktion-app.injection.html",
  "comment": "GENERATED by scripts/gen-grammar.mjs — do not edit by hand. Injects source.aktion into the body of an <aktion-app> element in HTML files.",
  "injectionSelector": "L:text.html -comment -string",
  "patterns": [
    {
      "include": "#aktion-app-embedded"
    }
  ],
  "repository": {
    "aktion-app-embedded": {
      "comment": "Match the full <aktion-app …> opening tag (non-self-closing) and highlight everything up to </aktion-app> as Aktion source.",
      "begin": "(?i)(<)(aktion-app)\\b([^>]*?)(?<!/)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "patterns": [
            {
              "include": "#tag-attributes"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(?i)(</)(aktion-app)\\s*(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "contentName": "meta.embedded.block.aktion",
      "patterns": [
        {
          "include": "source.aktion"
        }
      ]
    },
    "tag-attributes": {
      "comment": "Minimal, self-contained highlighting for the opening tag's attributes.",
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.html"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.html"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.html"
        },
        {
          "match": "[a-zA-Z_:][\\w:.-]*",
          "name": "entity.other.attribute-name.html"
        }
      ]
    }
  }
}
