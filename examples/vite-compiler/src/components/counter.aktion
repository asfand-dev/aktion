// A reusable module. `Counter` and `$count` are exported (importable by other
// `.aktion` files); `increment` is private to this module.

export $count = 0

export function Counter() {
  return Card([
    CardHeader("Imported Counter", { subtitle: "Large" }),
    Markdown(`Clicked **${$count}** times.`),
    Button("Increment", { action: increment, variant: "primary" })
  ])
}

function increment() {
  $count = $count + 1
}
