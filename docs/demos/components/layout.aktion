// Layout — 10 reusable structural / layout components.
$app(Column([header, Column(demos, { gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Layout", { subtitle: "10 reusable layout components", badge: Badge("Components", { tone: "primary", icon: "table-cells-large" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }

// 1 — titled section inside a card
function PageSection(title, { subtitle, eyebrow, children = [] } = {}) {
  return Card([SectionHeader(title, { subtitle, eyebrow }), Column(children, { gap: "sm" })])
}

// 2 — page header with actions
function PageTop(title, { subtitle, actions = [] } = {}) {
  return PageHeader(title, { subtitle, actions, breadcrumbs: false })
}

// 3 — toolbar with left/right slots
function ActionBar({ left = [], right = [] } = {}) {
  return Toolbar({ left, right })
}

// 4 — master/detail split view
function SplitMasterDetail({ primary = [], detail = [], primaryWidth = "240px" } = {}) {
  return SplitView(primary, { detail, primaryWidth })
}

// 5 — accordion of collapsible sections
function Expandable({ items = [] } = {}) {
  return Accordion(items.map(i => AccordionItem(i.title, { children: i.children, open: i.open })), { showArrow: true })
}

// 6 — masonry image/card wall
function ImageWall({ items = [], columns = 3 } = {}) {
  return MasonryGrid(items, { columns, gap: "md" })
}

// 7 — marketing hero
function HeroBanner(title, { subtitle, eyebrow, primaryLabel, secondaryLabel, highlights = [] } = {}) {
  return Hero(title, { subtitle, eyebrow, highlights, primary: primaryLabel ? Button(primaryLabel, { variant: "primary" }) : null, secondary: secondaryLabel ? Button(secondaryLabel, { variant: "ghost" }) : null })
}

// 8 — sticky bar
function StickyHeader({ children = [] } = {}) {
  return Sticky([Box([Row(children, { align: "center", gap: "md" })], { padding: "sm", background: "surface", border: "subtle" })], { side: "top" })
}

// 9 — responsive card grid
function CardGrid({ cards = [], columns = { base: 1, sm: 2, lg: 3 } } = {}) {
  return Grid(cards, { columns, gap: "md" })
}

// 10 — titled panel (card + header)
function Panel(title, { subtitle, children = [] } = {}) {
  return Card([CardHeader(title, { subtitle }), Column(children, { gap: "sm" })])
}

demos = [
  Demo("PageSection", "Titled section in a card", PageSection("Account details", { eyebrow: "PROFILE", subtitle: "Your basic info", children: [Text("Name: Ada Lovelace"), Text("Email: ada@aktion.dev")] })),
  Demo("PageTop", "Page header with actions", PageTop("Customers", { subtitle: "1,240 total", actions: [Button("Export", { variant: "ghost", icon: "download" }), Button("New", { variant: "primary", icon: "plus" })] })),
  Demo("ActionBar", "Toolbar with slots", ActionBar({ left: [Badge("12 selected", { tone: "primary" })], right: [Button("Archive", { variant: "ghost", size: "sm", icon: "box-archive" }), Button("Delete", { variant: "danger", size: "sm", icon: "trash" })] })),
  Demo("SplitMasterDetail", "Master/detail panes", SplitMasterDetail({ primary: [List([ListItem("Inbox", { icon: "inbox" }), ListItem("Starred", { icon: "star" }), ListItem("Sent", { icon: "paper-plane" })])], detail: [Text("Select an item to see details here.", { tone: "muted" })] })),
  Demo("Expandable", "Accordion sections", Expandable({ items: [{ title: "Can I change plans later?", children: [Text("Yes, prorated immediately.")], open: true }, { title: "Do you offer refunds?", children: [Text("Within 30 days, no questions asked.")] }, { title: "Is my data backed up?", children: [Text("Daily encrypted backups.")] }] })),
  Demo("ImageWall", "Masonry wall", ImageWall({ items: [Image("https://picsum.photos/seed/m1/300/220", { ratio: "4:3" }), Image("https://picsum.photos/seed/m2/300/320", { ratio: "3:4" }), Image("https://picsum.photos/seed/m3/300/200", { ratio: "16:9" }), Image("https://picsum.photos/seed/m4/300/300", { ratio: "1:1" })], columns: 3 })),
  Demo("HeroBanner", "Marketing hero", HeroBanner("Build UIs in seconds", { eyebrow: "Aktion 0.5", subtitle: "A declarative library for streaming, theme-aware interfaces.", primaryLabel: "Get started", secondaryLabel: "Read docs", highlights: ["No bundler", "6 themes", "Shadow DOM"] })),
  Demo("StickyHeader", "Sticky toolbar", StickyHeader({ children: [Text("Sticky toolbar", { variant: "body-heavy" }), Spacer(), Button("Action", { variant: "primary", size: "sm" })] })),
  Demo("CardGrid", "Responsive card grid", CardGrid({ cards: [Tile("Create", { icon: "folder-plus", description: "New project" }), Tile("Invite", { icon: "user-plus", description: "Add teammates" }), Tile("Connect", { icon: "plug", description: "Add a source" })] })),
  Demo("Panel", "Titled panel", Panel("Notifications", { subtitle: "Last 24 hours", children: [Text("No new notifications.", { tone: "muted" })] }))
]
