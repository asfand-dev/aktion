// Utility — 10 small reusable helpers (clocks, counters, copy, etc.).
$app(Column([header, Column(demos, { gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Utility widgets", { subtitle: "10 reusable utility components", badge: Badge("Components", { tone: "primary", icon: "screwdriver-wrench" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }

// 1 — read-only field with a copy button + confirmation
function CopyField(value) {
  const [done, setDone] = $state(false)
  return Row([
    StackItem(Box([Text(value, { style: "font-family: ui-monospace, monospace; word-break: break-all;" })], { padding: "sm", border: "subtle", background: "surface" }), { grow: 1 }),
    IconButton(done ? "check" : "copy", { label: "Copy", variant: done ? "secondary" : "primary", onClick: () => { navigator.clipboard.writeText(value); setDone(true); setTimeout(() => setDone(false), 1400) } })
  ], { gap: "sm", align: "center" })
}

// 2 — live countdown (per-instance atom + interval effect)
function Countdown({ seconds = 30 } = {}) {
  $left = seconds
  $effect(() => { if ($left > 0) $left = $left - 1 }, ["every(1000)"])
  return Row([Icon("hourglass-half", { size: "sm" }), Text(`${Math.floor($left / 60)}:${String($left % 60).padStart(2, "0")}`, { variant: "body-heavy", style: "font-variant-numeric: tabular-nums;" }), $left == 0 ? Badge("Time's up", { tone: "danger" }) : null], { gap: "sm", align: "center" })
}

// 3 — ticking live clock
function LiveClock() {
  $clock = $util.formatDate($util.now(), "h:mm:ss A")
  $effect(() => { $clock = $util.formatDate($util.now(), "h:mm:ss A") }, ["every(1000)"])
  return Row([Icon("clock", { size: "sm" }), Text($clock, { variant: "body-heavy", style: "font-variant-numeric: tabular-nums;" })], { gap: "sm", align: "center" })
}

// 4 — number that animates up to a target
function AnimatedCounter({ to = 1000, prefix = "", suffix = "" } = {}) {
  $cnt = 0
  $effect(() => { if ($cnt < to) $cnt = Math.min(to, $cnt + Math.max(1, Math.ceil(to / 40))) }, ["every(40)"])
  return Text(`${prefix}${$util.format($cnt, "number")}${suffix}`, { variant: "title", tone: "primary" })
}

// 5 — keyboard shortcut chip
function ShortcutHint(keys) { return Kbd(keys) }

// 6 — status pip + label
function StatusDotLabel(label, { tone = "success", pulse = false } = {}) { return StatusDot(label, { tone, pulse }) }

// 7 — file drop zone
function FileDrop({ hint = "PNG or JPG up to 5MB", accept = "image/*" } = {}) {
  return FileUpload("file", { label: "Drop files or click to upload", hint, accept, icon: "cloud-arrow-up" })
}

// 8 — segmented step progress
function SegmentedProgress({ current = 2, total = 5 } = {}) {
  return Column([Progress(current, { max: total, segments: total, tone: "primary" }), Text(`Step ${current} of ${total}`, { variant: "small", tone: "muted" })], { gap: "xs" })
}

// 9 — clamp long text with a "read more"
function ExpandText(text, { maxLines = 2 } = {}) { return Truncate(text, { maxLines, expandLabel: "Read more" }) }

// 10 — color swatch row with tooltips
function ColorChips({ colors = [] } = {}) {
  return Row(colors.map(c => Tooltip(c, { trigger: Icon("square", { color: c, size: "xl" }) })), { gap: "sm", wrap: true })
}

demos = [
  Demo("CopyField", "Copy value to clipboard", CopyField("sample_api_key_value_goes_here")),
  Demo("Countdown", "Live countdown timer", Row([Countdown({ seconds: 45 }), Countdown({ seconds: 10 })], { gap: "xl", wrap: true })),
  Demo("LiveClock", "Ticking clock", LiveClock()),
  Demo("AnimatedCounter", "Counts up on mount", Row([AnimatedCounter({ to: 1240 }), AnimatedCounter({ to: 99, suffix: "%" })], { gap: "xl", wrap: true })),
  Demo("ShortcutHint", "Keyboard shortcut chip", Row([ShortcutHint(["Cmd", "K"]), ShortcutHint(["Ctrl", "Shift", "P"]), ShortcutHint("Esc")], { gap: "md", align: "center", wrap: true })),
  Demo("StatusDotLabel", "Status pip + label", Row([StatusDotLabel("Operational", { tone: "success", pulse: true }), StatusDotLabel("Degraded", { tone: "warning" }), StatusDotLabel("Down", { tone: "danger" })], { gap: "lg", wrap: true })),
  Demo("FileDrop", "Upload drop zone", FileDrop()),
  Demo("SegmentedProgress", "Segmented step progress", SegmentedProgress({ current: 3, total: 5 })),
  Demo("ExpandText", "Clamp + read more", ExpandText("Aktion is a declarative language that is a strict subset of JavaScript. Every program is valid JS, and the runtime adds reactivity on top, turning a compact DSL into a rich, interactive UI inside its shadow DOM that works in any framework or none at all.", { maxLines: 2 })),
  Demo("ColorChips", "Color swatch row", ColorChips({ colors: ["#6366f1", "#10b981", "#f59e0b", "#ef4444", "#0ea5e9", "#8b5cf6"] }))
]
