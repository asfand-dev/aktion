// Data display — 10 reusable components for showing structured data.
$app(Column([header, Column(demos, { gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Data display", { subtitle: "10 reusable data components", badge: Badge("Components", { tone: "primary", icon: "table-list" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }

// 1 — sortable, filterable data grid (per-instance sort atom)
function SortableTable({ columns = [], rows = [] } = {}) {
  $sortState = { key: columns[0], direction: "asc" }
  return DataGrid(columns.map(c => Col(c, { values: rows.map(r => r[c]), sortable: true, filterable: true })), { sort: $sortState, striped: true, density: "compact" })
}

// 2 — key/value summary
function KeyValueList({ items = [], columns = 2 } = {}) {
  return DescriptionList(items.map(i => DescriptionItem(i.label, { value: i.value, icon: i.icon })), { columns })
}

// 3 — vertical activity timeline
function ActivityFeed({ items = [] } = {}) {
  return Timeline(items.map(i => TimelineItem(i.title, { time: i.time, description: i.description, icon: i.icon, tone: i.tone })))
}

// 4 — collapsible file/folder tree
function FileTree({ nodes = [] } = {}) {
  buildNode = n => TreeNode(n.label, { icon: n.icon || (n.children ? "folder" : "file"), expanded: n.expanded, badge: n.badge, children: n.children ? n.children.map(c => buildNode(c)) : null })
  return Tree(nodes.map(n => buildNode(n)))
}

// 5 — wrapping cloud of tags
function TagCloud({ tags = [], tone = "primary" } = {}) {
  return Row(tags.map(t => Badge(t, { tone, size: "sm" })), { gap: "xs", wrap: true })
}

// 6 — feature/plan comparison
function CompareSpecs({ columns = [], rows = [] } = {}) {
  return ComparisonTable({ columns, rows })
}

// 7 — KPI strip
function StatStrip({ items = [] } = {}) {
  return Stats(items)
}

// 8 — titled list with icons
function IconList({ items = [] } = {}) {
  return List(items.map(i => ListItem(i.title, { description: i.description, icon: i.icon })))
}

// 9 — expandable JSON viewer
function JsonViewer({ data = {}, expanded = true } = {}) {
  return JsonTree({ data, expanded })
}

// 10 — read-only code block with copy
function CodePreview({ code = "", language = "javascript" } = {}) {
  return CodeBlock(code, { language, showLineNumbers: true, copy: true })
}

demos = [
  Demo("SortableTable", "Click a header to sort", SortableTable({ columns: ["Name", "Team", "Score"], rows: [{ Name: "Ada", Team: "Compilers", Score: 98 }, { Name: "Linus", Team: "Kernel", Score: 96 }, { Name: "Grace", Team: "Compilers", Score: 95 }, { Name: "Donald", Team: "Algorithms", Score: 93 }] })),
  Demo("KeyValueList", "Aligned key/value pairs", KeyValueList({ items: [{ label: "Plan", value: "Team" }, { label: "MRR", value: "$4,200", icon: "sack-dollar" }, { label: "Seats", value: "18 / 25", icon: "users" }, { label: "Region", value: "EU" }] })),
  Demo("ActivityFeed", "Vertical event timeline", ActivityFeed({ items: [{ title: "Account created", time: "2d ago", icon: "user-plus", tone: "primary" }, { title: "First deploy", time: "1d ago", icon: "rocket", tone: "success" }, { title: "Invited 3 teammates", time: "4h ago", icon: "users" }] })),
  Demo("FileTree", "Recursive folder tree", FileTree({ nodes: [{ label: "src", expanded: true, children: [{ label: "components", children: [{ label: "Button.aktion" }, { label: "Card.aktion" }] }, { label: "app.aktion" }] }, { label: "README.md", icon: "file-lines" }] })),
  Demo("TagCloud", "Wrapping tag cluster", TagCloud({ tags: ["aktion", "ui", "streaming", "components", "reactive", "shadow-dom", "themes"] })),
  Demo("CompareSpecs", "Plan comparison table", CompareSpecs({ columns: ["Free", "Pro", "Team"], rows: [{ label: "Projects", values: ["3", "Unlimited", "Unlimited"] }, { label: "SSO", values: [false, false, true] }, { label: "Support", values: ["Community", "Priority", "Dedicated"] }] })),
  Demo("StatStrip", "KPI strip", StatStrip({ items: [{ label: "Teams", value: "1,240" }, { label: "Uptime", value: "99.9%" }, { label: "Regions", value: "12" }] })),
  Demo("IconList", "Titled list with icons", IconList({ items: [{ title: "Streaming UI v2.4", description: "3 open issues", icon: "rocket" }, { title: "Auth SDK rewrite", description: "1 open issue", icon: "shield-halved" }] })),
  Demo("JsonViewer", "Expandable JSON tree", JsonViewer({ data: { name: "aktion", version: "0.5.3", features: ["reactive", "themes"], meta: { stars: 1240, license: "MIT" } } })),
  Demo("CodePreview", "Read-only code block", CodePreview({ code: "function add(a, b) {\n  return a + b\n}\n\nadd(2, 3)", language: "javascript" }))
]
