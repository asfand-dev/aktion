// Marketplace Browse — multi-vendor search results for a secondhand-tech marketplace: live
// search, a full facet rail, sortable + paged listings, a 3-slot compare tray and a saved search.
// Starting point for: marketplace search, classifieds, any faceted catalogue browse.
// Uses: SearchBar + Select sorting, Slider/CheckBoxGroup/MultiSelect/Radio/Switch facets,
//        FilterChips, ToggleGroup view switch, Pagination, ComparisonTable Modal, $form.
$app(Column([nav, searchBand, browseBand, spotlightBand, alertBand, siteFooter, compareModal], { gap: "none" }))

sellers = [
  { name: "Northside Refurb", city: "Portland, OR", since: "2019", rating: 4.9, sales: 2840, badge: "Top rated", badgeTone: "success", speciality: "Laptops & docking gear", blurb: "Bench-tested machines with a 12-month parts warranty and an honest battery report." },
  { name: "Halcyon Devices", city: "Austin, TX", since: "2017", rating: 4.8, sales: 3905, badge: "Power seller", badgeTone: "primary", speciality: "Phones & tablets", blurb: "Largest handset inventory on Reclaim — every device IMEI-checked before it lists." },
  { name: "Kestrel Tech Co.", city: "Toronto, ON", since: "2021", rating: 4.7, sales: 1982, badge: "Fast shipper", badgeTone: "info", speciality: "Audio & studio kit", blurb: "Same-day dispatch on anything ordered before 15:00 ET, packed in reused foam." },
  { name: "Bitwise Salvage", city: "Sheffield, UK", since: "2020", rating: 4.6, sales: 1120, badge: "Repair shop", badgeTone: "neutral", speciality: "Cameras & lenses", blurb: "In-house technicians recover bodies most sellers scrap. Full service log included." },
  { name: "Ampere Trading", city: "Rotterdam, NL", since: "2023", rating: 4.4, sales: 640, badge: "New seller", badgeTone: "warning", speciality: "Budget phones", blurb: "Bulk EU stock at aggressive prices, with tracked shipping across the Schengen area." }
]

listings = [
  { id: "L-4021", title: "Aurelis Slate 13 ultrabook — 16GB / 512GB", vendor: "Northside Refurb", category: "Laptops", price: 749, compareAt: 1099, cond: "excellent", rating: 4.7, reviews: 128, shipping: 0, eta: "Aug 12", listed: "2026-08-04", sku: "NR-SL13-512", warranty: "12 months", returns: true, img: "https://picsum.photos/seed/reclaim-slate13/600/450" },
  { id: "L-4018", title: "Nimbus Fold 5 phone — 256GB, unlocked", vendor: "Halcyon Devices", category: "Phones", price: 480, compareAt: 899, cond: "likeNew", rating: 4.8, reviews: 341, shipping: 0, eta: "Aug 11", listed: "2026-08-05", sku: "HD-NF5-256", warranty: "6 months", returns: true, img: "https://picsum.photos/seed/reclaim-fold5/600/450" },
  { id: "L-3994", title: "Corvid Studio Monitors — matched pair", vendor: "Kestrel Tech Co.", category: "Audio", price: 265, compareAt: 349, cond: "good", rating: 4.4, reviews: 62, shipping: 24, eta: "Aug 14", listed: "2026-07-29", sku: "KT-CSM-PR", warranty: "90 days", returns: false, img: "https://picsum.photos/seed/reclaim-monitors/600/450" },
  { id: "L-3981", title: "Orbis M2 mirrorless camera body", vendor: "Bitwise Salvage", category: "Cameras", price: 1180, compareAt: 1699, cond: "excellent", rating: 4.9, reviews: 87, shipping: 0, eta: "Aug 15", listed: "2026-07-27", sku: "BS-OM2-BD", warranty: "12 months", returns: true, img: "https://picsum.photos/seed/reclaim-orbism2/600/450" },
  { id: "L-3976", title: "Vantor Tab 11 Pro — 128GB with stylus", vendor: "Halcyon Devices", category: "Tablets", price: 289, compareAt: 449, cond: "good", rating: 4.3, reviews: 154, shipping: 9, eta: "Aug 13", listed: "2026-07-26", sku: "HD-VT11-128", warranty: "6 months", returns: true, img: "https://picsum.photos/seed/reclaim-tab11/600/450" },
  { id: "L-3970", title: "Falken Rove ANC headphones", vendor: "Kestrel Tech Co.", category: "Audio", price: 129, compareAt: 249, cond: "likeNew", rating: 4.6, reviews: 209, shipping: 0, eta: "Aug 10", listed: "2026-08-02", sku: "KT-FRV-ANC", warranty: "90 days", returns: true, img: "https://picsum.photos/seed/reclaim-rove/600/450" },
  { id: "L-3958", title: "Aurelis Slate 15 workstation — 32GB / 1TB", vendor: "Northside Refurb", category: "Laptops", price: 1340, compareAt: 2099, cond: "excellent", rating: 4.8, reviews: 74, shipping: 0, eta: "Aug 13", listed: "2026-07-24", sku: "NR-SL15-1TB", warranty: "12 months", returns: true, img: "https://picsum.photos/seed/reclaim-slate15/600/450" },
  { id: "L-3947", title: "Marlin Pocket 4 phone — 128GB", vendor: "Ampere Trading", category: "Phones", price: 215, compareAt: 399, cond: "fair", rating: 3.9, reviews: 46, shipping: 12, eta: "Aug 18", listed: "2026-07-21", sku: "AT-MP4-128", warranty: "30 days", returns: false, img: "https://picsum.photos/seed/reclaim-pocket4/600/450" },
  { id: "L-3939", title: "Orbis 24-70mm f/2.8 zoom lens", vendor: "Bitwise Salvage", category: "Cameras", price: 640, compareAt: 999, cond: "good", rating: 4.5, reviews: 51, shipping: 18, eta: "Aug 16", listed: "2026-07-19", sku: "BS-O2470", warranty: "6 months", returns: true, img: "https://picsum.photos/seed/reclaim-zoom2470/600/450" },
  { id: "L-3906", title: "Corvid DAC and headphone amplifier", vendor: "Kestrel Tech Co.", category: "Audio", price: 199, compareAt: 279, cond: "likeNew", rating: 4.7, reviews: 33, shipping: 0, eta: "Aug 12", listed: "2026-07-30", sku: "KT-CDA-01", warranty: "12 months", returns: true, img: "https://picsum.photos/seed/reclaim-dacamp/600/450" },
  { id: "L-3891", title: "Aurelis Slate 14 laptop — 8GB / 256GB", vendor: "Northside Refurb", category: "Laptops", price: 429, compareAt: 749, cond: "good", rating: 4.2, reviews: 165, shipping: 0, eta: "Aug 14", listed: "2026-07-15", sku: "NR-SL14-256", warranty: "12 months", returns: true, img: "https://picsum.photos/seed/reclaim-slate14/600/450" },
  { id: "L-3884", title: "Falken Ridge 7 phone — 512GB dual SIM", vendor: "Halcyon Devices", category: "Phones", price: 655, compareAt: 1049, cond: "excellent", rating: 4.6, reviews: 118, shipping: 0, eta: "Aug 12", listed: "2026-07-28", sku: "HD-FR7-512", warranty: "6 months", returns: true, img: "https://picsum.photos/seed/reclaim-ridge7/600/450" },
  { id: "L-3877", title: "Orbis Compact X1 travel camera", vendor: "Bitwise Salvage", category: "Cameras", price: 385, compareAt: 599, cond: "likeNew", rating: 4.8, reviews: 64, shipping: 15, eta: "Aug 17", listed: "2026-07-31", sku: "BS-OCX1", warranty: "6 months", returns: true, img: "https://picsum.photos/seed/reclaim-compactx1/600/450" },
  { id: "L-3862", title: "Marlin Sketch Tab 12 — 256GB", vendor: "Kestrel Tech Co.", category: "Tablets", price: 512, compareAt: 799, cond: "excellent", rating: 4.5, reviews: 71, shipping: 0, eta: "Aug 13", listed: "2026-07-23", sku: "KT-MST12", warranty: "12 months", returns: true, img: "https://picsum.photos/seed/reclaim-sketch12/600/450" },
  { id: "L-3841", title: "Nimbus Vue 5 phone — 128GB", vendor: "Ampere Trading", category: "Phones", price: 168, compareAt: 329, cond: "fair", rating: 3.7, reviews: 132, shipping: 12, eta: "Aug 20", listed: "2026-07-10", sku: "AT-NV5-128", warranty: "30 days", returns: false, img: "https://picsum.photos/seed/reclaim-vue5/600/450" }
]

$q = ""
$category = "all"
$sort = "relevance"
$lo = 0
$hi = 1500
$conditions = { likeNew: false, excellent: false, good: false, fair: false }
$sellerPicks = []
$minRating = "0"
$freeShip = false
$savedOnly = false
$view = "grid"
$page = 1
$saved = []
$compare = []
$compareOpen = false
$alertSaved = false

perPage = 6
ceiling = 1500
money = n => $util.currency(n, "USD")
sellerIndex = $util.keyBy(sellers, "name")
categories = $util.unique(listings.map(l => l.category))
conditionKeys = ["likeNew", "excellent", "good", "fair"]
conditionLabels = { likeNew: "Like new", excellent: "Excellent", good: "Good", fair: "Fair" }
conditionTones = { likeNew: "success", excellent: "info", good: "neutral", fair: "warning" }
gradeHints = { likeNew: "Unmarked, original packaging", excellent: "Light wear, fully functional", good: "Visible marks, no faults", fair: "Cosmetic damage, works fine" }
sortLabels = { relevance: "best match", priceAsc: "price, low to high", priceDesc: "price, high to low", rating: "listing rating", newest: "newest first" }
ratingOptions = [{ value: "0", label: "Any seller rating" }, { value: "4.5", label: "4.5 and above" }, { value: "4.7", label: "4.7 and above" }, { value: "4.85", label: "4.85 and above" }]
activeConditions = conditionKeys.filter(k => $conditions[k])

function matchesQuery(l) {
  const q = $q.trim().toLowerCase()
  if (q.length == 0) return true
  return l.title.toLowerCase().includes(q) || l.vendor.toLowerCase().includes(q) || l.category.toLowerCase().includes(q)
}

function matchesFacets(l) {
  if ($category != "all" && l.category != $category) return false
  if (l.price < $lo || l.price > $hi) return false
  if (activeConditions.length > 0 && !activeConditions.includes(l.cond)) return false
  if ($sellerPicks.length > 0 && !$sellerPicks.includes(l.vendor)) return false
  if (sellerIndex[l.vendor].rating < Number($minRating)) return false
  if ($freeShip && l.shipping > 0) return false
  if ($savedOnly && !$saved.includes(l.id)) return false
  return true
}

sorters = {
  relevance: (a, b) => (b.rating * 40 + b.reviews / 8) - (a.rating * 40 + a.reviews / 8),
  priceAsc: (a, b) => a.price - b.price,
  priceDesc: (a, b) => b.price - a.price,
  rating: (a, b) => b.rating - a.rating,
  newest: (a, b) => a.listed > b.listed ? -1 : 1
}

matches = [...listings.filter(l => matchesQuery(l) && matchesFacets(l))].sort(sorters[$sort])
totalPages = Math.max(1, Math.ceil(matches.length / perPage))
page = $util.clamp($page, 1, totalPages)
pageItems = matches.slice((page - 1) * perPage, page * perPage)
firstShown = matches.length == 0 ? 0 : (page - 1) * perPage + 1
lastShown = Math.min(page * perPage, matches.length)
avgPrice = matches.length > 0 ? $util.sum(matches.map(l => l.price)) / matches.length : 0
lowestDelivered = matches.length > 0 ? $util.min(matches.map(l => l.price + l.shipping)) : 0
freeShipCount = matches.filter(l => l.shipping == 0).length
totalSaving = $util.sum(matches.map(l => Math.max(0, l.compareAt - l.price)))

function clearAll() {
  $q = ""
  $category = "all"
  $lo = 0
  $hi = ceiling
  $conditions = { likeNew: false, excellent: false, good: false, fair: false }
  $sellerPicks = []
  $minRating = "0"
  $freeShip = false
  $savedOnly = false
  $page = 1
}

chips = [
  ...($q.trim().length > 0 ? [{ label: `Search: ${$q.trim()}`, value: "q" }] : []),
  ...($category != "all" ? [{ label: $category, value: "cat" }] : []),
  ...($lo > 0 || $hi < ceiling ? [{ label: `${money($lo)} – ${money($hi)}`, value: "price" }] : []),
  ...activeConditions.map(k => ({ label: conditionLabels[k], value: `cond:${k}` })),
  ...$sellerPicks.map(v => ({ label: v, value: `seller:${v}` })),
  ...($minRating != "0" ? [{ label: `Seller ${$minRating}+`, value: "rating" }] : []),
  ...($freeShip ? [{ label: "Free shipping", value: "ship" }] : []),
  ...($savedOnly ? [{ label: "Saved only", value: "saved" }] : [])
]

function removeChip(v) {
  if (v == "q") $q = ""
  else if (v == "cat") $category = "all"
  else if (v == "price") { $lo = 0; $hi = ceiling }
  else if (v == "rating") $minRating = "0"
  else if (v == "ship") $freeShip = false
  else if (v == "saved") $savedOnly = false
  else if (v.startsWith("cond:")) $conditions = { ...$conditions, [v.slice(5)]: false }
  else if (v.startsWith("seller:")) $sellerPicks = $sellerPicks.filter(x => x != v.slice(7))
  $page = 1
}

function toggleSave(id) {
  if ($saved.includes(id)) $saved = $saved.filter(x => x != id)
  else $saved = [...$saved, id]
}

function toggleCompare(id) {
  if ($compare.includes(id)) { $compare = $compare.filter(x => x != id); return }
  if ($compare.length >= 3) { $toast.info("The tray holds three listings — remove one first"); return }
  $compare = [...$compare, id]
}

function clearCompare() { $compare = []; $compareOpen = false }
function showSeller(name) { $sellerPicks = [name]; $page = 1; $toast.info(`Showing listings from ${name}`) }
function shipLine(l) { return l.shipping == 0 ? `Free shipping · arrives ${l.eta}` : `${money(l.shipping)} shipping · arrives ${l.eta}` }
function savingLine(l) { return l.compareAt > l.price ? `Save ${money(l.compareAt - l.price)} (${$util.percent((l.compareAt - l.price) / l.compareAt)})` : "Priced at market rate" }
function sellerAverage(name) { return $util.sum(listings.filter(l => l.vendor == name).map(l => l.price)) / listings.filter(l => l.vendor == name).length }

nav = NavBar({
  brand: Brand("Reclaim", { href: "#top" }),
  links: [Link("Browse", { href: "#results" }), Link("Sellers", { href: "#sellers" }), Link("Saved searches", { href: "#alerts" })],
  actions: [
    Button(`Saved (${$saved.length})`, { variant: $savedOnly ? "primary" : "secondary", size: "sm", icon: "bookmark", onClick: () => { $savedOnly = !$savedOnly; $page = 1 } }),
    Button(`Compare (${$compare.length})`, { variant: "ghost", size: "sm", icon: "scale-balanced", onClick: () => { $compareOpen = true } }),
    ThemeToggle()], sticky: true, blur: true
})

searchControls = Row([
  StackItem(SearchBar("q", { placeholder: "Search titles and sellers — try “camera” or “Kestrel”", value: $q, shortcut: "/", ariaLabel: "Search listings and sellers", onChange: (v) => { $q = v; $page = 1 } }), { grow: 1, minWidth: "240px" }),
  StackItem(Select("category", { label: "Category", items: [{ value: "all", label: "All categories" }, ...categories.map(c => ({ value: c, label: c }))], value: $category, onChange: (v) => { $category = v; $page = 1 } }), { basis: "190px" }),
  StackItem(Select("sort", { label: "Sort by", items: Object.keys(sortLabels).map(k => ({ value: k, label: $util.capitalize(sortLabels[k]) })), value: $sort, onChange: (v) => { $sort = v; $page = 1 } }), { basis: "210px" })
], { gap: "sm", align: "end", wrap: true })

heroStats = Stats([
  { label: "Matching listings", value: String(matches.length), hint: `of ${listings.length} live today` },
  { label: "Average asking price", value: money(avgPrice), hint: "across the current filter" },
  { label: "Lowest delivered", value: money(lowestDelivered), hint: "price plus shipping" },
  { label: "Off retail", value: money(totalSaving), tone: "success", hint: "combined saving on show" }
], { layout: "strip" })

searchBand = Section([Column([searchControls, heroStats], { gap: "lg" })], { background: "soft", width: "xl", id: "top", eyebrow: "RECLAIM MARKETPLACE", title: "Secondhand tech from vetted independent sellers", subtitle: "Every device is bench-tested, graded, and covered by Reclaim buyer protection for 30 days." })

facetPanel = Card([Column([
  Row([SectionHeader("Refine", { eyebrow: "FILTERS", subtitle: `${chips.length} active` }), Spacer(), Button("Clear all", { variant: "ghost", size: "sm", icon: "rotate-left", onClick: clearAll })], { align: "center", gap: "sm" }),
  Separator("horizontal"),
  FormSection("Price range", [
    Slider("priceLo", { min: 0, max: $hi, step: 25, value: $lo, label: "Minimum", showValue: true, format: "${value}", onChange: (v) => { $lo = v; $page = 1 } }),
    Slider("priceHi", { min: $lo, max: ceiling, step: 25, value: $hi, label: "Maximum", showValue: true, format: "${value}", onChange: (v) => { $hi = v; $page = 1 } }),
    Text(`${money($lo)} – ${money($hi)} · ${$util.plural(matches.length, "match", "matches")}`, { variant: "small", tone: "muted" })
  ], { helper: "Asking price, before shipping." }),
  FormSection("Condition", [CheckBoxGroup("condition", { items: conditionKeys.map(k => ({ label: conditionLabels[k], name: k, description: gradeHints[k] })), value: $conditions, label: "Condition grades", labelHidden: true, onChange: (v) => { $conditions = v; $page = 1 } })]),
  FormSection("Sellers", [MultiSelect("sellers", { items: sellers.map(s => ({ value: s.name, label: `${s.name} — ${s.rating}` })), value: $sellerPicks, placeholder: "Any seller", label: "Pick sellers", labelHidden: true, emptyLabel: "No seller by that name", onChange: (v) => { $sellerPicks = v; $page = 1 } })]),
  FormSection("Seller rating", [Radio("minRating", { items: ratingOptions, value: $minRating, label: "Minimum seller rating", labelHidden: true, onChange: (v) => { $minRating = v; $page = 1 } })]),
  FormSection("Delivery", [Switch("freeShip", { label: "Free shipping only", value: $freeShip, description: `${freeShipCount} of ${matches.length} matches ship free`, onChange: (v) => { $freeShip = v; $page = 1 } })]),
  Callout("info", { title: "Buyer protection", description: "Funds are held until you confirm the item matches its grade. Returns are free on protected listings.", icon: "shield-halved", compact: true })
], { gap: "lg" })])

function ListingMeta(l) {
  return Column([
    Row([Badge(conditionLabels[l.cond], { tone: conditionTones[l.cond], size: "xs" }), Badge(l.category, { tone: "neutral", size: "xs" }), Spacer(), Text(l.sku, { variant: "small", tone: "muted" })], { align: "center", gap: "xs", wrap: true }),
    Text(l.title, { variant: "body-heavy", lines: 2 }),
    Row([PriceTag(l.price, { compareAt: l.compareAt > l.price ? l.compareAt : null, size: "md" }), Spacer(), Rating(l.rating, { count: l.reviews, readonly: true, size: "sm" })], { align: "center", gap: "xs", wrap: true }),
    Text(savingLine(l), { variant: "small", tone: l.compareAt > l.price ? "success" : "muted" }),
    PersonChip(l.vendor, { role: `${sellerIndex[l.vendor].rating} rating · ${sellerIndex[l.vendor].sales} sales · ${sellerIndex[l.vendor].city}`, size: "sm" }),
    Row([Icon(l.shipping == 0 ? "truck-fast" : "truck", { size: "sm" }), Text(shipLine(l), { variant: "small", tone: l.shipping == 0 ? "success" : "muted" }), Spacer(), Text(`Delivered ${money(l.price + l.shipping)}`, { variant: "small-heavy" })], { gap: "xs", align: "center", wrap: true }),
    Separator("horizontal"),
    Row([
      Button($saved.includes(l.id) ? "Saved" : "Save", { variant: $saved.includes(l.id) ? "secondary" : "ghost", size: "sm", icon: "bookmark", onClick: () => toggleSave(l.id) }),
      Spacer(),
      Button($compare.includes(l.id) ? "In compare" : "Compare", { variant: $compare.includes(l.id) ? "secondary" : "ghost", size: "sm", icon: "scale-balanced", onClick: () => toggleCompare(l.id) })
    ], { align: "center", gap: "xs" })
  ], { gap: "2xs" })
}

function ListingCard(l) {
  const cover = Image(l.img, { alt: `${l.title}, listed by ${l.vendor}`, ratio: "4:3", fit: "cover" })
  if ($view == "list") return Card([Split(cover, { right: ListingMeta(l), ratio: "1/2", gap: "lg", stackAt: "md", align: "start" })])
  return Card([Column([cover, ListingMeta(l)], { gap: "sm" })])
}

resultsToolbar = Toolbar({
  left: [Text($util.plural(matches.length, "listing"), { variant: "large-heavy" }), Pill(matches.length == 0 ? "No results" : `Showing ${firstShown}–${lastShown}`, { tone: "neutral" }), StatusDot(`Sorted by ${sortLabels[$sort]}`, { tone: "info" })],
  right: [Text("View", { variant: "small", tone: "muted" }), ToggleGroup("view", { items: [{ value: "grid", label: "Grid", icon: "grip" }, { value: "list", label: "List", icon: "list" }], value: $view, size: "sm", label: "Results layout", onChange: (v) => { $view = v } })]
})

compareTray = Show($compare.length > 0, {
  children: Card([Row([
    Icon("scale-balanced", { size: "lg" }),
    Column([Text(`Comparing ${$compare.length} of 3`, { variant: "body-heavy" }), Text(compareItems.map(l => l.title).join(" · "), { variant: "small", tone: "muted", lines: 1 })], { gap: "3xs" }),
    Spacer(),
    Button("Open comparison", { variant: "primary", icon: "table-columns", onClick: () => { $compareOpen = true } }),
    Button("Empty tray", { variant: "ghost", icon: "xmark", onClick: clearCompare })], { align: "center", gap: "md", wrap: true })])
})

resultsPanel = Column([
  resultsToolbar,
  Show(chips.length > 0, { children: FilterChips(chips, { onRemove: removeChip, onClear: clearAll, clearLabel: "Clear all filters" }) }),
  compareTray,
  Show(matches.length > 0, {
    fallback: EmptyState("Nothing matches those filters", { description: "Every listing was excluded. Widen the price range, drop a condition grade, or clear the filters and start again.", icon: "box-open", actions: [Button("Clear all filters", { variant: "primary", icon: "rotate-left", onClick: clearAll }), Button("Raise the ceiling", { variant: "secondary", icon: "sliders", onClick: () => { $lo = 0; $hi = ceiling; $page = 1 } })] }),
    children: $view == "grid" ? Grid(pageItems.map(l => ListingCard(l)), { columns: { base: 1, sm: 2, xl: 3 }, gap: "lg", alignItems: "start" }) : Column(pageItems.map(l => ListingCard(l)), { gap: "md" })
  }),
  Show(matches.length > 0, { children: Pagination($page, totalPages, { total: matches.length, perPage: perPage, siblings: 1, onChange: (p) => { $page = p } }) })
], { gap: "lg" })

browseBand = Section([Split(facetPanel, { right: resultsPanel, ratio: "1/3", gap: "xl", stackAt: "lg", sticky: "left", stickyOffset: "96px", align: "start" })], { width: "xl", id: "results" })

function SellerCard(s) {
  const own = listings.filter(l => l.vendor == s.name)
  return Card([Column([
    Row([PersonChip(s.name, { role: `${s.city} · selling since ${s.since}` }), Spacer(), Badge(s.badge, { tone: s.badgeTone, size: "xs" })], { align: "center", gap: "sm", wrap: true }),
    Rating(s.rating, { count: s.sales, readonly: true, size: "sm", label: `${s.rating} out of 5` }),
    Text(s.blurb, { variant: "small", tone: "muted" }),
    DescriptionList([DescriptionItem("Speciality", { value: s.speciality, icon: "gem" }), DescriptionItem("Live listings", { value: String(own.length), icon: "tag" }), DescriptionItem("Average price", { value: money(sellerAverage(s.name)), icon: "receipt" })], { columns: 1 }),
    Button("Show their listings", { variant: "secondary", size: "sm", fullWidth: true, icon: "store", onClick: () => showSeller(s.name) })
  ], { gap: "sm" })])
}

topSellers = [...sellers].sort((a, b) => b.rating - a.rating).slice(0, 3)
spotlightBand = Section([Grid(topSellers.map(s => SellerCard(s)), { columns: { base: 1, md: 3 }, gap: "lg", alignItems: "start" })], { background: "surface", width: "xl", id: "sellers", eyebrow: "VENDOR SPOTLIGHT", title: "Sellers buyers come back to", subtitle: "Ratings are collected after every completed sale and cannot be edited by the seller." })

alertForm = $form({
  values: { email: "", frequency: "daily" },
  rules: { email: [$util.rules.required("Add an address so we know where to send it"), $util.rules.email("That address is missing a domain")] },
  onSubmit: (v) => { $alertSaved = true; $toast.success(`Alerts for this search will go to ${v.email}`) }
})

alertSummary = `${$util.plural(matches.length, "listing")} match right now — ${$category == "all" ? "all categories" : $category}, ${money($lo)} to ${money($hi)}${$freeShip ? ", free shipping only" : ""}.`

alertCard = Show($alertSaved, {
  fallback: Card([Split(
    Column([
      SectionHeader("Tell me when something new matches", { eyebrow: "SAVED SEARCH" }),
      Text(alertSummary, { variant: "body", tone: "muted" }),
      Row([Icon("shield-halved", { size: "sm" }), Text("One digest, unsubscribe in a click. We never sell your address.", { variant: "small", tone: "muted" })], { gap: "xs", align: "center" })
    ], { gap: "sm" }),
    { right: Column([
        Input("alertEmail", { label: "Email address", type: "email", placeholder: "you@example.com", autocomplete: "email", required: true, value: alertForm.values.email, error: alertForm.errors.email, onBlur: () => alertForm.touch("email") }),
        Select("alertFreq", { label: "Digest frequency", items: [{ value: "instant", label: "As soon as it lists" }, { value: "daily", label: "Once a day" }, { value: "weekly", label: "Weekly round-up" }], value: alertForm.values.frequency }),
        Button("Create the alert", { variant: "primary", icon: "bell", fullWidth: true, loading: alertForm.submitting, onClick: () => alertForm.submit() })
      ], { gap: "sm" }), ratio: "1/1", gap: "xl", stackAt: "md", align: "center" }
  )]),
  children: Card([SuccessState("Alert created", { description: `We will email ${alertForm.values.email} when a new listing matches. ${alertSummary}`, icon: "bell", actions: [Button("Edit the alert", { variant: "secondary", icon: "pen", onClick: () => { $alertSaved = false } })] })])
})

alertBand = Section([alertCard], { width: "lg", id: "alerts" })

compareItems = $compare.map(id => listings.find(l => l.id == id)).filter(l => l != null)
cheapestPick = compareItems.length > 0 ? compareItems.reduce((best, l) => (l.price + l.shipping) < (best.price + best.shipping) ? l : best) : null
cheapestLine = cheapestPick ? `Best delivered price: ${money(cheapestPick.price + cheapestPick.shipping)} from ${cheapestPick.vendor}` : "Add listings from the results grid."

compareRows = [
  { label: "Asking price", group: "Money", values: compareItems.map(l => money(l.price)) },
  { label: "Retail when new", group: "Money", values: compareItems.map(l => money(l.compareAt)) },
  { label: "You save", group: "Money", values: compareItems.map(l => l.compareAt > l.price ? `${money(l.compareAt - l.price)} (${$util.percent((l.compareAt - l.price) / l.compareAt)})` : "—") },
  { label: "Shipping", group: "Money", values: compareItems.map(l => l.shipping == 0 ? "Free" : money(l.shipping)) },
  { label: "Total delivered", group: "Money", hint: "Asking price plus shipping", values: compareItems.map(l => money(l.price + l.shipping)) },
  { label: "Condition", group: "Condition and seller", values: compareItems.map(l => conditionLabels[l.cond]) },
  { label: "Listing rating", group: "Condition and seller", values: compareItems.map(l => `${l.rating} from ${l.reviews} reviews`) },
  { label: "Seller", group: "Condition and seller", values: compareItems.map(l => `${l.vendor} · ${sellerIndex[l.vendor].rating}`) },
  { label: "Warranty", group: "Condition and seller", values: compareItems.map(l => l.warranty) },
  { label: "Arrives by", group: "Delivery", values: compareItems.map(l => l.eta) },
  { label: "Free returns", group: "Delivery", values: compareItems.map(l => l.returns) }
]

compareModal = Modal("Compare listings", {
  open: $compareOpen, size: "lg", lazy: true,
  children: [Show(compareItems.length > 0, {
    fallback: EmptyState("Nothing in the tray yet", { description: "Add up to three listings with the Compare button on any result.", icon: "scale-balanced" }),
    children: ComparisonTable(compareItems.map(l => l.title), { rows: compareRows, featureLabel: "Detail", highlightColumn: cheapestPick ? compareItems.indexOf(cheapestPick) : 0, stickyFirstColumn: true, caption: "Side-by-side comparison of the listings in your tray" })
  })],
  footer: [Row([Text(cheapestLine, { variant: "small", tone: "muted" }), Spacer(), Button("Empty tray", { variant: "ghost", icon: "trash", onClick: clearCompare }), Button("Back to results", { variant: "primary", onClick: () => { $compareOpen = false } })], { align: "center", gap: "sm", wrap: true })]
})

siteFooter = Footer({
  brand: Brand("Reclaim"),
  tagline: "A marketplace for tech that deserves a second owner.",
  columns: [
    FooterColumn("Browse", { links: [Link("All listings", { href: "#results" }), Link("Sellers", { href: "#sellers" }), Link("Saved searches", { href: "#alerts" })] }),
    FooterColumn("Buying", { links: [Link("Buyer protection", { href: "#top" }), Link("Condition grades", { href: "#results" }), Link("Shipping and returns", { href: "#results" })] }),
    FooterColumn("Selling", { links: [Link("Open a storefront", { href: "#sellers" }), Link("Seller fees", { href: "#sellers" }), Link("Grading guide", { href: "#sellers" })] })
  ],
  legal: "© 2026 Reclaim Market — demo marketplace, no real inventory"
})
