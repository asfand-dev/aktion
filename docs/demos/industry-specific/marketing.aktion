// Marketing — a campaign analytics dashboard: reach KPIs, performance trend,
// channel mix, active campaigns and the conversion funnel. Reusable blocks
// (ChannelRow, CampaignRow, FunnelStage) for any growth / ads console.
$app(Column([header, kpis, body, campaignsCard, funnelCard], { gap: "lg", padding: "md" }))

money = n => $util.currency(n, "USD")

perf = {
  weeks: ["W1", "W2", "W3", "W4"],
  impressions: [120, 168, 142, 210],
  clicks: [4.2, 6.1, 5.4, 8.0]
}

channels = ["Organic", "Paid search", "Social", "Email", "Referral"]
channelShare = [38, 26, 18, 12, 6]

campaigns = [
  { name: "Summer Launch", channel: "Paid search", spend: 4200, roas: 4.2, status: "Active", tone: "success" },
  { name: "Retargeting Q2", channel: "Social", spend: 2600, roas: 3.1, status: "Active", tone: "success" },
  { name: "Newsletter Drip", channel: "Email", spend: 480, roas: 6.8, status: "Active", tone: "success" },
  { name: "Brand Awareness", channel: "Social", spend: 5100, roas: 1.4, status: "Review", tone: "warning" },
  { name: "Holiday Teaser", channel: "Paid search", spend: 0, roas: 0, status: "Draft", tone: "default" }
]

funnel = [
  { stage: "Impressions", value: 640000, pct: 100, tone: "primary" },
  { stage: "Clicks", value: 23800, pct: 37, tone: "info" },
  { stage: "Visits", value: 19200, pct: 30, tone: "info" },
  { stage: "Leads", value: 4200, pct: 18, tone: "warning" },
  { stage: "Customers", value: 920, pct: 4, tone: "success" }
]

// Reusable: a campaign row with channel, spend and ROAS.
function CampaignRow(c) {
  return Row([
    StackItem(Column([
      Text(c.name, { variant: "body-heavy" }),
      Text(c.channel, { variant: "small", tone: "muted" })
    ], { gap: "none" }), { grow: 1 }),
    StackItem(Text(money(c.spend), { variant: "body" }), { basis: "90px" }),
    Badge(`${c.roas}x ROAS`, { tone: c.roas >= 3 ? "success" : c.roas > 0 ? "warning" : "default", size: "sm" }),
    Badge(c.status, { tone: c.tone, size: "sm" })
  ], { gap: "md", align: "center", key: c.name })
}

// Reusable: a single funnel stage with a width-mapped bar.
function FunnelStage(f) {
  return Column([
    Row([
      Text(f.stage, { variant: "body-heavy" }),
      Spacer(),
      Text(`${$util.format(f.value, "compact")} · ${f.pct}%`, { variant: "small", tone: "muted" })
    ], { align: "center" }),
    Progress(f.pct, { max: 100, tone: f.tone })
  ], { gap: "2xs", key: f.stage })
}

header = PageHeader("Campaign performance", {
  subtitle: "All channels · this month",
  badge: Badge("4 active campaigns", { tone: "primary", icon: "bullhorn" }),
  actions: [
    Button("Export report", { variant: "secondary", size: "sm", icon: "download" }),
    Button("New campaign", { variant: "primary", size: "sm", icon: "plus", onClick: () => $toast.success("Campaign builder opened") })
  ]
})

kpis = Stats([
  StatCard("Impressions", { value: "640k", icon: "eye", tone: "primary", trend: "up", delta: "+22%" }),
  StatCard("Click rate", { value: "3.7%", icon: "arrow-pointer", tone: "info", trend: "up", delta: "+0.5%" }),
  StatCard("Conversions", { value: "920", icon: "bullseye", tone: "success", trend: "up", delta: "+14%" }),
  StatCard("Ad spend", { value: money($util.sum(campaigns.map(c => c.spend))), icon: "sack-dollar", tone: "warning", trend: "up", delta: "+8%" })
])

perfChart = Card([
  SectionHeader("Reach & engagement", { eyebrow: "4 WEEKS", subtitle: "Impressions (k) vs clicks (k)" }),
  LineChart(perf.weeks, { series: [Series("Impressions (k)", { values: perf.impressions }), Series("Clicks (k)", { values: perf.clicks })], filled: true })
])

channelCard = Card([
  SectionHeader("Channel mix", { eyebrow: "ATTRIBUTION" }),
  PieChart(channels, { values: channelShare, valueFormat: "percent" })
])

body = Grid([perfChart, channelCard], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" })

campaignsCard = Card([
  SectionHeader("Active campaigns", { eyebrow: "RUNNING" }),
  Column(campaigns.map(c => CampaignRow(c)), { gap: "md" })
])

funnelCard = Card([
  SectionHeader("Conversion funnel", { eyebrow: "JOURNEY", subtitle: "Impression → customer" }),
  Column(funnel.map(f => FunnelStage(f)), { gap: "md" })
])
