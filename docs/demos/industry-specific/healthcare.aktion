// Healthcare — a clinic dashboard: patient load, vitals trend, today's
// appointments, patient roster and a care timeline. Reusable blocks
// (AppointmentRow, PatientCard, VitalTile) for any EHR / telehealth surface.
$app(Column([header, kpis, body, patientsCard, careCard], { gap: "lg", padding: "md" }))

vitals = {
  days: ["Mon", "Tue", "Wed", "Thu", "Fri"],
  heartRate: [72, 75, 70, 78, 74],
  systolic: [118, 121, 119, 124, 120]
}

appointments = [
  { time: "09:00", patient: "Eleanor Park", reason: "Annual physical", tone: "info", status: "Checked in" },
  { time: "09:45", patient: "Marcus Bell", reason: "Follow-up — diabetes", tone: "warning", status: "Waiting" },
  { time: "10:30", patient: "Aisha Khan", reason: "Lab results review", tone: "success", status: "Scheduled" },
  { time: "11:15", patient: "Tom Rivera", reason: "Post-op check", tone: "primary", status: "Scheduled" }
]

patients = [
  { name: "Eleanor Park", age: 58, condition: "Hypertension", tone: "warning", last: "Today" },
  { name: "Marcus Bell", age: 44, condition: "Type 2 diabetes", tone: "danger", last: "Today" },
  { name: "Aisha Khan", age: 31, condition: "Healthy", tone: "success", last: "2 days ago" },
  { name: "Tom Rivera", age: 67, condition: "Post-surgery", tone: "info", last: "1 week ago" }
]

care = [
  { title: "Lab results uploaded — Aisha Khan", time: "20m ago", description: "Lipid panel within normal range", icon: "flask", tone: "success" },
  { title: "Prescription renewed — Marcus Bell", time: "1h ago", description: "Metformin 500mg, 90-day supply", icon: "prescription-bottle-medical", tone: "info" },
  { title: "New referral — Tom Rivera", time: "3h ago", description: "Cardiology consult requested", icon: "user-doctor", tone: "primary" },
  { title: "Missed appointment — J. Doe", time: "Yesterday", description: "No-show, rescheduling needed", icon: "calendar-xmark", tone: "danger" }
]

// Reusable: a time-blocked appointment row with status pill.
function AppointmentRow(a) {
  return Row([
    Badge(a.time, { tone: "info", size: "sm", icon: "clock" }),
    Avatar(a.patient, { size: "sm", fallback: "initials" }),
    StackItem(Column([
      Text(a.patient, { variant: "body-heavy" }),
      Text(a.reason, { variant: "small", tone: "muted" })
    ], { gap: "none" }), { grow: 1 }),
    Badge(a.status, { tone: a.tone, size: "sm" })
  ], { gap: "md", align: "center", key: a.time })
}

// Reusable: a roster card summarising a patient at a glance.
function PatientCard(p) {
  return Card([
    Row([Avatar(p.name, { fallback: "initials" }), StackItem(Column([
      Text(p.name, { variant: "body-heavy" }),
      Text(`${p.age} yrs · last visit ${p.last}`, { variant: "small", tone: "muted" })
    ], { gap: "none" }), { grow: 1 })], { gap: "sm", align: "center" }),
    StatusDot(p.condition, { tone: p.tone })
  ], { key: p.name, sx: { states: { hover: { translateY: "-2px", shadow: "lg" } } } })
}

header = PageHeader("Clinic dashboard", {
  subtitle: "Riverside Family Practice · Tuesday, March 12",
  badge: Badge("4 appointments today", { tone: "primary", icon: "calendar-check" }),
  actions: [
    Button("New patient", { variant: "secondary", size: "sm", icon: "user-plus" }),
    Button("Start visit", { variant: "primary", size: "sm", icon: "stethoscope", onClick: () => $toast.success("Visit started") })
  ]
})

kpis = Stats([
  StatCard("Patients today", { value: "18", icon: "users", tone: "primary", trend: "up", delta: "+3" }),
  StatCard("Avg wait", { value: "12 min", icon: "hourglass-half", tone: "success", trend: "down", delta: "-4 min" }),
  StatCard("Bed occupancy", { value: "82%", icon: "bed-pulse", tone: "warning", trend: "up", delta: "+5%" }),
  StatCard("Critical alerts", { value: "1", icon: "heart-pulse", tone: "danger", trend: "flat", delta: "0" })
])

vitalsChart = Card([
  SectionHeader("Average vitals", { eyebrow: "THIS WEEK", subtitle: "Across active patients" }),
  LineChart(vitals.days, { series: [Series("Heart rate (bpm)", { values: vitals.heartRate }), Series("Systolic (mmHg)", { values: vitals.systolic })], filled: true })
])

scheduleCard = Card([
  SectionHeader("Today's schedule", { eyebrow: "APPOINTMENTS" }),
  Column(appointments.map(a => AppointmentRow(a)), { gap: "md" })
])

body = Grid([vitalsChart, scheduleCard], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" })

patientsCard = Card([
  SectionHeader("Patient roster", { eyebrow: "ACTIVE CARE" }),
  Grid(patients.map(p => PatientCard(p)), { columns: { base: 1, sm: 2, lg: 4 }, gap: "md" })
])

careCard = Card([
  SectionHeader("Care activity", { eyebrow: "TIMELINE" }),
  Timeline(care.map(c => TimelineItem(c.title, { time: c.time, description: c.description, icon: c.icon, tone: c.tone })))
])
