// Finance — a personal banking dashboard: balances, cash-flow trend, accounts,
// budgets and recent transactions. Reusable blocks (AccountRow, BudgetBar,
// TxnRow) for any fintech / banking / wallet app.
$app(Column([header, kpis, body, budgetsCard, txnsCard], { gap: "lg", padding: "md" }))

money = n => $util.currency(n, "USD")

flow = {
  months: ["Jan", "Feb", "Mar", "Apr", "May", "Jun"],
  income: [5200, 5200, 5600, 5400, 5800, 6000],
  spend:  [3800, 4200, 3600, 4100, 3900, 4300]
}

accounts = [
  { name: "Everyday Checking", number: "•••• 4821", balance: 8420.55, icon: "wallet", tone: "primary" },
  { name: "High-Yield Savings", number: "•••• 9930", balance: 24650.00, icon: "piggy-bank", tone: "success" },
  { name: "Travel Card", number: "•••• 1102", balance: -640.20, icon: "credit-card", tone: "warning" }
]

budgets = [
  { name: "Groceries", spent: 420, limit: 600, icon: "cart-shopping" },
  { name: "Dining out", spent: 310, limit: 300, icon: "utensils" },
  { name: "Transport", spent: 140, limit: 250, icon: "car" },
  { name: "Subscriptions", spent: 96, limit: 120, icon: "repeat" }
]

txns = [
  { merchant: "Whole Foods", category: "Groceries", amount: -86.40, date: "Today", icon: "cart-shopping" },
  { merchant: "Salary — Acme Inc", category: "Income", amount: 6000.00, date: "Yesterday", icon: "building" },
  { merchant: "Spotify", category: "Subscriptions", amount: -10.99, date: "Mar 12", icon: "music" },
  { merchant: "Uber", category: "Transport", amount: -23.50, date: "Mar 11", icon: "car" },
  { merchant: "Transfer to Savings", category: "Transfer", amount: -500.00, date: "Mar 10", icon: "right-left" }
]

// Reusable: a labelled account row with masked number + balance.
function AccountRow(a) {
  return Row([
    Avatar(a.name, { fallback: "initials" }),
    StackItem(Column([
      Text(a.name, { variant: "body-heavy" }),
      Text(a.number, { variant: "small", tone: "muted" })
    ], { gap: "none" }), { grow: 1 }),
    Text(money(a.balance), { variant: "large-heavy", tone: a.balance < 0 ? "danger" : "default" })
  ], { gap: "md", align: "center", key: a.number })
}

// Reusable: a budget progress bar that flips tone when over limit.
function BudgetBar(b) {
  const pct = Math.round((b.spent / b.limit) * 100)
  return Column([
    Row([
      Row([Icon(b.icon, { size: "sm" }), Text(b.name, { variant: "body-heavy" })], { gap: "xs", align: "center" }),
      Spacer(),
      Text(`${money(b.spent)} / ${money(b.limit)}`, { variant: "small", tone: pct > 100 ? "danger" : "muted" })
    ], { align: "center" }),
    Progress(Math.min(pct, 100), { max: 100, tone: pct > 100 ? "danger" : pct > 85 ? "warning" : "success" })
  ], { gap: "2xs", key: b.name })
}

netWorth = $util.sum(accounts.map(a => a.balance))
spentThisMonth = $util.sum(budgets.map(b => b.spent))

header = PageHeader("Accounts", {
  subtitle: "Your money at a glance · synced 2 minutes ago",
  badge: Badge("All accounts linked", { tone: "success", icon: "circle-check" }),
  actions: [
    Button("Transfer", { variant: "secondary", size: "sm", icon: "right-left", onClick: () => $toast.show("Open transfer flow") }),
    Button("Send money", { variant: "primary", size: "sm", icon: "paper-plane", onClick: () => $toast.success("Payment started") })
  ]
})

kpis = Stats([
  StatCard("Net worth", { value: money(netWorth), icon: "scale-balanced", tone: "primary", trend: "up", delta: "+3.1%" }),
  StatCard("Income (Jun)", { value: money(flow.income[5]), icon: "arrow-trend-up", tone: "success", trend: "up", delta: "+3.4%" }),
  StatCard("Spending (Jun)", { value: money(spentThisMonth), icon: "arrow-trend-down", tone: "warning", trend: "down", delta: "-2.0%" }),
  StatCard("Savings rate", { value: "28%", icon: "piggy-bank", tone: "info", trend: "up", delta: "+1.5%" })
])

flowChart = Card([
  SectionHeader("Cash flow", { eyebrow: "6 MONTHS", subtitle: "Income vs spending" }),
  BarChart(flow.months, { series: [Series("Income", { values: flow.income }), Series("Spending", { values: flow.spend })] })
])

accountsCard = Card([
  SectionHeader("Your accounts", { eyebrow: "BALANCES" }),
  Column(accounts.map(a => AccountRow(a)), { gap: "md" })
])

body = Grid([flowChart, accountsCard], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" })

budgetsCard = Card([
  SectionHeader("Monthly budgets", { eyebrow: "SPENDING", subtitle: `${money(spentThisMonth)} spent this month` }),
  Column(budgets.map(b => BudgetBar(b)), { gap: "md" })
])

txnsCard = Card([
  SectionHeader("Recent transactions", { eyebrow: "ACTIVITY", actions: [Button("Export CSV", { variant: "ghost", size: "sm", icon: "download" })] }),
  Table([
    Col("Merchant", { values: txns.map(t => Row([Icon(t.icon, { size: "sm" }), Text(t.merchant, { variant: "body-heavy" })], { gap: "xs", align: "center" })) }),
    Col("Category", { values: txns.map(t => Badge(t.category, { tone: t.amount > 0 ? "success" : "default", size: "sm" })) }),
    Col("Date", { values: txns.map(t => Text(t.date, { variant: "small", tone: "muted" })) }),
    Col("Amount", { align: "right", values: txns.map(t => Text(`${t.amount > 0 ? "+" : ""}${money(t.amount)}`, { variant: "body-heavy", tone: t.amount > 0 ? "success" : "default" })) })
  ], { striped: true })
])
