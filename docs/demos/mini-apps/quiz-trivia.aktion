// Trivia Quiz — timed multiple-choice with scoring, progress and a results recap.
// Uses: keyed animate per question, Confetti on a great score, Metric countUp recap.
$app(Column([header, stage], { gap: "lg", padding: "md" }))

questions = [
  { q: "Which planet is known as the Red Planet?", options: ["Venus", "Mars", "Jupiter", "Mercury"], answer: "Mars", topic: "Space" },
  { q: "What is the capital of Australia?", options: ["Sydney", "Melbourne", "Canberra", "Perth"], answer: "Canberra", topic: "Geography" },
  { q: "How many bits are in a byte?", options: ["4", "8", "16", "32"], answer: "8", topic: "Tech" },
  { q: "Who painted the Mona Lisa?", options: ["Van Gogh", "Picasso", "Da Vinci", "Rembrandt"], answer: "Da Vinci", topic: "Art" },
  { q: "What is the largest ocean on Earth?", options: ["Atlantic", "Indian", "Arctic", "Pacific"], answer: "Pacific", topic: "Geography" },
  { q: "Which language runs natively in a web browser?", options: ["Python", "JavaScript", "C++", "Rust"], answer: "JavaScript", topic: "Tech" }
]
QUESTION_TIME = 15

$idx = 0
$score = 0
$picked = null
$revealed = false
$done = false
$timeLeft = QUESTION_TIME

current = questions[$idx]
correct = current ? current.answer : null
progress = Math.round((($idx) / questions.length) * 100)

// per-question countdown
$effect(() => {
  if (!$done && !$revealed) {
    if ($timeLeft > 0) $timeLeft = $timeLeft - 1
    else reveal(null)
  }
}, ["every(1000)"])

function reveal(opt) {
  if ($revealed) return
  $picked = opt
  $revealed = true
  if (opt && opt == correct) $score = $score + 1
}

function next() {
  if ($idx + 1 >= questions.length) {
    $done = true
  } else {
    $idx = $idx + 1
    $picked = null
    $revealed = false
    $timeLeft = QUESTION_TIME
  }
}

function restart() {
  $idx = 0
  $score = 0
  $picked = null
  $revealed = false
  $done = false
  $timeLeft = QUESTION_TIME
}

verdict = $score >= 5 ? "Brilliant!" : $score >= 3 ? "Nicely done" : "Keep practising"

header = PageHeader("Trivia Quiz", {
  subtitle: "Six questions · 15 seconds each",
  badge: Badge(`Score ${$score}/${questions.length}`, { tone: "primary", icon: "star" })
})

optionVariant = opt => !$revealed
  ? ($picked == opt ? "primary" : "secondary")
  : opt == correct ? "primary" : (opt == $picked ? "danger" : "ghost")

optionBtn = opt => Button(opt, {
  onClick: () => reveal(opt),
  variant: optionVariant(opt),
  size: "lg",
  fullWidth: true,
  disabled: $revealed,
  icon: $revealed && opt == correct ? "check" : ($revealed && opt == $picked ? "xmark" : null)
})

feedback = Show($revealed, {
  children: $picked == correct
    ? Callout("success", { title: "Correct!", icon: "circle-check", compact: true })
    : Callout("danger", { title: $picked ? "Not quite" : "Time's up!", description: `The answer was "${correct}".`, icon: "circle-xmark", compact: true })
})

// `key: $idx` remounts the card per question, replaying the entrance animation
quizCard = Card([
  Row([
    StackItem(Progress(progress, { max: 100, tone: "primary" }), { grow: 1 }),
    Badge(`Q${$idx + 1}/${questions.length}`, { tone: "neutral" })
  ], { gap: "md", align: "center" }),
  Row([
    Badge(current ? current.topic : "", { tone: "info", size: "sm", icon: "tag" }),
    Spacer(),
    Badge(`${$timeLeft}s`, { tone: $timeLeft <= 5 ? "danger" : "neutral", icon: "clock" })
  ], { align: "center" }),
  Text(current ? current.q : "", { variant: "title" }),
  Column((current ? current.options : []).map(o => optionBtn(o)), { gap: "sm" }),
  feedback,
  Show($revealed, {
    children: Button($idx + 1 >= questions.length ? "See results" : "Next question", { onClick: next, variant: "primary", icon: "arrow-right", iconPosition: "trailing", fullWidth: true })
  })
], { key: `q-${$idx}`, animate: "fade-up" })

results = Card([
  Show($score >= 5, { children: Confetti({ fire: true, count: 100 }) }),
  SuccessState(verdict, {
    description: `You scored ${$score} out of ${questions.length}.`,
    icon: $score >= 3 ? "trophy" : "face-smile",
    actions: [Button("Play again", { onClick: restart, variant: "primary", icon: "rotate-right" })]
  }),
  Separator("horizontal", { label: "summary" }),
  MetricStrip([
    Metric(String($score), { label: "Correct", countUp: true }),
    Metric(String(questions.length - $score), { label: "Missed", gradient: false, countUp: true }),
    Metric(`${Math.round(($score / questions.length) * 100)}%`, { label: "Accuracy", countUp: true })
  ])
], { animate: "zoom" })

stage = $done ? results : quizCard
