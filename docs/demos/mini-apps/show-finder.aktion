// Show Finder — search TV shows on the key-free TVMaze API and open a rich detail panel.
// Starting point for: media-catalog browsers (films, podcasts, courses) over a public API.
// Uses: declarative cached $query, Sheet detail with Prose, Rating, staggered animate.
$app(Column([header, searchRow, view, detailSheet], { gap: "lg", padding: "md" }))

$q = "office"
$term = "office"
$selected = null

$shows = $query({
  url: `https://api.tvmaze.com/search/shows?q=${encodeURIComponent($term)}`,
  key: `tv-search-${$term}`,
  ttl: 600000
})

function search() { if ($q) $term = $q }
function stripTags(html) {
  return (html || "").replaceAll("<p>", "").replaceAll("</p>", "\n\n").replaceAll("<b>", "").replaceAll("</b>", "").replaceAll("<i>", "").replaceAll("</i>", "").trim()
}

header = PageHeader("Show Finder", {
  subtitle: "TVMaze search — no API key needed",
  badge: Badge("Live API · cached", { tone: "success", icon: "tv" })
})

searchRow = Row([
  StackItem(SearchBar("q", { placeholder: "Search shows… e.g. severance, dark", value: $q, onSubmit: search }), { grow: 1 }),
  Button("Search", { onClick: search, variant: "primary", icon: "magnifying-glass" })
], { gap: "sm", align: "end" })

showCard = (s, i) => MediaCard(s.show.name, {
  imageSrc: s.show.image ? s.show.image.medium : "",
  description: (s.show.genres || []).join(" · ") || s.show.type,
  badge: Badge(s.show.status, { tone: s.show.status == "Running" ? "success" : "neutral", size: "sm" }),
  tags: s.show.premiered ? [s.show.premiered.slice(0, 4)] : [],
  ratio: "3:4",
  actions: [Button("Details", { onClick: () => { $selected = s.show }, variant: "primary", icon: "circle-info", fullWidth: true })],
  animate: { preset: "fade-up", delay: Math.min(i, 7) * 60 },
  sx: { states: { hover: { translateY: "-3px", shadow: "lg" } } }
})

view = Async($shows, {
  loading: LoadingState("Searching…", { description: `Looking for "${$term}"` }),
  error: ErrorState("Search failed", { description: "TVMaze didn't respond — try again.", actions: [Button("Retry", { onClick: () => $shows.refetch(), variant: "primary", icon: "rotate-right" })] }),
  data: Show(($shows.data ?? []).length > 0, {
    fallback: EmptyState("No shows found", { description: `Nothing matched "${$term}".`, icon: "tv" }),
    children: Grid(($shows.data ?? []).map((s, i) => showCard(s, i)), { columns: { base: 1, sm: 2, lg: 4 }, gap: "lg" })
  })
})

detailBody = $selected
  ? Column([
      Row([
        Show(!!($selected.image && $selected.image.medium), { children: Image($selected.image ? $selected.image.medium : "", { alt: $selected.name, ratio: "3:4", fit: "cover", sx: { w: "160px" } }) }),
        StackItem(Column([
          BadgeList($selected.genres || [], { size: "sm" }),
          Show(!!($selected.rating && $selected.rating.average), {
            children: Rating({ value: ($selected.rating && $selected.rating.average ? $selected.rating.average : 0) / 2, readonly: true, label: `${$selected.rating ? $selected.rating.average : 0} / 10` })
          }),
          DescriptionList([
            DescriptionItem("Status", { value: $selected.status }),
            DescriptionItem("Premiered", { value: $selected.premiered || "—" }),
            DescriptionItem("Network", { value: $selected.network ? $selected.network.name : ($selected.webChannel ? $selected.webChannel.name : "—") }),
            DescriptionItem("Runtime", { value: $selected.averageRuntime ? `${$selected.averageRuntime} min` : "—" })
          ], { columns: 1 })
        ], { gap: "sm" }), { grow: 1, minWidth: "200px" })
      ], { gap: "lg", align: "start", wrap: true }),
      Separator("horizontal", { label: "synopsis" }),
      Prose([Text(stripTags($selected.summary) || "No synopsis available.", { variant: "body" })]),
      Show(!!$selected.officialSite, {
        children: Link("Official site ↗", { href: $selected.officialSite || "", external: true })
      }),
      Button("Close", { variant: "secondary", fullWidth: true, onClick: () => { $selected = null } })
    ], { gap: "md" })
  : Text("", { variant: "small" })

detailSheet = Sheet([detailBody], {
  open: !!$selected,
  side: "right",
  title: $selected ? $selected.name : "Show",
  onClose: () => { $selected = null }
})
