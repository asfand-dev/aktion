// Password Generator — tune the recipe, score strength, copy, and keep a short history.
// Uses: $store({ persist }) for the recipe, CopyButton, QRCode for phone hand-off.
$app(Column([header, body, historyCard], { gap: "lg", padding: "md" }))

recipe = $store({
  persist: "pwd.recipe",
  len: 16,
  useUpper: true,
  useLower: true,
  useNums: true,
  useSyms: true,
  avoidAmbig: true
})

$pwd = ""
$history = []
$showQr = false

LOWER = "abcdefghijkmnopqrstuvwxyz"
UPPER = "ABCDEFGHJKLMNPQRSTUVWXYZ"
NUMS = "23456789"
SYMS = "!@#$%^&*()-_=+[]{}?,."

function charset() {
  let s = ""
  if (recipe.useLower) s += recipe.avoidAmbig ? LOWER : LOWER + "l"
  if (recipe.useUpper) s += recipe.avoidAmbig ? UPPER : UPPER + "ILO"
  if (recipe.useNums)  s += recipe.avoidAmbig ? NUMS : NUMS + "01"
  if (recipe.useSyms)  s += SYMS
  return s
}

function generate() {
  const set = charset()
  if (!set) { $pwd = ""; return }
  const arr = new Uint32Array(recipe.len)
  crypto.getRandomValues(arr)
  let out = ""
  for (let i = 0; i < recipe.len; i++) out += set[arr[i] % set.length]
  $pwd = out
  $history = [out, ...$history].slice(0, 6)
}

// generate one on first mount
$effect(() => { generate() }, ["mount"])

poolSize = charset().length
entropy = $pwd ? Math.round($pwd.length * Math.log2(poolSize || 1)) : 0
strengthPct = Math.min(100, Math.round((entropy / 120) * 100))
strengthLabel = entropy >= 90 ? "Very strong" : entropy >= 60 ? "Strong" : entropy >= 40 ? "Fair" : "Weak"
strengthTone = entropy >= 90 ? "success" : entropy >= 60 ? "primary" : entropy >= 40 ? "warning" : "danger"

header = PageHeader("Password Generator", {
  subtitle: "Cryptographically random, never leaves your browser",
  badge: Badge(strengthLabel, { tone: strengthTone, icon: "shield-halved" })
})

output = Card([
  Row([
    StackItem(Box([Text($pwd || "—", { variant: "title", style: "font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1.6rem; word-break: break-all;" })], { padding: "md", border: "subtle", background: "surface" }), { grow: 1 }),
    Column([
      IconButton("rotate", { label: "Regenerate", variant: "ghost", size: "lg", onClick: generate })
    ], { gap: "sm" })
  ], { gap: "md", align: "center" }),
  Row([
    CopyButton($pwd, { label: "Copy password", copiedLabel: "Copied!" }),
    Button($showQr ? "Hide QR" : "Show QR", { variant: "secondary", icon: "qrcode", onClick: () => { $showQr = !$showQr } })
  ], { gap: "sm" }),
  Show($showQr && !!$pwd, {
    children: Center([Column([
      QRCode($pwd, { size: 160 }),
      Text("Scan to type it on your phone", { variant: "small", tone: "muted" })
    ], { gap: "sm", align: "center" })])
  }),
  Row([
    StackItem(Progress(strengthPct, { max: 100, tone: strengthTone }), { grow: 1 }),
    Badge(`${entropy} bits`, { tone: "neutral", icon: "key" })
  ], { gap: "md", align: "center" })
], { animate: "fade-up" })

controls = Card([
  SectionHeader("Recipe", { eyebrow: "OPTIONS", subtitle: "Saved automatically" }),
  FormControl("Length", { field: Slider("len", { min: 6, max: 40, step: 1, value: recipe.len, showValue: true, onChange: generate }) }),
  Grid([
    Switch("useUpper", { label: "Uppercase A–Z", value: recipe.useUpper, onChange: generate }),
    Switch("useLower", { label: "Lowercase a–z", value: recipe.useLower, onChange: generate }),
    Switch("useNums", { label: "Numbers 0–9", value: recipe.useNums, onChange: generate }),
    Switch("useSyms", { label: "Symbols !@#$", value: recipe.useSyms, onChange: generate }),
    Switch("avoidAmbig", { label: "Avoid look-alikes", value: recipe.avoidAmbig, description: "Skip i, l, 1, O, 0…", onChange: generate })
  ], { columns: { base: 1, sm: 2 }, gap: "sm" }),
  Button("Generate new password", { onClick: generate, variant: "primary", icon: "wand-magic-sparkles", fullWidth: true })
], { animate: { preset: "fade-up", delay: 80 } })

body = Grid([output, controls], { columns: { base: 1, md: 2 }, gap: "lg", alignItems: "start" })

historyCard = Show($history.length > 0, {
  children: Card([
    SectionHeader("Recent", { subtitle: "Last six generated — session only", actions: [Button("Clear", { variant: "ghost", size: "sm", icon: "trash", onClick: () => { $history = [] } })] }),
    Column($history.map(p => Row([
      StackItem(Text(p, { variant: "body", style: "font-family: ui-monospace, monospace; word-break: break-all;" }), { grow: 1 }),
      CopyButton(p, { label: "Copy" })
    ], { gap: "sm", align: "center" })), { gap: "xs" })
  ])
})
