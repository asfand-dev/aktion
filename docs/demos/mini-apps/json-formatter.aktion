// JSON Formatter & Validator — paste JSON, validate it, pretty-print or minify
// it, and explore the parsed structure in a collapsible tree. Starting point
// for: any data-inspection / API-debugging tool.
// Uses: try/catch parsing, TextArea two-way, JsonTree, Stats, Callout, CopyButton.
$app(Column([header, toolbar, Grid([editorCard, treeCard], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" }), statsCard], { gap: "lg", padding: "md" }))

sample = `{
  "name": "Aktion",
  "version": "0.5.15",
  "themes": ["light", "dark", "modern"],
  "components": 272,
  "meta": { "open_source": true, "license": "MIT" }
}`

$input = sample

function parsed() {
  if (!$input.trim()) return { ok: false, error: "Empty input", value: null }
  try { return { ok: true, error: null, value: JSON.parse($input) } }
  catch (e) { return { ok: false, error: String(e.message ?? e), value: null } }
}
res = parsed()

function depthOf(v, d) {
  if (v == null || typeof v != "object") return d
  let max = d
  for (let k of Object.keys(v)) {
    const child = depthOf(v[k], d + 1)
    if (child > max) max = child
  }
  return max
}

function countNodes(v) {
  if (v == null || typeof v != "object") return 1
  let n = 1
  for (let k of Object.keys(v)) n = n + countNodes(v[k])
  return n
}

function format() { if (res.ok) $input = JSON.stringify(res.value, null, 2) }
function minify() { if (res.ok) $input = JSON.stringify(res.value) }

header = PageHeader("JSON Formatter", {
  subtitle: "Validate, pretty-print and explore JSON",
  badge: res.ok ? Badge("valid", { tone: "success", icon: "circle-check" }) : Badge("invalid", { tone: "danger", icon: "circle-xmark" })
})

toolbar = Toolbar({
  left: [
    Button("Format", { variant: "primary", icon: "align-left", size: "sm", onClick: format, disabled: !res.ok }),
    Button("Minify", { variant: "secondary", icon: "compress", size: "sm", onClick: minify, disabled: !res.ok }),
    Button("Sample", { variant: "ghost", icon: "file-code", size: "sm", onClick: () => { $input = sample } }),
    Button("Clear", { variant: "ghost", icon: "eraser", size: "sm", onClick: () => { $input = "" } })
  ],
  right: [CopyButton($input, { label: "Copy", copiedLabel: "Copied!" })]
})

editorCard = Card([
  SectionHeader("Input", { eyebrow: "PASTE JSON" }),
  TextArea("input", { value: $input, rows: 16, placeholder: "Paste JSON here…" }),
  Show(!res.ok, { children: Callout("danger", { title: "Parse error", description: res.error, icon: "triangle-exclamation", compact: true }) })
], { animate: "fade-up" })

treeCard = Card([
  SectionHeader("Tree", { eyebrow: "STRUCTURE" }),
  res.ok
    ? JsonTree({ data: res.value, expanded: true })
    : EmptyState("Nothing to show", { icon: "diagram-project", description: "Fix the JSON to explore its structure." })
], { animate: { preset: "fade-up", delay: 80 } })

statsCard = Show(res.ok, {
  children: Stats([
    StatCard("Top-level keys", { value: String(typeof res.value == "object" && res.value != null ? Object.keys(res.value).length : 0), icon: "key" }),
    StatCard("Total nodes", { value: String(countNodes(res.value)), icon: "diagram-project" }),
    StatCard("Max depth", { value: String(depthOf(res.value, 0)), icon: "layer-group" }),
    StatCard("Characters", { value: $util.format($input.length, "compact"), icon: "ruler-horizontal" })
  ])
})
