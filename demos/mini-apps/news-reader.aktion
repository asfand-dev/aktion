$app(AppShell(sidebar, [header, toolbar, view]))

$mode = "front"
$q = ""
$term = ""

// Data fetching
apiUrl = $mode == "front"
  ? "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=40"
  : `https://hn.algolia.com/api/v1/search?query=${encodeURIComponent($term)}&tags=story&hitsPerPage=40`

$stories = $query({ 
  url: apiUrl, 
  key: `hn-${$mode}-${$term}`, 
  ttl: 300000,
  refetchOnFocus: true 
})

// Actions
function runSearch() {
  if ($q.trim()) {
    $mode = "search"
    $term = $q.trim()
  }
}

function setMode(m) {
  $mode = m
  if (m == "front") {
    $q = ""
    $term = ""
  }
}

// Helpers
domainOf = url => {
  try {
    return new URL(url).hostname.replace(/^www\./, "")
  } catch (e) {
    return "ycombinator.com"
  }
}

// Components
sidebar = Sidebar([
  SidebarSection("Feeds", [
    SidebarItem("Front Page", { icon: "house", active: $mode == "front", onClick: () => setMode("front") }),
    SidebarItem("Search", { icon: "magnifying-glass", active: $mode == "search", onClick: () => setMode("search") })
  ]),
  SidebarSection("Categories", [
    SidebarItem("Show HN", { icon: "eye", onClick: () => { $mode = "search"; $term = "show_hn"; $q = "Show HN" } }),
    SidebarItem("Ask HN", { icon: "circle-question", onClick: () => { $mode = "search"; $term = "ask_hn"; $q = "Ask HN" } }),
    SidebarItem("Jobs", { icon: "briefcase", onClick: () => { $mode = "search"; $term = "author_whoishiring"; $q = "Hiring" } })
  ])
], { brand: "HN Reader", tagline: "Algolia Powered" })

header = PageHeader($mode == "front" ? "Front Page" : "Search Results", {
  subtitle: $mode == "front" ? "Top stories right now" : `Showing results for "${$term}"`,
  actions: [
    Button("Refresh", { variant: "outline", icon: "rotate", onClick: () => $stories.refetch(), loading: $stories.loading })
  ]
})

toolbar = Toolbar({
  left: [
    SegmentedControl(["front", "search"], { 
      value: $mode, 
      onChange: setMode,
      size: "sm"
    })
  ],
  right: [
    StackItem(SearchBar("q", { 
      placeholder: "Search news...", 
      value: $q, 
      onSubmit: runSearch,
      clearable: true
    }), { grow: 1, minWidth: "300px" })
  ]
})

function StoryRow(s, index) {
  const url = s.url || `https://news.ycombinator.com/item?id=${s.objectID}`
  const commentUrl = `https://news.ycombinator.com/item?id=${s.objectID}`
  
  return Card([
    Row([
      Center([
        Text(String(index + 1), { variant: "body-heavy", tone: "muted" })
      ], { sx: { w: "32px" } }),
      
      StackItem(Column([
        Link(Text(s.title || "Untitled", { variant: "large-heavy", sx: { hover: { color: "primary" } } }), { 
          href: url, 
          external: true 
        }),
        Row([
          StatusDot(domainOf(url), { tone: "primary" }),
          Separator({ orientation: "vertical" }),
          Text(`by ${s.author}`, { variant: "small", tone: "muted" }),
          Separator({ orientation: "vertical" }),
          RelativeTime(s.created_at_i * 1000),
          Spacer(),
          Badge(`${s.points || 0} points`, { variant: "neutral" })
        ], { gap: "sm", align: "center" })
      ], { gap: "xs" }), { grow: 1 }),

      Separator({ orientation: "vertical" }),

      Link(
        Column([
          Icon("regular:comment", { size: "lg", color: "muted" }),
          Text(String(s.num_comments || 0), { variant: "small-heavy" })
        ], { align: "center", gap: "3xs" }),
        { href: commentUrl, external: true, sx: { px: "md", hover: { opacity: 0.7 } } }
      )
    ], { gap: "md", align: "center" })
  ], { 
    key: s.objectID,
    sx: { 
      p: "md",
      hover: { lift: true, shadow: "md", borderColor: "primary" } 
    } 
  })
}

hits = $stories.data?.hits?.filter(h => h.title) ?? []

view = Async($stories, {
  loading: Column([
    Skeleton({ variant: "paragraph", lines: 3 }),
    Skeleton({ variant: "paragraph", lines: 3 }),
    Skeleton({ variant: "paragraph", lines: 3 })
  ], { gap: "md" }),
  error: ErrorState("API Error", { 
    description: "Failed to fetch stories from Algolia.",
    actions: [Button("Try Again", { onClick: () => $stories.refetch() })] 
  }),
  data: Show(hits.length > 0, {
    children: Column(hits.map((s, i) => StoryRow(s, i)), { gap: "sm" }),
    fallback: EmptyState("No results", { 
      description: `We couldn't find any stories for "${$term}"`,
      icon: "magnifying-glass"
    })
  })
})