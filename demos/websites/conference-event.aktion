// ShipConf 2026 — a two-day developer conference site: live countdown, speaker
// bios, a track-filtered agenda you can save sessions from, ticket ordering and travel info.
// Starting point for: conferences, meetups, festivals, workshops and any dated event site.
// Uses: NavBar + stacked Sections, CountdownTimer, MetricStrip, ProfileCard → Modal,
//        Tabs + ToggleGroup agenda filter, Timeline, Drawer schedule, PricingTable +
//        QuantityStepper + OrderSummary, LogoCloud, Map, Accordion FAQ, $form, Footer.
$app(Column([nav, hero, metrics, speakerWall, agenda, tickets, sponsors, venue, faq, cfp, pageFooter, speakerModal, scheduleDrawer], { gap: "none" }))

$theme({ colors: { primary: "#0d9488", accent: "#f59e0b" }, radius: { md: "12px", lg: "18px", button: "10px" } })

// ---------- data -------------------------------------------------------------
photo = seed => `https://picsum.photos/seed/${seed}/240/240`

speakers = [
  { id: "sp1", name: "Marta Okonkwo", role: "Principal Engineer, Northwind Cloud", track: "Platform", handle: "mokonkwo", seed: "shipconf-marta", talk: "Zero-downtime migrations at 40k requests a second", tags: ["Postgres", "Migrations"], bio: "Marta has moved four petabyte-scale fleets between database engines without a maintenance window. She writes the migration runbooks the rest of Northwind copies." },
  { id: "sp2", name: "Jonas Behrens", role: "Staff Frontend Engineer, Kastell", track: "Frontend", handle: "jbehrens", seed: "shipconf-jonas", talk: "The 200 kB budget: a design system that stays small", tags: ["Design systems", "Perf"], bio: "Jonas maintains Kastell's component library across 19 product teams and has kept its shipped bundle under 200 kB for three years running." },
  { id: "sp3", name: "Priya Raghunathan", role: "Head of ML Platform, Lumen Labs", track: "AI", handle: "praghunathan", seed: "shipconf-priya", talk: "Evaluating agents you cannot unit-test", tags: ["Evals", "LLMOps"], bio: "Priya built the offline evaluation harness that gates every model release at Lumen Labs. She is unreasonably fond of golden datasets and boring dashboards." },
  { id: "sp4", name: "Tomas Ferreira", role: "SRE Lead, Cadence Payments", track: "Platform", handle: "tferreira", seed: "shipconf-tomas", talk: "Incident reviews that people actually read", tags: ["SRE", "On-call"], bio: "Tomas rewrote incident review at a payments company handling 2.3 million transactions a day, and cut repeat incidents by 41% in two quarters." },
  { id: "sp5", name: "Ines Delacroix", role: "Creative Engineer, Studio Feldspar", track: "Frontend", handle: "idelacroix", seed: "shipconf-ines", talk: "View transitions, without the jank", tags: ["Animation", "CSS"], bio: "Ines makes browsers do things they were not entirely designed for, then writes up exactly how so everyone else can do it safely." },
  { id: "sp6", name: "Kwame Asante", role: "Distinguished Engineer, Halden Systems", track: "AI", handle: "kasante", seed: "shipconf-kwame", talk: "Small models, big latency wins", tags: ["Inference", "Edge"], bio: "Kwame ships inference to devices with 4 GB of RAM and a flaky uplink. His team's median response time is measured in milliseconds, not seconds." },
  { id: "sp7", name: "Sofia Lindqvist", role: "Director of Developer Experience, Brightpath", track: "Platform", handle: "slindqvist", seed: "shipconf-sofia", talk: "Paved roads, not guardrails", tags: ["DevEx", "Tooling"], bio: "Sofia has spent six years arguing that the fastest way to do the right thing should also be the easiest, and has the adoption charts to back it up." },
  { id: "sp8", name: "Haruto Nakamura", role: "Founder, Tessellate", track: "Frontend", handle: "hnakamura", seed: "shipconf-haruto", talk: "Rendering a million rows without a virtual DOM", tags: ["Rendering", "Data grids"], bio: "Haruto wrote a spreadsheet engine that renders a million rows at 120 fps, and will happily show you the flame graph that got it there." }
]

sessions = [
  { id: "s01", day: "d1", time: "09:30", room: "Hall A", track: "Platform", speakerId: "sp1", title: "Opening keynote: what actually broke in 2026" },
  { id: "s02", day: "d1", time: "10:45", room: "Hall B", track: "Frontend", speakerId: "sp2", title: "The 200 kB budget: a design system that stays small" },
  { id: "s03", day: "d1", time: "11:45", room: "Hall A", track: "AI", speakerId: "sp3", title: "Evaluating agents you cannot unit-test" },
  { id: "s04", day: "d1", time: "13:30", room: "Hall B", track: "Platform", speakerId: "sp4", title: "Incident reviews that people actually read" },
  { id: "s05", day: "d1", time: "14:45", room: "Hall A", track: "Frontend", speakerId: "sp5", title: "View transitions, without the jank" },
  { id: "s06", day: "d1", time: "16:15", room: "Studio", track: "AI", speakerId: "sp6", title: "Small models, big latency wins" },
  { id: "s07", day: "d2", time: "09:30", room: "Hall A", track: "Platform", speakerId: "sp7", title: "Paved roads, not guardrails" },
  { id: "s08", day: "d2", time: "10:45", room: "Hall B", track: "Frontend", speakerId: "sp8", title: "Rendering a million rows without a virtual DOM" },
  { id: "s09", day: "d2", time: "11:45", room: "Studio", track: "AI", speakerId: "sp3", title: "Retrieval that survives a schema change" },
  { id: "s10", day: "d2", time: "13:30", room: "Hall A", track: "Platform", speakerId: "sp1", title: "Zero-downtime migrations at 40k requests a second" },
  { id: "s11", day: "d2", time: "14:45", room: "Hall B", track: "Frontend", speakerId: "sp2", title: "Design tokens as a build artefact" },
  { id: "s12", day: "d2", time: "16:15", room: "Workshop room", track: "Platform", speakerId: "sp4", title: "Workshop: chaos drills for teams of five" }
]

tiers = [
  { id: "community", name: "Community", price: 149, blurb: "Subsidised seats for students, career switchers and non-profits.", features: ["Both conference days", "Hallway track + lunch", "Talk recordings", { label: "Day-two workshop seat", included: false }] },
  { id: "conference", name: "Conference", price: 349, blurb: "The full two-day programme across all three tracks.", features: ["Both conference days", "Hallway track + lunch", "Talk recordings", "Speaker dinner ballot"], featured: true, badge: "Most popular" },
  { id: "workshop", name: "Conference + Workshops", price: 549, blurb: "Everything, plus a hands-on seat in one of the eight day-two workshops.", features: ["Everything in Conference", "One workshop seat (8 on offer)", "Workshop materials to keep", "Priority Q&A slots"] }
]

// ---------- state ------------------------------------------------------------
$speaker = null
$scheduleOpen = false
$day = "d1"
$track = "all"
$saved = ["s03"]
$qtyCommunity = 0
$qtyConference = 1
$qtyWorkshop = 0
$ordered = false

money = n => $util.currency(n, "EUR")
speakerOf = id => speakers.find(p => p.id == id)
dayLabel = d => d == "d1" ? "Thu 12 Nov" : "Fri 13 Nov"
trackTone = t => t == "Frontend" ? "info" : t == "Platform" ? "primary" : "warning"
trackIcon = t => t == "Frontend" ? "code" : t == "Platform" ? "server" : "microchip"
qtyOf = id => id == "community" ? $qtyCommunity : id == "conference" ? $qtyConference : $qtyWorkshop
speakerDays = p => ["d1", "d2"].filter(d => sessions.some(s => s.speakerId == p.id && s.day == d))
daysLabel = ds => ds.length > 1 ? "Speaking both days" : dayLabel(ds[0])
sessionsFor = day => sessions.filter(s => s.day == day && ($track == "all" || s.track == $track))

seats = $qtyCommunity + $qtyConference + $qtyWorkshop
subtotal = $qtyCommunity * 149 + $qtyConference * 349 + $qtyWorkshop * 549
teamDiscount = seats >= 5 ? Math.round(subtotal * 0.15) : 0
vat = Math.round((subtotal - teamDiscount) * 0.19)
total = subtotal - teamDiscount + vat
savedSessions = sessions.filter(s => $saved.includes(s.id))

function setQty(id, n) {
  const v = Math.max(0, Math.min(12, n))
  if (id == "community") $qtyCommunity = v
  if (id == "conference") $qtyConference = v
  if (id == "workshop") $qtyWorkshop = v
}

function addTicket(t) {
  const next = qtyOf(t.id) + 1
  setQty(t.id, next)
  $ordered = false
  $toast.success(`${t.name} × ${next} in your order`)
}

function toggleSession(s) {
  const on = $saved.includes(s.id)
  $saved = on ? $saved.filter(x => x != s.id) : [...$saved, s.id]
  $toast.info(on ? `Removed ${s.title}` : `Saved ${s.title} to your schedule`)
}

function checkout() {
  if (seats == 0) return $toast.error("Add at least one ticket before checking out")
  $ordered = true
  $toast.success(`${$util.plural(seats, "seat")} reserved for ${money(total)} — your confirmation is on the way`)
}

function jumpToSession() {
  if (!$speaker) return
  $day = speakerDays($speaker)[0]
  $track = $speaker.track
  $toast.info(`Agenda filtered to the ${$speaker.track} track`)
  $speaker = null
}

// ---------- nav + hero -------------------------------------------------------
nav = NavBar({
  brand: Brand("ShipConf 2026"),
  links: [Link("Speakers", { href: "#speakers" }), Link("Agenda", { href: "#agenda" }), Link("Tickets", { href: "#tickets" }), Link("Venue", { href: "#venue" })],
  actions: [
    ThemeToggle(),
    Button(`My schedule (${$saved.length})`, { variant: "ghost", size: "sm", icon: "calendar-check", onClick: () => { $scheduleOpen = true } }),
    Button("Get tickets", { variant: "primary", size: "sm", icon: "ticket", href: "#tickets", onClick: () => addTicket(tiers[1]) })
  ],
  sticky: true,
  blur: true
})

hero = Section([
  Backdrop({ grid: true }),
  Column([
    Eyebrow("BERLIN · 12-13 NOVEMBER 2026"),
    Display(["Two days about ", GradientText("software that stays shipped", { gradient: "brand" })], { size: "hero", align: "center", balance: true }),
    Text("ShipConf is a practitioner conference for the people who keep production running: 32 speakers, three tracks and eight hands-on workshops at Kraftwerk Berlin.", { variant: "large", tone: "muted", align: "center" }),
    CountdownTimer("2026-11-12T09:30:00", { endLabel: "The opening keynote is live" }),
    Row([
      Button("Get tickets", { variant: "primary", size: "lg", icon: "ticket", href: "#tickets" }),
      Button("Browse the agenda", { variant: "secondary", size: "lg", icon: "calendar-days", href: "#agenda" })
    ], { gap: "md", justify: "center", wrap: true }),
    Row([
      StatusDot("Doors 08:00", { tone: "success", pulse: true }),
      Text("Kraftwerk Berlin · Koepenicker Str. 70 · 1,200 seats · talks recorded and free to watch", { variant: "small", tone: "muted", align: "center" })
    ], { gap: "sm", justify: "center", wrap: true })
  ], { gap: "lg", align: "center" })
], { background: "base", width: "lg", align: "center", padding: "lg" })

metrics = Section([
  Reveal(MetricStrip([
    Metric("32", { label: "Speakers", countUp: true, trend: "+7 vs 2025" }),
    Metric("48", { label: "Talks and workshops", countUp: true, trend: "+12 vs 2025" }),
    Metric("1,200", { label: "Attendees", countUp: true, trend: "+200 seats" }),
    Metric("8", { label: "Hands-on workshops", countUp: true, trend: "+2 rooms" })
  ], { columns: 4 }), { animation: "zoom" })
], { background: "brand", padding: "md", align: "center" })

// ---------- speakers ---------------------------------------------------------
function speakerCard(p) {
  return ProfileCard(p.name, {
    role: p.role, avatarSrc: photo(p.seed), bio: p.talk, tags: p.tags,
    actions: [Button("Bio and talk", { variant: "secondary", size: "sm", icon: "arrow-right", iconPosition: "trailing", fullWidth: true, onClick: () => { $speaker = p } })],
    sx: { states: { hover: { translateY: "-3px", shadow: "lg" } }, h: "full" }
  })
}

speakerWall = Section([
  Reveal(Grid(speakers.map(p => speakerCard(p)), { columns: { base: 1, sm: 2, lg: 4 }, gap: "lg" }), { animation: "fade-up" })
], { eyebrow: "SPEAKERS", title: "The people on stage", subtitle: "Eight of the thirty-two confirmed so far. Open a card for the full bio, the talk and where to find them.", align: "center", width: "xl", id: "speakers" })

function socialRow(p) {
  return Row([
    Button("GitHub", { variant: "ghost", size: "sm", icon: "brands:github", href: `https://github.com/${p.handle}` }),
    Button("Mastodon", { variant: "ghost", size: "sm", icon: "brands:mastodon", href: `https://hachyderm.io/@${p.handle}` }),
    Button("Personal site", { variant: "ghost", size: "sm", icon: "link", href: `https://${p.handle}.dev` })
  ], { gap: "xs", wrap: true })
}

function speakerPanel(p) {
  if (!p) return Text("Pick a speaker to read their bio.", { tone: "muted" })
  return Column([
    Row([
      Avatar(p.name, { src: photo(p.seed), size: "xl" }),
      Column([
        Text(p.role, { variant: "small", tone: "muted" }),
        Row([Badge(p.track, { tone: trackTone(p.track), size: "sm", icon: trackIcon(p.track) }), Pill(daysLabel(speakerDays(p)), { tone: "activating", icon: "calendar-day" })], { gap: "xs", wrap: true })
      ], { gap: "xs" })
    ], { gap: "md", align: "center" }),
    Quote(p.talk, { cite: `${p.name} · 30 minutes, plus live Q&A` }),
    Text(p.bio),
    List(sessions.filter(s => s.speakerId == p.id).map(s => ListItem(s.title, { description: `${dayLabel(s.day)} · ${s.time} · ${s.room}`, icon: trackIcon(s.track) })), { divided: true, gap: "xs" }),
    Separator({ label: "Find them online" }),
    socialRow(p)
  ], { gap: "md" })
}

speakerModal = Modal($speaker ? $speaker.name : "Speaker", {
  open: $speaker != null, size: "md", closeOnBackdrop: true,
  onClose: () => { $speaker = null },
  children: [speakerPanel($speaker)],
  footer: [Button("Close", { variant: "ghost", onClick: () => { $speaker = null } }), Button("Jump to their track", { variant: "primary", icon: "calendar-day", onClick: jumpToSession })]
})

// ---------- agenda -----------------------------------------------------------
function sessionRow(s) {
  const p = speakerOf(s.speakerId)
  const on = $saved.includes(s.id)
  return TimelineItem(s.title, {
    time: `${s.time} · ${s.room}`, icon: trackIcon(s.track), tone: trackTone(s.track),
    content: [Row([
      Badge(s.track, { tone: trackTone(s.track), size: "sm" }),
      PersonChip(p.name, { role: p.role, avatarSrc: photo(p.seed), size: "sm" }),
      Spacer(),
      Button(on ? "In my schedule" : "Add to my schedule", { size: "sm", variant: on ? "secondary" : "ghost", icon: on ? "check" : "plus", onClick: () => toggleSession(s) })
    ], { gap: "sm", align: "center", wrap: true })]
  })
}

function dayPane(day, subtitle) {
  const rows = sessionsFor(day)
  return Column([
    Text(subtitle, { variant: "small", tone: "muted" }),
    Show(rows.length > 0, {
      fallback: EmptyState("Nothing on this track today", { description: "Switch the track filter to see the rest of the day.", icon: "calendar-xmark" }),
      children: Timeline(rows.map(s => sessionRow(s)))
    })
  ], { gap: "md" })
}

trackFilters = ["all", "Frontend", "Platform", "AI"].map(t => ({ value: t, label: t == "all" ? "All tracks" : t }))

agendaToolbar = Toolbar({
  left: [Text("Track", { variant: "small-heavy", tone: "muted" }), ToggleGroup("track", { items: trackFilters, value: $track, size: "sm", label: "Filter sessions by track" })],
  right: [
    Pill(`${$util.plural($saved.length, "session")} saved`, { tone: $saved.length > 0 ? "success" : "neutral", icon: "bookmark" }),
    Button("Open my schedule", { variant: "secondary", size: "sm", icon: "calendar-check", onClick: () => { $scheduleOpen = true } })
  ]
})

agenda = Section([
  Card([
    agendaToolbar,
    Tabs([
      TabItem("d1", { label: "Day 1 · Thu 12 Nov", icon: "calendar-day", badge: String(sessionsFor("d1").length), children: [dayPane("d1", "Thursday 12 November · Hall A, Hall B and the Studio · doors 08:00")] }),
      TabItem("d2", { label: "Day 2 · Fri 13 Nov", icon: "calendar-day", badge: String(sessionsFor("d2").length), children: [dayPane("d2", "Friday 13 November · the eight workshops run alongside the afternoon track")] })
    ], { value: $day, fitted: true })
  ])
], { eyebrow: "AGENDA", title: "Two days, three tracks", subtitle: "Filter by track, then save the sessions you want. Your picks stay in the schedule drawer.", align: "center", width: "lg", background: "soft", id: "agenda" })

scheduleDrawer = Drawer("My schedule", {
  open: $scheduleOpen, side: "right", width: "440px",
  onClose: () => { $scheduleOpen = false },
  children: [Show(savedSessions.length > 0, {
    fallback: EmptyState("Nothing saved yet", { description: "Use the add button on any session and it lands here.", icon: "calendar-plus" }),
    children: Column([
      Callout("info", { title: `${$util.plural(savedSessions.length, "session")} saved`, description: "Your picks sync to the ShipConf app when you scan your badge at the door.", compact: true }),
      List(savedSessions.map(s => ListItem(s.title, {
        description: `${dayLabel(s.day)} · ${s.time} · ${s.room}`, icon: trackIcon(s.track),
        trailing: [IconButton("xmark", { label: `Remove ${s.title} from my schedule`, size: "sm", variant: "ghost", onClick: () => toggleSession(s) })]
      })), { divided: true, gap: "xs" })
    ], { gap: "md" })
  })],
  footer: [Button("Done", { variant: "primary", onClick: () => { $scheduleOpen = false } })]
})

// ---------- tickets ----------------------------------------------------------
orderLines = tiers.filter(t => qtyOf(t.id) > 0).map(t => ({ label: t.name, qty: qtyOf(t.id), amount: money(t.price * qtyOf(t.id)) }))

orderCard = Card([
  SectionHeader("Your order", { eyebrow: "CHECKOUT", status: Pill(seats > 0 ? $util.plural(seats, "seat") : "No seats yet", { tone: seats > 0 ? "success" : "neutral" }) }),
  Column(tiers.map(t => Row([
    StackItem(Column([Text(t.name, { variant: "body-heavy" }), Text(`${money(t.price)} per seat, plus VAT`, { variant: "small", tone: "muted" })], { gap: "none" }), { grow: 1 }),
    QuantityStepper(qtyOf(t.id), { min: 0, max: 12, size: "sm", label: `${t.name} tickets`, onChange: n => setQty(t.id, n) })
  ], { gap: "md", align: "center", wrap: true, key: t.id })), { gap: "sm" }),
  Separator(),
  OrderSummary(orderLines, {
    subtotal: money(subtotal), discount: teamDiscount > 0 ? `− ${money(teamDiscount)}` : null, tax: money(vat), total: money(total),
    empty: "No seats in your order yet — add a tier above.",
    note: teamDiscount > 0 ? "Team rate applied: 15% off five seats or more. Invoiced by ShipConf Events GmbH, Berlin." : `Add ${$util.plural(Math.max(1, 5 - seats), "more seat")} for the 15% team rate. Invoiced by ShipConf Events GmbH, Berlin.`
  }),
  Show($ordered, { children: Callout("success", { title: "Tickets reserved", description: `${$util.plural(seats, "seat")} held for 72 hours. We emailed the confirmation and a printable invoice; badges are collected at the door.`, compact: true }) }),
  Button("Checkout securely", { variant: "primary", size: "lg", fullWidth: true, icon: "lock", onClick: checkout })
])

tierCard = t => PricingCard(t.name, {
  price: money(t.price), period: "+ VAT", description: t.blurb,
  features: t.features, featured: t.featured, badge: t.badge,
  action: Button(qtyOf(t.id) > 0 ? `In order (${qtyOf(t.id)})` : "Add to order", { variant: t.featured ? "primary" : "secondary", fullWidth: true, icon: "ticket", onClick: () => addTicket(t) })
})

tickets = Section([
  Reveal(PricingTable(tiers.map(t => tierCard(t))), { animation: "fade-up" }),
  Spacer("lg"),
  Container([orderCard], { size: "md", padding: "none" })
], { eyebrow: "TICKETS", title: "Pick your seats", subtitle: "Prices hold until 30 September 2026. Five seats or more and the 15% team rate applies itself in the summary below.", align: "center", width: "lg", id: "tickets" })

// ---------- sponsors, venue, faq --------------------------------------------
chips = (names, icons) => names.map((n, i) => LogoChip(n, { icon: icons[i] }))

sponsors = Section([
  Column([
    LogoCloud(chips(["Northwind Cloud", "Cadence Payments", "Halden Systems"], ["cloud", "credit-card", "microchip"]), { label: "Platinum partners" }),
    LogoCloud(chips(["Kastell", "Lumen Labs", "Brightpath", "Tessellate"], ["shield-halved", "lightbulb", "route", "table-cells"]), { label: "Gold partners" }),
    LogoCloud(chips(["Berlin JS", "Rust Berlin", "Women Who Deploy", "Studio Feldspar", "Open Infra e.V."], ["brands:js", "gear", "users", "palette", "server"]), { label: "Community partners" })
  ], { gap: "lg" })
], { background: "soft", eyebrow: "PARTNERS", title: "Who makes it affordable", subtitle: "Partner support is what keeps the community tier at 149 EUR and every talk free to watch.", align: "center", width: "lg", padding: "md", id: "partners" })

travel = [
  ["Address", "Koepenicker Str. 70, 10179 Berlin", "location-dot"],
  ["Doors", "08:00 both days, first talk 09:30", "clock"],
  ["U-Bahn", "Heinrich-Heine-Strasse (U8), 6 minutes on foot", "train-subway"],
  ["From BER", "FEX to Ostbahnhof, then 8 minutes by tram M10", "plane"],
  ["Hotel block", "Hotel Kranhaus Mitte, code SHIPCONF26 until 1 Oct", "bed"],
  ["Quiet room", "Ground floor, open all day, no laptops", "spa"]
]

venueCard = Card([
  SectionHeader("Kraftwerk Berlin", { eyebrow: "GETTING THERE", status: Pill("Step-free throughout", { tone: "success" }) }),
  DescriptionList(travel.map(r => DescriptionItem(r[0], r[1], { icon: r[2] })), { columns: 1 }),
  Callout("info", { title: "Travel grants are open", description: "We cover trains and a hotel night for 40 attendees each year. Apply with your ticket order.", icon: "hand-holding-heart", compact: true })
])

venueMap = Map({
  lat: 52.5104, lng: 13.4241, zoom: 14, height: "380px",
  caption: "Kraftwerk Berlin, Koepenicker Str. 70",
  title: "Map of the ShipConf 2026 venue in Berlin-Mitte",
  markers: [{ lat: 52.5104, lng: 13.4241, label: "Kraftwerk Berlin" }, { lat: 52.5122, lng: 13.4176, label: "U Heinrich-Heine-Strasse" }]
})

venue = Section([
  Split(venueCard, venueMap, { ratio: "1/1", gap: "lg", stackAt: "md", align: "start" })
], { eyebrow: "VENUE AND TRAVEL", title: "A power station in Berlin-Mitte", align: "center", width: "xl", id: "venue" })

faqs = [
  { q: "Are the talks recorded?", a: "Yes. Every talk is recorded and published free on the ShipConf channel within three weeks. Workshops are not recorded, by request of the facilitators." },
  { q: "Can I switch my ticket to a colleague?", a: "Up to 48 hours before the event, from the order page in your confirmation email. No fee, no questions." },
  { q: "What is included with the workshop tier?", a: "One seat in one of the eight workshops on day two, all materials, and priority in the afternoon Q&A queues. Seats are allocated in order of purchase." },
  { q: "Is there a code of conduct?", a: "There is, it is enforced, and the response team wears bright orange lanyards. Reports can be made in person, by email or anonymously through the event app." },
  { q: "What food is provided?", a: "Lunch and two coffee breaks on both days. Vegan by default, with gluten-free and halal options you select when you register." },
  { q: "Do you offer a diversity ticket?", a: "Yes. 120 free tickets, including travel support, go to people from groups under-represented in our industry. Applications close 20 September 2026." }
]

faq = Section([
  Accordion(faqs.map(f => AccordionItem(f.q, { children: [Text(f.a, { tone: "muted" })] })), { type: "single", showArrow: true })
], { eyebrow: "FAQ", title: "Before you book", align: "center", width: "md", background: "soft", id: "faq" })

// ---------- call for papers --------------------------------------------------
$subscribed = false

cfpForm = $form({
  values: { email: "" },
  rules: { email: [$util.rules.required("Add an email so we can reach you"), $util.rules.email("That does not look like a valid address")] },
  onSubmit: (v) => { $subscribed = true; $toast.success(`The CFP brief is on its way to ${v.email}`) }
})

cfpPitch = Column([
  Eyebrow("CALL FOR PAPERS"),
  Heading("Speak at ShipConf 2026", { size: "section" }),
  Text("Submissions close 5 September 2026. First-time speakers get a mentor, two rehearsal slots and travel covered, no exceptions.", { tone: "muted" }),
  Row([Badge("30 min talks", { tone: "primary" }), Badge("Lightning slots", { tone: "info" }), Badge("Workshops", { tone: "warning" })], { gap: "xs", wrap: true })
], { gap: "sm" })

cfpCapture = Show($subscribed, {
  fallback: Column([
    Input("cfpEmail", { label: "Work email", type: "email", placeholder: "you@company.com", autocomplete: "email", value: cfpForm.values.email, error: cfpForm.errors.email, onChange: v => cfpForm.setField("email", v), onBlur: () => cfpForm.touch("email"), required: true }),
    Button("Send me the CFP brief", { variant: "primary", icon: "paper-plane", fullWidth: true, loading: cfpForm.submitting, onClick: () => cfpForm.submit() }),
    Text("One email with the brief and the review rubric. Nothing else, ever.", { variant: "small", tone: "muted" })
  ], { gap: "sm" }),
  children: SuccessState("You are on the list", { description: "The CFP brief and the speaker handbook are on their way to your inbox.", icon: "envelope-circle-check", actions: [Button("Use another address", { variant: "ghost", onClick: () => { $subscribed = false; cfpForm.reset() } })] })
})

cfp = Section([
  Reveal(Card([Grid([cfpPitch, cfpCapture], { columns: { base: 1, md: 2 }, gap: "lg", alignItems: "center" })]), { animation: "fade-up" })
], { background: "brand", width: "lg", padding: "lg", id: "cfp" })

pageFooter = Footer({
  brand: Brand("ShipConf 2026"),
  tagline: "A practitioner conference for the people who keep production running. Berlin, 12-13 November 2026.",
  columns: [
    FooterColumn("Event", { links: [Link("Speakers", { href: "#speakers" }), Link("Agenda", { href: "#agenda" }), Link("Tickets", { href: "#tickets" }), Link("Venue", { href: "#venue" })] }),
    FooterColumn("Take part", { links: [Link("Call for papers", { href: "#cfp" }), Link("Diversity tickets", { href: "#faq" }), Link("Become a partner", { href: "#partners" }), Link("Volunteer", { href: "mailto:crew@shipconf.dev" })] }),
    FooterColumn("Legal", { links: [Link("Code of conduct", { href: "#faq" }), Link("Refund policy", { href: "#faq" }), Link("Privacy", { href: "#" })] })
  ],
  legal: "© 2026 ShipConf Events GmbH, Berlin — demo event site"
})
