// Subscription & Billing — the self-service billing area of a SaaS workspace: live plan and seat
// pricing, metered usage with overage warnings, a prorated change-plan flow, invoice history with a
// detail drawer, payment methods and a guarded cancel flow.
// Starting point for: any account/billing portal, upgrade flow or usage-and-quota page.
// Uses: $store plan state, $form validation, computed proration with $util.currency, PricingTable in
//       a Modal, DataGrid + FilterPill + Drawer, ConfirmDialog, ProgressRing, BarChart.
$app(Container([Column([header, statusBanner, kpis, planCard, usageCard, trendCard, invoicesCard, paymentCard, detailsCard, planModal, cancelModal, cancelConfirm, removeConfirm, invoiceDrawer], { gap: "lg" })], { size: "lg" }))

// ---------- Catalogue, subscription state and money maths ----------
money = n => $util.currency(n, "EUR")
pct = (used, quota) => quota > 0 ? $util.clamp(Math.round(used / quota * 100), 0, 999) : 0
meterTone = p => p >= 90 ? "danger" : p >= 80 ? "warning" : "primary"

plans = [
  { id: "starter", name: "Starter", seat: 9,  icon: "seedling",         apiQuota: 100000,  storageQuota: 50,   blurb: "For small teams putting their first workflows live.", features: ["Up to 10 seats", "100k API calls / month", "50 GB object storage", "Community support"] },
  { id: "growth",  name: "Growth",  seat: 19, icon: "chart-line",       apiQuota: 500000,  storageQuota: 250,  blurb: "For teams shipping automations every week.",          features: ["Unlimited seats", "500k API calls / month", "250 GB object storage", "Priority email support", "SAML single sign-on"] },
  { id: "scale",   name: "Scale",   seat: 39, icon: "building-columns", apiQuota: 2500000, storageQuota: 1000, blurb: "For regulated organisations at full throughput.",     features: ["Unlimited seats", "2.5M API calls / month", "1 TB object storage", "24/7 support, 1h SLA", "Audit log export", "Dedicated success manager"] }
]
planById = id => plans.find(p => p.id == id) ?? plans[1]

sub = $store({
  plan: "growth", cycle: "monthly", seats: 24, seatsUsed: 21, apiCalls: 431200, storageGb: 118, status: "active", reason: "",
  apply: (s, plan, cycle, seats) => { s.plan = plan; s.cycle = cycle; s.seats = seats; s.status = "active" },
  cancel: (s, reason) => { s.status = "cancelling"; s.reason = reason },
  reactivate: (s) => { s.status = "active"; s.reason = "" }
})

daysLeft = 25
daysInPeriod = 31
renewalLabel = $util.formatDate($util.addDays($util.today(), daysLeft), "MMM D, YYYY")
periodLabel = `${$util.formatDate($util.addDays($util.today(), daysLeft - daysInPeriod), "MMM D")} – ${renewalLabel}`
cycleDays = c => c == "annual" ? 365 : daysInPeriod
cycleWord = c => c == "annual" ? "year" : "month"
seatRate = (p, c) => c == "annual" ? p.seat * 10 : p.seat
periodCharge = (p, c, seats) => seatRate(p, c) * seats

currentPlan = planById(sub.plan)
currentCharge = periodCharge(currentPlan, sub.cycle, sub.seats)
cancelling = sub.status == "cancelling"
seatPct = pct(sub.seatsUsed, sub.seats)
apiPct = pct(sub.apiCalls, currentPlan.apiQuota)
storagePct = pct(sub.storageGb, currentPlan.storageQuota)
overages = [seatPct, apiPct, storagePct].filter(p => p >= 80).length
usageTotals = [288, 344, 401, 466, 512, 431]
quotaK = currentPlan.apiQuota / 1000

// ---------- Invoices ----------
vatRate = 0.22
invoices = [
  { id: "INV-2048", issued: "2026-08-01", period: "1 Aug – 1 Sep", plan: "Growth",  seats: 24, rate: 19, addon: 49, status: "open" },
  { id: "INV-2031", issued: "2026-07-01", period: "1 Jul – 1 Aug", plan: "Growth",  seats: 24, rate: 19, addon: 49, status: "paid" },
  { id: "INV-2014", issued: "2026-06-01", period: "1 Jun – 1 Jul", plan: "Growth",  seats: 22, rate: 19, addon: 49, status: "paid" },
  { id: "INV-1996", issued: "2026-05-01", period: "1 May – 1 Jun", plan: "Growth",  seats: 22, rate: 19, addon: 0,  status: "past_due" },
  { id: "INV-1978", issued: "2026-04-01", period: "1 Apr – 1 May", plan: "Growth",  seats: 18, rate: 19, addon: 0,  status: "paid" },
  { id: "INV-1959", issued: "2026-03-01", period: "1 Mar – 1 Apr", plan: "Starter", seats: 18, rate: 9,  addon: 0,  status: "paid" },
  { id: "INV-1941", issued: "2026-02-01", period: "1 Feb – 1 Mar", plan: "Starter", seats: 14, rate: 9,  addon: 0,  status: "refunded" },
  { id: "INV-1922", issued: "2026-01-01", period: "1 Jan – 1 Feb", plan: "Starter", seats: 14, rate: 9,  addon: 0,  status: "paid" },
  { id: "INV-1903", issued: "2025-12-01", period: "1 Dec – 1 Jan", plan: "Starter", seats: 12, rate: 9,  addon: 0,  status: "paid" }
]
seatLine = inv => ({ label: `${inv.plan} plan · ${inv.seats} seats`, amount: inv.seats * inv.rate })
lineItems = inv => inv.addon > 0 ? [seatLine(inv), { label: "Priority support add-on", amount: inv.addon }] : [seatLine(inv)]
invSubtotal = inv => $util.sum(lineItems(inv).map(l => l.amount))
invVat = inv => $util.round(invSubtotal(inv) * vatRate, 2)
invTotal = inv => $util.round(invSubtotal(inv) + invVat(inv), 2)
lifetimeBilled = $util.sum(invoices.filter(i => i.status != "refunded").map(i => invTotal(i)))
statusMeta = { paid: { label: "Paid", tone: "success", icon: "circle-check" }, open: { label: "Open", tone: "activating", icon: "hourglass-half" }, past_due: { label: "Past due", tone: "critical", icon: "triangle-exclamation" }, refunded: { label: "Refunded", tone: "neutral", icon: "rotate-left" } }
filters = ["all", "paid", "open", "past_due", "refunded"]
filterLabel = id => id == "all" ? "All invoices" : statusMeta[id].label
filterIcon = id => id == "all" ? "receipt" : statusMeta[id].icon
filterCount = id => id == "all" ? invoices.length : invoices.filter(i => i.status == id).length
cancelReasons = [{ value: "too-expensive", label: "Too expensive for the value we get" }, { value: "missing-feature", label: "Missing a feature we need" }, { value: "switching", label: "Switching to another tool" }, { value: "project-ended", label: "The project ended" }, { value: "other", label: "Something else" }]
reasonLabel = id => (cancelReasons.find(r => r.value == id) ?? { label: "not given" }).label

// ---------- Interactive state ----------
$invoiceFilter = "all"
$invoiceSort = { key: "Issued", direction: "desc" }
$invoicePage = 1
$openInvoice = ""
$planOpen = false
$draftPlan = "growth"
$draftCycle = "monthly"
$draftSeats = 24
$cancelOpen = false
$cancelConfirmOpen = false
$cancelReason = ""
$cancelNote = ""
$defaultCard = "pm-visa"
$removeCard = ""
$newNumber = ""
$newExpiry = ""
$newCvc = ""
$newHolder = ""
$cards = [{ id: "pm-visa", brand: "Visa", last4: "4242", exp: "07/29", holder: "Marta Ilves" }, { id: "pm-mc", brand: "Mastercard", last4: "8117", exp: "11/27", holder: "Northwind Labs OÜ" }]

visibleInvoices = $invoiceFilter == "all" ? invoices : invoices.filter(i => i.status == $invoiceFilter)
activeInvoice = invoices.find(i => i.id == $openInvoice)
walletDefault = $cards.find(c => c.id == $defaultCard)
walletLabel = walletDefault ? `${walletDefault.brand} ···· ${walletDefault.last4}` : "no default card"
draftPlanObj = planById($draftPlan)
safeSeats = Math.max(1, Math.min(500, Number($draftSeats) || 1))
draftCharge = periodCharge(draftPlanObj, $draftCycle, safeSeats)
unusedCredit = $util.round(currentCharge * daysLeft / cycleDays(sub.cycle), 2)
proratedNew = $util.round(draftCharge * daysLeft / cycleDays($draftCycle), 2)
dueToday = Math.max(0, $util.round(proratedNew - unusedCredit, 2))
carryCredit = Math.max(0, $util.round(unusedCredit - proratedNew, 2))
planChanged = $draftPlan != sub.plan || $draftCycle != sub.cycle || safeSeats != sub.seats
newDigits = $util.replace($newNumber, " ", "")
cardNumberError = $newNumber.length > 0 && newDigits.length < 16 ? "Enter all 16 digits" : null
expiryError = $newExpiry.length > 0 && $newExpiry.length < 5 ? "Use MM/YY" : null
cvcError = $newCvc.length > 0 && $newCvc.length < 3 ? "3 digits, from the back of the card" : null
canAddCard = newDigits.length == 16 && $newExpiry.length == 5 && $newCvc.length == 3 && $newHolder.length > 2

// ---------- Actions ----------
function syncDraft(extra) { $draftPlan = sub.plan; $draftCycle = sub.cycle; $draftSeats = sub.seats + extra; $planOpen = true }
function openPlanModal() { syncDraft(0) }
function openSeatModal() { syncDraft(5) }
function confirmPlan() {
  const charged = dueToday
  const name = draftPlanObj.name
  sub.apply($draftPlan, $draftCycle, safeSeats)
  $planOpen = false
  $toast.success(`Now on ${name} with ${safeSeats} seats — ${money(charged)} charged today`)
}
function startCancel() { $cancelReason = ""; $cancelNote = ""; $cancelOpen = true }
function continueCancel() { $cancelOpen = false; $cancelConfirmOpen = true }
function confirmCancel() { sub.cancel(reasonLabel($cancelReason)); $cancelConfirmOpen = false; $toast.warning(`Subscription ends ${renewalLabel}. Full access until then.`) }
function reactivate() { sub.reactivate(); $toast.success("Reactivated — your next invoice is unchanged") }
function openInvoice(index, row, id) { $openInvoice = id }
function closeInvoice() { $openInvoice = "" }
function downloadInvoice() { $toast.success(`${$openInvoice}.pdf queued for download`) }
function pickFilter(id) { $invoiceFilter = id; $invoicePage = 1 }
function addCard() {
  const brand = $util.startsWith(newDigits, "4") ? "Visa" : $util.startsWith(newDigits, "5") ? "Mastercard" : "Card"
  const last4 = newDigits.slice(-4)
  $cards = [...$cards, { id: `pm-${$util.uuid()}`, brand: brand, last4: last4, exp: $newExpiry, holder: $newHolder }]
  $newNumber = ""; $newExpiry = ""; $newCvc = ""; $newHolder = ""
  $toast.success(`${brand} ···· ${last4} added to your wallet`)
}
function removeCard() {
  const remaining = $cards.filter(c => c.id != $removeCard)
  if ($defaultCard == $removeCard) $defaultCard = remaining.length > 0 ? remaining[0].id : ""
  $cards = remaining; $removeCard = ""
  $toast.info("Payment method removed")
}

details = $form({
  values: { company: "Northwind Labs OÜ", vat: "EE101938472", line1: "Pärnu mnt 141", city: "Tallinn", zip: "11314", email: "ap@northwindlabs.ee" },
  rules: {
    company: [$util.rules.required("A legal entity name is required")], line1: [$util.rules.required("Street address is required")], city: [$util.rules.required("City is required")],
    zip: [$util.rules.required("Postcode is required"), $util.rules.minLength(4, "That postcode looks too short")],
    email: [$util.rules.required("Invoices need a recipient"), $util.rules.email("Invoices bounce without a valid address")],
    vat: [$util.rules.required("A VAT id is required for EU invoicing"), $util.rules.custom(v => $util.match(v, "^[A-Z]{2}[0-9A-Z]{6,12}$"), "Use the full VAT id, e.g. EE101938472")]
  },
  onSubmit: (v) => { $toast.success(`Billing details saved for ${v.company}`) }
})

// ---------- Reusable pieces ----------
function MeterRow(label, used, quota, unit, icon) {
  const p = pct(used, quota)
  return Column([
    Row([Icon(icon, { size: "sm" }), StackItem(Text(label, { variant: "body-heavy" }), { grow: 1 }), Text(`${$util.format(used, "compact")} of ${$util.format(quota, "compact")} ${unit}`, { variant: "small", tone: "muted" }), Badge(`${p}%`, { tone: p >= 90 ? "danger" : p >= 80 ? "warning" : "neutral", size: "xs" })], { gap: "xs", align: "center", wrap: true }),
    Progress(p, { max: 100, tone: meterTone(p) })
  ], { gap: "2xs" })
}

function CardRow(c) {
  return Row([
    Icon("credit-card", { size: "sm" }),
    StackItem(Column([Text(`${c.brand} ···· ${c.last4}`, { variant: "small-heavy" }), Text(`${c.holder} · expires ${c.exp}`, { variant: "small", tone: "muted" })], { gap: "3xs" }), { grow: 1 }),
    c.id == $defaultCard ? Badge("Default", { tone: "primary", size: "xs", icon: "star" }) : null,
    IconButton("trash", { label: `Remove ${c.brand} ending ${c.last4}`, variant: "ghost", size: "sm", onClick: () => { $removeCard = c.id } })
  ], { gap: "xs", align: "center", key: c.id })
}

function PlanTier(p) {
  return PricingCard(p.name, {
    price: money(seatRate(p, $draftCycle)), period: `per seat / ${cycleWord($draftCycle)}`, description: p.blurb, features: p.features,
    featured: p.id == $draftPlan, ribbon: p.id == sub.plan ? "Your current plan" : "Selected",
    action: Button(p.id == $draftPlan ? "Selected" : `Choose ${p.name}`, { variant: p.id == $draftPlan ? "primary" : "secondary", fullWidth: true, icon: p.id == $draftPlan ? "circle-check" : "arrow-right", onClick: () => { $draftPlan = p.id } })
  })
}

function BillingField(id, label, key, hint) {
  return FormControl(label, { field: Input(id, { value: details.values[key], error: details.errors[key], onChange: v => details.setField(key, v), onBlur: () => details.touch(key) }), hint: hint })
}

// ---------- Page ----------
header = PageHeader("Billing", {
  subtitle: `${currentPlan.name} · ${sub.seats} seats · next invoice ${money(currentCharge)} on ${renewalLabel}`,
  breadcrumbs: ["Workspace", "Settings", "Billing"],
  status: cancelling ? Badge("Cancelling", { tone: "warning", icon: "clock-rotate-left" }) : Badge(`${currentPlan.name} plan`, { tone: "primary", icon: "bolt" }),
  actions: [Button("Contact billing", { variant: "ghost", size: "sm", icon: "headset", onClick: () => $toast.info("Billing support replies within one business day") }), Button("Change plan", { variant: "primary", size: "sm", icon: "arrow-right-arrow-left", onClick: openPlanModal })]
})

statusBanner = Show(cancelling, { children: Banner(`Your subscription ends on ${renewalLabel}`, { message: `Reason given: ${sub.reason}. Reactivate before then and nothing about your billing changes.`, tone: "warning", icon: "triangle-exclamation", action: Button("Reactivate plan", { variant: "primary", icon: "rotate-right", onClick: reactivate }) }) })

kpis = Stats([
  { label: "Next invoice", value: money(currentCharge), hint: renewalLabel, tone: cancelling ? "warning" : "default" },
  { label: "Seats assigned", value: `${sub.seatsUsed} / ${sub.seats}`, hint: `${seatPct}% of purchased seats` },
  { label: "API calls this period", value: $util.format(sub.apiCalls, "compact"), hint: `${apiPct}% of the ${currentPlan.name} allowance`, tone: apiPct >= 80 ? "warning" : "default" },
  { label: "Billed to date", value: money(lifetimeBilled), hint: `${invoices.length} invoices since Dec 2025` }
], { layout: "strip" })

planCard = Card([
  SectionHeader(`${currentPlan.name} plan`, {
    eyebrow: "CURRENT SUBSCRIPTION",
    subtitle: `Billed ${sub.cycle == "annual" ? "annually" : "monthly"} at ${money(seatRate(currentPlan, sub.cycle))} per seat per ${cycleWord(sub.cycle)}`,
    status: Pill(cancelling ? "Cancels at period end" : "Active", { tone: cancelling ? "warning" : "success" }),
    actions: [Button("Change plan", { variant: "secondary", size: "sm", icon: "arrow-right-arrow-left", onClick: openPlanModal }), Button("Add seats", { variant: "secondary", size: "sm", icon: "user-plus", onClick: openSeatModal }), cancelling ? Button("Reactivate", { variant: "primary", size: "sm", icon: "rotate-right", onClick: reactivate }) : Button("Cancel plan", { variant: "ghost", size: "sm", icon: "ban", onClick: startCancel })]
  }),
  DescriptionList([
    DescriptionItem("Tier", { value: Row([Icon(currentPlan.icon, { size: "sm" }), Text(currentPlan.name, { variant: "body-heavy" })], { gap: "2xs", align: "center" }), icon: "layer-group" }),
    DescriptionItem("Seats", { value: `${sub.seats} purchased · ${sub.seatsUsed} assigned`, icon: "users" }),
    DescriptionItem("Billing cycle", { value: sub.cycle == "annual" ? "Annual — two months free" : "Monthly", icon: "repeat" }),
    DescriptionItem("Current period", { value: periodLabel, icon: "calendar-days" }),
    DescriptionItem(cancelling ? "Access ends" : "Renews on", { value: `${renewalLabel} · in ${daysLeft} days`, icon: "calendar-check" }),
    DescriptionItem("Recurring total", { value: Text(`${money(currentCharge)} / ${cycleWord(sub.cycle)}`, { variant: "body-heavy", tone: "primary" }), icon: "file-invoice-dollar" })
  ], { columns: 2 })
])

usageCard = Card([
  SectionHeader("Usage this period", { eyebrow: "METERED", subtitle: `${periodLabel} · meters reset in ${daysLeft} days`, status: overages > 0 ? Pill(`${overages} meter${overages == 1 ? "" : "s"} above 80%`, { tone: "warning" }) : Pill("All meters healthy", { tone: "success" }) }),
  Grid([
    Center([ProgressRing(seatPct, { max: 100, label: `${sub.seatsUsed}/${sub.seats}`, caption: "Seats assigned", tone: meterTone(seatPct), size: "lg" })]),
    Column([MeterRow("API calls", sub.apiCalls, currentPlan.apiQuota, "calls", "bolt"), MeterRow("Object storage", sub.storageGb, currentPlan.storageQuota, "GB", "database"), MeterRow("Seats", sub.seatsUsed, sub.seats, "seats", "users")], { gap: "md" })
  ], { columns: { base: 1, md: 2 }, gap: "lg", alignItems: "center" }),
  overages > 0 ? Callout("warning", { title: "You are close to your plan limits", description: `At the current rate you will pass the ${currentPlan.name} allowance before ${renewalLabel}. Overage is billed at €0.90 per 1,000 API calls and €0.15 per GB — storage sits at ${storagePct}%.`, icon: "gauge-high", actions: [Button("Upgrade plan", { variant: "primary", size: "sm", icon: "arrow-up", onClick: openPlanModal })] }) : Callout("success", { title: "Comfortably inside your plan", description: "No overage is forecast for this period.", icon: "circle-check", compact: true })
])

trendCard = Card([
  SectionHeader("Usage over time", { eyebrow: "LAST SIX PERIODS", subtitle: `API calls in thousands, split into the ${$util.format(currentPlan.apiQuota, "compact")} allowance and billable overage`, actions: [Button("Export CSV", { variant: "ghost", size: "sm", icon: "download", onClick: () => $toast.success("usage-last-6-periods.csv exported") })] }),
  BarChart(["Mar", "Apr", "May", "Jun", "Jul", "Aug"], [Series("Included calls (k)", usageTotals.map(v => Math.min(v, quotaK))), Series("Overage calls (k)", usageTotals.map(v => Math.max(0, v - quotaK)))], { stacked: true, height: 260, yAxisLabel: "Thousands of calls", ariaLabel: "API call volume for the last six billing periods" })
])

invoicesCard = Card([
  SectionHeader("Invoices", { eyebrow: "HISTORY", subtitle: `Showing ${visibleInvoices.length} of ${invoices.length} invoices · every amount includes ${Math.round(vatRate * 100)}% Estonian VAT`, actions: [Button("Download all", { variant: "ghost", size: "sm", icon: "file-zipper", onClick: () => $toast.success(`${visibleInvoices.length} PDFs queued for download`) })] }),
  Row(filters.map(f => FilterPill(filterLabel(f), { active: $invoiceFilter == f, count: filterCount(f), icon: filterIcon(f), onToggle: () => pickFilter(f) })), { gap: "2xs", wrap: true }),
  Show(visibleInvoices.length > 0, {
    fallback: EmptyState("No invoices with that status", { description: "Switch back to all invoices to see the full billing history.", icon: "receipt", action: Button("Show all invoices", { variant: "primary", icon: "filter-circle-xmark", onClick: () => pickFilter("all") }) }),
    children: DataGrid([
      Col("Invoice", { values: visibleInvoices.map(i => i.id), sortable: true, width: "130px" }),
      Col("Issued", { values: visibleInvoices.map(i => i.issued), format: "date", sortable: true }),
      Col("Period", { values: visibleInvoices.map(i => `${i.period} · ${i.plan}`), wrap: true }),
      Col("Seats", { values: visibleInvoices.map(i => i.seats), format: "number", align: "right", sortable: true }),
      Col("Amount", { values: visibleInvoices.map(i => invTotal(i)), format: "currency", currency: "EUR", align: "right", sortable: true }),
      Col("Status", { values: visibleInvoices.map(i => Pill(statusMeta[i.status].label, { tone: statusMeta[i.status].tone, icon: statusMeta[i.status].icon })) })
    ], { rowIds: visibleInvoices.map(i => i.id), caption: "Select a row to open the invoice with its line items", sort: $invoiceSort, page: $invoicePage, perPage: 5, density: "compact", striped: true, stickyHeader: false, onRowClick: openInvoice, emptyLabel: "No invoices match this filter" })
  })
])

paymentCard = Card([
  SectionHeader("Payment methods", { eyebrow: "WALLET", subtitle: `${walletLabel} is charged on the renewal date`, status: Pill($cards.length > 0 ? `${$cards.length} on file` : "None on file", { tone: $cards.length > 0 ? "neutral" : "critical" }) }),
  Show($cards.length > 0, {
    fallback: EmptyState("No payment method on file", { description: "Add a card below so your next invoice does not fail.", icon: "credit-card" }),
    children: Column([
      Radio("default-card", { label: "Default payment method", items: $cards.map(c => ({ value: c.id, label: `${c.brand} ···· ${c.last4} — expires ${c.exp}` })), value: $defaultCard, onChange: () => { $toast.info("Default payment method updated") } }),
      Column($cards.map(c => CardRow(c)), { gap: "2xs" })
    ], { gap: "md" })
  }),
  Separator("horizontal", { label: "Add a card" }),
  Grid([
    FormControl("Card number", { field: MaskedInput("new-card", { mask: "9999 9999 9999 9999", value: $newNumber, placeholder: "4242 4242 4242 4242", inputMode: "numeric" }), error: cardNumberError }),
    FormControl("Name on card", { field: Input("new-holder", { value: $newHolder, placeholder: "Marta Ilves", autocomplete: "cc-name" }) }),
    FormControl("Expiry", { field: MaskedInput("new-exp", { mask: "99/99", value: $newExpiry, placeholder: "07/29", inputMode: "numeric" }), error: expiryError }),
    FormControl("Security code", { field: MaskedInput("new-cvc", { mask: "999", value: $newCvc, placeholder: "123", inputMode: "numeric" }), error: cvcError })
  ], { columns: { base: 1, md: 2 }, gap: "md" }),
  Row([Icon("lock", { size: "sm" }), StackItem(Text("Card details are tokenised by our payment provider — the full number never reaches us.", { variant: "small", tone: "muted" }), { grow: 1 }), Button("Add card", { variant: "primary", icon: "plus", disabled: !canAddCard, onClick: addCard })], { gap: "sm", align: "center", wrap: true })
])

detailsCard = Card([
  SectionHeader("Billing details", { eyebrow: "INVOICE FOOTER", subtitle: "These appear on every invoice and credit note", actions: [Button("Discard changes", { variant: "ghost", size: "sm", icon: "rotate-left", disabled: !details.dirty, onClick: () => details.reset() })] }),
  ValidationSummary(details.errors, { count: true }),
  FormSection("Company", [BillingField("bd-company", "Legal entity", "company", null), BillingField("bd-vat", "VAT identification number", "vat", "Reverse charge applies to valid EU VAT ids registered outside Estonia.")], { helper: "Shown in the invoice header for tax purposes." }),
  FormSection("Registered address", [BillingField("bd-line1", "Street and number", "line1", null), Grid([BillingField("bd-city", "City", "city", null), BillingField("bd-zip", "Postcode", "zip", null)], { columns: { base: 1, md: 2 }, gap: "md" }), BillingField("bd-email", "Accounts payable email", "email", "Invoices and dunning notices go here.")]),
  Row([Text(details.dirty ? "You have unsaved billing details" : "Everything is up to date", { variant: "small", tone: details.dirty ? "warning" : "muted" }), Spacer(), Button("Save billing details", { variant: "primary", icon: "floppy-disk", loading: details.submitting, onClick: () => details.submit() })], { align: "center", wrap: true })
])

// ---------- Overlays ----------
planModal = Modal("Change your plan", {
  open: $planOpen, size: "lg", onClose: () => { $planOpen = false },
  children: [Column([
    Callout("info", { title: "Changes take effect straight away", description: `You pay a prorated amount for the ${daysLeft} days left in this period, then the new rate from ${renewalLabel}.`, icon: "circle-info", compact: true }),
    Row([StackItem(ToggleGroup("draft-cycle", { label: "Billing cycle", items: [{ value: "monthly", label: "Monthly" }, { value: "annual", label: "Annual" }], value: $draftCycle }), { grow: 1 }), Badge("Annual pays for 10 months, you get 12", { tone: "success", icon: "piggy-bank", size: "sm" })], { gap: "sm", align: "center", wrap: true }),
    PricingTable(plans.map(p => PlanTier(p)), { columns: 3 }),
    Grid([
      Column([
        FormControl("Seats", { field: NumberInput("draft-seats", { value: $draftSeats, min: 1, max: 500, step: 1, suffix: "seats" }), hint: `${sub.seatsUsed} seats are assigned to people right now.` }),
        Text(`${draftPlanObj.name} at ${money(seatRate(draftPlanObj, $draftCycle))} per seat × ${safeSeats} seats = ${money(draftCharge)} per ${cycleWord($draftCycle)}.`, { variant: "small", tone: "muted" })
      ], { gap: "sm" }),
      Column([
        Text("Proration summary", { variant: "small-heavy" }),
        DescriptionList([
          DescriptionItem(`Unused ${currentPlan.name} time`, { value: `− ${money(unusedCredit)}`, icon: "rotate-left" }),
          DescriptionItem(`${draftPlanObj.name} for ${daysLeft} days`, { value: money(proratedNew), icon: "calendar-day" }),
          DescriptionItem("Amount due today", { value: Text(money(dueToday), { variant: "large-heavy", tone: "primary" }), icon: "credit-card" }),
          DescriptionItem(`Then every ${cycleWord($draftCycle)}`, { value: money(draftCharge), icon: "repeat" })
        ], { columns: 1 }),
        carryCredit > 0 ? Text(`${money(carryCredit)} of credit carries over to your invoice on ${renewalLabel}.`, { variant: "small", tone: "success" }) : null
      ], { gap: "xs" })
    ], { columns: { base: 1, md: 2 }, gap: "lg", alignItems: "start" })
  ], { gap: "lg" })],
  footer: [Button("Keep current plan", { variant: "ghost", onClick: () => { $planOpen = false } }), Button(`Confirm — pay ${money(dueToday)} now`, { variant: "primary", icon: "circle-check", disabled: !planChanged, onClick: confirmPlan })]
})

cancelModal = Modal("Cancel your subscription", {
  open: $cancelOpen, onClose: () => { $cancelOpen = false },
  children: [Column([
    Callout("warning", { title: `You keep full access until ${renewalLabel}`, description: "After that, workspaces become read-only and API keys stop accepting calls. Exports stay available for 30 days.", icon: "triangle-exclamation" }),
    FormControl("Why are you leaving?", { field: Select("cancel-reason", { placeholder: "Pick the closest reason", items: cancelReasons, value: $cancelReason }), required: true, hint: "This goes to the product team, not to sales." }),
    FormControl("Anything else we should know?", { field: TextArea("cancel-note", { value: $cancelNote, rows: 3, placeholder: "Optional — what would have kept you here?", maxLength: 400 }) })
  ], { gap: "md" })],
  footer: [Button("Keep my plan", { variant: "ghost", onClick: () => { $cancelOpen = false } }), Button("Continue", { variant: "danger", icon: "arrow-right", disabled: $cancelReason == "", onClick: continueCancel })]
})

cancelConfirm = ConfirmDialog("Cancel at the end of this period?", {
  open: $cancelConfirmOpen, tone: "danger", icon: "ban", confirmLabel: "Cancel subscription", cancelLabel: "Go back", confirmDisabled: $cancelReason == "", onConfirm: confirmCancel, onCancel: () => { $cancelConfirmOpen = false },
  message: `${currentPlan.name} with ${sub.seats} seats stays active until ${renewalLabel}, then billing stops. Reason: ${reasonLabel($cancelReason)}.`
})

removeConfirm = ConfirmDialog("Remove this payment method?", {
  open: $removeCard != "", tone: "danger", icon: "trash", confirmLabel: "Remove card", onConfirm: removeCard, onCancel: () => { $removeCard = "" },
  message: "Future invoices fall back to the remaining default card. Add a replacement before the next renewal to avoid a failed payment."
})

invoiceDrawer = Drawer(activeInvoice ? `Invoice ${activeInvoice.id}` : "Invoice", $openInvoice != "", [
  activeInvoice ? Column([
    Row([
      StackItem(Column([Text(`${activeInvoice.plan} plan · ${activeInvoice.period}`, { variant: "body-heavy" }), Text(`Issued ${$util.formatDate(activeInvoice.issued, "MMM D, YYYY")} · ${details.values.company} · ${details.values.vat}`, { variant: "small", tone: "muted" })], { gap: "3xs" }), { grow: 1 }),
      Pill(statusMeta[activeInvoice.status].label, { tone: statusMeta[activeInvoice.status].tone, icon: statusMeta[activeInvoice.status].icon })
    ], { gap: "sm", align: "center", wrap: true }),
    OrderSummary(lineItems(activeInvoice), { subtotal: money(invSubtotal(activeInvoice)), tax: `${money(invVat(activeInvoice))} · VAT ${Math.round(vatRate * 100)}%`, total: money(invTotal(activeInvoice)), currency: "EUR", note: activeInvoice.status == "past_due" ? "The charge failed on the default card — retry to avoid suspension." : "Settled by SEPA direct debit unless stated otherwise." }),
    DescriptionList([
      DescriptionItem("Invoice number", { value: activeInvoice.id, icon: "hashtag" }),
      DescriptionItem("Seats billed", { value: `${activeInvoice.seats} × ${money(activeInvoice.rate)}`, icon: "users" }),
      DescriptionItem("Tax treatment", { value: "Estonia — standard rate", icon: "scale-balanced" }),
      DescriptionItem("Charged to", { value: walletLabel, icon: "credit-card" })
    ], { columns: 1 })
  ], { gap: "lg" }) : EmptyState("No invoice selected", { description: "Pick a row in the invoice table to see its line items.", icon: "receipt" })
], {
  width: "520px", onClose: closeInvoice,
  footer: [Button("Download PDF", { variant: "primary", icon: "download", onClick: downloadInvoice }), CopyButton($openInvoice, { label: "Copy number" }), activeInvoice && activeInvoice.status == "past_due" ? Button("Retry payment", { variant: "danger", icon: "rotate-right", onClick: () => $toast.warning("Retrying with the default card…") }) : null, Button("Close", { variant: "ghost", onClick: closeInvoice })]
})
