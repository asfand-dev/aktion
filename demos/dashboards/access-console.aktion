// Identity & Access Console — the IAM back-office for the Meridian Cloud workspace:
// members, an editable role/capability matrix, a security audit trail and access policy.
// Starting point for: any IAM, team-administration or security-admin console.
// Uses: AppShell + Sidebar + $router, $store directory, DataGrid (search, FilterPills,
//       selection, bulk actions), Drawer detail, $form invite Modal, Switch permission
//       matrix, ActivityLog audit feed, Slider policy, ConfirmDialog key revocation.
$app(AppShell(consoleSidebar, [pages], { topbar: consoleTopbar, collapsible: true }))

roleName = id => id == "owner" ? "Owner" : id == "admin" ? "Workspace admin" : id == "developer" ? "Developer" : "Auditor"
roleIcon = id => id == "owner" ? "crown" : id == "admin" ? "user-shield" : id == "developer" ? "code" : "clipboard-check"
roleTone = id => id == "owner" ? "primary" : id == "admin" ? "info" : id == "developer" ? "neutral" : "warning"
statusTone = s => s == "active" ? "success" : s == "invited" ? "warning" : "danger"
presenceOf = s => s == "active" ? "online" : s == "invited" ? "away" : "offline"
mfaLabel = m => m == "hardware" ? "Security key" : m == "app" ? "Authenticator" : m == "sms" ? "SMS (weak)" : "Not enrolled"
mfaTone = m => m == "none" ? "critical" : m == "sms" ? "warning" : "success"
mfaIcon = m => m == "hardware" ? "key" : m == "app" ? "mobile-screen" : m == "sms" ? "comment-sms" : "triangle-exclamation"
severityTone = s => s == "critical" ? "danger" : s == "warning" ? "warning" : "info"
actionIcon = a => a.startsWith("member") ? "user-pen" : a.startsWith("role") ? "shield-halved" : a.startsWith("apikey") ? "key" : a.startsWith("sso") ? "right-to-bracket" : "circle-info"
stamp = () => $util.formatDate($util.now(), "iso")

iam = $store({
  users: [
    { id: "u-101", name: "Amara Okonkwo", email: "amara.okonkwo@meridiancloud.io", role: "owner", teams: ["Leadership"], status: "active", mfa: "hardware", lastActive: "2026-08-07T08:52:00Z", joined: "2023-04-18" },
    { id: "u-102", name: "Priya Raghunathan", email: "priya.raghunathan@meridiancloud.io", role: "admin", teams: ["Platform", "Security"], status: "active", mfa: "hardware", lastActive: "2026-08-07T09:14:00Z", joined: "2023-09-02" },
    { id: "u-103", name: "Tomas Lindqvist", email: "tomas.lindqvist@meridiancloud.io", role: "developer", teams: ["Platform"], status: "active", mfa: "app", lastActive: "2026-08-07T07:38:00Z", joined: "2024-01-15" },
    { id: "u-104", name: "Sofia Marchetti", email: "sofia.marchetti@meridiancloud.io", role: "auditor", teams: ["Compliance"], status: "active", mfa: "app", lastActive: "2026-08-06T16:02:00Z", joined: "2024-03-11" },
    { id: "u-105", name: "Daniel Bauer", email: "daniel.bauer@meridiancloud.io", role: "developer", teams: ["Payments"], status: "active", mfa: "app", lastActive: "2026-08-07T06:55:00Z", joined: "2024-06-24" },
    { id: "u-106", name: "Hannah Vogel", email: "hannah.vogel@meridiancloud.io", role: "admin", teams: ["Platform", "Support"], status: "active", mfa: "sms", lastActive: "2026-08-05T18:20:00Z", joined: "2024-08-05" },
    { id: "u-107", name: "Mei-Ling Chen", email: "meiling.chen@meridiancloud.io", role: "developer", teams: ["Platform"], status: "active", mfa: "app", lastActive: "2026-08-07T09:41:00Z", joined: "2025-02-17" },
    { id: "u-108", name: "Lucas Ferreira", email: "lucas.ferreira@meridiancloud.io", role: "developer", teams: ["Payments"], status: "suspended", mfa: "none", lastActive: "2026-06-29T10:12:00Z", joined: "2024-11-04" },
    { id: "u-109", name: "Kenji Watanabe", email: "kenji.watanabe@meridiancloud.io", role: "developer", teams: ["Data"], status: "invited", mfa: "none", lastActive: "2026-08-06T09:00:00Z", joined: "2026-08-06" },
    { id: "u-110", name: "Omar Haddad", email: "omar.haddad@meridiancloud.io", role: "auditor", teams: ["Data", "Compliance"], status: "invited", mfa: "none", lastActive: "2026-08-07T08:10:00Z", joined: "2026-08-07" }
  ],
  roles: [
    { id: "owner", locked: true, description: "Unrestricted control of the workspace, billing and every environment. Locked by policy." },
    { id: "admin", locked: false, description: "Runs the directory: invites people, edits roles and approves production releases." },
    { id: "developer", locked: false, description: "Ships services and rotates the API keys their own team owns." },
    { id: "auditor", locked: false, description: "Read-only across the workspace, plus audit-log export for compliance reviews." }
  ],
  caps: [
    { id: "view_directory", group: "Directory", label: "View member directory", hint: "See every member, role and team", roles: ["owner", "admin", "developer", "auditor"] },
    { id: "invite_members", group: "Directory", label: "Invite & remove members", hint: "Send invitations, suspend accounts", roles: ["owner", "admin"] },
    { id: "manage_roles", group: "Directory", label: "Edit roles & permissions", hint: "Change this very matrix", roles: ["owner", "admin"] },
    { id: "deploy_prod", group: "Environments", label: "Deploy to production", hint: "Promote a build past staging", roles: ["owner", "admin", "developer"] },
    { id: "rotate_keys", group: "Environments", label: "Rotate API keys", hint: "Create and revoke workspace keys", roles: ["owner", "developer"] },
    { id: "read_audit", group: "Compliance", label: "Read the audit log", hint: "Browse every recorded event", roles: ["owner", "admin", "auditor"] },
    { id: "export_audit", group: "Compliance", label: "Export the audit log", hint: "Download signed CSV evidence", roles: ["owner", "auditor"] },
    { id: "manage_billing", group: "Compliance", label: "Manage billing & plan", hint: "Change seats, payment and plan", roles: ["owner"] }
  ],
  sessions: [
    { user: "u-102", device: "MacBook Pro · Chrome 141", location: "Berlin, DE", ip: "203.0.113.24", seen: "2026-08-07T09:14:00Z", current: true },
    { user: "u-102", device: "iPhone 17 · Safari", location: "Berlin, DE", ip: "203.0.113.61", seen: "2026-08-06T21:03:00Z", current: false },
    { user: "u-101", device: "ThinkPad X1 · Firefox 140", location: "Lagos, NG", ip: "198.51.100.7", seen: "2026-08-07T08:52:00Z", current: true },
    { user: "u-107", device: "MacBook Pro · Arc", location: "Taipei, TW", ip: "203.0.113.150", seen: "2026-08-07T09:41:00Z", current: true },
    { user: "u-108", device: "Unrecognised device · Chrome 133", location: "Unknown network", ip: "198.51.100.201", seen: "2026-06-29T10:12:00Z", current: false }
  ],
  roleChanges: [
    { user: "u-102", from: "developer", to: "admin", at: "2025-11-12T10:30:00Z", by: "Amara Okonkwo" },
    { user: "u-104", from: "developer", to: "auditor", at: "2025-08-19T09:20:00Z", by: "Amara Okonkwo" },
    { user: "u-103", from: "auditor", to: "developer", at: "2024-02-01T08:15:00Z", by: "Amara Okonkwo" },
    { user: "u-108", from: "admin", to: "developer", at: "2026-06-29T11:00:00Z", by: "Priya Raghunathan" }
  ],
  audit: [
    { id: "e-9001", actor: "Priya Raghunathan", action: "sso.policy_updated", resource: "SAML enforcement → required", ip: "203.0.113.24", at: "2026-08-07T09:12:00Z", severity: "warning" },
    { id: "e-9000", actor: "Mei-Ling Chen", action: "apikey.created", resource: "ci-pipeline-eu", ip: "203.0.113.150", at: "2026-08-07T09:02:00Z", severity: "info" },
    { id: "e-8999", actor: "System", action: "member.signin_failed", resource: "lucas.ferreira@meridiancloud.io · 4 attempts", ip: "198.51.100.201", at: "2026-08-07T08:31:00Z", severity: "critical" },
    { id: "e-8998", actor: "Amara Okonkwo", action: "member.invited", resource: "omar.haddad@meridiancloud.io as Auditor", ip: "198.51.100.7", at: "2026-08-07T08:10:00Z", severity: "info" },
    { id: "e-8997", actor: "Priya Raghunathan", action: "member.suspended", resource: "lucas.ferreira@meridiancloud.io", ip: "203.0.113.24", at: "2026-08-06T17:26:00Z", severity: "warning" },
    { id: "e-8996", actor: "Hannah Vogel", action: "role.permission_changed", resource: "Developer → rotate API keys", ip: "192.0.2.90", at: "2026-08-06T15:48:00Z", severity: "warning" },
    { id: "e-8995", actor: "Hannah Vogel", action: "member.mfa_reset", resource: "kenji.watanabe@meridiancloud.io", ip: "192.0.2.90", at: "2026-08-06T11:19:00Z", severity: "info" },
    { id: "e-8994", actor: "System", action: "apikey.revoked", resource: "legacy-metrics-exporter", ip: "198.51.100.7", at: "2026-08-05T22:40:00Z", severity: "critical" },
    { id: "e-8992", actor: "System", action: "sso.directory_sync", resource: "Okta → 10 members, 0 conflicts", ip: "198.51.100.44", at: "2026-08-04T02:00:00Z", severity: "info" }
  ],
  keys: [
    { id: "k-1", name: "ci-pipeline-eu", prefix: "mrd_live_9f2Ac", scope: "deploy:write", lastUsed: "2026-08-07T09:20:00Z", status: "active" },
    { id: "k-2", name: "billing-reconciler", prefix: "mrd_live_4Kd81", scope: "billing:read", lastUsed: "2026-08-07T04:00:00Z", status: "active" },
    { id: "k-3", name: "status-page-probe", prefix: "mrd_live_77Bq0", scope: "status:read", lastUsed: "2026-08-06T23:55:00Z", status: "active" },
    { id: "k-4", name: "legacy-metrics-exporter", prefix: "mrd_live_1Zz33", scope: "metrics:read", lastUsed: "2026-08-05T22:39:00Z", status: "revoked" }
  ],
  invite: (s, member) => { s.users = [member, ...s.users] },
  removeUser: (s, id) => { s.users = s.users.filter(u => u.id != id) },
  setStatus: (s, ids, status) => { s.users = s.users.map(u => ids.includes(u.id) ? { ...u, status: status } : u) },
  setRole: (s, ids, role) => { s.users = s.users.map(u => ids.includes(u.id) ? { ...u, role: role } : u) },
  resetMfa: (s, id) => { s.users = s.users.map(u => u.id == id ? { ...u, mfa: "none" } : u) },
  toggleGrant: (s, capId, roleId) => { s.caps = s.caps.map(c => c.id == capId ? { ...c, roles: c.roles.includes(roleId) ? c.roles.filter(r => r != roleId) : [...c.roles, roleId] } : c) },
  revokeKey: (s, id) => { s.keys = s.keys.map(k => k.id == id ? { ...k, status: "revoked" } : k) },
  logEvent: (s, entry) => { s.audit = [entry, ...s.audit] }
})

org = $store({
  ssoEnabled: true, ssoDomain: "meridiancloud.io", idp: "okta", sessionHours: 12, idleMinutes: 30, enforceMfa: true,
  setSso: (s, v) => { s.ssoEnabled = v },
  setDomain: (s, v) => { s.ssoDomain = v },
  setIdp: (s, v) => { s.idp = v },
  setSession: (s, v) => { s.sessionHours = v },
  setIdle: (s, v) => { s.idleMinutes = v },
  setMfa: (s, v) => { s.enforceMfa = v }
})

$userQuery = ""
$userStatus = "all"
$userSort = { key: "Member", direction: "asc" }
$userPage = 1
$selectedIds = []
$openUserId = null
$inviteOpen = false
$auditSeverity = "all"
$auditQuery = ""
$revokeKeyId = null
$window = "7d"

activeMembers = iam.users.filter(u => u.status == "active")
pendingInvites = iam.users.filter(u => u.status == "invited")
suspended = iam.users.filter(u => u.status == "suspended")
mfaEnrolled = iam.users.filter(u => u.mfa != "none")
mfaCoverage = iam.users.length > 0 ? mfaEnrolled.length / iam.users.length : 0
privileged = iam.users.filter(u => u.role == "owner" || u.role == "admin")
teamOptions = $util.unique($util.flatten(iam.users.map(u => u.teams)))
failedEvents = iam.audit.filter(e => e.action == "member.signin_failed")
userQ = $userQuery.trim().toLowerCase()
visibleUsers = iam.users.filter(u => ($userStatus == "all" || u.status == $userStatus) && (userQ == "" || `${u.name} ${u.email} ${$util.join(u.teams, " ")}`.toLowerCase().includes(userQ)))
openUser = iam.users.find(u => u.id == $openUserId)
openSessions = iam.sessions.filter(s => s.user == $openUserId)
openHistory = iam.roleChanges.filter(r => r.user == $openUserId)
auditQ = $auditQuery.trim().toLowerCase()
visibleAudit = iam.audit.filter(e => ($auditSeverity == "all" || e.severity == $auditSeverity) && (auditQ == "" || `${e.actor} ${e.action} ${e.resource} ${e.ip}`.toLowerCase().includes(auditQ)))
auditDays = $util.reverse($util.unique(iam.audit.map(e => $util.formatDate(e.at, "YYYY-MM-DD"))))
countOn = (day, sev) => iam.audit.filter(e => $util.formatDate(e.at, "YYYY-MM-DD") == day && e.severity == sev).length
windows = { "7d": { points: 7, mult: 1, label: "last 7 days" }, "14d": { points: 7, mult: 2, label: "last 14 days" }, "30d": { points: 6, mult: 4, label: "last 30 days" } }
win = windows[$window]
signinBase = [412, 388, 441, 465, 402, 158, 121]
chartLabels = $util.range(0, win.points - 1).map(i => $window == "7d" ? ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"][i] : `W${i + 1}`)
signins = $util.range(0, win.points - 1).map(i => signinBase[i % 7] * win.mult)
failedSignins = signins.map(v => Math.round(v * 0.018) + win.mult)
totalSignins = $util.sum(signins)
totalFailed = $util.sum(failedSignins)
record = (action, resource, severity) => iam.logEvent({ id: $util.uuid(), actor: "Priya Raghunathan", action: action, resource: resource, ip: "203.0.113.24", at: stamp(), severity: severity })

function bulkApply(kind, value) {
  const n = $selectedIds.length
  if (n == 0) return $toast.info("Select at least one member first")
  if (kind == "role") iam.setRole($selectedIds, value)
  else iam.setStatus($selectedIds, value)
  record(kind == "role" ? "role.assigned" : "member.status_changed", `${n} member(s) → ${kind == "role" ? roleName(value) : value}`, "warning")
  $toast.success(`${$util.plural(n, "member")} updated`)
  $selectedIds = []
}

function confirmRevoke() {
  const key = iam.keys.find(k => k.id == $revokeKeyId)
  iam.revokeKey($revokeKeyId)
  record("apikey.revoked", key ? key.name : "API key", "critical")
  $toast.success(key ? `${key.name} revoked` : "API key revoked")
  $revokeKeyId = null
}

inviteForm = $form({
  values: { email: "", role: "developer", teams: [] },
  rules: { email: [$util.rules.required("A work email is required"), $util.rules.email("That does not look like an email address")], role: [$util.rules.required("Pick a starting role")] },
  onSubmit: (v) => {
    iam.invite({ id: $util.uuid(), name: $util.titlecase($util.replace($util.split(v.email, "@")[0], ".", " ")), email: v.email, role: v.role, teams: v.teams.length > 0 ? v.teams : ["Unassigned"], status: "invited", mfa: "none", lastActive: stamp(), joined: $util.today() })
    record("member.invited", `${v.email} as ${roleName(v.role)}`, "info")
    $toast.success(`Invitation sent to ${v.email}`)
    $inviteOpen = false
    inviteForm.reset()
  }
})

consoleSidebar = Sidebar([
  SidebarSection("Access", { items: [SidebarItem("Users", { icon: "users", to: "/", badge: String(iam.users.length) }), SidebarItem("Roles & permissions", { icon: "shield-halved", to: "/roles", badge: String(iam.roles.length) }), SidebarItem("Audit log", { icon: "list-check", to: "/audit", badge: String(failedEvents.length) })] }),
  SidebarSection("Workspace", { items: [SidebarItem("Organisation settings", { icon: "gear", to: "/settings", badge: String(pendingInvites.length) })] })
], { brand: "Meridian Cloud", tagline: "Identity & access", footer: [Row([Avatar("Priya Raghunathan", { size: "sm", fallback: "initials", status: "online" }), Column([Text("Priya Raghunathan", { variant: "small-heavy" }), Text("Workspace admin", { variant: "small", tone: "muted" })], { gap: "3xs" })], { gap: "sm", align: "center" })] })

consoleTopbar = Row([Pill("Production tenant", { tone: "corporate", icon: "cloud" }), StatusDot("Directory sync healthy", { tone: "success", pulse: true }), Spacer(), Pill(`${pendingInvites.length} pending invites`, { tone: "activating", icon: "envelope" }), IconButton("book", { label: "Access policy handbook", variant: "ghost" }), Avatar("Priya Raghunathan", { size: "sm", fallback: "initials" })], { gap: "sm", align: "center", wrap: true })

// ---- Users ------------------------------------------------------------------
memberCell = u => Row([Avatar(u.name, { size: "sm", fallback: "initials", status: presenceOf(u.status) }), Column([Text(u.name, { variant: "body-heavy" }), Text(u.email, { variant: "small", tone: "muted" })], { gap: "3xs" })], { gap: "sm", align: "center" })
statusPill = (value, label, icon) => FilterPill(label, { active: $userStatus == value, icon: icon, count: value == "all" ? iam.users.length : iam.users.filter(u => u.status == value).length, onToggle: () => { $userStatus = value; $userPage = 1 } })
bulkBar = Toolbar({ left: [Text($util.plural($selectedIds.length, "member") + " selected", { variant: "small-heavy" }), Select("bulk-role", { items: iam.roles.map(r => SelectItem(r.id, { label: roleName(r.id) })), placeholder: "Change role to…", label: "Change role for the selected members", labelHidden: true, value: "", onChange: (v) => bulkApply("role", v) })], right: [Button("Reactivate", { variant: "secondary", size: "sm", icon: "user-check", onClick: () => bulkApply("status", "active") }), Button("Deactivate", { variant: "danger", size: "sm", icon: "user-slash", onClick: () => bulkApply("status", "suspended") })] })

function UsersPage() {
  return Column([
    PageHeader("Users", { subtitle: `${iam.users.length} accounts · ${activeMembers.length} active · ${$util.percent(mfaCoverage)} MFA coverage`, breadcrumbs: ["Meridian Cloud", "Access", "Users"], status: Badge(`${privileged.length} privileged`, { tone: "warning", icon: "user-shield" }), actions: [Button("Invite people", { variant: "primary", icon: "user-plus", onClick: () => { inviteForm.reset(); $inviteOpen = true } })] }),
    Stats([StatCard("Members", { value: String(iam.users.length), icon: "users", hint: `${teamOptions.length} teams`, tone: "primary" }), StatCard("Active", { value: String(activeMembers.length), icon: "circle-check", trend: "up", delta: `+${pendingInvites.length} joining`, tone: "success" }), StatCard("MFA enrolled", { value: `${mfaEnrolled.length} / ${iam.users.length}`, icon: "shield-halved", hint: $util.percent(mfaCoverage), tone: "info" }), StatCard("Suspended", { value: String(suspended.length), icon: "user-slash", hint: "Access revoked", tone: "danger" }), StatCard("Failed sign-ins", { value: String(totalFailed), icon: "triangle-exclamation", trend: "down", delta: win.label, tone: "warning" })], { layout: "grid" }),
    Grid([
      Card([SectionHeader("Sign-in activity", { eyebrow: "AUTHENTICATION", subtitle: `${$util.format(totalSignins, "compact")} successful sign-ins in the ${win.label}`, actions: [SegmentedControl(["7d", "14d", "30d"], { value: $window, size: "sm", label: "Reporting window", onChange: (v) => { $window = v } })] }), BarChart(chartLabels, { series: [Series("Successful", { values: signins }), Series("Failed", { values: failedSignins })], height: 220, ariaLabel: `Successful and failed sign-ins over the ${win.label}` })]),
      Card([SectionHeader("Role distribution", { eyebrow: "PRIVILEGE" }), PieChart(iam.roles.map(r => roleName(r.id)), { values: iam.roles.map(r => iam.users.filter(u => u.role == r.id).length), donut: true, valueFormat: "percent", size: 200, ariaLabel: "Members per role" }), Callout("warning", { title: `${privileged.length} accounts can change permissions`, description: "The quarterly access review is due on 30 September.", icon: "user-shield", compact: true })])
    ], { columns: { base: 1, lg: 2 }, gap: "lg", alignItems: "start" }),
    Card([
      SectionHeader("Directory", { eyebrow: "MEMBERS", subtitle: "Tick rows for bulk actions, or open a row for sessions, devices and role history." }),
      Toolbar({ left: [SearchBar("member-search", { placeholder: "Search name, email or team…", value: $userQuery, ariaLabel: "Search members", onChange: (v) => { $userQuery = v; $userPage = 1 } })], right: [Button("Export CSV", { variant: "secondary", size: "sm", icon: "download", onClick: () => $toast.info(`${$util.plural(visibleUsers.length, "row")} queued for export`) })] }),
      Row([statusPill("all", "All", "list"), statusPill("active", "Active", "circle-check"), statusPill("invited", "Invited", "envelope"), statusPill("suspended", "Suspended", "ban")], { gap: "xs", wrap: true }),
      Show(visibleUsers.length > 0, {
        fallback: EmptyState("No members match those filters", { description: "Clear the search box or pick another status.", icon: "user-slash", actions: [Button("Reset filters", { variant: "secondary", icon: "rotate-left", onClick: () => { $userQuery = ""; $userStatus = "all"; $userPage = 1 } })] }),
        children: DataGrid([
          Col("Member", visibleUsers.map(u => memberCell(u)), { sortable: true, width: "260px" }),
          Col("Role", visibleUsers.map(u => Badge(roleName(u.role), { tone: roleTone(u.role), size: "sm", icon: roleIcon(u.role) })), { sortable: true }),
          Col("Teams", visibleUsers.map(u => BadgeList(u.teams, { tone: "neutral", size: "xs", max: 2 }))),
          Col("MFA", visibleUsers.map(u => Pill(mfaLabel(u.mfa), { tone: mfaTone(u.mfa), icon: mfaIcon(u.mfa) }))),
          Col("Last active", visibleUsers.map(u => RelativeTime(u.lastActive)), { align: "right" }),
          Col("Status", visibleUsers.map(u => Badge($util.capitalize(u.status), { tone: statusTone(u.status), size: "sm" })), { align: "center" })], { rowIds: visibleUsers.map(u => u.id), selectable: true, selectedIds: $selectedIds, sort: $userSort, page: $userPage, perPage: 6, density: "compact", striped: true, toolbar: bulkBar, emptyLabel: "No members on this page", onRowClick: (i, row, id) => { $openUserId = id } }) })
    ]),
    Card([
      SectionHeader("Pending invitations", { eyebrow: "ONBOARDING", subtitle: `${$util.plural(pendingInvites.length, "person", "people")} invited but not yet signed in`, actions: [Button("Review role permissions", { variant: "ghost", size: "sm", icon: "arrow-right", iconPosition: "trailing", onClick: () => route.navigate("/roles") })] }),
      Show(pendingInvites.length > 0, { fallback: EmptyState("Everyone has signed in", { description: "No invitations are waiting for a first sign-in.", icon: "envelope-open-text" }), children: List(pendingInvites.map(u => ListItem(u.name, { description: `${u.email} · invited as ${roleName(u.role)} · ${$util.join(u.teams, ", ")}`, icon: "envelope", tone: "warning", trailing: [Button("Resend", { variant: "ghost", size: "xs", icon: "rotate-right", onClick: () => { record("member.invite_resent", u.email, "info"); $toast.info(`Invitation resent to ${u.email}`) } }), Button("Revoke", { variant: "ghost", size: "xs", icon: "xmark", onClick: () => { iam.removeUser(u.id); record("member.invite_revoked", u.email, "warning"); $toast.warning(`Invitation for ${u.email} revoked`) } })] })), { divided: true }) })
    ]),
    inviteModal,
    userDrawer
  ], { gap: "lg" })
}

inviteModal = Modal("Invite people", {
  open: $inviteOpen, size: "md", closeOnBackdrop: true, onClose: () => { $inviteOpen = false },
  children: [Column([
    Callout("info", { title: "Invitations expire after 7 days", description: "The member gets a signed link and must enrol a second factor before their first sign-in.", icon: "envelope-circle-check", compact: true }),
    FormSection("Identity", [FormControl("Work email", { field: Input("invite-email", { type: "email", placeholder: "name@meridiancloud.io", value: inviteForm.values.email, error: inviteForm.errors.email, onBlur: () => inviteForm.touch("email") }), required: true, hint: "Only verified domains can be invited." })]),
    FormSection("Access", [FormControl("Starting role", { field: Select("invite-role", { items: iam.roles.map(r => SelectItem(r.id, { label: roleName(r.id) })), value: inviteForm.values.role, error: inviteForm.errors.role, onChange: (v) => inviteForm.setField("role", v) }), required: true }), FormControl("Teams", { field: MultiSelect("invite-teams", { items: teamOptions.map(t => SelectItem(t, { label: t })), value: inviteForm.values.teams, placeholder: "Add to teams…", onChange: (v) => inviteForm.setField("teams", v) }), hint: "Team membership drives environment access." })], { helper: "The role can be changed at any time from the directory." })
  ], { gap: "md" })],
  footer: [Button("Cancel", { variant: "ghost", onClick: () => { $inviteOpen = false } }), Button("Send invitation", { variant: "primary", icon: "paper-plane", loading: inviteForm.submitting, onClick: () => inviteForm.submit() })]
})

userDrawer = Drawer(openUser ? openUser.name : "Member", {
  open: $openUserId != null, side: "right", width: "520px", onClose: () => { $openUserId = null },
  children: openUser ? [Column([
    Row([Avatar(openUser.name, { size: "lg", fallback: "initials", status: presenceOf(openUser.status) }), Column([Text(openUser.email, { variant: "body-heavy" }), Row([Badge(roleName(openUser.role), { tone: roleTone(openUser.role), size: "sm", icon: roleIcon(openUser.role) }), Badge($util.capitalize(openUser.status), { tone: statusTone(openUser.status), size: "sm" })], { gap: "2xs" })], { gap: "2xs" })], { gap: "md", align: "center" }),
    DescriptionList([DescriptionItem("Teams", { value: BadgeList(openUser.teams, { tone: "neutral", size: "xs" }), icon: "people-group" }), DescriptionItem("Second factor", { value: Pill(mfaLabel(openUser.mfa), { tone: mfaTone(openUser.mfa), icon: mfaIcon(openUser.mfa) }), icon: "shield-halved" }), DescriptionItem("Joined", { value: $util.formatDate(openUser.joined, "date"), icon: "calendar" }), DescriptionItem("Last active", { value: RelativeTime(openUser.lastActive), icon: "clock" })], { columns: 1 }),
    Card([SectionHeader("Sessions & devices", { eyebrow: "LIVE ACCESS", status: Badge(String(openSessions.length), { tone: "info", size: "sm" }) }), Show(openSessions.length > 0, { fallback: EmptyState("No signed-in devices", { description: "This account has no live session.", icon: "laptop" }), children: List(openSessions.map(s => ListItem(s.device, { description: `${s.location} · ${s.ip} · ${$util.relativeTime(s.seen)}`, icon: s.current ? "circle-dot" : "laptop", tone: s.current ? "success" : "default", trailing: [s.current ? Pill("This device", { tone: "success" }) : Pill("Idle", { tone: "neutral" })] })), { divided: true }) })]),
    Card([SectionHeader("Role history", { eyebrow: "PRIVILEGE TRAIL" }), Show(openHistory.length > 0, { fallback: EmptyState("Role never changed", { description: "This member still holds the role they were invited with.", icon: "shield-halved" }), children: Timeline(openHistory.map(h => TimelineItem(`${roleName(h.from)} → ${roleName(h.to)}`, { time: $util.formatDate(h.at, "date"), description: `Approved by ${h.by}`, icon: "shield-halved", tone: h.to == "admin" || h.to == "owner" ? "warning" : "info" }))) })])
  ], { gap: "lg" })] : [EmptyState("No member selected", { icon: "user" })],
  footer: openUser ? [Button("Reset MFA", { variant: "secondary", size: "sm", icon: "key", onClick: () => { iam.resetMfa(openUser.id); record("member.mfa_reset", openUser.email, "warning"); $toast.warning(`${openUser.name} must enrol a new factor`) } }), Button(openUser.status == "suspended" ? "Reactivate" : "Suspend access", { variant: openUser.status == "suspended" ? "primary" : "danger", size: "sm", icon: "user-slash", onClick: () => { iam.setStatus([openUser.id], openUser.status == "suspended" ? "active" : "suspended"); record("member.status_changed", openUser.email, "warning"); $toast.success(`Access updated for ${openUser.name}`) } })] : []
})

// ---- Roles ------------------------------------------------------------------
function RoleCard(r) {
  const members = iam.users.filter(u => u.role == r.id)
  const granted = iam.caps.filter(c => c.roles.includes(r.id))
  return Card([Column([
    Row([Icon(roleIcon(r.id), { size: "lg" }), StackItem(Column([Text(roleName(r.id), { variant: "body-heavy" }), Text($util.plural(members.length, "member"), { variant: "small", tone: "muted" })], { gap: "3xs" }), { grow: 1 }), r.locked ? Pill("Locked", { tone: "neutral", icon: "lock" }) : Pill("Editable", { tone: "activating", icon: "pen" })], { gap: "sm", align: "center" }),
    Text(r.description, { variant: "small", tone: "muted" }),
    Progress(granted.length, { max: iam.caps.length, label: `${granted.length} of ${iam.caps.length} capabilities`, tone: r.id == "owner" ? "danger" : r.id == "admin" ? "warning" : "primary" }),
    Row([AvatarGroup(members.map(m => ({ name: m.name })), { max: 4, size: "sm", fallback: "initials" }), Spacer(), Text(members.length > 0 ? $util.join(members.slice(0, 2).map(m => m.name), ", ") : "Nobody assigned", { variant: "small", tone: "muted", truncate: true })], { gap: "sm", align: "center" })
  ], { gap: "sm" })])
}

function RolesPage() {
  return Column([
    PageHeader("Roles & permissions", { subtitle: `${iam.roles.length} roles · ${iam.caps.length} capabilities · changes apply immediately`, breadcrumbs: ["Meridian Cloud", "Access", "Roles"], status: Badge("Live matrix", { tone: "success", icon: "shield-halved" }), actions: [Button("Back to users", { variant: "secondary", icon: "arrow-left", onClick: () => route.navigate("/") })] }),
    Stats([{ label: "Roles", value: String(iam.roles.length), hint: "1 locked by policy" }, { label: "Capabilities", value: String(iam.caps.length), hint: "3 groups" }, { label: "Privileged accounts", value: String(privileged.length), tone: "warning" }, { label: "Grants in force", value: String($util.sum(iam.caps.map(c => c.roles.length))), tone: "primary" }], { layout: "strip" }),
    Grid(iam.roles.map(r => RoleCard(r)), { columns: { base: 1, md: 2, lg: 4 }, gap: "md" }),
    Card([
      SectionHeader("Capability matrix", { eyebrow: "WHO CAN DO WHAT", subtitle: "Toggle a capability to grant or revoke it. Owner is locked.", actions: [Button("Export matrix", { variant: "ghost", size: "sm", icon: "download", onClick: () => $toast.info("Matrix exported as CSV") })] }),
      Table([Col("Capability", iam.caps.map(c => Column([Text(c.label, { variant: "body-heavy" }), Text(`${c.group} · ${c.hint}`, { variant: "small", tone: "muted" })], { gap: "3xs" })), { width: "280px" }), ...iam.roles.map(r => Col(roleName(r.id), iam.caps.map(c => Switch(`cap-${c.id}-${r.id}`, { label: `${c.label} for ${roleName(r.id)}`, labelHidden: true, value: c.roles.includes(r.id), disabled: r.locked, onChange: () => { iam.toggleGrant(c.id, r.id); record("role.permission_changed", `${roleName(r.id)} → ${c.label}`, "warning") } })), { align: "center" }))], { striped: true, density: "compact", ariaLabel: "Role by capability permission matrix" }),
      Callout("info", { title: `${iam.caps.filter(c => c.roles.length == 1).length} capabilities are owner-only`, description: "Everything else is delegated to at least two roles, so nobody is a single point of failure.", icon: "crown", compact: true })
    ])
  ], { gap: "lg" })
}

// ---- Audit ------------------------------------------------------------------
function AuditPage() {
  return Column([
    PageHeader("Audit log", { subtitle: `${iam.audit.length} recorded events · retained for 400 days`, breadcrumbs: ["Meridian Cloud", "Access", "Audit log"], status: Badge(`${failedEvents.length} failed sign-ins`, { tone: failedEvents.length > 0 ? "danger" : "success", icon: "triangle-exclamation" }), actions: [Button("Export evidence", { variant: "primary", icon: "file-export", onClick: () => $toast.success(`${$util.plural(visibleAudit.length, "event")} exported`) })] }),
    Stats([{ label: "Events", value: String(iam.audit.length), hint: "all severities" }, { label: "Critical", value: String(iam.audit.filter(e => e.severity == "critical").length), tone: "danger" }, { label: "Warnings", value: String(iam.audit.filter(e => e.severity == "warning").length), tone: "warning" }, { label: "Distinct actors", value: String($util.unique(iam.audit.map(e => e.actor)).length) }, { label: "Matching filter", value: String(visibleAudit.length), tone: "primary" }], { layout: "strip" }),
    Card([
      SectionHeader("Events per day", { eyebrow: "TREND", subtitle: "Stacked by severity across the retained window" }),
      BarChart(auditDays.map(d => $util.formatDate(d, "MMM D")), { series: [Series("Info", { values: auditDays.map(d => countOn(d, "info")) }), Series("Warning", { values: auditDays.map(d => countOn(d, "warning")) }), Series("Critical", { values: auditDays.map(d => countOn(d, "critical")) })], stacked: true, height: 200, ariaLabel: "Audit events per day, stacked by severity" })
    ]),
    Card([
      SectionHeader("Recorded activity", { eyebrow: "TRAIL", subtitle: "Actor, action, resource and origin IP for every privileged change." }),
      Toolbar({ left: [ToggleGroup("severity", { items: [{ value: "all", label: "All" }, { value: "info", label: "Info" }, { value: "warning", label: "Warning" }, { value: "critical", label: "Critical" }], value: $auditSeverity, size: "sm", label: "Severity", onChange: (v) => { $auditSeverity = v } })], right: [SearchBar("audit-search", { placeholder: "Filter by actor, action or IP…", value: $auditQuery, ariaLabel: "Filter audit events", onChange: (v) => { $auditQuery = v } })] }),
      Show(visibleAudit.length > 0, {
        fallback: EmptyState("No events match", { description: "Widen the severity filter or clear the search.", icon: "magnifying-glass", actions: [Button("Clear filters", { variant: "secondary", icon: "rotate-left", onClick: () => { $auditSeverity = "all"; $auditQuery = "" } })] }),
        children: ActivityLog(visibleAudit.map(e => ({ actor: e.actor, title: e.action, description: e.resource, time: $util.relativeTime(e.at), icon: actionIcon(e.action), tone: severityTone(e.severity), meta: `${e.ip} · ${$util.formatDate(e.at, "datetime")} · ${e.id}` })), { variant: "audit", emptyLabel: "No events recorded" })
      })
    ]),
    Card([SectionHeader("Suggested follow-ups", { eyebrow: "NEXT STEPS" }), Grid([ActionStripe("Investigate repeated failures", { description: `${failedEvents.length} failed sign-ins from unrecognised networks`, icon: "user-lock", trailing: Badge("Open", { tone: "danger", size: "sm" }), onClick: () => { $auditSeverity = "critical"; $toast.info("Filtered to critical events") } }), ActionStripe("Rotate exposed API keys", { description: "One key was revoked automatically last night", icon: "key", trailing: Badge("Settings", { tone: "info", size: "sm" }), onClick: () => route.navigate("/settings") })], { columns: { base: 1, md: 2 }, gap: "md" })])
  ], { gap: "lg" })
}

// ---- Settings ---------------------------------------------------------------
function SettingsPage() {
  return Column([
    PageHeader("Organisation settings", { subtitle: "Single sign-on, session policy and workspace credentials", breadcrumbs: ["Meridian Cloud", "Workspace", "Settings"], status: Badge(org.ssoEnabled ? "SSO enforced" : "SSO off", { tone: org.ssoEnabled ? "success" : "warning", icon: "right-to-bracket" }), actions: [Button("View audit log", { variant: "secondary", icon: "list-check", onClick: () => route.navigate("/audit") })] }),
    Card([
      SectionHeader("Single sign-on", { eyebrow: "SAML 2.0", status: Pill(org.ssoEnabled ? "Active" : "Disabled", { tone: org.ssoEnabled ? "success" : "neutral" }) }),
      FormSection("Identity provider", [
        Switch("sso-enabled", { label: "Require SAML for every member", value: org.ssoEnabled, description: "Password sign-in is refused once this is on.", onChange: (v) => { org.setSso(v); record("sso.policy_updated", v ? "SAML required" : "SAML optional", "warning") } }),
        FormControl("Verified domain", { field: InputGroup(Input("sso-domain", { value: org.ssoDomain, placeholder: "example.com", onChange: (v) => org.setDomain(v) }), { icon: "globe", suffix: "verified" }), hint: "Only addresses on this domain can be invited." }),
        FormControl("Provider", { field: Select("sso-idp", { items: [SelectItem("okta", { label: "Okta" }), SelectItem("entra", { label: "Microsoft Entra ID" }), SelectItem("google", { label: "Google Workspace" })], value: org.idp, onChange: (v) => { org.setIdp(v); $toast.success("Identity provider updated") } }) })], { helper: "Changes apply at the next sign-in; existing sessions are unaffected." })
    ]),
    Card([
      SectionHeader("Session policy", { eyebrow: "SECURITY", subtitle: `Sessions end after ${org.sessionHours}h, or ${org.idleMinutes} minutes idle` }),
      FormSection("Lifetimes", [
        Slider("session-hours", { min: 1, max: 24, step: 1, value: org.sessionHours, label: "Maximum session length", showValue: true, suffix: "h", marks: [1, 8, 12, 24], onChange: (v) => org.setSession(v) }),
        Slider("idle-minutes", { min: 5, max: 120, step: 5, value: org.idleMinutes, label: "Idle timeout", showValue: true, suffix: " min", marks: [5, 30, 60, 120], onChange: (v) => org.setIdle(v) }),
        Switch("enforce-mfa", { label: "Require a second factor", value: org.enforceMfa, description: `${mfaEnrolled.length} of ${iam.users.length} members are enrolled today.`, onChange: (v) => { org.setMfa(v); $toast.warning(v ? "MFA is now mandatory" : "MFA is now optional") } })]),
      Show(mfaCoverage < 1, { children: Callout("warning", { title: `${iam.users.length - mfaEnrolled.length} members have no second factor`, description: "They are locked out at their next sign-in while enforcement is on.", icon: "shield-halved", compact: true }) })
    ]),
    Card([
      SectionHeader("API keys", { eyebrow: "CREDENTIALS", subtitle: `${iam.keys.filter(k => k.status == "active").length} active · ${iam.keys.filter(k => k.status == "revoked").length} revoked`, actions: [Button("Create key", { variant: "secondary", size: "sm", icon: "plus", onClick: () => $toast.info("Key creation requires a hardware factor") })] }),
      Table([
        Col("Name", iam.keys.map(k => Text(k.name, { variant: "body-heavy" }))),
        Col("Prefix", iam.keys.map(k => Row([Text(k.prefix + "…", { variant: "small" }), CopyButton(k.prefix, { label: `Copy the ${k.name} prefix`, iconOnly: true })], { gap: "2xs", align: "center" }))),
        Col("Scope", iam.keys.map(k => Badge(k.scope, { tone: "neutral", size: "sm" }))),
        Col("Last used", iam.keys.map(k => RelativeTime(k.lastUsed)), { align: "right" }),
        Col("Status", iam.keys.map(k => Badge($util.capitalize(k.status), { tone: k.status == "active" ? "success" : "danger", size: "sm" })), { align: "center" }),
        Col("Revoke", iam.keys.map(k => k.status == "active" ? IconButton("ban", { label: `Revoke ${k.name}`, variant: "ghost", onClick: () => { $revokeKeyId = k.id } }) : Text("—", { tone: "muted" })), { align: "center" })], { density: "compact", ariaLabel: "Workspace API keys" })
    ]),
    Card([
      SectionHeader("Danger zone", { eyebrow: "IRREVERSIBLE" }),
      Callout("danger", { title: "Force sign-out of every session", description: `${iam.sessions.length} live sessions across ${$util.unique(iam.sessions.map(s => s.user)).length} members would end immediately.`, icon: "triangle-exclamation", actions: [Button("Sign everyone out", { variant: "danger", size: "sm", icon: "power-off", onClick: () => { record("session.global_signout", "All sessions", "critical"); $toast.warning("Every session has been invalidated") } })] }),
      ActionStripe("Delete this workspace", { description: "Removes all members, roles, keys and audit history after a 30-day hold.", icon: "trash", value: "Owner only", disabled: true })
    ]),
    revokeDialog
  ], { gap: "lg" })
}

revokeDialog = ConfirmDialog("Revoke this API key?", { open: $revokeKeyId != null, message: "Any service still presenting this key starts receiving 401 responses within seconds. This cannot be undone.", confirmLabel: "Revoke key", cancelLabel: "Keep it", tone: "danger", icon: "key", onConfirm: () => confirmRevoke(), onCancel: () => { $revokeKeyId = null } })

pages = $router({ "/": UsersPage(), "/roles": RolesPage(), "/audit": AuditPage(), "/settings": SettingsPage(), default: UsersPage() })
