// Feedback — 11 reusable status, alert and loading components.
$app(Column([header, Column(demos, { gap: "lg" })], { gap: "lg", padding: "md" }))

header = PageHeader("Feedback & status", { subtitle: "11 reusable feedback components", badge: Badge("Components", { tone: "primary", icon: "bell" }) })
function Demo(name, desc, body) { return Card([SectionHeader(name, { eyebrow: "COMPONENT", subtitle: desc }), body]) }

// 1 — inline callout/alert
function Alert(tone, { title, desc, icon = "circle-info" } = {}) {
  return Callout(tone || "info", { title, description: desc, icon })
}

// 2 — full-width page banner with action
function PageBanner(title, { message, tone = "primary", actionLabel } = {}) {
  return Banner(title, { message, tone, icon: "bullhorn", action: actionLabel ? Button(actionLabel, { variant: "secondary", size: "sm" }) : null })
}

// 3 — transient toast notification
function InlineToast(title, { message, tone = "success", icon = "circle-check" } = {}) {
  return Toast(title, { message, tone, icon })
}

// 4 — empty state with a call to action
function EmptyView(title, { desc, icon = "inbox", actionLabel } = {}) {
  return EmptyState(title, { description: desc, icon, action: actionLabel ? Button(actionLabel, { variant: "primary", icon: "plus" }) : null })
}

// 5 — error state with retry
function ErrorView(title, { desc, onRetry } = {}) {
  return ErrorState(title || "Something went wrong", { description: desc, actions: [Button("Retry", { variant: "primary", icon: "rotate-right", onClick: onRetry || (() => {}) })] })
}

// 6 — success confirmation state
function SuccessView(title, { desc, actionLabel } = {}) {
  return SuccessState(title || "All done!", { description: desc, icon: "circle-check", actions: actionLabel ? [Button(actionLabel, { variant: "primary" })] : [] })
}

// 7 — full-card loading state
function LoadingCard({ title = "Loading…", desc } = {}) {
  return LoadingState(title, { description: desc })
}

// 8 — skeleton placeholder
function SkeletonBlock({ variant = "paragraph", lines = 3 } = {}) {
  return Skeleton({ variant, lines })
}

// 9 — labelled progress bar
function ProgressBar(label, { value = 50, max = 100, tone = "primary" } = {}) {
  return Column([Row([Text(label, { variant: "small-heavy" }), Spacer(), Text(`${Math.round((value / max) * 100)}%`, { variant: "small", tone: "muted" })], { align: "center" }), Progress(value, { max, tone })], { gap: "xs" })
}

// 10 — status badge mapped from a status string
function StatusBadge(status) {
  const tones = { active: "success", pending: "warning", failed: "danger", draft: "neutral", live: "success", paused: "neutral" }
  const icons = { active: "circle-check", pending: "clock", failed: "circle-xmark", draft: "pen", live: "circle", paused: "pause" }
  return Badge($util.capitalize(status), { tone: tones[status] || "neutral", icon: icons[status] || "circle", size: "sm" })
}

// 11 — alert that can be dismissed and restored
function DismissibleAlert(tone, { title, desc } = {}) {
  const [show, setShow] = $state(true)
  return show
    ? Row([StackItem(Callout(tone || "warning", { title, description: desc, icon: "triangle-exclamation" }), { grow: 1 }), IconButton("xmark", { label: "Dismiss", variant: "ghost", onClick: () => setShow(false) })], { gap: "sm", align: "start" })
    : Button("Show alert", { variant: "ghost", size: "sm", icon: "rotate-left", onClick: () => setShow(true) })
}

demos = [
  Demo("Alert", "Inline callout by tone", Column([Alert("info", { title: "Heads up", desc: "A new version is available." }), Alert("success", { title: "Saved", desc: "Your changes are live.", icon: "circle-check" }), Alert("danger", { title: "Payment failed", desc: "Update your card to continue.", icon: "triangle-exclamation" })], { gap: "sm" })),
  Demo("PageBanner", "Full-width announcement", PageBanner("Scheduled maintenance", { message: "We'll be down for ~10 min at 2am UTC.", actionLabel: "Learn more" })),
  Demo("InlineToast", "Transient notification", Column([InlineToast("Deployment finished", { message: "Production is live · v2.4.0" }), InlineToast("Connection unstable", { message: "Retrying in 12s…", tone: "warning", icon: "triangle-exclamation" })], { gap: "sm" })),
  Demo("EmptyView", "Zero-state with CTA", EmptyView("No projects yet", { desc: "Create your first project to get started.", icon: "folder-open", actionLabel: "New project" })),
  Demo("ErrorView", "Error state with retry", ErrorView("Couldn't load data", { desc: "The server didn't respond." })),
  Demo("SuccessView", "Success confirmation", SuccessView("Order placed!", { desc: "We've emailed your receipt.", actionLabel: "View order" })),
  Demo("LoadingCard", "Full-card loading", LoadingCard({ title: "Crunching numbers…", desc: "This may take a moment" })),
  Demo("SkeletonBlock", "Loading placeholders", Grid([SkeletonBlock({ variant: "paragraph", lines: 3 }), SkeletonBlock({ variant: "card" })], { columns: 2, gap: "md" })),
  Demo("ProgressBar", "Labelled progress", Column([ProgressBar("Upload", { value: 64 }), ProgressBar("Storage", { value: 88, tone: "warning" })], { gap: "md" })),
  Demo("StatusBadge", "Status → coloured badge", Row([StatusBadge("active"), StatusBadge("pending"), StatusBadge("failed"), StatusBadge("draft"), StatusBadge("live")], { gap: "sm", wrap: true })),
  Demo("DismissibleAlert", "Dismissable + restorable", DismissibleAlert("warning", { title: "Storage almost full", desc: "You've used 92% of your quota." }))
]
