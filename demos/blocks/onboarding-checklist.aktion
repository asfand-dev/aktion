// Onboarding Checklist — a getting-started block with an overall progress ring,
// completable steps (each with an action), a dismissible tip, and a celebratory
// completed state once every required step is done. Progress persists.
$app(Container([Column([header, body], { gap: "lg" })], { size: "md" }))

steps = [
  { id: "verify", title: "Verify your email", desc: "Confirm your address to secure your account.", icon: "envelope", cta: "Resend email" },
  { id: "profile", title: "Complete your profile", desc: "Add a photo and a short bio.", icon: "id-badge", cta: "Edit profile" },
  { id: "workspace", title: "Create a workspace", desc: "Give your team a home base.", icon: "building", cta: "Create" },
  { id: "invite", title: "Invite a teammate", desc: "Collaboration is better together.", icon: "user-plus", cta: "Invite" },
  { id: "integrate", title: "Connect an integration", desc: "Link GitHub, Slack or Linear.", icon: "plug", cta: "Browse" }
]

$done = $storage.get("onboarding.done") ?? { verify: true }
$tipOpen = true

completedCount = steps.filter(s => $done[s.id]).length
pct = Math.round((completedCount / steps.length) * 100)
allDone = completedCount == steps.length
nextStep = steps.find(s => !$done[s.id])

$effect(() => { $storage.set("onboarding.done", $done) }, [$done])

function complete(id) { $done = { ...$done, [id]: true } }
function undo(id) { $done = { ...$done, [id]: false } }
function reset() { $done = {} }

header = PageHeader("Get started", { subtitle: `${completedCount} of ${steps.length} steps complete`, breadcrumbs: false, status: Badge(`${pct}%`, { tone: allDone ? "success" : "primary" }) })

progressCard = Card([Row([
  ProgressRing(pct, { max: 100, tone: allDone ? "success" : "primary", size: "lg", caption: "Setup" }),
  StackItem(Column([
    Text(allDone ? "You're all set!" : `Next: ${nextStep.title}`, { variant: "body-heavy" }),
    Text(allDone ? "Every step is complete. Nicely done." : nextStep.desc, { variant: "small", tone: "muted" }),
    Progress(pct, { max: 100, tone: allDone ? "success" : "primary", showValue: true })
  ], { gap: "sm" }), { grow: 1 })
], { gap: "lg", align: "center" })])

tip = Show($tipOpen && !allDone, {
  children: Banner("Pro tip", { message: "Finish onboarding to unlock templates and sample data.", tone: "info", icon: "lightbulb", action: Button("Got it", { variant: "ghost", size: "sm", onClick: () => { $tipOpen = false } }) })
})

function stepRow(s) {
  const isDone = $done[s.id] === true
  return Card([Row([
    IconButton(isDone ? "circle-check" : "circle", { label: isDone ? "Completed" : "Mark complete", variant: isDone ? "primary" : "ghost", onClick: () => isDone ? undo(s.id) : complete(s.id) }),
    StackItem(Column([
      Text(s.title, { variant: "body-heavy", tone: isDone ? "muted" : "default" }),
      Text(s.desc, { variant: "small", tone: "muted" })
    ], { gap: "xs" }), { grow: 1 }),
    isDone
      ? Badge("Done", { tone: "success", size: "sm", icon: "check" })
      : Button(s.cta, { variant: "secondary", size: "sm", icon: s.icon, onClick: () => complete(s.id) })
  ], { align: "center", gap: "md" })])
}

list = Column(steps.map(s => stepRow(s)), { gap: "sm" })

celebrate = Card([Center([Column([
  Icon("trophy", { size: "lg", color: "var(--rui-color-success)" }),
  SectionHeader("Onboarding complete!", { subtitle: "Your workspace is ready to roll." }),
  Row([Button("Go to dashboard", { variant: "primary", icon: "gauge" }), Button("Reset demo", { variant: "ghost", icon: "rotate-left", onClick: reset })], { gap: "sm" })
], { gap: "md", align: "center" })], { minHeight: "220px" })])

body = Show(allDone, {
  fallback: Column([progressCard, tip, list], { gap: "lg" }),
  children: celebrate
})
